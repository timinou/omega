; vendor/bl-ed/serve.bl — bl-ed on its own: files and evaluation, no providers.
;
;   bin/bl run -p vendor/bl-ed/src vendor/bl-ed/serve.bl     → http://127.0.0.1:8790/
;   BLED_PORT=… BLED_ROOT=dir BLED_WEB=dir                    (defaults: 8790, cwd, ./vendor/bl-ed/web)
;
; The server is the library bl-ed.serve (src/bl_ed/serve.bl); omega's launcher
; (bin/bl-ed) starts the same library with omega's providers and intents.

(ns bl-ed.serve-main (:require [bl-ed.serve :as s]))

(let [port (let [p (System/get_env "BLED_PORT")] (if (blank? p) 8790 (erlang/binary_to_integer p)))
      r (s/start! {:port port
                   :root (or (System/get_env "BLED_ROOT") ".")
                   :web (or (System/get_env "BLED_WEB") "vendor/bl-ed/web")})]
  (println (str "bl-ed: " (:url r) "   (documents under " (:root r) ")"))
  (receive (_ nil)))
