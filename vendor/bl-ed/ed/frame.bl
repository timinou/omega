; ed/frame.bl — a FRAME: one window, several panes, wired together.
;
; A Genera program frame (Zmail: a summary pane drives a message pane), in
; bl-ed terms. Design and decisions: research/domain/interface/frames.bl.md.
;
; ─── the data ──────────────────────────────────────────────────────────────
;
; A LAYOUT says what the window looks like. It is a plain value; a package
; provides it under (:provides {:layouts {name layout}}).
;
;   {:name  "inbox"
;    :panes [{:id :rail :doc "omega:overview" :width [:ch 38]}    ; an EDITOR pane
;            {:id :main :doc :linked          :width :fill}       ; filled by a link
;            {:id :map  :view [:minimap :main] :width [:ch 24]}]  ; a VIEW pane
;    :links [{:from :rail :on :select :to :main :do :visit}
;            {:from :map  :on :scroll :to :main :do :scroll}]
;    :focus :rail}
;
; A FRAME is a layout brought to life:
;
;   {:layout  layout
;    :editors {id ed}       ; one whole bl-ed editor per EDITOR pane
;    :focus   id            ; the editor pane keys go to
;    :effects [effect]}     ; what the panes asked the host for, tagged {:pane id}
;
; Two kinds of pane, and only two:
;   EDITOR  has a document, a cursor and keys: an ed, exactly as bl-ed has one
;   VIEW    has none of those: a pure function of another pane, recomputed when
;           drawn (a minimap); it can SEND events to the pane it views
;
; ─── the rules ─────────────────────────────────────────────────────────────
;
;   1. Keys go to the focused editor. space w w / h / l move focus
;      between EDITOR panes (views are never focused).
;   2. An event tagged {:pane id} goes to that pane: the host answering a
;      pane's effect, or a view acting on the pane it views.
;   3. A link fires after its :from pane changed. :select fires when the
;      object under that pane's cursor changed; its :visit emits a :visit
;      effect FOR the :to pane. A link never edits another pane directly:
;      every interaction is data (an effect or an event), testable and
;      replayable.
;   4. Packages are not per pane. Every editor pane carries every loaded
;      package (use/unuse in one pane spreads to all); a document's :adopt
;      picks how it draws. Removing the package that provided the active
;      layout returns to one pane.
;   5. One pane is today's bl-ed: (single ed) is a frame whose only pane is
;      that editor, and (frame/render) of it is ed.main/render plus a wrapper.

(ns ed.frame
  (:require [ed.main :as m]
            [ed.core :as c]
            [ed.docs :as docs]
            [ed.pkg :as pkg]
            [ed.memo :as memo]))

; ─── panes ─────────────────────────────────────────────────────────────────

(defn view-pane? [p] (some? (:view p)))
(defn editor-pane? [p] (not (view-pane? p)))

(defn panes [fr] (:panes (:layout fr)))
(defn pane-spec [fr id] (first (filter (fn [p] (= id (:id p))) (panes fr))))
(defn editor-ids [fr] (vec (map :id (filter editor-pane? (panes fr)))))

(defn editor [fr id] (get (:editors fr) id))
(defn focused [fr] (editor fr (:focus fr)))

; ─── making a frame ────────────────────────────────────────────────────────

(def SINGLE
  "The layout of today's bl-ed: one editor pane, nothing else."
  {:name "single" :panes [{:id :main :width :fill}] :links [] :focus :main})

(defn single
  "A frame of one pane: the editor `ed`."
  [ed]
  {:layout SINGLE :editors {:main ed} :focus :main :effects []})

(defn- blank-editor
  "An editor pane before its document arrives: it inherits the packages and
   the user's tables of `like`, so a pane is the same editor, elsewhere."
  [like]
  (merge (m/boot "" "")
         (select-keys like [:packages :pkg-state :user-commands :user-keys :registers])))

(defn- open-docs
  "Visit effects for the editor panes `ids` whose :doc is a path."
  [fr ids]
  (reduce (fn [fr id]
            (let [d (:doc (pane-spec fr id))]
              (if (string? d) (update fr :effects conj {:pane id :kind :visit :path d}) fr)))
          fr ids))

(defn arrange
  "Re-arrange frame `fr` into `layout`. The focused editor is KEPT (its
   document, cursor, history) in the layout's pane that shows the same :doc,
   or else its first :linked pane; the other editor panes start blank and
   their documents are fetched."
  [fr layout]
  (let [keep-ed (focused fr)
        eds (filter editor-pane? (:panes layout))
        here (or (first (filter (fn [p] (= (:doc p) (:path keep-ed))) eds))
                 (first (filter (fn [p] (= :linked (:doc p))) eds))
                 (first eds))
        others (filter (fn [p] (not= (:id p) (:id here))) eds)]
    ;; a world request (:intent) the kept editor already emitted — e.g. a
    ;; package's :adopt asking for its data while it arranges the window —
    ;; survives the re-arrangement, retagged to the pane the editor now lives
    ;; in, so its answer finds it. Everything else pending is dropped as
    ;; before: arranging re-requests every pane's document itself.
    (open-docs {:layout layout
                :editors (into {(:id here) keep-ed} (map (fn [p] [(:id p) (blank-editor keep-ed)]) others))
                :focus (or (:focus layout) (:id here))
                :effects (vec (keep (fn [e] (when (and (= :intent (:kind e))
                                                       (or (nil? (:pane e)) (= (:pane e) (:focus fr))))
                                              (assoc e :pane (:id here))))
                                    (:effects fr)))}
               (map :id others))))

(defn unarrange
  "Back to one pane: the focused editor, keeping its pane id."
  [fr]
  (let [id (:focus fr)]
    {:layout (assoc SINGLE :panes [{:id id :width :fill}] :focus id)
     :editors {id (focused fr)} :focus id :effects (:effects fr)}))

; ─── links ─────────────────────────────────────────────────────────────────

(defn selection
  "What a pane's cursor is on: the provider object's [type key], or nil."
  [ed]
  (let [o (or (docs/object-at ed)
              (some (fn [p] (when-let [f (get-in p [:provides :selection])] (f ed)))
                    (reverse (pkg/packages ed))))]
    (when (some? o) [(:type o) (:key o)])))

(defn link-path
  "Where an object leads: asked of the packages that provide links for its
   type (:provides {:links {type (fn [obj] path)}})."
  [ed [ty k]]
  (let [f (some (fn [p] (get-in p [:provides :links ty])) (reverse (pkg/packages ed)))]
    (when (some? f) (f {:type ty :key k}))))

(defn- fire-link
  "One :select link from pane `from`, whose selection changed."
  [fr link sel]
  (let [path (when (some? sel) (link-path (editor fr (:from link)) sel))]
    (if (and (= :visit (:do link)) (some? path))
      (update fr :effects conj {:pane (:to link) :kind :visit :path path})
      fr)))

(defn- follow-links
  "After pane `id` changed from `before`: fire its :select links."
  [fr id before]
  (let [s0 (selection before) s1 (selection (editor fr id))]
    (if (= s0 s1) fr
      (reduce (fn [fr l] (fire-link fr l s1)) fr
              (filter (fn [l] (and (= id (:from l)) (= :select (:on l)))) (:links (:layout fr)))))))

; ─── events ────────────────────────────────────────────────────────────────

(defn- step-editor
  "Run one event through editor pane `id`; collect its effects, tagged."
  [fr id ev]
  (let [before (editor fr id)
        after (m/handle before ev)
        [after effs] (m/take-effects after)
        fr (-> fr
               (assoc-in [:editors id] after)
               (update :effects into (map (fn [e] (assoc e :pane (or (:pane e) id))) effs)))]
    (follow-links fr id before)))

(defn- move-focus [fr dir]
  (let [ids (editor-ids fr)
        i (or (first (filter (fn [i] (= (nth ids i) (:focus fr))) (range (count ids)))) 0)]
    (assoc fr :focus (nth ids (mod (+ i dir) (count ids))))))

(declare layouts)

(defn reconfigure
  "A package-requested layout transition. :keep maps destination pane ids to
   existing source ids (:origin names the sender); nil requests a fresh editor.
   A vector of sources chooses its first existing editor.
   Retained editors keep exact state. Unsaved text or prompt drafts cannot be
   discarded. :visits is {pane {:path address :goto optional}}. Pure host effects."
  [fr request]
  (let [layout (get (layouts (focused fr)) (:layout request))
        origin (:pane request)
        fail (fn [message] (assoc-in fr [:editors (:focus fr)] (c/message (focused fr) message)))]
    (if (nil? layout) (fail (str "No layout " (:layout request)))
      (let [ids (vec (map :id (filter editor-pane? (:panes layout))))
            specified (or (:keep request) {})
            resolve-source (fn [v] (if (= :origin v) origin v))
            source (fn [id] (let [v (if (contains? specified id) (get specified id) id)]
                              (if (vector? v)
                                (first (filter (fn [src] (some? (editor fr src))) (map resolve-source v)))
                                (resolve-source v))))
            mapping (into {} (map (fn [id] [id (source id)]) ids))
            sources (vec (keep (fn [[id src]] (when (editor fr src) src)) mapping))
            draft? (fn [ed] (or (and (not (docs/read-only? ed)) (c/dirty? ed)) (seq (get-in ed [:minibuf :text]))))
            lost (filter (fn [id] (and (not (some (fn [src] (= id src)) sources)) (draft? (editor fr id)))) (editor-ids fr))
            replaced (filter (fn [[id visit]] (let [ed (editor fr (get mapping id))]
                                               (and ed (not= (:path ed) (:path visit)) (draft? ed)))) (:visits request))]
        (cond
          (not= (count sources) (count (distinct sources))) (fail "A layout cannot duplicate one editor into two panes.")
          (or (seq lost) (seq replaced)) (fail "This layout would discard a draft — publish or finish it first.")
          :else
          (let [fresh (fn [] (blank-editor (dissoc (focused fr) :pkg-state)))
                eds (into {} (map (fn [id] [id (or (editor fr (get mapping id)) (fresh))]) ids))
                gone (filter (fn [id] (not (some (fn [src] (= id src)) sources))) (editor-ids fr))
                cleanup (mapcat (fn [id] (let [[ed effects] (m/take-effects (m/handle (editor fr id) {:type :session-leave}))]
                                          (map (fn [e] (assoc e :pane (or (:pane e) id))) effects))) gone)
                visits (map (fn [[id v]] (merge {:kind :visit :pane id} v)) (:visits request))
                focus (or (:focus request) (when (some (fn [id] (= (:focus fr) id)) ids) (:focus fr)) (first ids))]
            (if (not (some (fn [id] (= focus id)) ids)) (fail "The requested focus pane is not in this layout.")
              {:layout layout :editors eds :focus focus :effects (vec (concat (:effects fr) cleanup visits))})))))))

(defn- candidate-pane [fr target]
  (if (vector? target)
    (first (filter (fn [id] (some? (editor fr id))) target))
    (when (editor fr target) target)))

(defn- focus-effects
  "Consume generic package-requested spatial focus effects before the host.
   Clamps at edges and skips view panes. Editors, drafts and pending keys stay intact."
  [fr]
  (let [effects (:effects fr)
        fr (assoc fr :effects [])]
    (reduce (fn [f e]
              (cond
                (= :frame-layout (:kind e)) (reconfigure f e)
                (= :frame-focus (:kind e))
                (let [ids (editor-ids f)
                      i (or (first (filter (fn [i] (= (nth ids i) (:focus f))) (range (count ids)))) 0)
                      dest (if (:target e) (candidate-pane f (:target e))
                             (nth ids (max 0 (min (dec (count ids)) (+ i (:direction e))))))]
                  (if dest (assoc f :focus dest) f))
                (= :visit (:kind e))
                (if-let [target (candidate-pane f (:pane e))]
                  (let [ed (editor f target) draft? (or (and (not (docs/read-only? ed)) (c/dirty? ed)) (seq (get-in ed [:minibuf :text])))]
                    (if draft?
                      (if (= (:path ed) (:path e)) f
                        (let [message "Publish the file or finish/cancel its prompt before opening another document."]
                          (-> f (assoc-in [:editors target :message] message) (assoc-in [:editors (:focus f) :message] message))))
                      (update f :effects conj (assoc e :pane target)))) f)
                :else (update f :effects conj e))) fr effects)))

(def WINDOW-KEYS
  "space w then … (the window keys). C-w is the browser's close-tab, so the
   frame's prefix is the leader's `w`, as in Spacemacs."
  {"w" :next "l" :next "h" :prev "o" :only})

(defn- window-key
  "Run window command `k`; the focused editor's half-typed `space w` is dropped."
  [fr k]
  (let [fr (assoc-in fr [:editors (:focus fr)]
                     (assoc (focused fr) :pending [] :message nil))
        cmd (get WINDOW-KEYS k)]
    (cond (= :next cmd) (move-focus fr 1)
          (= :prev cmd) (move-focus fr -1)
          :else (unarrange fr))))

(defn- window-key? [fr ev]
  (let [ed (focused fr)]
    (and (= :key (:type ev)) (nil? (:pane ev))
         (contains? WINDOW-KEYS (:key ev))
         (= ["space" "w"] (:pending ed))
         (contains? #{:normal :select} (:mode ed))
         (> (count (editor-ids fr)) 1))))

; ─── packages are frame-wide (rule 4) ──────────────────────────────────────
;
; A package used or removed in one pane is used or removed in every editor
; pane; removing the package that provided the active layout returns to one
; pane. The frame notices by comparing a pane's package names before/after.

(declare layouts)

(defn- names [ed] (vec (map :name (pkg/packages ed))))

(defn- spread-packages
  "Pane `id` just used or removed packages: every other editor pane does the
   same (pkg/use, pkg/unuse: exact in each pane), and a layout whose provider
   is gone ends."
  [fr id before]
  (let [now (editor fr id)]
    (if (= (names before) (names now)) fr
      (let [gone (filter (fn [n] (not (some (fn [m] (= m n)) (names now)))) (names before))
            added (filter (fn [p] (not (some (fn [m] (= m (:name p))) (names before)))) (pkg/packages now))
            sync (fn [ed] (reduce pkg/use (reduce pkg/unuse ed gone) added))
            fr (reduce (fn [fr other]
                         (let [[ed effects] (m/take-effects (sync (editor fr other)))]
                           (-> fr (assoc-in [:editors other] ed)
                               (update :effects into (map (fn [e] (assoc e :pane other)) effects)))))
                       fr (filter (fn [o] (not= o id)) (editor-ids fr)))
            provided? (contains? (layouts now) (:name (:layout fr)))
            replacement? (some (fn [effect] (and (= :frame-layout (:kind effect))
                              (contains? (layouts now) (:layout effect)))) (:effects fr))]
        (if (or (= "single" (:name (:layout fr))) provided? replacement?) fr (unarrange fr))))))


(defn- layout-request
  "A pane asked to (un)arrange the window (ed/layout sets :frame/layout on it)."
  [fr id]
  (let [ed (editor fr id) req (:frame/layout ed)]
    (if (nil? req) fr
      (let [fr (assoc-in fr [:editors id] (dissoc ed :frame/layout))]
        (cond (= :none req) (unarrange fr)
              (map? req) (arrange fr req)
              :else fr)))))

(defn handle
  "One host event into the frame."
  [fr ev]
  (let [target (or (:pane ev) (:focus fr))]
    (cond
      ; `space w` + w/h/l/o is the frame's own chord, in every layout (the
      ; editor still owns `space w (` etc.: only these four keys are taken)
      (window-key? fr ev) (window-key fr (:key ev))
      ; a resize reaches every editor pane, each with its own width in cells
      (= :resize (:type ev))
        (reduce (fn [fr id]
                  (let [cols (get (:cols ev) id)
                        fr (step-editor fr id (dissoc ev :cols))]
                    (if (some? cols) (assoc-in fr [:editors id :view :cols] cols) fr)))
                fr (editor-ids fr))
      ; an event for a pane that no longer exists (a late host answer) is dropped
      (nil? (editor fr target)) fr
      :else
        (let [before (editor fr target)
              fr (step-editor fr target (dissoc ev :pane))]
          (focus-effects (layout-request (spread-packages fr target before) target))))))

(defn take-effects [fr] [(assoc fr :effects []) (:effects fr)])

; ─── drawing ───────────────────────────────────────────────────────────────

(def ^:private rendered-view
  (memo/identity-pair 8 (fn [f ed] (f ed))))

(defn render
  "What the host paints:
     {:layout name :focus id
      :panes [{:id :width :focus? :kind :editor :view (ed.main/render ed)}
              {:id :width :kind :view :view-kind kw :of id :view (view-fn ed)}]}
   A view's model comes from the packages: (:provides {:views {kind (fn [ed] model)}})."
  [fr]
  {:layout (:name (:layout fr))
   :focus (:focus fr)
   :panes (vec (map (fn [p]
                      (let [drawn (if (view-pane? p)
                        (let [[kind of] (:view p)
                              ed (editor fr of)
                              f (some (fn [q] (get-in q [:provides :views kind])) (reverse (pkg/packages ed)))]
                          {:id (:id p) :width (:width p) :kind :view :view-kind kind :of of
                           :view (when (some? f) (rendered-view f ed))})
                        {:id (:id p) :width (:width p) :kind :editor :focus? (= (:id p) (:focus fr))
                         :view (rendered-view m/render (editor fr (:id p)))})]
                        (cond-> drawn (:dock p) (assoc :dock (:dock p) :height (:height p)))))
                    (panes fr)))})

; ─── the layouts packages provide ──────────────────────────────────────────

(defn layouts
  "{name layout} from every loaded package of `ed`."
  [ed]
  (reduce (fn [m p] (merge m (get-in p [:provides :layouts]))) {} (pkg/packages ed)))
