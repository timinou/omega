; guidelines/ext.bl — the omega extension.
;
;   (extension {:sources [{:path p :scope :user|:project} …]   ; REQUIRED, explicit: nothing is auto-loaded
;               :pipeline  guidelines.recall pipeline           ; default: triggers + semantic + gate
;               :judge     (fn [{:guideline :goal :work}] → {:verdict …})  ; optional, see lifecycle
;               :enabled   #{gid …}})                           ; optional allow-list (the explorer's "on" set)
;
; Per step (:context hook): select with the pipeline over ctx :situation, add
; the hits to the request :tail, trace each first showing per task (op :shown,
; with :via and :score). Never recorded as a turn.
;
; The `guideline` tool lets the agent report: applied → a CANDIDATE (never a
; file write); misfire → a trace; propose → a draft trace.
;
; :turn/end (an event, in its own process): the judge looks at shown-but-
; unreported guidelines; then every candidate of the task is settled
; (lifecycle/settle!: :ready or :dropped). Promotion into the .bl.org happens
; only from the explorer, by a human, rev-checked.

(ns guidelines.ext
  (:require [guidelines.core :as g]
            [guidelines.recall :as recall]
            [guidelines.lifecycle :as life]
            [omega.trace :as tr]
            [omega.task :as task]
            [clojure.string :as str]))

(defn load-all
  "Read every source; project layered over user."
  [sources]
  (apply g/layer (map (fn [{:keys [path scope]}]
                        (if (File/regular? path) (g/parse (File/read! path) scope path) []))
                      sources)))

(defn extension
  ([] (extension {}))
  ([opts]
   (let [sources (or (:sources opts) [])
         pipeline (or (:pipeline opts) recall/default-pipeline)
         state (atom nil)
         reload! (fn [] (let [gs (load-all sources)
                              gs (if-let [on (:enabled opts)] (filterv (fn [x] (contains? on (name (:id x)))) gs) gs)]
                          (reset! state {:gs gs :idx (g/index gs)})))
         ensure! (fn [] (when (nil? @state) (reload!)) @state)
         shown (atom {})]
     {:name :guidelines
      :doc "Matched guidelines at the request tail; uses become candidates, settled at turn end."
      :start (fn [_] (reload!) {})
      :state state
      :reload! reload!
      :hooks
      {:context
       (fn [req ctx]
         (let [{:keys [gs idx]} (ensure!)
               t (:task ctx)
               sit (or (:situation ctx) {:text (g/situation req) :paths []})
               hits (recall/select pipeline {:gs gs :idx idx} sit)
               fresh (remove (fn [h] (contains? (get @shown t #{}) (:id h))) hits)]
           (when (and t (seq fresh))
             (swap! shown update t (fn [s] (into (or s #{}) (map :id fresh))))
             (doseq [h fresh]
               (tr/leave! (get-in ctx [:sys :env]) t
                          {:kind :guideline :subject (str (name (:id h)) "#shown")
                           :text (str "shown via " (name (:via h)) " (" (/ (erlang/round (* 100 (or (:p h) (:score h)))) 100.0) "): " (:anchor h))
                           :data {:op :shown :gid (name (:id h)) :via (:via h) :score (:score h) :p (:p h)
                                  :anchor (:anchor h) :step (:step sit)}})))
           (g/inject req hits (:by-id idx))))}
      :on
      ;; ONE handler, so judging and settling are sequential (the judge may take
      ;; seconds on the network; settling must see its candidates). Every turn
      ;; ending sets a status (a failed turn emits no :turn/end), so this is the
      ;; one place: judge after a turn that answered (:idle / :done), settle once
      ;; the task is finished.
      {:task/status
       (fn [d ctx]
         (let [st (:status d) sys (:sys ctx) idx (:idx (ensure!))]
           (when (and (:judge opts) (contains? #{:idle :done} st))
             (life/judge-turn! sys idx (:judge opts) (:task d)))
           (when (contains? #{:done :failed :cancelled} st)
             (life/settle! (:env sys) idx (:task d) st))))}
      :tools
      [{:name "guideline"
        :description (str "Report on a guideline shown to you under [guidelines]. "
                          "op=applied: it shaped your work; note = one concrete line saying what you did. "
                          "op=misfire: it did not fit; note = why. "
                          "op=propose: suggest a new one; id = short-kebab, note = the rule, then ' | when: ' situations. "
                          "Optional: the harness also judges shown guidelines itself at the end of the turn.")
        :input-schema {:type "object"
                       :properties {:op {:type "string" :enum ["applied" "misfire" "propose"]}
                                    :id {:type "string"} :note {:type "string"}}
                       :required ["op" "id" "note"]}
        :run (fn [ctx input]
               (let [op (keyword (str (or (:op input) (get input "op"))))
                     id (str (or (:id input) (get input "id")))
                     note (str/trim (str (or (:note input) (get input "note"))))
                     e (get-in ctx [:sys :env])
                     t (:task ctx)
                     g* (get-in (ensure!) [:idx :by-id (keyword id)])
                     goal (:task/goal (omega.env/pull e [:task/goal] (omega.env/eid e :task/id t)))]
                 (cond
                   (and (not= op :propose) (nil? g*)) {:error (str "no guideline " id)}
                   (str/blank? note) {:error "note is required"}
                   (= op :applied)
                   (do (life/candidate! e t id {:note note :goal goal :source :agent})
                       {:ok (str "noted; it becomes an example of " id " if the task succeeds and a human accepts it")})
                   (= op :misfire)
                   (do (tr/leave! e t {:kind :guideline :subject (str id "#misfire") :text note
                                       :data {:op :misfire :gid id :note note :goal goal}})
                       {:ok "recorded; a human will review whether to add a 'not when'"})
                   :else
                   (let [[rule when*] (map str/trim (str/split note #"\|\s*when:" 2))]
                     (tr/leave! e t {:kind :guideline :subject (str id "#proposed") :text rule
                                     :data {:op :proposed :source :agent
                                            :draft {:id id :name id :rule rule
                                                    :when (vec (remove str/blank? (map str/trim (str/split (or when* "") #","))))}}})
                     {:ok "proposal recorded for review"}))))}]})))
