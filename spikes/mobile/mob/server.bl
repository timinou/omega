; Compatibility entry; application ownership and all world setup live in Omega.
(ns mob.server (:require [pelagic.launch :as launch]))
(defn launch [project state port home]
  (when-not (= (Path/expand project) (Path/expand home))
    (throw (ex-info "Attach other directories as places with bin/omega attach DIR." {})))
  (launch/dev! ["--preset" "pocket" "--live" "--db" (str state "/db") "--port" (str port)]))
