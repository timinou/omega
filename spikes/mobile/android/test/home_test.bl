(ns pocket.home-test (:require [pocket.home :as home] [android.ui :as ui]))

(deftest android-companion-contract
  (is (home/origin-valid? "https://work.tail123.ts.net"))
  (is (home/origin-valid? "https://work.tail123.ts.net:8443"))
  (is (home/origin-valid? "https://work.tail123.ts.net:18001"))
  (is (= "https://work.tailcb5318.ts.net:18001"
         (:connected (home/connect {:origin "https://work.tailcb5318.ts.net:18001"}))))
  (doseq [s ["http://work.tail123.ts.net" "https://evil.example" "https://work.tail123.ts.net.evil.example" "https://work.tail123.ts.net/path" "https://user@work.tail123.ts.net" "https://work.tail123.ts.net?x=y" "https://work.tail123.ts.net#x" "https://work.tail123.ts.net:0" "https://work.tail123.ts.net:99999"]]
    (is (not (home/origin-valid? s))))
  (is (= "https://work.tail123.ts.net:8443" (:connected (home/connect {:origin "https://work.tail123.ts.net:8443"}))))
  (is (:error (home/connect {:origin "http://evil.example"})))
  (is (= :column (:type (home/render {:origin ""}))))
  (is (= (home/render {:origin ""}) (home/render {:origin "" :draft-origin "https://typing.tail.ts.net"})))
  (let [field (nth (:children (home/render {:origin "https://work.tail123.ts.net:8443"})) 4)]
    (is (= "https://work.tail123.ts.net:8443" (get-in field [:props :value])))
    (is (= "url" (get-in field [:props :keyboard]))))
  (is (= :web_view (:type (last (:children (home/render {:connected "https://work.tail123.ts.net:8443"})))))))

(deftest notification-decisions
  (let [item {:key "t-1" :title "Ship" :ask "Go?" :status "idle" :place "omega"}
        r1 (home/attend {} [item])
        r2 (home/attend (:assigns r1) [item])
        r3 (home/attend (:assigns r2) [])]
    (is (= :post (first (first (:effects r1)))))
    (is (= "Go?" (:text (second (first (:effects r1))))))
    (is (= "Your turn · Ship" (:title (second (first (:effects r1))))))
    (is (= [] (:effects r2)))
    (is (= [[:cancel (pocket.attention/id-of "t-1")]] (:effects r3)))))

(deftest finished-and-failed-reach-the-phone-once-after-priming
  (let [run {:key "t-2" :title "Build" :status "running" :place "omega"}
        r1 (home/attend {} [run])
        done (assoc run :status "done" :summary "APK signed" :proposals [{:label "Install" :text "Install it"}])
        r2 (home/attend (:assigns r1) [done])
        r3 (home/attend (:assigns r2) [done])
        quiet (home/attend {} [done])]
    (is (= [[:post (pocket.attention/ongoing [run])]] (:effects r1)) "running work is one quiet ongoing notification")
    (is (= "Finished · Build" (:title (second (first (:effects r2))))))
    (is (= ["p0"] (mapv :id (:actions (second (first (:effects r2)))))))
    (is (= [:cancel pocket.attention/ongoing-id] (last (:effects r2))))
    (is (= [] (:effects r3)))
    (is (= [] (:effects quiet)) "history never floods the shade on first launch")
    (is (= [] (:effects (home/attend {} [(assoc run :ask "Go?" :status "idle" :notify ["done"])]))) "launch settings choose")))

(deftest notification-actions-answer-without-opening-pocket
  (let [item {:key "t-1" :title "Ship" :ask "Rebuild?" :ask-id "msg-9" :status "idle" :place "omega"
              :proposals [{:label "Rebuild APK" :text "Rebuild and sign it"}]}
        a (:assigns (home/attend {} [item]))
        id (pocket.attention/id-of "t-1")]
    (is (= {:send {:intent "msg/answer" :args {:msg "msg-9" :text "Rebuild and sign it"}} :cancel id}
           (home/act a {:notification id :action "p0"})))
    (is (= {:send {:intent "msg/answer" :args {:msg "msg-9" :text "bump to 0.2.0"}} :cancel id}
           (home/act a {:notification id :action "reply" :reply "bump to 0.2.0"})))
    (is (= {:open "t-1"} (home/act a {:notification id :action "tap"})))
    (is (= ["p0" "reply"] (mapv :id (:actions (pocket.attention/notification item)))))))

(deftest one-header-and-a-native-connection-panel
  (let [connected (home/render {:connected "https://h.ts.net:8443"})
        open (home/render {:connected "https://h.ts.net:8443" :panel true})]
    (is (= 2 (count (:children connected))))
    (is (= :web_view (:type (last (:children open)))))
    (is (re-find #"app=pocket" home/query))))

(deftest tapping-a-notification-opens-its-task
  (is (= (str "https://h.ts.net:18001" home/query) (home/start-url {:connected "https://h.ts.net:18001"})))
  (is (= (str "https://h.ts.net" home/query "&pocket=task&at=task%3At-9")
         (home/start-url {:connected "https://h.ts.net" :open "t-9"})))
  (let [web (last (:children (home/render {:connected "https://h.ts.net:8443" :open "t-9"})))]
    (is (= :web_view (:type web)))
    (is (re-find #"pocket=task" (get-in web [:props :url]))))
  (home/perform! [])
  (home/perform! [[:post {:id 1}]]))
