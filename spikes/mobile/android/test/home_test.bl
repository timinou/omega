(ns pocket.home-test (:require [pocket.home :as home] [android.ui :as ui]))

(deftest android-companion-contract
  (is (home/origin-valid? "https://work.tail123.ts.net"))
  (is (home/origin-valid? "https://work.tail123.ts.net:8443"))
  (is (home/origin-valid? "https://work.tail123.ts.net:18001"))
  (doseq [s ["http://work.tail123.ts.net" "https://evil.example" "https://work.tail123.ts.net.evil.example" "https://work.tail123.ts.net/path" "https://user@work.tail123.ts.net" "https://work.tail123.ts.net?x=y" "https://work.tail123.ts.net#x" "https://work.tail123.ts.net:0" "https://work.tail123.ts.net:99999"]]
    (is (not (home/origin-valid? s))))
  (is (= "https://work.tail123.ts.net:8443" (:connected (home/connect {:origin "https://work.tail123.ts.net:8443"}))))
  (is (:error (home/connect {:origin "http://evil.example"})))
  (is (= :column (:type (home/render {:origin ""}))))
  (is (= (home/render {:origin ""}) (home/render {:origin "" :draft-origin "https://typing.tail.ts.net"})))
  (let [field (nth (:children (home/render {:origin "https://work.tail123.ts.net:8443"})) 4)]
    (is (= "https://work.tail123.ts.net:8443" (get-in field [:props :value])))
    (is (= "url" (get-in field [:props :keyboard]))))
  (is (= :web_view (:type (last (:children (home/render {:connected "https://work.tail123.ts.net:8443"}))))))
)
