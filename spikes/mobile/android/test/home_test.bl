(ns pocket.home-test (:require [pocket.home :as home] [android.ui :as ui]))
(assert (home/origin-valid? "https://work.tail123.ts.net"))
(assert (home/origin-valid? "https://work.tail123.ts.net:8443"))
(doseq [s ["http://work.tail123.ts.net" "https://evil.example" "https://work.tail123.ts.net.evil.example" "https://work.tail123.ts.net/path" "https://user@work.tail123.ts.net" "https://work.tail123.ts.net?x=y" "https://work.tail123.ts.net#x" "https://work.tail123.ts.net:8790"]]
  (assert (not (home/origin-valid? s))))
(assert (= "https://work.tail123.ts.net:8443" (:connected (home/connect {:origin "https://work.tail123.ts.net:8443"}))))
(assert (:error (home/connect {:origin "http://evil.example"})))
(assert (= :column (:type (home/render {:origin ""}))))
(assert (= :web_view (:type (home/render {:connected "https://work.tail123.ts.net:8443"}))))
(println "14 Android companion assertions passed (origin validation, connection and native screen trees).")
