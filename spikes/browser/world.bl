; Isolated, in-memory Omega world. Scripted model, real browser tool and task facts.
(ns browser.world
  (:require [omega.env :as env] [omega.task :as task] [omega.loop :as loop]
            [omega.ed.providers :as pv] [omega.llm :as llm]
            [omega.codemode :as cm] [omega.cli :as cli] [bl-ed.serve :as serve]))
(def home (System/get_env "OMEGA_HOME"))
(def root (System/get_env "BROWSER_DEMO_ROOT"))
(def browser-tool
  {:name "browser/research" :description "Native browser research with visible session artifacts."
   :input-schema {:type "object" :properties {}}
   :run (fn [ctx input]
     (let [r (System/cmd "node" (list (str home "/spikes/browser/client.mjs") (:task ctx))
                           (list (tuple :stderr_to_stdout true)))
           out (elem r 0) exit (elem r 1)]
       (if (= 0 exit) {:ok out :done true} {:error out})))})
(def e (env/open))
(def live? (= "1" (System/get_env "BROWSER_LIVE")))
(def model (when live?
  (if (= "1" (System/get_env "BROWSER_OPENAI"))
    (llm/provider {:kind :anthropic :model (or (System/get_env "BROWSER_MODEL") (if (= "deepseek" (System/get_env "BROWSER_PROVIDER")) "deepseek-flash" "gpt-5.4"))
                   :base-url "http://127.0.0.1:8808" :stream false :identity nil})
    (llm/from-env home))))
(def sys (task/start-system e
  (if live?
    {:root root :token-budget (when (= "1" (System/get_env "PROCUREMENT_DEMO")) {:input 400000 :output 12000}) :eval-preloads (when (= "1" (System/get_env "PROCUREMENT_DEMO")) ["search.bl"]) :tools cm/tools :step (llm/step model) :max-steps (if (= "1" (System/get_env "PROCUREMENT_DEMO")) 16 25)
     :system-prompt (str cli/SYSTEM-PROMPT
       (str " Current UTC date: " (Date/to_iso8601 (Date/utc_today)) ". Record UTC provenance separately from browser-local dates.")
       " For this procurement run use your single eval tool. Read instructions.bl.org first. "
       "Do not spawn tasks. The browser-tool.mjs shell helper reaches the visible task-owned browser. "
       "Generate reusable curated beam-lisp functions and execute them; write the requested files.")}
    {:root root :tools [browser-tool]
     :step (fn [req]
       (if (some (fn [b] (= :tool-result (:type b))) (:content (last (:messages req))))
         (loop/say "Browser research stopped with an error; inspect browser:sessions and its event log.")
         (loop/call-tool "browser/research" {} "native-browser")))})))
(def intents (assoc (pv/intents sys) "browser/run-proof"
  (fn [a] {:task (task/view sys (:id a)) :turns (loop/turns sys (:id a))
           :model (when live? (:model model)) :live live?})))
(def intents (assoc intents "procurement/model-open"
 (fn [{:keys [goal desk maxSteps maxInput maxOutput]}]
  (when-not (and (re-matches #"[a-z0-9][a-z0-9-]{0,63}" desk)
    (<= 1 maxSteps 16) (<= 10000 maxInput 400000) (<= 1000 maxOutput 32000))
   (throw (ex-info "Invalid bounded research configuration" {})))
  (let [id (task/open! (assoc sys :max-steps maxSteps :token-budget {:input maxInput :output maxOutput})
    {:goal goal :title (str "Procurement · " desk) :cwd (str root "/desks/" desk)})]
   {:id id :path (str "task:" id)}))))
(def server (serve/start! {:port 8796 :root root :web (str home "/vendor/bl-ed/web")
                          :providers (pv/providers sys) :intents intents}))
(println (str "Isolated browser demo world: " (:url server)))
(receive :never nil)
