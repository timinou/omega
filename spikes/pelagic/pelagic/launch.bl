; Launch policy belongs to Omega's development task, not the editor package.
(ns pelagic.launch
  (:require [pelagic.build :as build] [omega.dev :as dev] [omega.artifacts :as artifacts]
            [bl-ed.serve :as serve] [bl.json :as json] [bl.env :as project] [vm.gateway :as gateway]))
(def ^:private LOADED-HOST (build/host-fingerprint))
(defn check-host!
 "The shared realm must not start new host services with obsolete backend code."
 []
 (when-not (= LOADED-HOST (build/host-fingerprint))
  (throw (ex-info "Backend or root env.bl changed; close and reopen the project realm" {:kind :host-authority})))
 :ok)
(defn options [args default-port]
  (loop [xs args result {:port default-port :live? false}]
    (if (empty? xs) result
      (case (first xs)
        "--port" (let [port (when (second xs) (erlang/binary_to_integer (second xs)))]
                   (when-not (and port (<= 1024 port 65535))
                     (throw (ex-info "--port requires an integer from 1024 to 65535" {})))
                   (recur (drop 2 xs) (assoc result :port port)))
        "--preset" (let [preset (second xs)]
                     (when-not (contains? #{"pelagic" "spikes" "packages" "pocket" "runtime"} preset)
                       (throw (ex-info "--preset requires pelagic, spikes, packages or pocket" {})))
                     (recur (drop 2 xs) (assoc result :preset preset)))
        "--live" (recur (rest xs) (assoc result :live? true))
        "--db" (let [path (second xs)]
                   (when (or (nil? path) (starts-with? path "--"))
                     (throw (ex-info "--db requires a store directory" {})))
                   (recur (drop 2 xs) (assoc result :db (Path/expand path (build/root)))))
        (throw (ex-info (str "Unknown launch option: " (first xs)) {}))))))
(defn studio-url [port]
  (str "http://localhost:" port "/?use=pelagic&layout=pelagic&file=spikes/pelagic/live-set.bl.org"))
(defn preset-url [port preset]
  (case preset
    "pocket" (str "http://localhost:" port "/?use=present,dwim,workspace,places,references,buffers,workbench,mobile&layout=mobile&file=workspace:all")
    "runtime" (str "http://localhost:" port "/?use=runtime&layout=runtime&file=runtime:overview")
    "packages" (str "http://localhost:" port "/?use=packages&file=package:catalog")
    "spikes" (str "http://localhost:" port "/?use=pelagic&layout=pelagic&file=spikes/pelagic/tutorials/00-start.bl.org")
    (studio-url port)))
(defn identity [web opts]
  ; The dynamic provider proves the host mode and document root, not just assets.
  (json/encode {:schema "omega.dev-session" :version 1 :root (build/root)
                :host (build/host-fingerprint)
                :frontend (File/read! (str web "/.inputs")) :live (:live? opts)
                :db (or (:db opts) (when (:live? opts) (str (build/root) "/.omega/db")))
                :port (:port opts) :routes (:routes opts)}))
(defn- http-get [port path]
  (Application/ensure_all_started :inets)
  (try
    (let [response (httpc/request :get
                     (tuple (String/to_charlist (str "http://127.0.0.1:" port path)) (list))
                     (list (tuple :timeout 1500) (tuple :connect_timeout 500))
                     (list (tuple :body_format :binary)))]
      (when (and (= :ok (elem response 0)) (= 200 (elem (elem (elem response 1) 0) 1)))
        (elem (elem response 1) 2)))
    (catch _ nil)))
(defn remote-identity [port]
  (try
    (get (json/decode (http-get port "/api/doc?path=launch:identity")) "text")
    (catch _ nil)))
(defn- local-identity [port]
  (try (get (json/decode (http-get port "/assets.json")) "sha256")
       (catch _ nil)))
(defn occupied? [port]
  (let [connection (gen_tcp/connect (String/to_charlist "127.0.0.1") port (list) 500)]
    (when (= :ok (elem connection 0))
      (gen_tcp/close (elem connection 1))
      true)))
(defn host-state [port expected]
  (cond (= expected (remote-identity port)) :reuse
        (occupied? port) :conflict
        :else :start))
(defn route-config []
  (let [env (project/project (build/root))]
    (when (seq (:errors env)) (throw (ex-info "Invalid root env.bl" {:errors (:errors env)})))
    (get-in env [:ports "omega"] {:port 8812})))
(defn dev! [args]
  (check-host!)
  (let [config (route-config)
        opts (assoc (options args (or (:port config) 8812)) :routes (or (:routes config) {})) web (build/frontend!) expected (identity web opts)
        port (:port opts) url (preset-url port (:preset opts)) state (host-state port expected)]
    (case state
      :reuse (println (str "Omega host already running; open a session: " url))
      :conflict (throw (ex-info (str "Port " port " belongs to an incompatible host. Use bl pelagic.dev -- --port N; no changes were sent to it.") {:port port}))
      :start (do
               (let [host (dev/acquire! expected {:root (build/root) :web web :port port :dev? true
                              :hosts (vec (keys (:routes opts))) :landing-pages (:routes opts)
                              :offline? (not (:live? opts)) :memory? (and (not (:live? opts)) (nil? (:db opts))) :db (:db opts)
                              :providers {"launch" {:read (fn [_ _] {:text expected :rev expected :read-only? true})}}})]
               (println (str "Omega development host" (if (:live? opts) " (live)" " (offline development)") ": " (preset-url (:port host) (:preset opts)))))
               (when (seq (:routes opts))
                 (gateway/ensure-for-claim (vec (keys (:routes opts))))
                 (println (str "Host presets registered: " (join ", " (sort (keys (:routes opts)))))))
               (println "Each browser session owns its package state and audio.")
               (if (dev/persistent?)
                 (println "Host is realm-owned. bl omega.stop stops this world; other realms keep running.")
                 (do (println "Foreground host. Ctrl+C stops this VM.") (receive :never nil)))))))
(defn local! [args]
  (let [opts (options args 8818)]
    (when (:live? opts) (throw (ex-info "--live belongs to pelagic.dev; local is a standalone demo" {})))
    (let [web (build/local!) port (:port opts)
          expected (get (json/decode (File/read! (str web "/assets.json"))) "sha256")
          url (str "http://localhost:" port "/")]
      (cond
        (= expected (local-identity port)) (println (str "PELAGIC demo already running: " url))
        (occupied? port) (throw (ex-info "Demo port is occupied; use bl pelagic.local -- --port N" {:port port}))
        :else (artifacts/reading web
                (fn [directory]
                 (let [host (serve/start! {:root directory :web directory :port port})]
                  (try
                   (println (str "PELAGIC standalone demo: " url))
                   (receive :never nil)
                   (finally (serve/stop! host))))))))))
