; One frontend graph. Server sessions consume it directly; demos add adapters.
(ns pelagic.build
  (:require [bl.js :as js] [bl.json :as json]
            [pelagic.actor-build :as actors] [pelagic.artifact :as artifact]
            [omega.frontend :as frontend] [omega.artifacts :as artifacts]))

(def compiler "e10bdab8")
(defn home []
  (Path/expand ".." (Path/dirname (BeamLisp.Loader/source_path "pelagic.build"))))
(defn root [] (Path/expand "../.." (home)))
(defn package-manifests [] (frontend/manifests (root)
  ["pelagic" "packages" "atlas" "present" "dwim" "workspace" "places" "references" "buffers" "workbench" "mobile" "runtime" "inspector"]))
(defn assembly [] (frontend/assembly (root) (package-manifests)))
(defn manifest-inputs []
  [(package-manifests)
   (File/read! (BeamLisp.Loader/source_path "omega.frontend"))
   (File/read! (BeamLisp.Loader/source_path "omega.artifacts"))])
(defn copy! [from to]
  (File/mkdir_p! (Path/dirname to))
  (File/cp! from to))
(defn copy-files! [from to suffixes]
  (doseq [name (File/ls! from)]
    (when (some (fn [suffix] (ends-with? name suffix)) suffixes)
      (copy! (str from "/" name) (str to "/" name)))))
(defn- sources [directory]
  (mapcat (fn [name]
            (let [path (Path/join directory name)]
              (cond
                (contains? #{"dist" "out" "proof" "test" ".git" "node_modules" "__pycache__"} name) []
                (File/dir? path) (sources path)
                (and (File/regular? path)
                     (some (fn [suffix] (ends-with? name suffix)) [".bl" ".bl.md" ".clj" ".cljc" ".mjs" ".css" ".html" ".glsl" ".org" ".in" ".json" ".edn"]))
                  [[path (artifact/sha256 (File/read! path))]]
                :else [])))
          (sort (File/ls! directory))))
(defn compiler-identity []
  ; Include every compiler/logic/host source, including literate BL. Re-read on
  ; each admission so a warm development VM cannot hide checkout changes.
  (let [entry (BeamLisp.Loader/source_path "bl.js")]
    [compiler [entry (artifact/sha256 (File/read! entry))]
     (sources (Path/dirname (Path/dirname (BeamLisp.Loader/source_path "core"))))]))
(defn tool-identity
 "The executable build tools are fixed for a loaded realm. Data inputs may vary."
 []
 [(compiler-identity)
  (mapv (fn [n] (let [path (BeamLisp.Loader/source_path n)] [path (artifact/sha256 (File/read! path))]))
    ["pelagic.build" "pelagic.actor-build" "pelagic.artifact" "omega.frontend" "omega.artifacts"])])
(def ^:private LOADED-TOOLS (tool-identity))
(defn check-tools!
 "Refuse to label output with new tool sources while executing old loaded code."
 []
 (when-not (= LOADED-TOOLS (tool-identity))
  (throw (ex-info "Build tools changed; close and reopen the project realm before compiling" {:kind :build-authority})))
 :ok)
(defn fingerprint
  "Conservative content cache: compiler identity and all frontend inputs."
  []
  (artifact/sha256 (json/encode
    [(compiler-identity) (manifest-inputs) (sources (home)) (sources (str (root) "/vendor/bl-ed/ed"))
     (sources (str (root) "/spikes/packages"))
     (sources (str (root) "/spikes/present"))
     (sources (str (root) "/spikes/atlas"))
     (sources (str (root) "/spikes/mobile"))
     (sources (str (root) "/spikes/runtime"))
     (sources (str (root) "/spikes/workspace"))
     (sources (str (root) "/spikes/dwim"))
     ; Package output is generated, not a source dependency.
     (filter (fn [entry] (not (starts-with? (first entry) (str (root) "/vendor/bl-ed/web/pkg/"))))
             (sources (str (root) "/vendor/bl-ed/web")))])))
(defn host-fingerprint []
  (artifact/sha256 (json/encode [(sources (str (root) "/src"))
                               (sources (str (root) "/vendor/bl-ed/src"))
                               (sources (str (root) "/packages"))
                               (sources (str (root) "/spikes/workspace"))
                               (File/read! (str (root) "/env.bl"))])))
(defn- replace! [stage output marker] (artifacts/publish! stage output marker))
(defn artifact-valid? [output identity]
  (try
    (let [manifest (json/decode (File/read! (str output "/pelagic-build.json")) {:keys :keyword})
          files (:files manifest)]
      (and (if (File/regular? (str output "/.pelagic-local"))
             (and (File/regular? (str output "/assets.json")) (File/regular? (str output "/sw.mjs")))
             (and (not (File/exists? (str output "/assets.json"))) (not (File/exists? (str output "/sw.mjs")))))
           (= identity (File/read! (str output "/.inputs")))
           (= identity (:inputs manifest)) (= compiler (:compiler manifest)) (seq files)
           (= files (vec (remove (fn [file] (= "pelagic-build.json" (:path file)))
                                 (:files (artifact/manifest output)))))))
    (catch _ false)))
(defn bl-source? [path]
  (some (fn [suffix] (ends-with? path suffix)) [".bl" ".bl.md" ".bl.org" ".clj" ".cljc"]))
(defn source-fingerprint [directories bl-only?]
  (let [entries (mapcat sources directories)]
    (artifact/sha256 (json/encode
      [(compiler-identity) (if bl-only? (filter (fn [entry] (bl-source? (first entry))) entries) entries)]))))
(defn graph-input? [path]
  ; Launch programs cannot affect the browser graph. Compiler/build/actor
  ; helpers remain conservative inputs until upstream reports all dependencies.
  (and (not (starts-with? path (str (home) "/tutorials/")))
       (not (contains? #{(str (home) "/live-set.bl.org") (str (home) "/demo.bl.org")} path))
       (not (contains? #{"/pelagic/launch.bl" "/dev.bl" "/frontend.bl" "/local-task.bl" "/bundle.bl" "/watch.bl"}
    (when (starts-with? path (home)) (subs path (count (home))))))))
(defn graph-fingerprint []
  (let [entries (mapcat sources (:paths (assembly)))]
    (artifact/sha256 (json/encode [(compiler-identity) (manifest-inputs)
      (filter (fn [entry] (and (bl-source? (first entry)) (graph-input? (first entry)))) entries)]))))
(defn- seal! [stage identity]
  (File/rm (str stage "/.omega-stage"))
  (File/write! (str stage "/.omega-managed") "Omega immutable generation v1\n")
  (File/write! (str stage "/.inputs") identity)
  (File/write! (str stage "/pelagic-build.json")
    (json/encode {:root (root) :compiler compiler :inputs identity
                  :files (:files (artifact/manifest stage))})))
(defn- graph-unlocked!
  "Compile the BL graph once. Asset-only edits reuse these checked modules."
  []
  (let [here (home) root (root) identity (graph-fingerprint)
        output (str here "/dist/graph/" identity)]
    (artifacts/clean-stages! (Path/dirname output))
    (if (artifact-valid? output identity)
      (do (println "PELAGIC: reusing compiled BL graph") output)
      (let [stage (artifacts/stage! output)]
        (File/mkdir_p! stage)
        (try
          (println "PELAGIC: compiling shared editor, language and package graph")
          (let [a (assembly) generated (str stage "/source")
                entry (str generated "/omega/frontend-graph.bl")
                _ (File/mkdir_p! (Path/dirname entry))
                _ (File/write! entry
                    (str "(ns omega.frontend-graph (:require "
                         (join " " (map (fn [n] (str "[" n "]")) (:namespaces a))) "))\n"))
                result (js/build! "omega.frontend-graph"
                         {:paths (to-list (cons generated (:paths a)))
                          :stub "lower" :with "reader" :preload (:preload a)
                          :host (:host a) :out (str stage "/out")})]
            (doseq [module (:modules result)]
              (let [alias (str stage "/out/" module ".mjs")]
                (when-not (File/exists? alias)
                  (File/write! alias (str "export * from './ns/" module ".mjs';\n")))))
            (File/write! (str stage "/build.json")
              (json/encode {:name "pelagic-frontend" :compiler compiler :modules (count (:modules result))})))
          (println "PELAGIC: linking preparation actors against the checked shared graph")
          (actors/build! here (str stage "/out") (str stage "/pkg/pelagic/actor"))
          (File/write! (str stage "/.pelagic-graph") "PELAGIC compiled BL graph\n")
          (when-not (= identity (graph-fingerprint))
            (throw (ex-info "BL inputs changed during compilation; run the task again." {})))
          (seal! stage identity)
          (replace! stage output ".pelagic-graph")
          output
          (finally (when (File/exists? stage) (File/rm_rf! stage))))))))
(defn graph! []
  (check-tools!)
  (artifacts/coordinated (str (home) "/dist/.graph.lock")
    (fn [] (let [output (graph-unlocked!)]
      (artifacts/collect! (Path/dirname output) ".pelagic-graph" 3 #{output}) output))))
(defn- frontend-unlocked!
  "Return the shared, checked server frontend; compile only when inputs change."
  []
  (let [here (home) root (root) identity (fingerprint)
        output (str here "/dist/frontend/" identity)]
    (artifacts/clean-stages! (Path/dirname output))
    (if (artifact-valid? output identity)
      (do (println "PELAGIC: reusing compiled frontend") output)
      (let [stage (artifacts/stage! output)]
        (File/mkdir_p! (Path/dirname stage))
        (try
          (artifacts/reading (graph!) (fn [graph] (File/cp_r! graph stage)))
          (File/rm! (str stage "/pelagic-build.json"))
          (println "PELAGIC: staging session frontend assets")
          (copy-files! (str root "/vendor/bl-ed/web") stage [".mjs" ".css"])
          (copy! (str root "/vendor/bl-ed/web/index.html") (str stage "/index.html"))
          (copy! (str root "/vendor/bl-ed/web/welcome.bl.org") (str stage "/welcome.bl.org"))
          (doseq [m (package-manifests)]
            (doseq [asset (get-in m [:frontend :assets])]
              (let [from (str root "/" (:from asset)) to (str stage "/" (:to asset))]
                (if (:suffixes asset)
                  (copy-files! from to (:suffixes asset))
                  (copy! from to))))
            (File/write! (str stage "/pkg/" (:name m) ".mjs") (frontend/loader m)))
          (let [boot (Path/dirname (BeamLisp.Loader/source_path "core"))]
            (doseq [name ["core.bl" "sugar.bl"]]
              (copy! (str boot "/" name) (str stage "/out/src/priv/boot/" name))))
          (File/write! (str stage "/.pelagic-server") "PELAGIC shared frontend\n")
          (when-not (= identity (fingerprint))
            (throw (ex-info "Frontend inputs changed during staging; run the task again." {})))
          (seal! stage identity)
          (replace! stage output ".pelagic-server")
          output
          (finally (when (File/exists? stage) (File/rm_rf! stage))))))))
(defn frontend! []
  (check-tools!)
  (artifacts/coordinated (str (home) "/dist/.frontend.lock")
    (fn [] (let [output (frontend-unlocked!)]
      (artifacts/collect! (Path/dirname output) ".pelagic-server" 3 #{output}) output))))
(defn local-valid? [output identity]
  (and (artifact-valid? output identity)
    (try
      (let [stored (json/decode (File/read! (str output "/assets.json")) {:keys :keyword})
            current (artifact/manifest output)
            urls (conj (mapv (fn [file] (str "./" (:path file))) (:files current)) "./assets.json")]
        (and (= (:sha256 stored) (:sha256 current))
             (= (File/read! (str output "/sw.mjs"))
                (artifact/service-worker (str "pelagic-local-" (subs (:sha256 current) 0 20)) urls))))
      (catch _ false))))
(defn- local-from-frontend!
  "Add the local adapter in an immutable generation; existing demos keep theirs."
  [frontend]
  (let [identity (File/read! (str frontend "/.inputs"))
        output (str (home) "/dist/local-generations/" identity)]
    (artifacts/clean-stages! (Path/dirname output))
    (if (local-valid? output identity)
      (do (println "PELAGIC: reusing standalone generation") output)
      (let [stage (artifacts/stage! output)]
        (File/mkdir_p! (Path/dirname stage))
        (try
          (File/cp_r! frontend stage)
          (File/rm! (str stage "/pelagic-build.json"))
          (File/write! (str stage "/index.html")
            (replace-str (File/read! (str frontend "/index.html")) "./host.mjs" "./local/boot.mjs"))
          (doseq [name ["boot.mjs" "documents.mjs"]]
            (copy! (str (home) "/local/" name) (str stage "/local/" name)))
          (File/write! (str stage "/.pelagic-local") "PELAGIC optional local demo\n")
          (seal! stage identity)
          (artifact/write! stage)
          (replace! stage output ".pelagic-local")
          output
          (finally (when (File/exists? stage) (File/rm_rf! stage))))))))
(defn local! []
  (check-tools!)
  (artifacts/coordinated (str (home) "/dist/.local.lock")
    (fn [] (let [output (artifacts/reading (frontend!) local-from-frontend!)]
      (artifacts/collect! (Path/dirname output) ".pelagic-local" 3 #{output}) output))))
(defn bundle! []
  (artifacts/coordinated (str (home) "/dist/.bundle.lock")
    (fn []
      (let [output (local!) archive (str (home) "/dist/pelagic-local.zip")
            stage (artifacts/staging archive)
            script "import pathlib,sys,zipfile\nroot=pathlib.Path(sys.argv[1])\nwith zipfile.ZipFile(sys.argv[2],'w',zipfile.ZIP_DEFLATED) as z:\n for p in sorted(root.rglob('*')):\n  if p.is_file(): z.write(p,'pelagic-local/'+p.relative_to(root).as_posix())\n"]
        (try
          (let [result (artifacts/reading output (fn [directory] (System/cmd "python3" (list "-c" script directory stage))))]
            (when-not (= 0 (elem result 1)) (throw (ex-info "Demo archive failed" {:output (elem result 0)})))
            (File/rename! stage archive)
            (println (str "PELAGIC demo: " archive))
            archive)
          (finally (when (File/exists? stage) (File/rm! stage))))))))
