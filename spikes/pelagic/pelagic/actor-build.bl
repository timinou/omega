; The package supplies its entrypoint; the compiler owns actor policy and links.
(ns pelagic.actor-build (:require [js.actor :as actors]))
(defn build!
  "Build preparation against the frontend's checked modules and shared values."
  [here modules out]
  (let [scratch (str (System/tmp_dir!) "/pelagic-actors-"
                     (System/unique_integer (list :positive)))
        here (Path/expand here)]
    (File/mkdir_p! scratch)
    (try
      (File/cp! (str here "/actor/prepare.bl") (str scratch "/prepare.bl"))
      (actors/build-one scratch "prepare.bl" "prepare.mjs" []
        {:prune true :native-manifest (str modules "/native-modules.json")
                     :native-base "../../../../out"})
      (File/mkdir_p! (str out "/out"))
      (actors/link-runtime! out "../../../out/actor")
      (File/cp! (str scratch "/out/prepare.mjs") (str out "/out/prepare.mjs"))
      (finally (File/rm_rf! scratch)))))
