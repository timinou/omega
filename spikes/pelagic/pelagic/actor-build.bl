; Reuse the checked actor compiler/runtime; never fork their scheduler.
(ns pelagic.actor-build)
(defn build!
  "Build actor preparation against the checked frontend graph and its values."
  [here modules out]
  (let [home (Path/expand (str (Path/dirname (BeamLisp.Loader/source_path "js.build")) "/../../.."))
      actor-dir (some (fn [candidate]
                        (when (and candidate (File/exists? (str candidate "/research/js-actors/compiler.bl")))
                          (Path/expand (str candidate "/research/js-actors"))))
                      [(System/get_env "PELAGIC_ACTOR_ROOT") home (str home "/../../..")])
      source (if actor-dir (File/read! (str actor-dir "/compiler.bl")) (throw (ex-info "Actor source checkout required; set PELAGIC_ACTOR_ROOT" {})))
      ending (index-of source "\n(main (BeamLisp/argv))")
      scratch (str (System/tmp_dir!) "/pelagic-actors-" (System/unique_integer (list :positive)))
      here (Path/expand here)]
  (when-not ending (throw (ex-info "Actor compiler entrypoint changed" {})))
  (File/mkdir_p! scratch)
  (try
    (File/cp! (str actor-dir "/runtime.bl") (str scratch "/runtime.bl"))
    (File/cp! (str here "/actor/prepare.bl") (str scratch "/prepare.bl"))
    (when-not (BeamLisp.Env/bound? "js-actors-compiler" "build-one")
      (BeamLisp/eval (subs source 0 ending)))
    (let [positive (BeamLisp.Env/fetch! "js-actors-compiler" "positive-tests")
          negative (BeamLisp.Env/fetch! "js-actors-compiler" "negative-tests")
          _ (when-not (zero? (+ (positive) (negative))) (throw (ex-info "Actor ABI tests failed" {})))
          build (BeamLisp.Env/fetch! "js-actors-compiler" "build-one")]
      (build scratch "prepare.bl" "prepare.mjs" []
        {:prune true :native-manifest (str modules "/native-modules.json")
                     :native-base "../../../../out"}))
    (let [write-runtime (BeamLisp.Env/fetch! "js-actors-compiler" "write-runtime!")]
      (File/mkdir_p! (str out "/out"))
      (write-runtime actor-dir out "../../../out/rt.mjs")
      (File/cp! (str scratch "/out/prepare.mjs") (str out "/out/prepare.mjs")))
    (finally (File/rm_rf! scratch)))))
