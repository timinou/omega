; One build graph and one runtime shared by the editor, language and package.
(ns pelagic.bundle
  (:require [ed.frame] [pelagic.main] [pelagic.performance] [pelagic.live]
            [pelagic.audition] [pelagic.graph-js] [pelagic.playback-js]
            [pelagic.shadertone] [pelagic.bridge] [pelagic.browser] [pelagic.worker] [pelagic.overtone] [js.eval]))
