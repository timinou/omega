; Live performance edits are data, committed by the host on a bar boundary.
(ns pelagic.live)
(defn configure [values] {:kind :configure :values values})
(defn pattern [stem beats plan] {:kind :pattern :stem stem :beats beats :plan plan})
(defn session [& edits] {:kind :session :edits (vec edits)})
(defn perform [] {:kind :perform})
(defn cue [movement] {:kind :cue :movement movement})
(defn commit [options] (assoc options :kind :commit))
(defn scene [nm value] {:kind :scene :name (name nm) :value value})
(defn launch ([nm] (launch nm {})) ([nm options] {:kind :launch :name (name nm) :options options}))
(defn layer ([nm] (layer nm 0.25)) ([nm amount] {:kind :layer :name (when nm (name nm)) :mix amount}))
(defn visual [values] {:kind :visual :values values})
(defn variation [values] {:kind :variation :values values})
(defn gesture [nm] {:kind :gesture :name (name nm)})
(defn pattern-stop [stem] {:kind :pattern-stop :stem stem})
(defn undo [& options] {:kind :undo})
(defn redo [& options] {:kind :redo})
(defn snapshot [nm] {:kind :snapshot :name (name nm)})
(defn recall [nm] {:kind :recall :name (name nm)})
(defn cancel [] {:kind :cancel})
(defn pause [] {:kind :pause})
(defn resume [] {:kind :resume})
(defn panic [] {:kind :panic})
