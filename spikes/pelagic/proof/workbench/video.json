  "captions": [
    {
      "at": 0.018,
      "text": "PELAGIC  /  Three live voices. The sound comes from this code."
    },
    {
      "at": 4.024,
      "text": "Select kick + bass together.  Shift-click adds a second target."
    },
    {
      "at": 9.283,
      "text": "g a  /  Ask about the selected code while the music keeps playing."
    },
    {
      "at": 20.511,
      "text": "Gen explains the selection. Ask leaves the code and playing revision unchanged."
    },
    {
      "at": 27.861,
      "text": "g q  /  Session keeps questions, answers and follow-ups with their source targets."
    },
    {
      "at": 32.905,
      "text": "Change the same selection: make both patterns sparser."
    },
    {
      "at": 49.34,
      "text": "The two generated replacements update the draft together, as one undoable edit."
    },
    {
      "at": 56.573,
      "text": "Ctrl+Enter  /  Publish the edit at a musical boundary. Hear the extra space."
    },
    {
      "at": 64.655,
      "text": "g v  /  Components move into their source positions: one working column."
    },
    {
      "at": 70.135,
      "text": "g c  /  Peek inside a component to edit its actual source."
    },
    {
      "at": 82.206,
      "text": "One document, two presentations, and the conversation kept beside your music."
    }
  ],
