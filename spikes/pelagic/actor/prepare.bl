; One annotated namespace: actors control demand; native BL runs directly.
(ns ^:js pelagic.prepare (:require [pelagic.browser :as browser] [pelagic.compute :as compute]))
(defn prepare-score [context id start owner]
  (if (< start 1024)
    (let [size (min 16 (- 1024 start))
          before (.now js/performance)
          packet (browser/score-slice context start size (.-pelagicPrepareBudget js/self))]
      (.postMessage js/self #js {:op "chunk" :id id :start start :rows (.-rows packet) :graphs (.-graphs packet)
                                :workMs (- (.now js/performance) before)})
      (receive
        [:credit] (prepare-score context id (+ start (.-length (.-rows packet))) owner)))
    (do (.postMessage js/self #js {:op "done" :id id})
        (rt-send owner [:finished id]))))
(defn main []
  (rt-register-input!)
  (.postMessage js/self #js {:op "ready"})
  (let [owner (rt-self)]
   (loop [jobs {}]
    (receive
      [:browser :prepare id]
        (if (compute/admit? jobs id)
          (recur (assoc jobs id (rt-spawn-owned prepare-score [(browser/preparation-context) id 0 owner])))
          (do (.postMessage js/self #js {:op "error" :id id :error "Preparation capacity exhausted"})
              (recur jobs)))
      [:browser :credit id]
        (do (when-let [worker (get jobs id)] (rt-send worker [:credit])) (recur jobs))
      [:browser :observe id]
        (do (.postMessage js/self #js {:op "observation" :id id :value (bl->js (rt-observation 32))})
            (recur jobs))
      [:browser :ping id]
        (do (.postMessage js/self #js {:op "pong" :id id}) (recur jobs))
      [:browser :cancel id]
        (do (when-let [worker (get jobs id)] (rt-exit worker :kill))
            (.postMessage js/self #js {:op "cancelled" :id id :stale (not (contains? jobs id))})
            (recur (dissoc jobs id)))
      [:finished id] (recur (dissoc jobs id))))))
