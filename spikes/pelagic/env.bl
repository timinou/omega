;; Optional local build; Omega's normal env.bl and editor output stay independent.
{:name "pelagic-local"
 :bl "commit:797dc039"
 :paths ["."]
 :tasks {"artifact-check" {:doc "Verify BL artifact hashes, reproducibility and cache generation." :run "test/artifact.bl"}
         "frontend" {:doc "Compile one frontend for local and server-backed PELAGIC." :run "frontend.bl"}
         "actors" {:doc "Rebuild actor preparation within the frontend graph." :run "actor/build.bl"}
         "bundle" {:doc "Compile the local PELAGIC editor application."
                    :run "bundle.bl"}}}
