; Explicit integration check: this may acquire a frontend through Nix on Build.
; It never mutates checkout assets or falls back to the old local compiler cache.
(ns pelagic-build-integration
  (:require [pelagic.build :as build] [bl.json :as json]))
(defn assert! [value message] (when-not value (throw (ex-info message {}))))
(defn timed [f]
  (let [start (System/monotonic_time :microsecond) value (f)]
    {:value value :ms (/ (- (System/monotonic_time :microsecond) start) 1000.0)}))
(let [first (timed build/frontend!) second (timed build/frontend!)
      web (:value first) manifest (json/decode (File/read! (str web "/pelagic-build.json")) {:keys :keyword})]
  (assert! (= web (:value second)) "Unchanged frontend did not reuse its generation")
  (assert! (starts-with? web "/nix/store/") "Frontend was not built by Nix")
  (assert! (File/regular? (str web "/.omega-managed")) "Frontend is not managed")
  (assert! (= build/compiler (:compiler manifest)) "Compiler pin does not match")
  (assert! (= (:inputs manifest) (File/read! (str web "/.inputs"))) "Build identity is inconsistent")
  (assert! (File/regular? (str web "/out/ed.main.mjs")) "Compiled editor missing")
  (assert! (not (File/exists? (str web "/sw.mjs"))) "Server frontend contains a demo service worker")
  (println (str "PASS remote frontend, pinned compiler and immutable cache reuse: " (json/encode {:first first :unchanged second}))))
