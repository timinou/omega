(ns workspace-desk-test (:require [omega.env :as env] [omega.task :as task] [omega.loop :as loop]
                                [place.model :as place] [ws.desk-server :as desk] [clojure.string] [links.model] [buffer.model :as buffer] [omega.codemode :as cm]))
(deftest rail-scopes-descendants-and-keeps-task-objects-addressable
  (let [e (env/open {:schema place/schema}) sys (task/start-system e {:root "/tmp" :step (loop/scripted [(loop/say "waiting")])})]
    (place/put! e {:id "root" :root "/tmp"}) (place/put! e {:id "child" :parent "root"})
    (place/put! e {:id "other" :root "/tmp"})
    (let [a (task/open! sys {:goal "child work" :place "child"}) b (task/open! sys {:goal "other work" :place "other"})]
      (task/await sys a 5000) (task/await sys b 5000)
      (is (= #{a} (set (map :key (filter (fn [o] (= "omega/task" (:type o))) (:objects (desk/scope-doc sys "root")))))))
      (is (= #{a b} (set (map :key (filter (fn [o] (= "omega/task" (:type o))) (:objects (desk/scope-doc sys "all")))))))
      (is (= "root" (get-in (desk/scope-doc sys "root") [:data :scope])))
      (is (= "No tasks here yet. Press n to start one." (some (fn [line] (when (= line "No tasks here yet. Press n to start one.") line)) (clojure.string/split (:text (desk/scope-doc sys "missing")) "\n")))))
    (task/stop-system! sys) (env/close! e)))

(deftest task-context-addresses-working-files-and-home-independently
  (let [e (env/open {:schema (vec (concat place/schema links.model/schema))})
        sys (task/start-system e {:root "/tmp" :step (loop/scripted [(loop/say "waiting")])})]
    (place/put! e {:id "a" :root "/tmp"})
    (let [id (task/open! sys {:goal "work" :title "A readable task" :place "a" :home {:path "work:a/plan.bl.org" :block "stable"}})]
      (task/await sys id 5000)
      (links.model/put! e {:id "out" :from {:task id} :kind :output :to {:place "a" :path "board.bl.org"}})
      (let [ctx (desk/task-context sys id)]
        (is (= "A readable task" (:task-title ctx)))
        (is (= "work:a/board.bl.org" (:path (first (:artifacts ctx)))))
        (is (= "stable" (:block (last (:artifacts ctx)))))
        (is (= "a" (:place ctx)))))
    (task/stop-system! sys) (env/close! e)))

(deftest task-folder-follows-the-saved-cwd-and-does-not-confuse-it-with-an-anchored-home
  (let [root (str "/tmp/omega-desk-folder-" (erlang/unique_integer (to-list [:positive])))
        e (env/open {:schema place/schema}) sys {:env e}]
    (File/mkdir_p! (str root "/a/sub")) (File/mkdir_p! (str root "/b"))
    (place/put! e {:id "a" :root (str root "/a")}) (place/put! e {:id "b" :root (str root "/b")})
    (let [t {:place "a" :cwd (str root "/a/sub") :home {:path "work:b/plan.bl.org" :block "task"}}]
      (is (= "folder:a/sub" (desk/folder-address sys t)))
      (place/put! e {:id "a" :root (str root "/b")})
      (is (nil? (desk/folder-address sys t)))
      (place/put! e {:id "saved" :root (str root "/a")})
      (is (= "folder:saved/sub" (desk/folder-address sys t)))
      (is (= #{"a" "b" "saved"} (set (map :id (desk/place-choices sys))))))
    (env/close! e)))

(deftest completed-tasks-discover-their-actual-file-operations-without-an-output-link
  (let [root (str "/tmp/omega-desk-output-" (System/system_time :microsecond))
        e (env/open {:schema (vec (concat place/schema links.model/schema buffer/schema))})
        _ (File/mkdir_p! root) _ (File/write! (str root "/board.bl.org") "* TODO Board\n")
        _ (place/put! e {:id "omega" :root root}) server (buffer/start! e)
        sys (task/start-system e {:root root :files (buffer/port server) :tools cm/tools
              :step (loop/scripted [(loop/call-tool "eval" {:code "(edit \"board.bl.org\" [{:old \"TODO\" :new \"DONE\"}])\n(done \"Completed the board.\")"} "edit")])})
        id (task/open! sys {:goal "Update the board" :place "omega" :cwd root})]
    (task/await sys id 10000)
    (is (= "changed" (:kind (first (:artifacts (desk/task-context sys id))))))
    (links.model/put! e {:id "out" :from {:task id} :kind :output :to {:place "omega" :path "board.bl.org"}})
    (let [ctx (desk/task-context sys id)]
      (is (= "work:omega/board.bl.org" (:path (first (:artifacts ctx)))))
      (is (= "output" (:kind (first (:artifacts ctx)))))
      (is (= ["work:omega/board.bl.org"] (:changed-files ctx)))
      (is (= "Completed the board." (:task-result ctx)))
      (is (= "* DONE Board\n" (File/read! (str root "/board.bl.org")))))
    (task/stop-system! sys) (GenServer/stop server) (env/close! e)))

(deftest change-counts-include-linked-human-edits-once-and-exclude-unedited-inputs
  (let [root (str "/tmp/omega-desk-count-" (System/system_time :microsecond))
        e (env/open {:schema (vec (concat place/schema links.model/schema buffer/schema))})
        _ (File/mkdir_p! root) _ (File/write! (str root "/review.org") "Original\n")
        _ (place/put! e {:id "a" :root root}) server (buffer/start! e)
        sys (task/start-system e {:root root :step (loop/scripted [(loop/say "waiting")])})
        id (task/open! sys {:goal "Review" :place "a"})]
    (task/await sys id 5000)
    (doseq [[key path block] [["first" "review.org" "one"] ["second" "review.org" "two"] ["input" "input.org" nil]]]
      (links.model/put! e {:id key :from {:task id} :kind :input :to {:place "a" :path path :block block}}))
    (is (= [] (:changed-files (desk/task-context sys id))))
    (buffer/request! server [:save (str root "/review.org") {:text "Edited\n" :base "0" :client "human" :sequence 1}])
    (is (= ["work:a/review.org"] (:changed-files (desk/task-context sys id))))
    (task/stop-system! sys) (GenServer/stop server) (env/close! e)))
