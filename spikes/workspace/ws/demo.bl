; Offline, isolated, reproducible. Files are only under the explicit /tmp root.
(ns ws.demo
  (:require [omega.env :as env] [omega.task :as task] [omega.loop :as loop]
            [omega.codemode :as cm] [omega.ed.providers :as pv]
            [bl-ed.serve :as serve] [clojure.string :as str] [ws.server :as workspace] [ws.desk-server :as desk] [place.model :as place] [place.server :as places] [links.model :as link] [links.server :as links] [buffer.model :as buffer] [buffer.server :as buffers]))

(defn model []
  ; Derive the stage from durable conversation, not a process-local counter.
  ; Reopened tasks and two tasks with the same goal keep independent scripts.
  (fn [req]
    (let [messages (:messages req) goal (get-in (first messages) [:content 0 :text])
          stage (count (filter (fn [m] (= :assistant (:role m))) messages))
          reply (str (get-in (last messages) [:content 0 :text]))]
      (if (contains? #{"Update the omega board." "Update the beam-lisp board."} goal)
        (cond
          (= stage 0) (loop/call-tool "eval" {:code "(println (sh \"pwd\"))\n(println (read \"board.bl.org\"))"} "demo-read")
          (= stage 1) (loop/call-tool "eval" {:code "(send \"human:me\" :ask \"Mark this folder's board DONE?\")"} "demo-ask")
          (= stage 2) (loop/say "I checked my working directory and board. Waiting for your answer.")
          :else (loop/call-tool "eval"
                  {:code (if (str/includes? reply "yes")
                           "(edit \"board.bl.org\" [{:old \"TODO\" :new \"DONE\"}])\n(done \"Updated board.bl.org in my own working directory.\")"
                           "(done \"Kept the board unchanged.\")")} "demo-finish"))
        (loop/say "This offline model demonstrates the two board goals. Install your own :step function for other work.")))))

(defn launch
  ([root port home] (launch root port home {}))
  ([root port home options]
  (let [places {"omega" (str root "/omega") "beam-lisp" (str root "/beam-lisp")}
        _ (doseq [[_ dir] places] (File/mkdir_p! dir)
            (when-not (File/regular? (str dir "/board.bl.org"))
              (File/write! (str dir "/board.bl.org") (str "#+TITLE: " (Path/basename dir) " board\n\n* TODO Check this folder\nAn ordinary editable todo board.\n"))))
        plan (str "#+TITLE: Two working directories\n\n* Omega board\n#+begin_task :id omega-board :cwd @omega\nUpdate the omega board.\n#+end_task\n\n* Beam Lisp board\n#+begin_task :id beam-board :cwd @beam-lisp\nUpdate the beam-lisp board.\n#+end_task\n\n* Notes\nThis plan is editable text. Both tasks live here; each edits its own board.bl.org.\nAlt+h/l focuses panes. g H goes home; g d visits the folder; g t returns to context.\n")
        _ (when-not (File/regular? (str root "/omega/plan.bl.org")) (File/write! (str root "/omega/plan.bl.org") plan))
        e (env/open {:path (str root "/.omega/db") :schema (vec (concat place/schema link/schema buffer/schema))})
        _ (doseq [[id dir] places]
            (when-not (get (place/all e) id) (place/put! e {:id id :name id :root dir :home (when (= id "omega") {:path "plan.bl.org"}) :config {:test-command "printf offline-demo"}})))
        _ (when-not (get (place/all e) "boards") (place/put! e {:id "boards" :name "Boards" :parent "omega" :config {:view :todo-board}}))
        _ (when (empty? (link/all e {:place "boards"}))
            (link/put! e {:id "boards-plan" :from {:place "boards"} :kind :context :to {:place "omega" :path "plan.bl.org" :block "beam-board"}}))
        server (buffer/start! e)
        sys (task/start-system e {:step (model) :tools cm/tools :root root :files (buffer/port server)})
        _ (task/recover! sys)
        opts {:state (str root "/.omega/ed")
              :task-context (fn [path cwd] (places/context sys path cwd))}
        r (serve/start! {:port port :root root :web (str home "/vendor/bl-ed/web")
                         :providers (merge (pv/providers sys opts) (places/providers sys) (links/providers sys) (buffers/providers sys server) (desk/providers sys (get (pv/providers sys opts) "task")))
                         :intents (merge (pv/intents sys opts) (places/intents sys) (links/intents sys) (buffers/intents sys server))})]
    (when (:experience options)
      (doseq [[goal title id anchor] [["Update the omega board." "Refresh the Omega board" "omega" "omega-board"]
                                    ["Update the beam-lisp board." "Finish the Beam Lisp checklist" "beam-lisp" "beam-board"]]]
        (when-not (some (fn [t] (= goal (:goal t))) (task/all sys))
          (task/open! sys {:goal goal :title title :place id :cwd (get places id) :home {:path "work:omega/plan.bl.org" :block anchor}}))))
    (when (:experience options)
      (doseq [t (task/all sys)]
        (when (contains? #{"Update the omega board." "Update the beam-lisp board."} (:goal t))
          (let [id (str (:id t) "-board")]
            (when-not (some (fn [m] (= id (:id m))) (link/all e {:task (:id t)}))
              (link/put! e {:id id :from {:task (:id t)} :kind :output
                           :to {:place (:place t) :path "board.bl.org"}}))))))
    (println (str (:url r) (if (:experience options)
      "?file=workspace:all&use=present,dwim,workspace,places,references,buffers,workbench&layout=desk"
      "?file=places:&use=present,dwim,workspace,places,references,buffers&layout=workspace")))
    (receive :never nil))))
