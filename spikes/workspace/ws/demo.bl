; Offline, isolated, reproducible. Files are only under the explicit /tmp root.
(ns ws.demo
  (:require [omega.env :as env] [omega.task :as task] [omega.loop :as loop]
            [omega.codemode :as cm] [omega.ed.providers :as pv]
            [bl-ed.serve :as serve] [ws.server :as workspace]))

(defn model []
  (loop/by-goal
    (into {} (map (fn [goal]
                    [goal [(loop/call-tool "eval" {:code "(println (sh \"pwd\"))\n(println (read \"board.bl.org\"))"})
                           (loop/call-tool "eval" {:code "(send \"human:me\" :ask \"Mark this folder's board DONE?\")"})
                           (loop/say "I checked my working directory and board. Waiting for your answer.")
                           (fn [req]
                             (let [reply (str (get-in (last (:messages req)) [:content 0 :text]))]
                               (loop/call-tool "eval"
                                 {:code (if (clojure.string/includes? reply "yes")
                                          "(edit \"board.bl.org\" [{:old \"TODO\" :new \"DONE\"}])\n(done \"Updated board.bl.org in my own working directory.\")"
                                          "(done \"Kept the board unchanged.\")")})))]] )
                  ["Update the omega board." "Update the beam-lisp board."]))))

(defn launch [root port home]
  (let [places {"omega" (str root "/omega") "beam-lisp" (str root "/beam-lisp")}
        _ (doseq [[_ dir] places] (File/mkdir_p! dir)
            (when-not (File/regular? (str dir "/board.bl.org"))
              (File/write! (str dir "/board.bl.org") (str "#+TITLE: " (Path/basename dir) " board\n\n* TODO Check this folder\nAn ordinary editable todo board.\n"))))
        plan (str "#+TITLE: Two working directories\n\n* Omega board\n#+begin_task :id omega-board :cwd @omega\nUpdate the omega board.\n#+end_task\n\n* Beam Lisp board\n#+begin_task :id beam-board :cwd @beam-lisp\nUpdate the beam-lisp board.\n#+end_task\n\n* Notes\nThis plan is editable text. Both tasks live here; each edits its own board.bl.org.\nAlt+h/l focuses panes. g H goes home; g f visits the folder; g t visits a task.\n")
        _ (when-not (File/regular? (str root "/omega/plan.bl.org")) (File/write! (str root "/omega/plan.bl.org") plan))
        sys (task/start-system (env/open) {:step (model) :tools cm/tools :root root})
        opts {:state (str root "/.omega/ed")
              :working-directory (fn [path cwd] (workspace/working-directory places root path cwd))}
        r (serve/start! {:port port :root root :web (str home "/vendor/bl-ed/web")
                         :providers (merge (pv/providers sys opts) (workspace/providers sys places))
                         :intents (pv/intents sys opts)})]
    (println (str (:url r) "?file=places:&use=present,dwim,workspace&layout=workspace"))
    (receive :never nil)))
