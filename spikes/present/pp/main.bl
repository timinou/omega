; pp/main.bl — the spike's entry: ed.main + presentations + modes
; (spike: spikes/present-pipeline.bl.md).
;
; A MODE is data: {:name :lighter :keys {seq cmd} :commands {name cmd}
; :on-event (fn [old new ev] new)}. `handle` runs ed.main/handle, then folds
; every active mode's :on-event over the result — so a mode reacts to what
; an event DID (old → new), never re-implements it. Modes and presentations
; are chosen per document scheme (auto) and toggled at runtime.

(ns pp.main
  (:require [ed.main :as m]
            [ed.pkg :as pkg]
            [ed.core :as c]
            [ed.text :as t]
            [pp.read :as rd]
            [pp.present :as p]
            [pp.omega :as om]
            [pp.conv :as cv]
            [pp.rail :as rl]
            [pp.inbox :as inbox]))

; ─── block motions from the readtable ──────────────────────────────────────

(defn- goto-row [ed r]
  (c/scroll-to-cursor (assoc ed :sels [{:anchor [r 0] :head [r 0]}] :primary 0)))

(defn- objects-of [ed ty]
  (let [pr (:presentation ed)]
    (filter (fn [o] (= ty (:type o))) (rd/walk (p/tree-of (:readtable pr) ed (or (:read pr) rd/read-doc))))))

(defn block-motion [ty dir]
  (fn [ed]
    (let [r (first (c/cursor ed))
          os (objects-of ed ty)
          hit (if (pos? dir) (first (filter (fn [o] (> (:from o) r)) os)) (last (filter (fn [o] (< (:from o) r)) os)))]
      (if (nil? hit) (c/message ed (str "no " (if (pos? dir) "next" "previous") " " (name ty))) (goto-row ed (:from hit))))))

(defn- composer-row [ed] (:from (first (objects-of ed :omega/composer))))

; ─── modes ─────────────────────────────────────────────────────────────────

(defn- at-tail?
  "Was the reader at the tail: in the newest turn, the traces or the composer?"
  [ed]
  (let [turns (objects-of ed :omega/turn)
        last-from (if (empty? turns) 0 (:from (last turns)))]
    (>= (first (c/cursor ed)) last-from)))

(defn- follow? [ed] (some (fn [m] (= m :follow)) (:modes ed)))

(def follow
  {:name :follow :lighter "⇣ follow"
   :doc "Stay at the latest: while you are at the bottom, new turns keep the end in view; scrolling up lets go, scrolling back down (or G) picks it up again."
   ; the pin itself is the view's :pin (set by scrolling to the tail, by the cursor
   ; landing on the composer, and by opening a task); the render honours it
   :on-event (fn [old new ev] new)})

(def compose
  {:name :compose :lighter "✎ compose"
   :doc "When the task hands you the turn WHILE you are reading it, the cursor goes to the say block (opening a task is not that: you land at the latest turn, ready to read)."
   :on-event (fn [old new ev]
               (let [yours? (fn [ed] (some? (index-of (t/line (:text ed) 0) "your turn")))]
                 (if (and (= :doc (:type ev)) (= (:path old) (:path new)) (yours? new) (not (yours? old)) (at-tail? old) (some? (composer-row new)))
                   (goto-row new (composer-row new))
                   new)))})

(def MODES {:follow follow :compose compose})

; ─── presentations, chosen per scheme ──────────────────────────────────────

(def PRESENTATIONS {"text" om/default-presentation "omega" om/presentation
                    "conversation" cv/presentation "rail" rl/presentation})

(def CYCLE {"text" "omega" "omega" "conversation" "conversation" "text" "rail" "text"})

(defn- auto [path]
  (cond
    (starts-with? (str path) "task:") {:presentation "conversation" :modes [:follow :compose]}
    (= "omega:overview" (str path)) {:presentation "rail" :modes []}
    :else {:presentation "text" :modes []}))

(defn- adopt
  "A document arrived. A VISIT to a task opens at the latest: the cursor on the
   newest turn, the view pinned to the end (a refresh of the same document is not
   a visit: it keeps where the reader is)."
  [ed path]
  (let [a (auto path)
        seen (get-in ed [:pkg-state "present" :seen])
        empty? (= "" (t/to-string (:text ed)))
        ed (-> ed (assoc :presentation (get PRESENTATIONS (:presentation a)) :modes (:modes a))
                  ; an empty document (the host's boot) has not been seen yet
                  (assoc-in [:pkg-state "present" :seen] (if empty? nil path)))
        ; the cursor rests on the newest turn's last line, NOT the composer: the
        ; composer takes typed characters (chat), reading keys must still read
        turns (when (and (not= seen path) (follow? ed)) (objects-of ed :omega/turn))
        r (when (seq turns) (min (:to (last turns)) (dec (or (composer-row ed) (t/line-count (:text ed))))))]
    (if (nil? r) ed
      (-> ed (assoc :sels [{:anchor [r 0] :head [r 0]}] :primary 0)
             (assoc-in [:view :pin] :end)))))

(def commands
  {:pp/next-turn {:doc "Next turn." :run (block-motion :omega/turn 1)}
   :pp/prev-turn {:doc "Previous turn." :run (block-motion :omega/turn -1)}
   :pp/next-cell {:doc "Next cell." :run (block-motion :omega/cell 1)}
   :pp/next-thread {:doc "Next thing you said." :run (block-motion :conv/thread 1)}
   :pp/prev-thread {:doc "Previous thing you said." :run (block-motion :conv/thread -1)}
   :pp/next-task {:doc "Next task." :run (block-motion :omega/task 1)}
   :pp/prev-task {:doc "Previous task." :run (block-motion :omega/task -1)}
   :pp/prev-cell {:doc "Previous cell." :run (block-motion :omega/cell -1)}
   :pp/say {:doc "Go to the say block." :run (fn [ed] (if-let [r (composer-row ed)] (goto-row ed r) (c/message ed "no say block here")))}
   :pp/toggle-presentation {:doc "Cycle the drawing: text → omega → conversation → text."
                            :run (fn [ed] (let [nxt (get CYCLE (:name (:presentation ed)) "text")]
                                            (c/message (assoc ed :presentation (get PRESENTATIONS nxt)) (str "presentation: " nxt))))}
   :pp/toggle-follow {:doc "Toggle follow mode."
                      :run (fn [ed] (let [on? (some (fn [x] (= x :follow)) (:modes ed))]
                                      (c/message (update ed :modes (fn [ms] (if on? (vec (remove (fn [x] (= x :follow)) ms)) (conj (vec ms) :follow))))
                                                 (str "follow " (if on? "off" "on")))))}})

(def keys-normal
  {"] q" :pp/next-thread "[ q" :pp/prev-thread "J" :pp/next-thread "K" :pp/prev-thread
   "] t" :pp/next-turn "[ t" :pp/prev-turn "] c" :pp/next-cell "[ c" :pp/prev-cell
   "g s" :pp/say "space t p" :pp/toggle-presentation "space t f" :pp/toggle-follow})

; In the rail, j/k move TASK to task (a task is three screen rows, one text row);
; the frame's link then opens the selection in the pane.
(def rail-keys {"j" :pp/next-task "k" :pp/prev-task})

(defn- keys-of
  "The package's keys for the shown document (the rail moves task to task)."
  [ed]
  {:normal (merge keys-normal (if (= "rail" (:name (:presentation ed))) rail-keys {}))})

; ─── the host API ──────────────────────────────────────────────────────────

(defn- presented? [ed] (contains? #{"omega" "conversation"} (:name (:presentation ed))))


; ─── type-to-compose: the say block is where you write ─────────────────────
;
; On the composer row of a read-only task view, a printable key does not run a
; normal-mode command (where `e` visits effects and `y` answers yes): it opens
; the say prompt with that character already in it. A finished task cannot
; take messages, so the same keystroke drafts a NEW task instead.

(defn- on-composer? [ed]
  (and (= :normal (:mode ed)) (empty? (:pending ed))
       (some? (composer-row ed)) (= (composer-row ed) (first (c/cursor ed)))))

(defn- task-id
  "The task id from the title line `#+TITLE: t-15 · …`, or nil."
  [ed]
  (let [l (t/line (:text ed) 0)
        p "#+TITLE: "]
    (when (starts-with? l p)
      (let [w (first (split (subs l (count p)) " "))] (when (starts-with? w "t-") w)))))

(defn- finished? [ed] (some? (index-of (t/line (:text ed) 0) "✓ done")))

(defn- compose-key [ed ch]
  (let [id (task-id ed)
        submit (if (finished? ed)
                 (fn [e s] (-> e (c/effect {:kind :intent :intent "task/open" :args {:goal s}})
                               (c/message "opened a new task; it is in omega:scratch (space a s)")))
                 (fn [e s] (-> e (c/effect {:kind :intent :intent "task/say" :args {:id id :text s}})
                               (c/message (str "sent to " id)))))]
    (assoc ed :mode :command
           :minibuf {:prompt (if (finished? ed) "new task ▸ " (str "say to " id " ▸ ")) :text ch :kind :prompt :submit submit})))

(defn- typed-char [ev]
  (let [k (:key ev)] (when (and (= :key (:type ev)) (string? k) (= 1 (count k)) (not= k " ")) k)))


(defn- prompting? [ed] (and (= :command (:mode ed)) (= :prompt (:kind (:minibuf ed)))))

; ─── scrolling: the position is a value, in rows ───────────────────────────
;
; A wrapped answer is ONE text row drawn as many slots, so scrolling by text
; rows would jump over it, and a wheel that moves whole rows is jerky. The view
; keeps an anchor {:row r :off k :sub f}: the k-th slot of text row r, f rows
; (fractional) scrolled past its top. Any motion that moves :top drops it.
;
; The view may also be PINNED to the latest ({:pin :end}): the end of the
; document stays in view while it grows (a chat's "latest shown"). Pinned means
; at the tail AND following; scrolling up unpins, reaching the tail pins again.
; A refresh that is not pinned keeps the anchor (docs/refreshed maps its row
; through the text change), so an update never pulls a reader back to the top.

(defn- source-row [line] (or (:row line) (:src line)))

(defn- body-lines [v]
  (filter (fn [line] (and (some? (source-row line)) (not (:fixed? line)) (not (:peek? line)))) (:lines v)))

(defn- size-at [slots y] (or (:size (nth slots y)) 1))

(defn- walk
  "Slot y, `sub` rows into it, moved by `delta` rows (either sign) → [y sub],
   clamped to the screen [0, limit)."
  [slots limit y sub delta]
  (loop [y y pos (+ sub delta)]
    (cond (< pos 0) (if (zero? y) [0 0] (recur (dec y) (+ pos (size-at slots (dec y)))))
          (>= pos (size-at slots y)) (if (>= (inc y) limit) [y 0] (recur (inc y) (- pos (size-at slots y))))
          :else [y pos])))

(defn- scroll-to-slot
  "Put slot y (sub rows into it) at the top. Reaching the tail pins (when
   following); the cursor leaves the body → it follows (Vim C-e)."
  ([ed y] (scroll-to-slot ed y 0))
  ([ed y sub]
   (let [pr (:presentation ed)
         v (p/render pr ed)
         {:keys [slots limit]} (:screen v)
         tail (:tail-top v)
         at-tail? (>= y tail)
         y (if at-tail? tail (max 0 (min y (dec (max 1 limit)))))
         sub (if at-tail? 0 sub)
         r (p/slot-row (nth slots y))
         base (p/first-slot-of-row slots r)
         ed2 (assoc ed :view (-> (:view ed)
                                 (assoc :top r :anchor {:row r :off (- y base) :sub sub})
                                 (assoc :pin (when (and at-tail? (follow? ed)) :end))))
         v2 (p/render pr ed2)
         body (body-lines v2)
         cur (first (c/cursor ed2))
         shown (set (map source-row body))]
     (if (or (contains? shown cur) (empty? body) (= :end (:pin (:view ed2)))) ed2
       (let [q [(if (> y (:slot-top v)) (source-row (first body)) (source-row (last body))) 0]]
         (assoc ed2 :sels [{:anchor q :head q}] :primary 0))))))

(defn- scroll-by
  "Scroll by `delta` rows (fractional: a trackpad's pixels, a wheel tween's step)."
  [ed delta]
  (let [v (p/render (:presentation ed) ed)
        {:keys [slots limit]} (:screen v)
        [y sub] (walk slots limit (:slot-top v) (or (:frac v) 0) delta)]
    (scroll-to-slot ed y sub)))

(defn- pinned? [ed] (= :end (:pin (:view ed))))

(defn- unpin
  "Materialise a pinned view as an ordinary anchored one (same picture), so a
   motion the core makes starts from what is on screen, not from a stale :top.
   A cursor that is not on screen comes to the last body row first: a key
   never throws the picture to wherever the cursor happened to be."
  [ed]
  (if-not (pinned? ed) ed
    (let [v (p/render (:presentation ed) ed)
          y (:slot-top v)
          r (p/slot-row (nth (:slots (:screen v)) y))
          base (p/first-slot-of-row (:slots (:screen v)) r)
          body (body-lines v)
          shown (set (map source-row body))
          ed (if (or (empty? body) (contains? shown (first (c/cursor ed)))) ed
               (let [q [(source-row (last body)) 0]] (assoc ed :sels [{:anchor q :head q}] :primary 0)))]
      (assoc ed :view (-> (:view ed) (dissoc :pin) (assoc :top r :anchor {:row r :off (- y base) :sub 0}))))))

(defn- intercept
  "Events the package answers instead of the core (nil: let the core run)."
  [ed ev]
  (cond
    (nil? (:presentation ed)) nil
    (= :scroll-slots (:type ev)) (scroll-by ed (:delta ev))
    (= :scroll-to-slot (:type ev)) (scroll-to-slot ed (:y ev))
    ; a draft is several lines: S-Enter breaks the line (Enter still sends)
    (and (prompting? ed) (= :key (:type ev)) (= "S-Enter" (:key ev)))
      (update-in ed [:minibuf :text] str "\n")
    ; `i` anywhere in a presented task writes in its composer (chat-style)
    (and (presented? ed) (= :key (:type ev)) (= "i" (:key ev)) (= :normal (:mode ed)) (empty? (:pending ed))
         (some? (task-id ed)) (some? (composer-row ed)))
      (compose-key ed "")
    (and (presented? ed) (some? (typed-char ev)) (on-composer? ed) (some? (task-id ed)))
      (compose-key ed (typed-char ev))
    ; a pinned view moves like any other: from what is on screen. (While a
    ; prompt is open the keys are the draft's, nothing moves: stay pinned.)
    (and (pinned? ed) (contains? #{:key :click} (:type ev)) (not= :command (:mode ed)))
      (m/handle (unpin ed) ev)
    :else nil))

(defn- repin
  "Following, with the cursor on the composer after a key or click: the view is
   at the latest (and stays there as the document grows)."
  [new ev]
  (if (and (contains? #{:key :click} (:type ev)) (presented? new) (follow? new)
           (some? (composer-row new)) (>= (first (c/cursor new)) (composer-row new)))
    (assoc-in new [:view :pin] :end)
    new))

(defn- on-event
  "After the core: the active modes react to what it did."
  [old new ev]
  (repin (reduce (fn [acc k] ((:on-event (get MODES k)) old acc ev)) new (or (:modes new) [])) ev))

(defn- draw
  "The document, drawn through its presentation (nil: no presentation → text)."
  [ed]
    ; A resize changes the available room, not what the reader chose to see.
    (and (= :resize (:type ev)) (or (:anchor (:view ed)) (pinned? ed)))
      (assoc-in ed [:view :height] (max 4 (:height ev)))
  (when (and (some? (:presentation ed)) (not= "text" (:name (:presentation ed))))
    (let [v (p/render (:presentation ed) ed)
          lighters (vec (map (fn [k] (:lighter (get MODES k))) (:modes ed)))]
      (cond-> (assoc v :modes lighters :presentation (:name (:presentation ed)))
        (and (some? (:minibuf v)) (presented? ed) (= :prompt (:kind (:minibuf ed))))
          (assoc-in [:minibuf :inline?] true)))))

(def bl-package
  "The presentation spike as a bl-ed package (ed/pkg.bl): load it into a
   running bl-ed with `:(ed/use \"present\")` (or ?use=present)."
  {:name "present"
   :doc "Draw documents through presentations: task: as a conversation, omega:overview as a rail; follow/compose modes; a docked multi-line composer."
   :commands commands
   :keys keys-of
   :intercept intercept
   :on-event on-event
   :adopt (fn [ed] (adopt ed (:path ed)))
   ;; what :adopt sets on the editor — removed with the package
   :owns [:presentation :modes]
   :render draw
   ;; what other parts of bl-ed consume (ed/frame.bl reads :layouts :links :views)
   :provides {:layouts {"inbox" inbox/inbox}
              :links   {"omega/task" inbox/task-path}
              :views   {:minimap (fn [ed] (when (some? (:presentation ed)) (p/minimap (:presentation ed) ed)))}}})

; A module exports its package as `bl-package` (`package` is a reserved word in
; JS, so the compiled export would be mangled).

; ─── the host API (what the spike's pages and tests call) ──────────────────
; ed.main with this package used: the SAME code path as a loaded module.

(defn boot [s path] (pkg/use (m/boot s path) bl-package))
(defn handle [ed ev] (m/handle ed ev))
(defn take-effects [ed] (m/take-effects ed))
(defn render [ed] (m/render ed))

(defn render-text
  "Today's view model, for comparison."
  [ed] (m/render-rows ed (range (:top (:view ed)) (min (t/line-count (:text ed)) (+ (:top (:view ed)) (:height (:view ed)))))))
