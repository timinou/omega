; pp/present.bl — presenters → marks → grid layout (spike: spikes/present-pipeline.bl.md).
;
;   text ─read─▶ objects ─present─▶ marks ─layout─▶ slots+frames ─paint─▶ host
;
; MARKS (plain maps, every one knows where it came from):
;   {:m :text  :row r}                       a source row, drawn by ed.main/line-view (EDITABLE)
;   {:m :line  :src r :segs [seg] :key k}    an ornament row: derived text; `:src` is where a
;                                            click / RET lands (NOT editable)
;   {:m :stack :kids [mark]}
;   {:m :card  :key k :tone s :kids [mark]}  a frame around its kids' slots
;   {:m :sticky :key k :kids [mark]}         drawn in place, or pinned to the viewport's bottom
;                                            edge while its place is below it (position: sticky)
;
; PRESENTERS: a table {type (fn [o ctx] mark)} looked up through an isa
; hierarchy (:omega/cell → :src → :node), wrapped by :around advice
; [{:type t :fn (fn [o ctx next] mark)}] — CLOS-style method combination, so a
; mode changes how a type draws without editing its presenter.
;
; LOD: ctx carries (:lod ctx) = (fn [o] 0..3). 0 = folded to its first row,
; 3 = everything. Folding is no longer a mechanism of its own: the default
; policy gives a folded section lod 0.
;
; LAYOUT is arithmetic on a monospace grid: a mark tree flattens to SLOTS (one
; screen row each) and FRAMES ({:key :tone :y0 :y1 :depth}). Expensive work
; (segments) happens only for slots inside the viewport.

(ns pp.present
  (:require [ed.main :as m]
            [ed.text :as t]
            [ed.core :as c]
            [ed.memo :as memo]
            [pp.read :as rd]))

; ─── marks ─────────────────────────────────────────────────────────────────

(defn text-mark [r] {:m :text :row r})
(defn line-mark
  "An ornament row. opts: {:size rows (default 1) :role kw} — a :size 2 row is a
   double-height line (a VT100 DECDHL / a Genera :large character style): the
   grid stays integral, a headline just takes two of its rows."
  ([src segs key] {:m :line :src src :segs segs :key key})
  ([src segs key opts] (merge {:m :line :src src :segs segs :key key} opts)))
(defn stack [kids] {:m :stack :kids (vec kids)})
(defn card [key tone kids] {:m :card :key key :tone tone :kids (vec kids)})
(defn head-card
  "A card whose FIRST slot is its heading: it sticks to the top of the viewport
   while the rest of the card is on screen (a sticky section header)."
  [key tone kids] {:m :card :key key :tone tone :head? true :kids (vec kids)})
(defn sticky [key kids] {:m :sticky :key key :kids (vec kids)})
(defn dock
  "Docked to the viewport's bottom edge ALWAYS (a chat composer): never part of
   the scrolling body, whatever is shown."
  [key kids] {:m :sticky :key key :dock? true :kids (vec kids)})

; ─── presenter lookup ──────────────────────────────────────────────────────

(def ISA
  {:section :node :src :node :result :node :prose :node :block :node :doc :node
   :omega/turn :section :omega/traces :section :omega/composer :section
   :omega/cell :src :omega/result :result :omega/task :prose :omega/trace :prose})

(defn lineage
  "ty, its parents, … and always :node last: a type nobody declared (a
   provider's new object type) still draws, as text."
  [isa ty]
  (let [l (loop [t ty out []] (if (nil? t) out (recur (get isa t) (conj out t))))]
    (if (= :node (last l)) l (conj l :node))))

(defn present
  "The mark for object `o` under ctx {:table :around :isa :lod …}."
  [o ctx]
  (let [line (lineage (:isa ctx) (:type o))
        base (some (fn [t] (get (:table ctx) t)) line)
        advice (filter (fn [a] (some (fn [t] (= t (:type a))) line)) (:around ctx))]
    ((reduce (fn [nxt a] (fn [o ctx] ((:fn a) o ctx nxt))) base (reverse advice)) o ctx)))

; ─── the default presenter: the text itself ────────────────────────────────

(defn rows-with-kids
  "o's rows in order, each kid presented where it starts: today's screen."
  [o ctx]
  (let [kids-at (reduce (fn [m k] (assoc m (:from k) k)) {} (:kids o))]
    (loop [r (:from o) out []]
      (if (>= r (:to o)) out
        (if-let [k (get kids-at r)]
          (recur (max (inc r) (:to k)) (conj out (present k ctx)))
          (recur (inc r) (conj out (text-mark r))))))))

(defn present-node [o ctx]
  (if (and (= 0 ((:lod ctx) o)) (> (:to o) (inc (:from o))))
    (text-mark (:from o))
    (stack (rows-with-kids o ctx))))

(def default-table {:node present-node})

(defn default-lod
  "Today's policy: a folded section shows its heading only."
  [ed]
  (let [folds (or (:folds ed) #{})]
    (fn [o] (if (and (= :heading (:kind (:span o))) (contains? folds (:from o))) 0 3))))

; ─── layout: marks → slots + frames ────────────────────────────────────────

(defn flatten-mark
  "acc = {:slots [] :frames [] :sticky [] :index {row y}}; depth = frame nesting."
  [acc mk depth]
  (let [kind (:m mk)]
    (cond
      (= kind :text) (-> acc (assoc-in [:index (:row mk)] (count (:slots acc)))
                         (update :slots conj {:kind :text :row (:row mk)}))
      (= kind :line) (update acc :slots conj {:kind :line :src (:src mk) :segs (:segs mk) :key (:key mk)
                                              :size (or (:size mk) 1) :role (:role mk)})
      (= kind :stack) (reduce (fn [a k] (flatten-mark a k depth)) acc (:kids mk))
      (contains? #{:card :sticky} kind)
        (let [y0 (count (:slots acc))
              a (reduce (fn [a k] (flatten-mark a k (inc depth))) acc (:kids mk))
              fr {:key (:key mk) :tone (:tone mk) :y0 y0 :y1 (count (:slots a)) :depth depth :sticky? (= :sticky kind)
                  :head? (= true (:head? mk)) :dock? (= true (:dock? mk))}]
          (if (= :sticky kind) (update a :sticky conj fr) (update a :frames conj fr)))
      :else acc)))

(defn layout [mk] (flatten-mark {:slots [] :frames [] :sticky [] :index {}} mk 0))

(defn slot-row [s] (if (= :text (:kind s)) (:row s) (:src s)))

; ─── one cache per stage, keyed by identity (pure memo: same inputs → same value) ─

(def ^:private read-cache (atom nil))
(def ^:private layout-cache (atom nil))

(defn tree-of
  "The object tree of `ed` under readtable `rt`, read by `read-fn` (default
   pp.read/read-doc), memoised on the identity of the inputs."
  ([rt ed] (tree-of rt ed rd/read-doc))
  ([rt ed read-fn]
   (let [c @read-cache]
     (if (and (some? c) (identical? (:s c) (:struct ed)) (identical? (:o c) (:obj-index ed))
              (identical? (:rt c) rt) (identical? (:f c) read-fn))
       (:v c)
       (let [v (read-fn rt ed)]
         (reset! read-cache {:s (:struct ed) :o (:obj-index ed) :rt rt :f read-fn :v v})
         v)))))

(defn screen-of
  "Slots and frames for the editor under presentation `p`
   {:readtable :table :around :isa :lod-of (fn [ed tree] lod-fn) :focus-of (fn [ed tree] key)}."
  [p ed]
  (let [tree (tree-of (:readtable p) ed (or (:read p) rd/read-doc))
        focus ((:focus-of p) ed tree)
        c @layout-cache]
    (if (and (some? c) (identical? (:tree c) tree) (= (:focus c) focus) (identical? (:p c) p))
      (:v c)
      (let [ctx (merge {:table (:table p) :around (:around p) :isa (:isa p) :ed ed :lod ((:lod-of p) ed tree)}
                       (if (:ctx-of p) ((:ctx-of p) ed) {}))
            v (layout (present tree ctx))]
        (reset! layout-cache {:tree tree :focus focus :p p :v v})
        v))))

; ─── the view model ────────────────────────────────────────────────────────

(defn first-slot-of-row
  "The first slot drawn for text row r (a text slot, or its first ornament)."
  [slots r]
  (or (first (filter (fn [i] (= r (slot-row (nth slots i)))) (range (count slots)))) 0))

(defn- first-slot-at-or-after [slots index top]
  (or (get index top)
      (first (filter (fn [i] (let [r (slot-row (nth slots i))] (and (some? r) (>= r top)))) (range (count slots))))
      (max 0 (dec (count slots)))))

(defn- size-of [s] (or (:size s) 1))

(defn- reductions-of
  "Running offsets: [3 1 2] → [0 3 4]."
  [xs]
  (loop [xs xs acc 0 out []] (if (empty? xs) out (recur (rest xs) (+ acc (first xs)) (conj out acc)))))

(defn- take-rows
  "Slot indices from y, in order, below `limit`, while their sizes fit in `budget` rows."
  ([slots y budget] (take-rows slots y budget (count slots)))
  ([slots y budget limit]
   (loop [y y used 0 out []]
     (if (or (>= y limit) (> (+ used (size-of (nth slots y))) budget)) out
       (recur (inc y) (+ used (size-of (nth slots y))) (conj out y))))))

(defn- top-for-bottom
  "The first slot of a window of `budget` rows that ends with slot y."
  [slots y budget]
  (loop [t y used (size-of (nth slots y))]
    (if (or (zero? t) (> (+ used (size-of (nth slots (dec t)))) budget)) t
      (recur (dec t) (+ used (size-of (nth slots (dec t))))))))

(defn- tail-top
  "The first slot of a viewport of `budget` rows that ends with the last body
   slot (limit-1). With sticky headlines the headline over that top takes
   rows from the body, so the top is asked for again with them subtracted."
  [slots limit budget frames sticky-heads?]
  (if (zero? limit) 0
    (let [last-y (dec limit)
          t0 (top-for-bottom slots last-y budget)
          head-of (fn [t] (when sticky-heads?
                            (last (filter (fn [f] (and (:head? f) (< (:y0 f) t) (> (:y1 f) t))) frames))))
          h0 (head-of t0)
          hh (if (some? h0) (size-of (nth slots (:y0 h0))) 0)]
      (if (zero? hh) t0 (top-for-bottom slots last-y (- budget hh))))))

(defn- peek-slots
  "The slots from y (below `end`) that a body scrolled up by `frac` rows
   uncovers at its bottom edge."
  [slots y end frac]
  (loop [y y covered 0 out []]
    (if (or (>= y end) (>= covered frac)) out
      (recur (inc y) (+ covered (size-of (nth slots y))) (conj out y)))))

(defn- render-model
  "ed.main/render's view model, drawn through presentation `p`. :lines are
   today's line maps for text slots; ornament slots add {:ornament? :src :key
   :role :size}. Every line carries :vy (its row offset in the viewport);
   :frames are in viewport ROWS. A presentation with :sticky-heads? pins the
   heading of the section the viewport is inside to the top."
  [p ed]
  (let [{:keys [slots frames sticky index]} (screen-of p ed)
        n (count slots)
        h (:height (:view ed))
        cur (first (:head (c/primary ed)))
        top (:top (:view ed))
        ; docked frames (a chat composer) are always at the bottom, outside the body
        docked (filter :dock? sticky)
        dock-ys (vec (mapcat (fn [f] (range (:y0 f) (:y1 f))) docked))
        dock-h (reduce + 0 (map (fn [y] (size-of (nth slots y))) dock-ys))
        limit (if (empty? docked) n (apply min (map :y0 docked)))
        anchor (:anchor (:view ed))
        y-top (if (and (some? anchor) (= (:row anchor) top))
                (+ (first-slot-of-row slots top) (:off anchor))
                (first-slot-at-or-after slots index top))
        y-top (min y-top (max 0 (dec limit)))
        ; a sub-row offset (smooth scrolling): the anchor slot is `frac` rows
        ; scrolled past its top. Only meaningful while that anchor is in use.
        frac0 (if (and (some? anchor) (= (:row anchor) top)) (or (:sub anchor) 0) 0)
        ; the viewport that ENDS at the last body slot (a chat's "latest"): under
        ; the sticky headline the body is shorter, so ask for the top twice
        pinned? (and (:follows-tail? p) (= :end (:pin (:view ed))))
        y-tail (tail-top slots limit (- h dock-h) frames (:sticky-heads? p))
        ; a presenter may grow or shrink what is between :top and the cursor:
        ; if the cursor is on screen in TEXT space, keep it on screen here too
        yc (when (and (>= cur top) (< cur (+ top h))) (get index cur))
        yc (when (and (some? yc) (< yc limit)) yc)
        y-top (cond pinned? y-tail
                    (or (nil? yc) (zero? n)) y-top
                    (< yc y-top) yc
                    (not (some (fn [y] (= y yc)) (take-rows slots y-top (- h dock-h) limit))) (top-for-bottom slots yc (- h dock-h))
                    :else y-top)
        ; a presentation that shrinks the document fills the screen from the end
        y-top (if (and (:fill? p) (pos? limit)) (min y-top y-tail) y-top)
        ; the heading of the section the top is inside (scrolled past) sticks
        head (when (:sticky-heads? p)
               (last (filter (fn [f] (and (:head? f) (< (:y0 f) y-top) (> (:y1 f) y-top))) frames)))
        head-ys (if (some? head) [(:y0 head)] [])
        head-h (reduce + 0 (map (fn [y] (size-of (nth slots y))) head-ys))
        ; sticky (not docked) frames below the viewport pin to its bottom edge
        floating (filter (fn [f] (not (:dock? f))) sticky)
        all-pin-h (+ dock-h (reduce + 0 (map (fn [f] (reduce + 0 (map (fn [y] (size-of (nth slots y))) (range (:y0 f) (:y1 f))))) floating)))
        probe (take-rows slots y-top (- h head-h all-pin-h) limit)
        probe-end (if (empty? probe) y-top (inc (last probe)))
        pinned (filter (fn [f] (>= (:y0 f) probe-end)) floating)
        pin-ys (vec (concat (mapcat (fn [f] (range (:y0 f) (:y1 f))) pinned) dock-ys))
        pin-h (reduce + 0 (map (fn [y] (size-of (nth slots y))) pin-ys))
        body-end (if (empty? pinned) limit (min limit (:y0 (first pinned))))
        body (take-rows slots y-top (- h head-h pin-h) body-end)
        body-used (reduce + 0 (map (fn [y] (size-of (nth slots y))) body))
        ; Smooth scrolling: the view is `frac` rows past the top slot. The body
        ; moves up by that much (the host does it), so the slots just below it
        ; PEEK in; they are listed last (the host takes them out of flow).
        frac (if (or pinned? (empty? body) (>= (inc (last body)) body-end)) 0 frac0)
        peek (if (pos? frac) (peek-slots slots (inc (last body)) body-end frac) [])
        ys (vec (concat head-ys body pin-ys))
        vys (vec (reductions-of (map (fn [y] (size-of (nth slots y))) ys)))
        peek-vys (vec (reductions-of (cons (+ head-h body-used) (map (fn [y] (size-of (nth slots y))) peek))))
        shown (vec (concat (map (fn [i] [(nth ys i) (nth slots (nth ys i)) (nth vys i)]) (range (count ys)))
                           (map (fn [i] [(nth peek i) (nth slots (nth peek i)) (nth peek-vys i)]) (range (count peek)))))
        rows (vec (keep (fn [[_ s _]] (when (= :text (:kind s)) (:row s))) shown))
        ; ONE pass of today's line drawing, over exactly the rows on screen
        v (m/render-rows ed rows)
        by-row (reduce (fn [acc l] (assoc acc (:row l) l)) {} (:lines v))
        ; Rows that do not scroll with the body (the sticky headline, the docked
        ; composer) stay put; body rows move up by `frac` and are CLIPPED to the
        ; body (the part under the headline, or past its bottom edge, is hidden).
        fixed (set (concat head-ys pin-ys))
        peeked? (set peek)
        edge-top head-h
        edge-bot (+ head-h body-used)
        clip (fn [y s vy]
               (if (or (zero? frac) (contains? fixed y)) {}
                 (let [t (- vy frac) b (+ t (size-of s))
                       ct (max 0 (- edge-top t)) cb (max 0 (- b edge-bot))]
                   (cond-> {} (pos? ct) (assoc :clip-top ct) (pos? cb) (assoc :clip-bottom cb)))))
        line-of (fn [[y s vy0]]
                  (let [vy (if (contains? fixed y) vy0 (- vy0 frac))     ; the row's actual offset (may be fractional)
                        flags (merge {:fixed? (contains? fixed y) :peek? (contains? peeked? y)} (clip y s vy0))]
                    (if (= :text (:kind s))
                      (merge (assoc (get by-row (:row s)) :y y :vy vy) flags)
                      (merge {:row nil :src (:src s) :key (:key s) :y y :vy vy :ornament? true :segments (:segs s)
                              :role (:role s) :size (size-of s) :current? (= cur (:src s))} flags))))
        body-rows (- h head-h pin-h)
        ; a frame's box: fixed ends stay, scrolling ends move with the body and
        ; stay inside it
        frame-view (fn [f]
                     (let [in (filter (fn [[y _ _]] (and (>= y (:y0 f)) (< y (:y1 f)))) shown)]
                       (cond
                         (seq in)
                           (let [[y0 s0 v0] (first in) [y1 s1 v1] (last in)
                                 from (nth (first in) 2)
                                 to (+ v1 (size-of s1))
                                 from (if (contains? fixed y0) from (max edge-top (- from frac)))
                                 to (if (contains? fixed y1) to (min edge-bot (- to frac)))]
                             (when (> to from) (assoc f :from from :to to)))
                         (and (seq body) (< (:y0 f) (first body)) (> (:y1 f) (last body)))
                           (assoc f :from head-h :to (+ head-h body-rows))
                         :else nil)))]
    (assoc v
           :lines (mapv line-of shown)
           :frames (vec (keep frame-view (concat frames sticky)))
           :slot-count n
           :slot-top y-top
           ; rows the body is scrolled past its top slot (smooth scrolling)
           :frac frac
           ; the top that shows the end, and whether the pane is pinned there
           :tail-top y-tail
           :pinned? pinned?
           ; what a minimap needs: the body's slot range and the whole screen
           :slot-end (if (empty? body) y-top (inc (last body)))
           :screen {:slots slots :limit limit})))

; Drawing, scroll/reveal and a linked minimap ask for the same model. Keep a
; bounded identity memo across those consumers (and the unchanged rail), not
; just the last layout: alternating panes must not evict each other's view.
(def RENDER-CACHE-SIZE 8)
(def ^:private cached-render (memo/identity-pair RENDER-CACHE-SIZE render-model))
(defn render [p ed] (cached-render p ed))

; ─── the minimap: the whole screen, one bar per slot ────────────────────────
;
; A miniature of what the presentation lays out (not of the text): each slot
; is a bar as wide as its text, coloured by its role; headings carry their
; words. The lens is the body the viewport shows. Generic: any presentation
; has one.

(defn minimap
  "{:bars [{:role kw :w cells :size rows :label s?}] :top y :end y :limit n}."
  [p ed]
  (let [v (render p ed)
        {:keys [slots limit]} (:screen v)
        tx (:text ed)
        bar (fn [s]
              (let [txt (if (= :text (:kind s)) (t/line tx (:row s)) (join "" (map :text (:segs s))))
                    role (or (:role s) :text)]
                (merge {:role role :w (count (trim txt)) :size (or (:size s) 1) :row (slot-row s)}
                       (if (contains? #{:title :question} role) {:label (trim txt)} {}))))]
    {:bars (vec (map bar (take limit slots))) :top (:slot-top v) :end (:slot-end v) :frac (:frac v) :limit limit}))
