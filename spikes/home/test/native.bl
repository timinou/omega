; Called only by browser.py inside its private shared realm and compositor.
(ns home.native-test (:require [omega.desktop :as desktop] [omega.ui.probe :as probe]
                              [wry] [bl.json :as json]))
(defn ensure! [value message]
  (when-not (and value (not= value :timeout) (not (and (map? value) (get value "error"))))
    (throw (ex-info message {:value value}))) value)
(let [session (probe/attach) root (System/get_env "HOME_TEST_PROOF")
      inbox (spawn (fn [] (loop [owner nil]
                     (receive [:to p] (recur p)
                              :stop nil
                              message (do (when owner (erlang/send owner message)) (recur owner))))))
      window (desktop/open! (str (System/get_env "HOME_TEST_URL") "/?use=home&layout=home&file=workspace:all")
                           {:on-message #(erlang/send inbox [:omega/page (json/decode %)])})
      view {:window window :inbox inbox :session session} results (atom [])
      check (fn [js message] (ensure! (probe/wait-for view js 90000) message) (swap! results conj message))]
  (try
    (check "!!window.blEd&&!!document.querySelector('.omega-home h1')" "native Home uses the actual compiled editor")
    (probe/shot view (str root "/native-home.png"))
    (probe/query view "(document.querySelector('.omega-home nav [data-activity=work]').click(),true)")
    (check "!!document.querySelector('[data-pane=work] iframe')?.contentWindow?.blEd" "native Work viewer loads on the same host")
    (probe/shot view (str root "/native-work.png"))
    (probe/query view "(document.querySelector('.omega-home nav [data-activity=music]').click(),true)")
    (check "!!document.querySelector('[data-pane=music] iframe')?.contentDocument?.querySelector('.view-host .view-body')?.pelagic" "native Pelagic package loads")
    (probe/query view "(window.nativeMusic=document.querySelector('[data-pane=music] iframe').contentWindow,window.nativeInstrument=nativeMusic.document.querySelector('.view-host .view-body').pelagic,window.nativeReady=false,nativeInstrument.ready().then(()=>window.nativeReady=true,e=>window.nativeReadyError=String(e)),true)")
    (check "window.nativeReady||(window.nativeReadyError&&{error:window.nativeReadyError})" "native instrument graph is ready")
    (let [features (probe/query view "(()=>{const w=document.querySelector('[data-pane=music] iframe').contentWindow;return {worker:!!w.Worker,audioContext:!!w.AudioContext,audioWorklet:!!w.AudioWorkletNode,offscreenCanvas:!!w.OffscreenCanvas,webgl2:!!w.document.createElement('canvas').getContext('webgl2'),mediaRecorder:!!w.MediaRecorder,userAgent:w.navigator.userAgent};})()")]
      (File/write! (str root "/native-features.json") (json/encode features)))
    (probe/shot view (str root "/native-pelagic.png"))
    (probe/query view "(window.nativeCompiler=false,nativeInstrument.compilerReady().then(()=>window.nativeCompiler=true,e=>window.nativeCompilerError=String(e)),true)")
    (check "window.nativeCompiler||(window.nativeCompilerError&&{error:window.nativeCompilerError})" "native live compiler Worker loads")
    (probe/query view "(document.querySelector('.omega-home nav [data-activity=home]').click(),true)")
    (check "nativeMusic===document.querySelector('[data-pane=music] iframe').contentWindow&&nativeInstrument===nativeMusic.document.querySelector('.view-host .view-body').pelagic" "native Home return retains the instrument viewer")
    (probe/query view "(document.querySelector('.omega-home nav [data-activity=machine]').click(),true)")
    (check "!!document.querySelector('[data-pane=machine] iframe')?.contentDocument?.querySelector('[data-pane=observatory] .view-body')?.shadowRoot?.querySelector('h1')" "native inspector uses the existing Runtime package")
    (probe/shot view (str root "/native-inspector.png"))
    (File/write! (str root "/native.json") (json/encode {:checks @results :display (:display session) :physicalDevice false}))
    (println (str "Native Home checks: " (count @results)))
    (catch error
      (File/write! (str root "/native-failure.json") (json/encode {:checks @results :error (str error)}))
      (throw error))
    (finally (wry/close window) (erlang/send inbox :stop))))
