; One adaptive chrome; retained packages remain the working surfaces.
(ns home.main (:require [ed.core :as c] [ws.workbench :as wb]))
(def work-url "?use=present,dwim,workspace,places,references,buffers,workbench,mobile&layout=mobile&file=workspace:all")
(def music-url "?use=pelagic&layout=pelagic&file=spikes/pelagic/live-set.bl.org")
(def machine-url "?use=runtime&layout=runtime&file=runtime:overview")
(defn state [ed] (get-in ed [:pkg-state "home"] {}))
(defn put [ed k v] (assoc-in ed [:pkg-state "home" k] v))
(defn activity [ed] (or (:activity (state ed)) "work"))
(defn layout [requested]
  (let [selected (if (= requested "home") "work" requested)]
    {:name (str "home" (when-not (= requested "home") (str "-" requested)))
     :doc "One adaptive workbench with retained working buffers."
     :panes [{:id :main :doc :linked :width [:ch 0]}
             {:id :home :view [:home/surface :main] :dock :top :height 52}
             {:id :work :view [:home/work :main] :width (if (= selected "work") :fill [:ch 0])}
             {:id :music :view [:home/music :main] :width (if (= selected "music") :fill [:ch 0])}
             {:id :machine :view [:home/machine :main] :width (if (= selected "machine") :fill [:ch 0])}
             {:id :navigation :view [:home/navigation :main] :dock :bottom :height 48}]
     :links [] :focus :main}))
(defn open [ed requested]
  (if-not (contains? #{"home" "work" "music" "machine"} requested) ed
    (let [selected (if (= requested "home") "work" requested)]
      (-> ed (put :activity selected) (put (keyword (str selected "-opened")) true)
          (c/effect {:kind :frame-layout :layout (:name (layout requested)) :keep {:main [:main :origin]}})))))
(defn navigate [ed screen path]
  (if-not (contains? #{"work" "places" "buffers" "task" "document" "machine"} screen) ed
    (-> (open ed "work") (c/effect {:kind :package-host :package "home" :op :navigate :args {:screen screen :path path}}))))
(defn model
  ([ed] (model ed "chrome"))
  ([ed role]
   (let [s (state ed) selected (activity ed) source (:context s)]
     {:package "home" :role role :activity selected :error (:error s)
      :context (wb/context selected source) :screen (or (:screen source) "work")
      :destination (wb/destination selected (or (:screen source) "work"))
      :actions (when (= selected "work") (:actions source))
      :modal (if (= selected "work") (:modal source) (get-in s [:overlays selected]))
      :feedback (when (= selected (:feedback-owner s)) (:feedback s))
      :navigation (wb/navigation (:navigation s)) :profile (or (:navigation s) "full")
      :buffers wb/buffers :groups (wb/groups (:objects source) (:query s)) :query (or (:query s) "")
      :opened (vec (filter #(or (= % "work") (get s (keyword (str % "-opened")))) ["work" "music" "machine"]))})))
(defn embed [ed selected url]
  {:renderer "embed" :src (when (or (= selected "work") (get (state ed) (keyword (str selected "-opened")))) url)
   :title (get {"work" "Omega workbench" "music" "Pelagic" "machine" "Runtime"} selected selected)})
(defn action [ed name]
  (c/effect ed {:kind :package-host :package "home" :op :action :args {:activity (activity ed) :name name}}))
(defn intercept [ed ev]
  (case (:type ev)
    :home/open (open (put ed :error nil) (:activity ev))
    :home/navigate (navigate (put ed :error nil) (:screen ev) (:path ev))
    :home/context (put ed :context (:context ev))
    :home/overlay (if (contains? #{"music" "machine"} (:owner ev)) (assoc-in ed [:pkg-state "home" :overlays (:owner ev)] (:open ev)) ed)
    :home/feedback (-> ed (put :feedback-owner (:owner ev)) (put :feedback (:message ev)))
    :home/clear-feedback (put ed :feedback nil)
    :home/filter (put ed :query (:text ev))
    :home/profile (if (contains? #{"full" "scoped"} (:profile ev)) (put ed :navigation (:profile ev)) ed)
    :home/tool (if (wb/buffer (:id ev)) (open ed (:id ev)) ed)
    :home/action (action ed (:name ev))
    :home/error (put ed :error (:message ev))
    nil))
(def bl-package
  {:name "home" :doc "Omega's adaptive Lisp workbench."
   :commands {:home/open {:doc "Work" :run #(navigate % "work" "workspace:all")}
              :home/buffers {:doc "Switch working buffer" :run #(navigate % "buffers" nil)}
              :home/places {:doc "Working places" :run #(navigate % "places" "places:")}
              :home/pelagic {:doc "Open Pelagic instrument" :run #(open % "music")}
              :home/runtime {:doc "Inspect runtime" :run #(open % "machine")}
              :home/commands {:doc "Commands for the current buffer" :run #(action % "commands")}
              :home/lisp {:doc "Evaluate Lisp in the current editor" :run #(action % "lisp")}
              :home/navigation {:doc "Try the alternate navigation arrangement"
                 :run #(put % :navigation (if (= "scoped" (:navigation (state %))) "full" "scoped"))}}
   :keys {:normal {"space h h" :home/open "space h b" :home/buffers}}
   :intercept intercept :owns [:frame/layout]
   :provides {:layouts {"home" (layout "home") "home-work" (layout "work")
                        "home-music" (layout "music") "home-machine" (layout "machine")}
              :views {:home/surface #(model % "chrome") :home/navigation #(model % "navigation")
                      :home/work #(embed % "work" work-url)
                      :home/music #(embed % "music" music-url)
                      :home/machine #(embed % "machine" machine-url)}}})
