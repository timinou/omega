(ns pq.main
 (:require [ed.core :as c] [ed.text :as t] [ed.docs :as docs]
           [pp.present :as p] [pp.conv :as conv] [pp.omega :as om] [br.main :as br]))
(defn header [ed prefix]
 (some (fn [line] (when (starts-with? line prefix) (trim (subs line (count prefix))))) (take 12 (:lines (:text ed)))))
(defn desk-id [ed] (or (header ed "#+PROCUREMENT_DESK:") (get-in ed [:doc :data :desk]) (get-in ed [:pkg-state "procurement" :desk])))
(defn decision-at [ed]
 (first (filter (fn [b] (and (= "decision" (:lang b)) (<= (:from b) (first (c/cursor ed))) (< (first (c/cursor ed)) (:to b)))) (:blocks (:struct ed)))))
(defn opportunity-id [ed]
 (or (get-in ed [:doc :data :opportunity])
  (when (= "procurement/opportunity" (:type (docs/object-at ed))) (:key (docs/object-at ed)))
  (when-let [b (decision-at ed)] (:id (br/attrs (t/line (:text ed) (:from b)))))
  (when (some? (index-of (str (:path ed)) "opportunity-"))
   (:id (br/attrs (or (some (fn [line] (when (starts-with? line "#+begin_decision") line)) (:lines (:text ed))) ""))))))
(defn layout [id]
 {:name "procurement-desk" :doc "Opportunity queue, decision and accountable research."
  :panes [{:id :queue :doc (str "procurement:" id "/queue") :width [:ch 28]}
          {:id :decision :doc :linked :width :fill}
          {:id :activity :doc (str "procurement:" id "/activity") :width [:ch 28]}]
  :links [{:from :queue :on :select :to :decision :do :visit}] :focus :decision})
(def desk-layout (layout "ora"))
(defn review-layout [id opportunity]
 {:name "procurement-evidence" :doc "Requirements beside company facts and original source pages."
  :panes [{:id :requirements :doc (str "procurement:" id "/requirements/" opportunity) :width [:ch 30]}
          {:id :review :doc :linked :width [:fr 1]}
          {:id :source :view [:procurement/source :review] :width [:fr 1]}]
  :links [{:from :requirements :on :select :to :review :do :visit}] :focus :review})
(defn source-model [ed]
 {:package "procurement" :src (get-in ed [:doc :data :source])
  :label (get-in ed [:doc :data :sourceLabel]) :excerpt (get-in ed [:doc :data :excerpt])})

(defn adopt [ed]
 (if-let [id (desk-id ed)]
  (let [old (get-in ed [:pkg-state "procurement" :desk]) was-review (get-in ed [:pkg-state "procurement" :review?])
        ed (assoc-in (assoc-in ed [:pkg-state "procurement" :desk] id) [:pkg-state "procurement" :review?] (some? (get-in ed [:doc :data :requirement])))]
   (cond
    (some? (get-in ed [:doc :data :requirement])) (assoc ed :frame/layout (review-layout id (opportunity-id ed)))
    (or was-review (header ed "#+PROCUREMENT_DESK:") (and old (not= old id))) (assoc ed :frame/layout (layout id))
    :else ed)) ed))
(defn intent [ed verb args]
 (c/effect ed {:kind :intent :intent (str "procurement/" verb) :args args :then :visit-path}))
(defn run [ed operation]
 (if-let [desk (desk-id ed)] (intent ed "run" {:desk desk :operation operation :id (opportunity-id ed)})
  (c/message ed "Open a decision desk first, or create one with space p n.")))
(defn new-desk [ed]
 (docs/owned-prompt ed "procurement" "New desk ID (lowercase, hyphens): "
  (fn [ed id] (intent ed "new" {:id (trim id) :title (trim id) :from (desk-id ed)}))))
(defn ask [ed labels values done]
 (if (seq labels)
  (docs/owned-prompt ed "procurement" (first labels)
   (fn [ed value] (ask ed (rest labels) (conj values (trim value)) done)))
  (done ed values)))
(defn fresh-desk [ed]
 (ask ed ["New company desk ID: " "Company website (https): "] []
  (fn [ed v] (intent ed "new" {:id (first v) :title (first v) :website (second v)}))))
(defn view [ed name] (docs/visit ed (str "procurement:" (desk-id ed) "/" name)))
(defn review [ed]
 (if-let [id (opportunity-id ed)] (view ed (str "review/" id "/0")) (c/message ed "Open an opportunity with dossier requirements first.")))
(defn add-work [ed]
 (if-let [id (opportunity-id ed)]
  (ask ed ["Missing information: " "Owner (blank = unassigned): " "Due date YYYY-MM-DD (optional): "] []
   (fn [ed v] (intent ed "work-add" {:desk (desk-id ed) :id id :title (nth v 0) :owner (nth v 1) :due (nth v 2)})))
  (c/message ed "Open an opportunity first.")))
(defn attach-work [ed]
 (if-let [work (:key (docs/object-at ed))]
  (ask ed ["Evidence file (desks/...): " "Evidence note: "] []
   (fn [ed v] (intent ed "work-attach" {:desk (desk-id ed) :work work :file (first v) :note (second v)})))
  (c/message ed "Select a work item first.")))
(defn resolve-work [ed]
 (if-let [work (:key (docs/object-at ed))]
  (docs/owned-prompt ed "procurement" "Resolution rationale: "
   (fn [ed note] (intent ed "work-resolve" {:desk (desk-id ed) :work work :note note})))
  (c/message ed "Select a work item first.")))
(defn record-review [ed]
 (if (some? (get-in ed [:doc :data :requirement]))
  (ask ed ["Verdict: met / unknown / not-met: " "Company fact and review rationale: " "Company evidence file (required for met): "] []
   (fn [ed v] (intent ed "review" {:desk (desk-id ed) :id (opportunity-id ed)
    :index (get-in ed [:doc :data :requirement]) :verdict (nth v 0) :fact (nth v 1) :file (nth v 2)})))
  (c/message ed "Open a requirement in Evidence review first.")))
(defn decide [ed decision]
 (if-let [id (opportunity-id ed)]
  (if (and (= decision "pursue")
       (not= "true" (:pursuable (br/attrs (or (some (fn [line] (when (and (starts-with? line "#+begin_decision") (some? (index-of line (str ":id " id " ")))) line)) (:lines (:text ed))) "")))))
   (c/message ed "Resolve unknown qualification requirements before pursuing; open the qualification report.")
   (docs/owned-prompt ed "procurement" (str decision " — rationale: ")
    (fn [ed reason] (intent ed "decide" {:desk (desk-id ed) :id id :decision decision :rationale reason}))))
  (c/message ed "Open an opportunity first.")))
(defn home [ed] (docs/visit ed (str "desks/" (or (desk-id ed) "ora") "/desk.bl.org")))
(defn button [text command] {:text (str " " text " ") :kind :strong :command command})
(defn narrow-provider? [ed]
 (and (starts-with? (str (:path ed)) "procurement:")
  (or (ends-with? (str (:path ed)) "/queue") (ends-with? (str (:path ed)) "/activity") (some? (index-of (str (:path ed)) "/requirements/")))))
(defn wrapped [ed row key text kind]
 (map-indexed (fn [i s] (p/line-mark row [{:text s :kind kind}] (str key "/" i)))
  (conv/wrap text (max 16 (- (or (get-in ed [:view :cols]) (when (narrow-provider? ed) 28) 80) 6)))))
(defn decision-card [o ctx]
 (let [ed (:ed ctx) a (br/attrs (t/line (:text ed) (:from o))) rows (range (inc (:from o)) (dec (:to o))) key (:key o)]
  (p/head-card key "focus"
   (concat [(p/line-mark (:from o) [{:text (str "● " (:stage a) "   /   " (:decision a)) :kind :who}] key)]
    (mapcat (fn [r] (wrapped ed r (str key r) (t/line (:text ed) r) (if (= r (inc (:from o))) :heading-1 :prose))) rows)
    [(p/line-mark (:from o) [(button "Open" :procurement/open) (if (contains? #{"qualification-checked" "dossier-reviewed"} (:stage a)) (button "Evidence" :procurement/review) (button "Qualify dossier" :procurement/qualify)) (button "Add blocker" :procurement/add-work)] (str key "/open"))]
     (when-not (= "true" (:compact a)) [(p/line-mark (:from o) [(button "Needs info" :procurement/needs-information) (if (= "true" (:pursuable a)) (button "Pursue" :procurement/pursue) {:text (if (= "qualification-checked" (:stage a)) " Pursue · resolve unknowns " " Pursue · check first ") :kind :comment}) (button "Reject" :procurement/reject)] (str key "/decide"))])))))
(defn measure [ed]
 (max 16 (- (or (get-in ed [:view :cols]) (when (narrow-provider? ed) 28) 80) 6)))
(defn follow-link [ed]
 (let [line (t/line (:text ed) (first (c/cursor ed))) start (index-of line "[[") end (index-of line "][")]
  (if (and start end (< start end)) (docs/visit ed (subs line (+ start 2) end)) ed)))
(defn prose [o ctx]
 (p/stack (mapcat (fn [r]
  (let [line (t/line (:text (:ed ctx)) r)]
   (if (or (starts-with? line "#+USE:") (starts-with? line "#+PROCUREMENT_DESK:") (starts-with? line "#+TITLE:")) []
    (if (and (starts-with? line "[[") (some? (index-of line "][")))
     [(p/line-mark r [(button (subs line (+ 2 (index-of line "][")) (- (count line) 2)) :procurement/follow)] (str (:key o) r))]
     (wrapped (:ed ctx) r (str (:key o) r) line :prose))))) (range (:from o) (:to o)))))
(defn queue-card [o ctx]
 (p/head-card (:key o) "focus" (wrapped (:ed ctx) (:from o) (:key o) (t/line (:text (:ed ctx)) (:from o)) :strong)))
(defn doc-actions [o ctx next]
 (let [ed (:ed ctx) virtual? (narrow-provider? ed)]
  (p/stack (concat
   (when-not virtual? [(p/line-mark 0 [
    (button "Desk" :procurement/home) (button "Discover" :procurement/discover) (button "Refresh" :procurement/refresh)
    (button "Resume" :procurement/resume)] "procurement/actions")
    (p/line-mark 0 [(button "New company" :procurement/fresh) (button "Reuse" :procurement/new)
     (button "Work" :procurement/work) (button "Browsers" :procurement/sessions)
     (button "Sort" :procurement/sort)] "procurement/navigation")])
   (when (some? (get-in ed [:doc :data :requirement]))
    [(p/line-mark 0 [(button "Record review" :procurement/record-review) (button "Add blocker" :procurement/add-work)] "procurement/review-actions")])
   (when (ends-with? (str (:path ed)) "/work")
    [(p/line-mark 0 [(button "Attach evidence" :procurement/attach-work) (button "Resolve selected item" :procurement/resolve-work)] "procurement/work-actions")])
   (wrapped ed 0 "procurement/title" (or (header ed "#+TITLE:") "Procurement") :heading-1)
   (:kids (next o ctx))))))
(def decision-entry {:type :procurement/decision :match (fn [b l] (= "decision" (:lang b))) :attrs (fn [b l] (br/attrs l))})
(defn render [ed]
 (when (or (header ed "#+PROCUREMENT_DESK:") (starts-with? (str (:path ed)) "procurement:"))
  (p/render (assoc om/default-presentation :fill? false :readtable (into [decision-entry br/browser-entry] (:readtable om/default-presentation))
   :table (assoc (:table om/default-presentation) :procurement/decision decision-card :omega/browser-block br/present-browser :procurement/opportunity queue-card :procurement/requirement queue-card :procurement/work queue-card :omega/task prose :prose prose)
   :around [{:type :doc :fn doc-actions}]) ed)))
(defn open [ed]
 (if-let [id (opportunity-id ed)] (docs/visit ed (str "desks/" (desk-id ed) "/opportunity-" id ".bl.org")) ed))
(defn source? [ed]
 (and (ends-with? (str (:path ed)) "search.bl.org") (some (fn [b] (and (= "beam-lisp" (:lang b)) (<= (:from b) (first (c/cursor ed))) (< (first (c/cursor ed)) (:to b)))) (:blocks (:struct ed)))))
(def bl-package
 {:name "procurement" :doc "Loadable, evidence-based procurement decision desks." :requires ["present" "browser"]
  :commands {:procurement/review {:doc "Review a requirement with its source page." :run review}
   :procurement/record-review {:doc "Record a cited human review." :run record-review}
   :procurement/add-work {:doc "Assign missing information with a due date." :run add-work}
   :procurement/resolve-work {:doc "Resolve a work item with evidence and rationale." :run resolve-work}
   :procurement/attach-work {:doc "Attach evidence without assuming qualification." :run attach-work}
   :procurement/work {:doc "Open missing-information work." :run (fn [ed] (view ed "work"))}
   :procurement/sessions {:doc "Open this desk's browser shelf." :run (fn [ed] (view ed "sessions"))}
   :procurement/fresh {:doc "Create a fresh company desk." :run fresh-desk}
   :procurement/resume {:doc "Resume latest partial research from retained evidence." :run (fn [ed] (intent ed "resume" {:desk (desk-id ed)}))}
   :procurement/sort {:doc "Sort shortlist by deadline, blockers or verified." :run (fn [ed] (docs/owned-prompt ed "procurement" "Sort: deadline / blockers / verified: " (fn [ed value] (intent ed "sort" {:desk (desk-id ed) :sort (trim value)}))))}
   :procurement/follow {:doc "Open the file reference at the cursor." :run follow-link}
   :procurement/home {:doc "Open this decision desk." :run home}
   :procurement/open {:doc "Open the selected opportunity." :run open}
   :procurement/new {:doc "Create a separate desk, reusing profile and curated functions." :run new-desk}
   :procurement/discover {:doc "Run bounded official-source discovery." :run (fn [ed] (run ed "discover"))}
   :procurement/refresh {:doc "Reuse curated functions and preserve change history." :run (fn [ed] (run ed "refresh"))}
   :procurement/qualify {:doc "Read dossier and compare to sourced qualification facts." :run (fn [ed] (run ed "qualify"))}
   :procurement/needs-information {:doc "Record missing information with rationale." :run (fn [ed] (decide ed "needs-information"))}
   :procurement/pursue {:doc "Record pursue after qualification check." :run (fn [ed] (decide ed "pursue"))}
   :procurement/reject {:doc "Record rejection with rationale." :run (fn [ed] (decide ed "reject"))}}
  :keys {:normal {"space p h" :procurement/home "space p n" :procurement/new "space p d" :procurement/discover "space p r" :procurement/refresh "space p q" :procurement/qualify "space p i" :procurement/needs-information "space p y" :procurement/pursue "space p x" :procurement/reject}}
  :intercept (fn [ed ev] (when (and (= :key (:type ev)) (= "C-Enter" (:key ev)))
    (cond (source? ed) (run ed "refresh")
     (= "procurement/requirement" (:type (docs/object-at ed))) (docs/visit ed (:path (docs/object-at ed)))
     (= "omega/browser" (:type (docs/object-at ed))) (docs/visit ed (str "browser:" (:key (docs/object-at ed))))
     (= "procurement/opportunity" (:type (docs/object-at ed))) (open ed)
     (some? (decision-at ed)) (open ed)
     :else nil)))
  :adopt adopt :owns [:frame/layout] :render render
  :provides {:views {:procurement/source source-model}
   :layouts {"procurement-desk" desk-layout "procurement-evidence" (review-layout "ora" "onmt-qlik")}
   :links {"procurement/requirement" (fn [o] (:path o))
    "procurement/opportunity" (fn [o] (or (:path o) (str "desks/" (:desk o) "/opportunity-" (:key o) ".bl.org")))}}})
