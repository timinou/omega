(ns atlas-context-test (:require [atlas.context :as c]))
(def source (File/read! (str (System/get_env "OMEGA_HOME") "/spikes/atlas/desk.bl.org")))
(def original (json/decode (nth (re-find #"(?ms)^#\+begin_atlas\s*\n(.*?)^#\+end_atlas" source) 1)))
(def compact (c/text source))
(def d (json/decode compact))
(assert (= "information-diffusion-v2" (get-in d ["revision" "id"])))
(assert (= (get original "evidence") (get d "evidence")))
(assert (= 4 (count (get-in d ["movement" "windows"]))))
(assert (not (contains? d "data")))
(assert (< (count compact) (count source)))
(assert (= (get original "gates") (get (json/decode (c/readiness source)) "gates")))
(println (str "Current notebook Gen context: " (count source) " -> " (count compact) " characters; evidence and current gates retained."))
