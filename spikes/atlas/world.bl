; Optional network-backed Gen review world; always an isolated /tmp root.
(ns atlas.world (:require [omega.ed.main :as editor] [atlas.review :as review]))
(def home (System/get_env "OMEGA_HOME"))
(def root (System/get_env "ATLAS_WORLD"))
(when-not (and root (String/starts_with? root "/tmp/omega-atlas."))
 (throw (ex-info "Atlas Gen world requires an isolated /tmp/omega-atlas.* root" {})))
(def world (editor/start! {:root root :port (erlang/binary_to_integer (or (System/get_env "ATLAS_PORT") "8831")) :memory? true :step (review/step root home)}))
(println (str "Atlas Gen review: " (:url world) "?file=spikes/atlas/desk.bl.org&use=atlas"))
(receive :never nil)
