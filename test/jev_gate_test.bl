(ns jev-gate-test
  (:require [omega.env :as env] [omega.trace :as tr]
            [omega.task :as task]
            [omega.loop :as loop]
            [omega.codemode :as cm]
            [omega.ext :as ext]
            [omega.jev :as jev]
            [omega.ext.jev-gate :as gate]))

;; Live answers recorded once (test/tapes/jev-probe.tape) — replayed here, offline.
(def tape (jev/cassette (fn [_] {:error {:kind :offline}}) "test/tapes/jev-probe.tape" :replay))

(def charter "Task t-1 · goal: make the beam-lisp reader accept 0x hex integer literals. Scope: src/reader.bl, test/reader_test.bl.")

(deftest recorded-scope-verdicts-replay
  (is (= :in-scope (:value (jev/decide tape gate/scope-decl {:charter charter :message "Also accept uppercase 0X prefixes."})))))

(deftest a-transport-that-says-not-done-turns-done-back-into-work
  (let [jev-no (fn [_] {:ok {"answers" {"met" {"type" "noul" "noul" 0.05}}}})
        sys (ext/install (task/start-system (env/open) {:tools cm/tools :root "/tmp"
                                                        :step (loop/scripted [(loop/call-tool "eval" {:code "(done \"done!\")"})
                                                                              (fn [req] (loop/say (get-in (last (:messages req)) [:content 0 :content])))])})
                         [(gate/extension {:transport jev-no})])
        id (task/open! sys {:goal "fix it"})
        v (task/await sys id 5000)]
    (is (= :idle (:status v)) "the task did not close")
    (is (starts-with? (:result v) "not done yet"))
    (task/stop-system! sys)))

(deftest when-jev-fails-done-stands
  (let [sys (ext/install (task/start-system (env/open) {:tools cm/tools :root "/tmp"
                                                        :step (loop/scripted [(loop/call-tool "eval" {:code "(done \"done!\")"})])})
                         [(gate/extension {:transport (fn [_] {:error {:kind :overloaded}})})])
        id (task/open! sys {:goal "fix it"})]
    (is (= :done (:status (task/await sys id 5000))))
    (task/stop-system! sys)))

