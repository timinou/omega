(ns omega.org-list-test (:require [omega.org-list :as org-list]))
(deftest stars-belong-to-outline-or-list-according-to-native-indentation
 (is (nil? (org-list/marker "* An outline heading")))
 (is (= {:lead "  " :indent 2 :marker "*" :ordered? false :ordinal nil :ordinal-value nil :counter nil :counter-value nil
         :checkbox nil :type "bullet" :prefix-bytes 4 :text "A nested item" :checked false}
        (org-list/marker "  * A nested item")))
 (is (= 8 (:indent (org-list/marker "\t- Tab-indented item")))))
(deftest ordered-counter-and-checkbox-remain-independent-native-fields
 (let [item (org-list/marker "12) [@20] [-] A mixed item\r")]
  (is (= "12)" (:marker item)))
  (is (= "12" (:ordinal item)))
  (is (= "20" (:counter item)))
  (is (= "mixed" (:checkbox item)))
  (is (= "task" (:type item)))
  (is (false? (:checked item)))
  (is (= "  12) [@20] [-] " (org-list/prefix item 2)))
  (is (= "  3) [@20] [-] " (org-list/prefix (assoc item :ordinal "3") 2)))
  (is (= "A mixed item" (:text item)))))
(deftest list-text-keeps-description-separators-and-inline-syntax
 (is (= "Person :: A *rich* description." (:text (org-list/marker "+ Person :: A *rich* description."))))
 (is (= "" (:text (org-list/marker "- [ ]")))))
(deftest marker-rendering-refuses-structural-prefix-injection
 (doseq [item [{:marker "*"} {:marker "-\n*"} {:marker "-" :counter "2]\n*"}
               {:marker "-" :checkbox "unknown"}]]
  (is (thrown? (org-list/prefix item 0))))
 (is (thrown? (org-list/prefix {:marker "-"} -1))))

(deftest list-reader-builds-hierarchy-continuations-and-source-owned-child-blocks
 (let [source "- First 🌱\r\n  soft continuation\r\n  + Child\r\n\r\n  A second paragraph.\r\n\r\n  #+name: literal\r\n  #+begin_src org\r\n* A literal heading inside the cell\r\n  #+end_src\r\n  | Name | Count |\r\n  | A | 2 |\r\n- [@3] [-] Next\r\n\r\nAfter the list.\r\n"
       lines (vec (String/split source "\n")) result (org-list/read-at lines 0 "list") blocks (:blocks result)
       reconstructed (join "" (map #(str (:prefix %) (:raw %)) blocks))
       expected (str (join "\n" (subvec lines 0 13)) "\n")]
  (is (= 13 (:to result)))
  (is (= ["bullet" "bullet" "paragraph" "org-retained" "org-retained" "task"] (mapv :type blocks)))
  (is (= [nil "list" "list" "list" "list" nil] (mapv :parent blocks)))
  (is (= "First 🌱 soft continuation" (:text (first blocks))))
  (is (= "mixed" (get-in (last blocks) [:list :checkbox])))
  (is (= "3" (get-in (last blocks) [:list :counter])))
  (is (= "src" (:kind (nth blocks 3))))
  (is (= "\r\n  #+name: literal\r\n" (:prefix (nth blocks 3))))
  (is (= "table" (:kind (nth blocks 4))))
  (is (= expected reconstructed))
))
