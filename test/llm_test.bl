(ns llm-test
  (:require [omega.llm :as llm]))

(def p (llm/provider {:kind :anthropic}))

(deftest the-body-carries-identity-then-omega-system-and-tools
  (let [b (llm/anthropic-body p {:system "be omega"
                                 :messages [{:role :user :content [{:type :text :text "hi"}]}]
                                 :tools [{:name "read" :description "d" :input-schema {:type "object"}}]})]
    (is (= ["You are Claude Code, Anthropic's official CLI for Claude." "be omega"] (map :text (:system b))))
    (is (= "claude-sonnet-5-5" (:model b)))
    (is (= [{:role "user" :content [{:type "text" :text "hi"}]}] (:messages b)))
    (is (= "read" (:name (first (:tools b)))))))

(deftest tool-use-and-results-round-trip-the-wire
  (let [b (llm/anthropic-body p {:messages [{:role :assistant :content [{:type :tool-use :id "x" :name "read" :input {:path "a"}}]}
                                            {:role :user :content [{:type :tool-result :id "x" :content "ok" :error? false}]}]})]
    (is (= {:type "tool_use" :id "x" :name "read" :input {:path "a"}} (get-in b [:messages 0 :content 0])))
    (is (= {:type "tool_result" :tool_use_id "x" :content "ok" :is_error false} (get-in b [:messages 1 :content 0])))))

(deftest a-response-becomes-neutral-blocks
  (let [r (llm/anthropic-response
           {"content" [{"type" "thinking" "thinking" ""}
                       {"type" "text" "text" "reading"}
                       {"type" "tool_use" "id" "toolu_1" "name" "read" "input" {"path" "a.txt"}}]
            "stop_reason" "tool_use"
            "usage" {"input_tokens" 10 "output_tokens" 5 "cache_read_input_tokens" 2}})]
    (is (= [{:type :text :text "reading"} {:type :tool-use :id "toolu_1" :name "read" :input {:path "a.txt"}}] (:content r)))
    (is (= :tool-use (:stop r)))
    (is (= {:input 10 :output 5 :cache-read 2} (select-keys (:usage r) [:input :output :cache-read])))))

(deftest jsonable-turns-vectors-and-keywords-into-json-shapes
  (is (= {"a" (list 1 "b") "c" :null} (llm/jsonable {:a [1 :b] :c nil}))))

(deftest jsonable-keeps-every-key-and-json-null
  ;; a tool input with a :meta key crashed every later request of its task;
  ;; a JSON null came back to the model as the string "null"
  (is (= {"meta" {"x" 1} "a" 2} (llm/jsonable {:meta {:x 1} :a 2})))
  (is (= {"x" :null "y" (list :null)} (llm/jsonable {:x :null :y [:null]}))))

(deftest cassettes-record-then-replay-and-fail-loud-on-a-miss
  (let [path (str "/tmp/omega-cassette-" (erlang/unique_integer (to-list [:positive])) ".tape")
        calls (atom 0)
        inner (fn [req] (swap! calls inc) {:content [{:type :text :text (str "n" @calls)}] :stop :end})
        req {:messages [{:role :user :content [{:type :text :text "hi"}]}]}
        rec (llm/cassette inner path :record)]
    (is (= "n1" (get-in (rec req) [:content 0 :text])))
    (let [play (llm/cassette inner path :replay)]
      (is (= "n1" (get-in (play req) [:content 0 :text])))
      (is (= 1 @calls) "replay never calls the model")
      (is (= :cassette-miss (get-in (play (assoc req :system "changed")) [:error :kind]))))))

(deftest max-tokens-setting-parses-strictly
  (is (= {:ok nil} (llm/parse-max-tokens nil)))
  (is (= {:ok nil} (llm/parse-max-tokens "  ")))
  (is (= {:ok 32000} (llm/parse-max-tokens "32000")))
  (is (= {:ok 128000} (llm/parse-max-tokens " 128000 ")))
  (doseq [bad ["0" "-5" "12.5" "abc" "8k" "128001" "99999999" "1e5"]]
    (is (some? (:error (llm/parse-max-tokens bad))) (str "rejects " bad)))
  (is (includes? (:error (llm/parse-max-tokens "sk-secret-value")) "OMEGA_MAX_TOKENS"))
  (is (not (includes? (:error (llm/parse-max-tokens "sk-secret-value")) "sk-secret")) "the rejected text is never echoed"))

(defn- env-root! [content]
  (let [r (str "/tmp/omega-llm-env-" (erlang/unique_integer (to-list [:positive])))]
    (File/mkdir_p! r)
    (when content (File/write! (str r "/.env") content))
    r))

(deftest from-env-reads-max-tokens-with-a-deliberate-default
  (when (nil? (System/get_env "OMEGA_MAX_TOKENS"))
    (is (= 8000 (:max-tokens (llm/from-env (env-root! "OMEGA_MODEL=m\n")))) "unset keeps the default")
    (is (= 8000 (:max-tokens (llm/from-env (env-root! nil))))))
  (let [p (llm/from-env (env-root! "OMEGA_MAX_TOKENS=32000\n"))]
    (is (= 32000 (:max-tokens p)))
    (is (= 32000 (:max_tokens (llm/anthropic-body p {:messages []}))) "and it reaches the wire")))

(deftest from-env-rejects-an-invalid-max-tokens-loudly-without-leaking-it
  (doseq [bad ["0" "-1" "lots" "999999999"]]
    (let [r (try (llm/from-env (env-root! (str "OMEGA_MAX_TOKENS=" bad "\nANTHROPIC_API_KEY=sk-ant-secret\n")))
                 :no-error
                 (catch err (ex-message err)))]
      (is (string? r) (str "throws for " bad))
      (when (string? r)
        (is (includes? r "OMEGA_MAX_TOKENS"))
        (is (not (includes? r "sk-ant-secret")))))))

(deftest a-cut-off-tool-input-streams-into-an-empty-input-not-a-crash
  (let [sse (omega.llm.sse/response
             (reduce omega.llm.sse/fold omega.llm.sse/empty-acc
                     [{"type" "content_block_start" "index" 0 "content_block" {"type" "tool_use" "id" "tu1" "name" "eval"}}
                      {"type" "content_block_delta" "index" 0 "delta" {"type" "input_json_delta" "partial_json" "{\"code\": \"(writ"}}
                      {"type" "message_delta" "delta" {"stop_reason" "max_tokens"} "usage" {"output_tokens" 8000}}]))]
    (is (= :max-tokens (:stop sse)))
    (is (= {} (:input (first (:content sse)))))))
