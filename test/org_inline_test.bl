(ns omega.org-inline-test (:require [omega.org-inline :as inline] [omega.org-canvas :as canvas] [omega.org-semantics :as semantics] [omega.org-heading-model :as heading] [omega.org-presentation :as presentation] [live.edit.registry :as registry]))
(deftest native-marks-and-links-project-to-rich-data
 (let [source "Bold *مرحبا* and /gentle/ [[https://example.org][a link]] [[highlight:mint][useful]]."
       parsed (inline/read-text source "inline")]
  (is (= "Bold مرحبا and gentle a link useful." (:text parsed)))
  (is (= #{"text/bold" "text/emphasis" "text/link" "text/highlight"} (set (map #(get-in % [:call :function]) (:marks parsed)))))
  (is (= "مرحبا" (unicode/characters_to_binary (to-list (subvec (vec (unicode/characters_to_list (:text parsed))) 5 10)))))
  (is (= source (canvas/write-source (canvas/read-source source "doc"))))))
(deftest unsupported-links-stay-readable-source-and-code-is-literal
 (is (= "[[retired:elsewhere][Other]]" (:text (inline/read-text "[[retired:elsewhere][Other]]" "x"))))
 (let [parsed (inline/read-text "Use ~*literal*~ here." "x")]
  (is (= "Use *literal* here." (:text parsed)))
  (is (= ["text/code"] (mapv #(get-in % [:call :function]) (:marks parsed))))))
(deftest native-references-keep-labels-and-exact-source-with-portable-navigation
 (let [text "[[id:method]] and [[file:Café & plans.bl.org::#first][The *plan*]]."
       projected (inline/read-text text "rich")
       [bare labeled] (:marks projected)
       target (get-in labeled [:call :args :target])
       [tag attrs display] (registry/present (registry/functions [presentation/package]) (:call labeled) "inline" "The plan")]
  (is (= "id:method and The plan." (:text projected)))
  (is (= {:target "id:method"} (get-in bare [:call :args])))
  (is (= "org/reference" (get-in labeled [:call :function])))
  (is (= text (inline/write-text projected)))
  (is (= text (canvas/write-source (canvas/read-source text "doc"))))
  (is (= target (:data-org-reference attrs)))
  (is (= :a tag))
  (is (= "The plan" display))
  (is (includes? (:href attrs) "%C3%A9%20%26"))))
(deftest formatted-edits-serialize-native-org-and-readable-callout-annotations
 (let [doc (canvas/read-source "#+title: Notes\n\n*Bold* text.\n" "note")
       next (-> doc (assoc-in [:blocks 0 :text] "Changed text.") (assoc-in [:blocks 0 :marks 0 :to] 7))
       written (canvas/write-source next)]
  (is (= "#+title: Notes\n\n*Changed* text.\n" written))
  (is (= "Changed text." (get-in (canvas/read-source written "again") [:blocks 0 :text]))))
 (let [doc (canvas/read-source "#+title: Notes\n\nPay attention.\n" "note")
       call {:id "note-callout" :function "text/callout" :version 1 :args {:tone "warning"}}
       written (canvas/write-source (assoc-in doc [:blocks 0 :wraps] [call]))
       read (canvas/read-source written "again")]
  (is (includes? written "#+attr_enchant: :callout warning\nPay attention."))
  (is (= "warning" (get-in read [:blocks 0 :wraps 0 :args :tone])))
  (is (= written (canvas/write-source read)))
  (is (= "#+title: Notes\n\nPay attention.\n" (canvas/write-source (assoc-in read [:blocks 0 :wraps] []))))))

(deftest partial-word-crossing-and-literal-syntax-use-readable-org-affiliations
 (let [semantic (fn [block] [(:text block) (mapv (fn [m] [(:from m) (:to m) (select-keys (:call m) [:function :version :args])]) (:marks block))])
       mark (fn [id from to function] {:from from :to to :call {:id id :function function :version 1 :args {}}})]
  (doseq [marks [[(mark "part" 1 4 "text/bold")]
                [(mark "bold" 0 4 "text/bold") (mark "cross" 2 6 "text/emphasis")]
                [(mark "code" 0 6 "text/code") (mark "bold" 1 4 "text/bold")]]]
   (let [doc (-> (canvas/read-source "abcdef.\r\n" "marks") (assoc-in [:blocks 0 :marks] marks))
         written (canvas/write-source doc) reread (canvas/read-source written "again")]
    (is (includes? written "#+attr_enchant: :inline "))
    (is (= (semantic (first (:blocks doc))) (semantic (first (:blocks reread)))))
    (is (= written (canvas/write-source reread)))
    (let [plain (canvas/write-source (assoc-in reread [:blocks 0 :marks] []))]
     (is (= "abcdef.\r\n" plain)))))
  (let [doc (assoc-in (canvas/read-source "A sentence.\n" "literal") [:blocks 0 :text] "Keep *literal* markers.")
        written (canvas/write-source doc)]
   (is (includes? written "#+attr_enchant: :inline []"))
   (is (= "Keep *literal* markers." (get-in (canvas/read-source written "literal-again") [:blocks 0 :text]))))))
(deftest invalid-inline-annotations-are-retained-without-running-their-forms
 (doseq [declaration ["(File/write! \"/tmp/should-not-exist\" \"no\")" "[{:from 0 :to 900 :function \"text/bold\" :version 1 :args {}}]"]]
  (let [source (str "#+attr_enchant: :inline " declaration "\nText.\n") doc (canvas/read-source source "invalid")]
   (is (= "org-retained" (get-in doc [:blocks 0 :type])))
   (is (= source (canvas/write-source doc))))))

(defn heading-signature [doc]
 (let [block (first (:blocks doc))]
  [(:text block) (inline/mark-data (:marks block))
   (select-keys (inline/heading-fields block (get-in doc [:meta :org/workflow])) [:title :state :priority :tags])]))
(deftest native-rich-literals-keep-native-heading-meaning-and-bytes
 (doseq [[body expected] [["*TODO* Literal" {:title "TODO Literal" :state nil :priority nil :tags []}]
                         ["TODO *[#27]* Literal" {:title "[#27] Literal" :state "TODO" :priority nil :tags []}]
                         ["TODO Literal *:work:*" {:title "Literal :work:" :state "TODO" :priority nil :tags []}]
                         ["*TODO* [#27] Literal" {:title "TODO [#27] Literal" :state nil :priority nil :tags []}]
                         ["TODO [#27] *Rich* :work:" {:title "Rich" :state "TODO" :priority "27" :tags ["work"]}]]]
  (let [source (str "* " body "\r\n:PROPERTIES:\r\n:ID: heading\r\n:CUSTOM: retain\r\n:END:\r\n")
        doc (canvas/read-source source "literal") block (first (:blocks doc))
        expected-row (update expected :tags set)
        parsed (first (:objects (semantics/read-source source)))
        changed (assoc-in doc [:blocks 0 :text] (String/replace (:text block) "Literal" "Revised"))
        written (canvas/write-source changed) reread (canvas/read-source written "again")]
   (is (= expected (last (heading-signature doc))))
   (is (= expected-row (select-keys parsed [:title :state :priority :tags])))
   (is (= source (canvas/write-source doc)))
   (is (= (heading-signature changed) (heading-signature reread)))
   (is (ends-with? written ":ID: heading\r\n:CUSTOM: retain\r\n:END:\r\n")))))
(deftest formatting-real-metadata-does-not-turn-it-into-a-literal
 (doseq [[from to] [[0 4] [1 3]]]
  (let [source "* TODO [#27] Rich :work:\n:PROPERTIES:\n:ID: heading\n:END:\n"
        doc (canvas/read-source source "actual")
        next (assoc-in doc [:blocks 0 :marks] [{:from from :to to :call {:id "bold" :function "text/bold" :version 1 :args {}}}])
        written (canvas/write-source next) reread (canvas/read-source written "again")
        object (first (:objects (semantics/read-source written)))]
   (is (includes? written "#+attr_enchant: :inline "))
   (is (= (heading-signature next) (heading-signature reread)))
   (is (= {:state "TODO" :priority "27" :tags #{"work"} :title "Rich"}
          (select-keys object [:state :priority :tags :title])))
   (is (= written (canvas/write-source reread))))))
(deftest explicit-literal-affiliation-and-protected-workflow
 (let [source "#+TODO: READY(r) | FINISHED(f)\r\n* READY literal\r\n:PROPERTIES:\r\n:ID: literal\r\n:END:\r\n"
       doc (canvas/read-source source "literal")
       next (assoc-in doc [:blocks 0 :marks] [{:from 0 :to 5 :call {:id "literal" :function "org/literal" :version 1 :args {}}}])
       written (canvas/write-source next) reread (canvas/read-source written "again")
       object (first (:objects (semantics/read-source written)))]
  (is (= ["READY"] (get-in doc [:meta :org/workflow :open])))
  (is (= ["FINISHED"] (get-in doc [:meta :org/workflow :done])))
  (is (= (heading-signature next) (heading-signature reread)))
  (is (nil? (:state object)))
  (is (= "READY literal" (:title object)))
  (is (thrown? (canvas/write-source (assoc-in doc [:meta :org/workflow :open] ["OTHER"])))))
 (let [source "* TODO *Rich*\n:PROPERTIES:\n:ID: rich\n:END:\n"]
  (is (= source (semantics/update-object source "rich" {:title "Rich"})))
  (is (= (String/replace source "TODO" "DONE") (semantics/update-object source "rich" {:done? true}))))
 (let [source "#+attr_enchant: :inline [{:from 0 :to 999 :function \"org/literal\" :version 1 :args {}}]\n* TODO Broken\n"]
  (is (some #(= :inline-annotation (:code %)) (:diagnostics (semantics/read-source source))))))
