(ns omega.org-canvas-test (:require [omega.org-canvas :as canvas]))
(def source "#+title: Native 🌿\r\n\r\n* TODO Review :project:\r\n:PROPERTIES:\r\n:ID: review\r\n:END:\r\nSCHEDULED: <2026-11-16 Mon>\r\nBody text.\r\n\r\n#+begin_src beam-lisp\r\n(+ 1 1)\r\n#+end_src\r\n\r\n- [ ] Check this\r\n#+begin_unknown\r\nKeep everything\r\n#+end_unknown\r\n")
(deftest native-projection-roundtrip-and-protected-source
 (let [doc (canvas/read-source source "native") next (assoc-in doc [:blocks 1 :text] "مرحبا")]
  (is (= source (canvas/write-source doc)))
  (is (= (String/replace source "Body text." "مرحبا") (canvas/write-source next)))
  (is (= (String/replace source "[ ]" "[X]") (canvas/write-source (assoc-in doc [:blocks 3 :attrs :checked] true))))
  (is (thrown? (canvas/write-source (assoc-in doc [:meta :org/tail] ""))))
  (is (= source (canvas/write-source (canvas/read-source source "another-session"))))))
(deftest empty-and-unterminated-source-stay-exact
 (doseq [text ["" "#+title: Empty\n" "No trailing newline" "* Heading\nText\n\n"]]
  (is (= text (canvas/write-source (canvas/read-source text "x"))))))
(deftest metadata-stays-outside-empty-writing-and-with-its-heading
 (let [source "#+title: New note\n\n" doc (canvas/read-source source "note")
       next (assoc-in doc [:blocks 0 :text] "Write here.")]
  (is (= source (canvas/write-source doc)))
  (is (= (str source "Write here.\n") (canvas/write-source next))))
 (let [source "* TODO First\n:PROPERTIES:\n:ID: first\n:END:\n* TODO Second\n:PROPERTIES:\n:ID: second\n:END:\n"
       doc (canvas/read-source source "tasks") moved (update doc :blocks #(vec (reverse %)))]
  (is (= "* TODO Second\n:PROPERTIES:\n:ID: second\n:END:\n* TODO First\n:PROPERTIES:\n:ID: first\n:END:\n" (canvas/write-source moved)))))
(deftest native-code-and-quotes-are-editable-with-original-headers
 (let [source "#+title: Cells\n\n#+name: calculation\n#+begin_src beam-lisp :results value :id sum\n(+ 1 1)\n#+end_src\n#+RESULTS:\n: 2\n\n#+begin_quote\nA thoughtful /reply/.\n#+end_quote\n"
       doc (canvas/read-source source "cells")
       next (assoc-in doc [:blocks 0 :text] "(+ 2 2)")]
  (is (= ["code" "paragraph" "quote"] (mapv :type (:blocks doc))))
  (is (= source (canvas/write-source doc)))
  (is (= (String/replace source "(+ 1 1)" "(+ 2 2)") (canvas/write-source next)))
  (is (includes? (canvas/write-source (assoc-in doc [:blocks 0 :attrs :language] "python")) "#+begin_src python :results value :id sum"))
  (is (thrown? (canvas/write-source (assoc-in doc [:blocks 0 :text] "#+end_src\nInjected"))))))

(deftest new-work-identities-are-stable-within-an-editor-and-fresh-after-source-reset
 (let [heading (fn [id] (-> (canvas/read-source "" id) (assoc-in [:blocks 0 :type] "heading")
                           (assoc-in [:blocks 0 :attrs :level] 1) (assoc-in [:blocks 0 :text] "TODO New work")))
       first-source (canvas/write-source (heading "first-editor") "shared-document")
       second-source (canvas/write-source (heading "second-editor") "shared-document")
       id (fn [text] (second (re-find #":ID: ([^\n]+)" text)))]
  (is (string? (id first-source)))
  (is (= first-source (canvas/write-source (heading "first-editor") "shared-document")))
  (is (not= (id first-source) (id second-source)))
  (is (= first-source (canvas/write-source (canvas/read-source first-source "third-editor") "shared-document")))))
