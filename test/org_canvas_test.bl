(ns omega.org-canvas-test (:require [omega.org-canvas :as canvas] [omega.document-source :as source]))
(def source "#+title: Native 🌿\r\n\r\n* TODO Review :project:\r\n:PROPERTIES:\r\n:ID: review\r\n:END:\r\nSCHEDULED: <2026-11-16 Mon>\r\nBody text.\r\n\r\n#+begin_src beam-lisp\r\n(+ 1 1)\r\n#+end_src\r\n\r\n- [ ] Check this\r\n#+begin_unknown\r\nKeep everything\r\n#+end_unknown\r\n")
(deftest native-projection-roundtrip-and-protected-source
 (let [doc (canvas/read-source source "native") next (assoc-in doc [:blocks 1 :text] "مرحبا")]
  (is (= source (canvas/write-source doc)))
  (is (= (String/replace source "Body text." "مرحبا") (canvas/write-source next)))
  (is (= (String/replace source "[ ]" "[X]") (canvas/write-source (assoc-in doc [:blocks 3 :attrs :checked] true))))
  (is (thrown? (canvas/write-source (assoc-in doc [:meta :org/tail] "Tampered tail"))))
  (is (= source (canvas/write-source (canvas/read-source source "another-session"))))))
(deftest empty-and-unterminated-source-stay-exact
 (doseq [text ["" "#+title: Empty\n" "No trailing newline" "* Heading\nText\n\n"]]
  (is (= text (canvas/write-source (canvas/read-source text "x"))))))
(deftest metadata-stays-outside-empty-writing-and-with-its-heading
 (let [source "#+title: New note\n\n" doc (canvas/read-source source "note")
       next (assoc-in doc [:blocks 0 :text] "Write here.")]
  (is (= source (canvas/write-source doc)))
  (is (= (str source "Write here.\n") (canvas/write-source next))))
 (let [source "* TODO First\n:PROPERTIES:\n:ID: first\n:END:\n* TODO Second\n:PROPERTIES:\n:ID: second\n:END:\n"
       doc (canvas/read-source source "tasks") moved (update doc :blocks #(vec (reverse %)))]
  (is (= "* TODO Second\n:PROPERTIES:\n:ID: second\n:END:\n* TODO First\n:PROPERTIES:\n:ID: first\n:END:\n" (canvas/write-source moved)))))
(deftest native-code-and-quotes-are-editable-with-original-headers
 (let [source "#+title: Cells\n\n#+name: calculation\n#+begin_src beam-lisp :results value :id sum\n(+ 1 1)\n#+end_src\n#+RESULTS:\n: 2\n\n#+begin_quote\nA thoughtful /reply/.\n#+end_quote\n"
       doc (canvas/read-source source "cells")
       next (assoc-in doc [:blocks 0 :text] "(+ 2 2)")]
  (is (= ["code" "paragraph" "quote"] (mapv :type (:blocks doc))))
  (is (= source (canvas/write-source doc)))
  (is (= (String/replace source "(+ 1 1)" "(+ 2 2)") (canvas/write-source next)))
  (is (includes? (canvas/write-source (assoc-in doc [:blocks 0 :attrs :language] "python")) "#+begin_src python :results value :id sum"))
  (is (thrown? (canvas/write-source (assoc-in doc [:blocks 0 :text] "#+end_src\nInjected"))))))

(deftest new-work-identities-are-stable-within-an-editor-and-fresh-after-source-reset
 (let [heading (fn [id] (-> (canvas/read-source "" id) (assoc-in [:blocks 0 :type] "heading")
                           (assoc-in [:blocks 0 :attrs :level] 1) (assoc-in [:blocks 0 :text] "TODO New work")))
       first-source (canvas/write-source (heading "first-editor") "shared-document")
       second-source (canvas/write-source (heading "second-editor") "shared-document")
       id (fn [text] (second (re-find #":ID: ([^\n]+)" text)))]
  (is (string? (id first-source)))
  (is (= first-source (canvas/write-source (heading "first-editor") "shared-document")))
  (is (not= (id first-source) (id second-source)))
  (is (= first-source (canvas/write-source (canvas/read-source first-source "third-editor") "shared-document")))))

(deftest deep-native-heading-levels-survive-title-edits
 (doseq [level [1 6 7 12 40]]
  (let [stars (join "" (repeat level "*")) source (str stars " A heading\r\n:PROPERTIES:\r\n:ID: deep\r\n:END:\r\n")
        doc (canvas/read-source source "depth")]
   (is (= source (canvas/write-source doc)))
   (is (= (String/replace source "A heading" "A revised heading")
          (canvas/write-source (assoc-in doc [:blocks 0 :text] "A revised heading")))))))
(deftest retained-constructs-are-visible-exact-and-source-owned
 (doseq [source ["#+title: Retained\n\n#+begin_custom\r\nKeep 🌿 exactly\r\n#+end_custom\r\n"
                 "#+title: Retained\n| Name | Count |\n|------+-------|\n| A | 2 |\n"
                 "#+name: org-profile\n#+begin_src edn\n{:format \"org.profile/1\" :id \"empty\" :types {}}\n#+end_src\n"
                 "#+begin_unfinished\nKeep this too"]]
  (let [doc (canvas/read-source source "retained")]
   (is (= "org-retained" (get-in doc [:blocks 0 :type])))
   (is (= source (canvas/write-source doc)))
   (is (thrown? (canvas/write-source (assoc-in doc [:blocks 0 :text] "Replaced"))))
   (is (thrown? (canvas/write-source (assoc-in doc [:blocks 0 :attrs :org/raw] "Replaced"))))
   (is (thrown? (canvas/write-source (assoc doc :blocks [])))))))
(deftest large-constructs-remain-admissible-with-bounded-editable-text
 (let [source (str "#+title: Long note\n* " (apply str (repeat 100000 "x")) "\r\n:PROPERTIES:\r\n:ID: long\r\n:END:\r\nBody.\r\n")
       doc (canvas/read-source source "long")]
  (is (= ["org-retained" "paragraph"] (mapv :type (:blocks doc))))
  (is (= "heading" (get-in doc [:blocks 0 :attrs :org/retained-type])))
  (is (= "" (get-in doc [:blocks 0 :text])))
  (is (= source (canvas/write-source doc)))
  (is (= (String/replace source "Body." "A revised body.")
         (canvas/write-source (assoc-in doc [:blocks 1 :text] "A revised body."))))))
(deftest unsupported-nesting-cannot-be-acknowledged-and-disappear
 (let [doc (canvas/read-source "First.\nSecond.\n" "nesting")]
  (is (thrown? (canvas/write-source (assoc-in doc [:blocks 1 :parent] "org-0"))))
  (is (thrown? (canvas/write-source (assoc-in doc [:blocks 1 :slot] "caption"))))))

(deftest source-anchors-cannot-be-replaced-by-visible-metadata-or-raw-payloads
 (let [source "#+title: Anchors\nOriginal.\n" doc (canvas/read-source source "anchors")]
  (is (= doc (canvas/validate-transition doc doc)))
  (is (thrown? (canvas/validate-transition doc (assoc-in doc [:meta :org/source] "Forged.\n"))))
  (is (thrown? (canvas/write-source (assoc-in doc [:blocks 0 :attrs :org/raw] "Forged.\n"))))
  (let [duplicate (assoc (first (:blocks doc)) :id "new-copy")]
   (is (= "#+title: Anchors\nOriginal.\nOriginal.\n" (canvas/write-source (update doc :blocks conj duplicate)))))
  (let [fresh (assoc (first (:blocks doc)) :id "new-copy" :text "Visible.")
        fresh (assoc-in fresh [:attrs :org/raw] "Invisible forgery.\n")
        written (canvas/write-source (update doc :blocks conj fresh))]
   (is (includes? written "Visible."))
   (is (not (includes? written "Invisible forgery."))))))

(deftest visible-metadata-is-native-and-patches-only-effective-prose-declarations
 (let [text "#+TITLE:  Earlier\r\n#+begin_src text\r\n#+title: Literal cell title\r\n#+icon: literal\r\n#+end_src\r\n#+TiTlE:\tNative 🌿\r\n#+ICON: leaf\r\nBody.\r\n"
       doc (canvas/read-source text "metadata")
       edited (-> doc (assoc-in [:meta :title] "مرحبا 🌿") (assoc-in [:meta :icon] "folder"))
       expected (-> text (String/replace "Native 🌿" "مرحبا 🌿") (String/replace "#+ICON: leaf" "#+ICON: folder"))
       written (canvas/write-source edited) reread (canvas/read-source written "rebuilt")]
  (is (= "Native 🌿" (get-in doc [:meta :title])))
  (is (= "leaf" (get-in doc [:meta :icon])))
  (is (= text (canvas/write-source doc)))
  (is (= expected written))
  (is (= "مرحبا 🌿" (get-in reread [:meta :title])))
  (is (= "folder" (get-in reread [:meta :icon])))
  (is (= written (canvas/write-source reread)))
  (is (thrown? (canvas/write-source (assoc-in doc [:meta :title] "Injected\n* TODO Other"))))
  (is (thrown? (canvas/write-source (assoc-in doc [:meta :icon] "<svg>"))))
  (is (thrown? (canvas/validate-transition doc (assoc-in doc [:meta :custom] "Unsaved")))))
 (doseq [text ["" "Body without trailing newline" "#+title: Before" "#+title: Before\r\nBody.\r\n"]]
  (let [doc (canvas/read-source text "metadata") edited (assoc-in doc [:meta :title] "After")
        written (canvas/write-source edited)]
   (is (= "After" (source/keyword-value written "title" nil)))
   (is (= written (canvas/write-source (canvas/read-source written "rebuilt"))))
   (when (includes? text "Body") (is (includes? written "Body")))))
 (let [text "#+title: Before\r\nBody.\r\n" doc (canvas/read-source text "icon")]
  (is (= (str "#+icon: leaf\r\n" text) (canvas/write-source (assoc-in doc [:meta :icon] "leaf")))))
 (is (thrown? (source/write-keyword "Body." "invalid:key" "Value")))
 (is (thrown? (source/write-keyword "Body." "title" "Injected\nline"))))
