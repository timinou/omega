(ns omega.org-heading-test
 (:require [omega.org-heading :as heading] [omega.org-canvas :as canvas]
           [live.edit.input :as input] [live.edit.commands :as commands] [live.edit.projection :as projection] [live.edit.document :as d]
           [omega.org-presentation :as presentation] [omega.org-semantics :as semantics]
           [live.edit.extensions :as extensions] [live.edit.standard :as standard]))
(def ext (extensions/build [standard/package presentation/package {:name "heading-typing-test" :provides {:editor/typing heading/typing}}]))
(deftest empty-heading-title-input-preserves-metadata-mark-ranges-and-source
 (doseq [[text expected at] [["TODO" "TODO 🌱" 4] ["TODO [#27]" "TODO [#27] 🌱" 10]
                             ["TODO [#27] :work:" "TODO [#27] 🌱 :work:" 11]
                             [":work:" "🌱 :work:" 0]]]
  (let [source (str "* " text "\n:PROPERTIES:\n:ID: heading\n:END:\n")
        doc (d/prepare (canvas/read-source source "heading-field")) id (get-in doc [:blocks 0 :id])
        op {:op "text/replace" :block id :from at :to at :text "🌱" :expected ""
            :styles [{:id "typed" :function "text/bold" :version 1 :args {}}]}
        selection {:anchor {:block id :offset (inc at)} :head {:block id :offset (inc at)}}
        plan (input/plan ext {:document doc} op {:input true :id "typing" :selection selection})
        edit (d/apply-op (:functions ext) doc (:op plan)) after (:document edit)
        fields (heading/fields (first (:blocks after)) after) mark (first (get-in after [:blocks 0 :marks]))
        undo (:document (d/apply-op (:functions ext) after (:inverse edit)))
        exported (canvas/write-source after)]
   (is (= expected (get-in after [:blocks 0 :text])))
   (is (= "🌱" (:title fields)))
   (is (= (inc (:from mark)) (:to mark)))
   (is (= (:title/from fields) (:from mark)))
   (is (= (:title/to fields) (get-in plan [:options :selection :head :offset])))
   (is (= doc undo))
   (is (includes? exported ":ID: heading\n:END:\n"))
   (is (= expected (get-in (canvas/read-source exported "reloaded") [:blocks 0 :text]))))))
(deftest existing-title-and-nonheading-input-do-not-inject-separators
 (let [doc (d/prepare (canvas/read-source "* TODO Valid :work:\n" "ordinary")) id (get-in doc [:blocks 0 :id])
       op {:op "text/replace" :block id :from 5 :to 5 :text "New "}]
  (is (= op (:op (input/plan ext {:document doc} op {:input true}))))
  (is (= op (:op (input/plan ext {:document (assoc-in doc [:blocks 0 :type] "paragraph")} op {:input true}))))))

(deftest mapped-heading-field-plans-preserve-native-source-and-rich-title
 (let [source "#+TODO: TODO NEXT | DONE\r\n* TODO [#27] *Rich* :work:\r\n:PROPERTIES:\r\n:ID: heading\r\n:CUSTOM: retain\r\n:END:\r\nNotes.\r\n"
       doc (d/prepare (canvas/read-source source "fields")) id (get-in doc [:blocks 0 :id])
       registry (:functions (extensions/build [standard/package presentation/package]))]
  (doseq [changes [{:state "DONE"} {:priority "64"} {:tags ["other"]}
                   {:state nil :priority "" :tags []} {:state nil :priority "64" :title "TODO literal :label:"}
                   {:title "TODO literal"}]]
   (let [plan (heading/plan-fields doc id changes "fields")
         op {:op "batch" :ops (:ops plan)} edit (d/apply-op registry doc op)
         written (canvas/write-source (:document edit))
         reread (canvas/read-source written "again") after-fields (heading/fields (first (:blocks reread)) reread)]
    (is (= (:document plan) (:document edit)))
    (is (= doc (:document (d/apply-op registry (:document edit) (:inverse edit)))))
    (is (includes? written ":ID: heading\r\n:CUSTOM: retain\r\n:END:\r\nNotes.\r\n"))
    (doseq [[key value] changes]
     (is (= (if (and (= key :priority) (= "" value)) nil value) (get after-fields key))))
    (when-not (contains? changes :title)
     (is (includes? written "*Rich*")))))
  (is (= [] (:ops (heading/plan-fields doc id {:state "TODO" :priority "27" :tags ["work"] :title "Rich"} "noop"))))
  (doseq [changes [{:state "UNKNOWN"} {:priority "65"} {:tags ["same" "same"]} {:title "Two\nlines"}]]
   (is (thrown? (heading/plan-fields doc id changes "invalid"))))))
(deftest clearing-metadata-does-not-reclassify-title-words
 (let [source "* TODO NEXT [#27] title :work:\n:PROPERTIES:\n:ID: fields\n:END:\n"
       doc (d/prepare (canvas/read-source source "fields")) id (get-in doc [:blocks 0 :id])
       plan (heading/plan-fields doc id {:state nil :priority "64"} "clear")
       next (:document plan) fields (heading/fields (first (:blocks next)) next)
       written (canvas/write-source next) object (first (:objects (semantics/read-source written)))]
  (is (nil? (:state fields)))
  (is (= "64" (:priority fields)))
  (is (= "NEXT [#27] title" (:title fields)))
  (is (= {:state nil :priority "64" :title "NEXT [#27] title"} (select-keys object [:state :priority :title])))))
(deftest semantic-heading-edits-keep-exact-annotation-ranges
 (let [source "#+TODO: READY(r) | FINISHED(f)\r\n#+caption: Keep\r\n#+attr_enchant: :inline [{:from 1 :to 4 :function \"text/bold\" :version 1 :args {}}]\r\n* READY [#27] Rich :work:\r\n:PROPERTIES:\r\n:ID: annotated\r\n:CUSTOM: retain\r\n:END:\r\nNotes.\r\n"
       next (semantics/update-object source "annotated" {:state "FINISHED" :priority "64" :tags ["other"] :title "READY literal"})
       object (first (:objects (semantics/read-source next)))]
  (is (= {:state "FINISHED" :priority "64" :tags #{"other"} :title "READY literal"}
         (select-keys object [:state :priority :tags :title])))
  (is (includes? next "#+caption: Keep\r\n"))
  (is (includes? next ":ID: annotated\r\n:CUSTOM: retain\r\n:END:\r\nNotes.\r\n"))
  (is (= next (canvas/write-source (canvas/read-source next "reread")))))
 (let [source "#+attr_enchant: :inline [{:from 0 :to 4 :function \"org/literal\" :version 1 :args {}}]\n* TODO title :project:\n:PROPERTIES:\n:ID: literal\n:END:\n"
       next (semantics/update-object source "literal" {:priority "64" :title "NEXT literal"})
       object (first (:objects (semantics/read-source next)))]
  (is (nil? (:state object)))
  (is (= "64" (:priority object)))
  (is (= "NEXT literal" (:title object)))))

(deftest title-input-preserves-meaning-with-literal-keywords-cookies-tags-and-ime-text
 (doseq [text ["TODO literal" "[#27] title" "Literal :work:" "TODO [#27] 🌱 :work:"]]
  (let [doc (d/prepare (canvas/read-source "* Heading\n" "title-input")) id (get-in doc [:blocks 0 :id])
        op {:op "text/replace" :block id :from 0 :to 7 :expected "Heading" :text text :styles []}
        plan (input/plan ext {:document doc} op {:input true :id "native"})
        edit (d/apply-op (:functions ext) doc (:op plan)) after (:document edit)
        f (heading/fields (first (:blocks after)) after)
        written (canvas/write-source after) parsed (first (:objects (semantics/read-source written)))]
   (is (= text (:title f)))
   (is (nil? (:state f)))
   (is (nil? (:priority f)))
   (is (= [] (:tags f)))
   (is (= text (:title parsed)))
   (is (nil? (:state parsed)))
   (is (= doc (:document (d/apply-op (:functions ext) after (:inverse edit))))))))
(deftest native-title-input-does-not-cross-field-boundaries-or-admit-newlines
 (let [doc (d/prepare (canvas/read-source "* TODO Title :work:\n" "field-bounds")) id (get-in doc [:blocks 0 :id])]
  (doseq [[from to text] [[0 4 "DONE"] [5 17 "replace"] [5 5 "Two\nlines"]]]
   (is (thrown? (input/plan ext {:document doc} {:op "text/replace" :block id :from from :to to :text text}
                  {:input true :id "outside"}))))))
(deftest enter-splits-only-title-content-with-rich-ranges-and-one-inverse
 (let [source "* TODO [#27] *Left 🌱 right* :work:\r\n:PROPERTIES:\r\n:ID: heading\r\n:END:\r\nBody.\r\n"
       doc (d/prepare (canvas/read-source source "enter")) block (first (:blocks doc)) id (:id block)
       f (heading/fields block doc) registry (:functions ext)]
  (doseq [[from to left right before?] [[(:title/from f) (:title/from f) "Left 🌱 right" "" true]
                                       [(+ (:title/from f) 6) (+ (:title/from f) 6) "Left 🌱" "right" false]
                                       [(:title/to f) (:title/to f) "Left 🌱 right" "" false]
                                       [(+ (:title/from f) 4) (+ (:title/from f) 7) "Left" "right" false]]]
   (let [context {:document doc :seed "enter" :selection {:anchor {:block id :offset from} :head {:block id :offset to}}}
         plan (heading/paragraph context {}) edit (d/apply-op registry doc {:op "batch" :ops (:ops plan)})
         after (:document edit) old (d/find-block after id) new (d/find-block after "enter/paragraph")
         after-fields (heading/fields old after) written (canvas/write-source after)]
    (is (= left (:title after-fields)))
    (is (= right (:text new)))
    (is (= {:state "TODO" :priority "27" :tags ["work"]} (select-keys after-fields [:state :priority :tags])))
    (is (= "paragraph" (:type new)))
    (is (= (if before? 0 1) (d/block-index after (:id new))))
    (is (= 0 (get-in plan [:selection :head :offset])))
    (is (includes? written ":ID: heading\r\n:END:\r\n"))
    (is (= doc (:document (d/apply-op registry after (:inverse edit)))))))))
(deftest boundary-keys-navigate-without-joining-native-heading-metadata
 (let [doc (d/prepare (canvas/read-source "Before.\n* TODO Heading :work:\nAfter.\n" "boundaries"))
       heading-block (nth (:blocks doc) 1) f (heading/fields heading-block doc)
       context (fn [block offset] {:document doc :selection {:anchor {:block block :offset offset :affinity "right"} :head {:block block :offset offset :affinity "right"}}})
       at-start (context (:id heading-block) (:title/from f)) at-end (context (:id heading-block) (:title/to f))
       before (first (:blocks doc)) after (nth (:blocks doc) 2)]
  (is (heading/backward-boundary? at-start))
  (is (heading/forward-boundary? at-end))
  (is (not (heading/backward-boundary? (context (:id heading-block) (inc (:title/from f))))))
  (is (= (:selection at-start) (:selection (heading/backward-boundary at-start {}))))
  (is (= (:selection at-end) (:selection (heading/forward-boundary at-end {}))))
  (is (= (:selection at-start) (:selection (heading/forward-boundary (context (:id before) (d/length (:text before))) {}))))
  (is (= (:selection at-end) (:selection (heading/backward-boundary (context (:id after) 0) {}))))))
(deftest heading-paste-keeps-metadata-on-the-first-heading-and-structure-after-it
 (let [source "* TODO [#27] Left right :work:\r\n:PROPERTIES:\r\n:ID: heading\r\n:END:\r\nBody.\r\n"
       doc (d/prepare (canvas/read-source source "paste")) id (get-in doc [:blocks 0 :id])
       rich (assoc (d/block "rich" "Rich") :marks [{:from 0 :to 4 :call {:id "old-call" :function "text/bold" :version 1 :args {}}}])
       table (:blocks (canvas/read-source "| Name | Value |\n|------+-------|\n| A | 🌱 |\n" "table"))
       at (+ (get-in (heading/fields (first (:blocks doc)) doc) [:title/from]) 5)
       context {:document doc :seed "pasted" :selection {:anchor {:block id :offset at} :head {:block id :offset at}}}]
  (doseq [payload [{:text "First\nSecond"} {:blocks [rich (d/block "last" "Last")]} {:blocks table}]]
   (let [plan (heading/paste context payload) edit (d/apply-op (:functions ext) doc {:op "batch" :ops (:ops plan)})
         after (:document edit) f (heading/fields (d/find-block after id) after)
         written (canvas/write-source after) object (first (:objects (semantics/read-source written)))]
    (is (= {:state "TODO" :priority "27" :tags ["work"]} (select-keys f [:state :priority :tags])))
    (is (= {:state "TODO" :priority "27" :tags #{"work"}} (select-keys object [:state :priority :tags])))
    (is (includes? written ":ID: heading\r\n:END:\r\n"))
    (is (= doc (:document (d/apply-op (:functions ext) after (:inverse edit)))))
    (is (not-any? #(< (:to %) (:from %)) (mapcat :marks (:blocks after))))
    (when (= table (:blocks payload))
     (is (= ["heading" "table" "table-row" "table-cell" "table-cell" "table-row" "table-cell" "table-cell" "paragraph" "paragraph"]
            (mapv :type (:blocks after))))
     (is (includes? written "🌱")))
    (when (= rich (first (:blocks payload)))
     (is (includes? written "*Rich*"))
     (is (not (contains? (d/call-ids after) "old-call"))))))))
(deftest paste-repairs-empty-title-separators-and-cut-remains-one-private-operation
 (let [source "* TODO [#27] :work:\n:PROPERTIES:\n:ID: heading\n:END:\n"
       doc (d/prepare (canvas/read-source source "empty-paste")) id (get-in doc [:blocks 0 :id])
       at (:title/from (heading/fields (first (:blocks doc)) doc))
       context {:document doc :seed "empty-paste" :selection {:anchor {:block id :offset at} :head {:block id :offset at}}}
       plan (heading/paste context {:text "Filled"})
       after (:document (d/apply-op (:functions ext) doc {:op "batch" :ops (:ops plan)}))
       fields (heading/fields (first (:blocks after)) after)]
  (is (= "TODO [#27] Filled :work:" (get-in after [:blocks 0 :text])))
  (is (= {:state "TODO" :priority "27" :tags ["work"] :title "Filled"} (select-keys fields [:state :priority :tags :title])))
  (let [cut-context {:document after :seed "cut" :selection {:anchor {:block id :offset (:title/from fields)} :head {:block id :offset (:title/to fields)}}}
        plan (heading/cut cut-context {}) edit (d/apply-op (:functions ext) after {:op "batch" :ops (:ops plan)})
        cut-fields (heading/fields (first (get-in edit [:document :blocks])) (:document edit))]
   (is (= "" (:title cut-fields)))
   (is (= (:tags fields) (:tags cut-fields)))
   (is (= after (:document (d/apply-op (:functions ext) (:document edit) (:inverse edit))))))))

(deftest heading-package-uses-source-workflow-current-values-and-clipped-rich-title
 (let [source "#+TODO: READY(r) None(n) | FINISHED(f)\r\n* READY [#27] *Rich* :work:\r\n"
       doc (d/prepare (canvas/read-source source "surface")) id (get-in doc [:blocks 0 :id])
       installed (extensions/build [standard/package presentation/package heading/package])
       context {:document doc :selection {:anchor {:block id :offset 11} :head {:block id :offset 15}}}
       items (into {} (map (fn [item] [(:id item) item]) (commands/query installed context)))
       tree (pr-str (projection/node installed (first (:blocks doc)) {:document doc}))
       state-item (get items "org/heading-state")
       plan (commands/plan installed context "org/heading-state" {:value "None"} "custom-none")
       after (:document (d/apply-op (:functions installed) doc {:op "batch" :ops (:ops plan)}))]
  (is (= ["" "READY" "None" "FINISHED"] (get-in state-item [:params :value :values])))
  (is (= "READY" (get-in state-item [:params :value :default])))
  (is (= "27" (get-in items ["org/heading-priority" :params :value :default])))
  (is (= "work" (get-in items ["org/heading-tags" :params :value :default])))
  (is (= "None" (:state (heading/fields (first (:blocks after)) after))))
  (is (includes? tree "Heading title"))
  (is (includes? tree "data-edit-isolated"))
  (is (includes? tree "data-edit-start 12"))
  (is (includes? tree "data-edit-tail 7"))
  (is (includes? tree "Heading fields"))
  (is (includes? tree "Change heading state"))
  (is (includes? tree "Rich"))
  (is (get-in items ["org/heading-paragraph" :enabled]))))
