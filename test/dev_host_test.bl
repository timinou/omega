(ns omega.dev-host-test
 (:require [omega.ed.main :as omega] [omega.dev :as dev] [vm.manager :as manager]
           [vm.scope :as scope] [vm.ports :as ports] [bl-ed.serve :as serve]))
(deftest an-owned-offline-host-reuses-and-stops-its-resources
 (let [root (str (System/tmp_dir!) "/omega-host-" (System/unique_integer (list :positive)))
       id (str "omega-host-test-" (System/unique_integer (list :positive)))
       probe (elem (gen_tcp/listen 0 (list :binary (tuple :active false))) 1)
       port (elem (elem (inet/sockname probe) 1) 1)]
  (gen_tcp/close probe)
  (File/mkdir_p! root)
  (File/write! (str root "/index.html") "owned offline host")
  (manager/start)
  (manager/ensure {:id id})
  (try
   (scope/with-vm id
    (fn []
     (let [opts {:root root :web root :port port :offline? true :memory? true}
           a (dev/acquire! {:world root :frontend "fixture"} opts)
           b (dev/acquire! {:world root :frontend "fixture"} opts)]
      (is (string? (get-in a [:route :generation])))
      (is (some (fn [claim] (= root (:root claim))) (ports/list-claims)))
      (is (= (:listener a) (:listener b)))
      (is (= (:buffers a) (:buffers b)))
      (is (Process/alive? (:buffers a)))
      (is (= (:sup (:sys a)) (:sup (:sys b))))
      (is (Process/alive? (:listener a)))
      (is (Process/alive? (:sup (:sys a))))
      (dev/stop! root)
      (is (not (some (fn [claim] (= root (:root claim))) (ports/list-claims))))
      (is (not (Process/alive? (:listener a))))
      (is (not (Process/alive? (:buffers a))))
      (is (not (File/exists? (:state a))))
      (let [ref (erlang/monitor :process (:sup (:sys a)))]
       (is (= :stopped (receive [:DOWN seen :process _ _] :when (= ref seen) :stopped
                               (after 5000 :timeout))))))))
   (finally (manager/drain id) (File/rm_rf! root)))))

(deftest failed-listener-start-rolls-back-the-task-system
 (let [root (str (System/tmp_dir!) "/omega-host-failure-" (System/unique_integer (list :positive)))
       socket (elem (gen_tcp/listen 0 (list :binary (tuple :active false))) 1)
       port (elem (elem (inet/sockname socket) 1) 1)
       captured (atom nil)]
  (File/mkdir_p! root)
  (try
   (is (= :failed
    (try
     (omega/start! {:root root :web root :port port :offline? true :memory? true
                    :intent-factory (fn [sys] (reset! captured sys) {})})
     :unexpected-success
     (catch _ :failed))))
   (is (some? @captured))
   (let [ref (erlang/monitor :process (:sup @captured))]
    (is (= :stopped (receive [:DOWN seen :process _ _] :when (= ref seen) :stopped
                            (after 5000 :timeout)))))
   (finally (gen_tcp/close socket) (File/rm_rf! root)))))

(deftest host-presets-redirect-only-the-unqualified-root
 (let [root (str (System/tmp_dir!) "/omega-preset-" (System/unique_integer (list :positive)))
       previous (Application/get_env :plug :validate_header_keys_during_test :absent)
       cfg {:root root :web root :landing-pages {"pelagic.dev" "/?use=pelagic"}}
       handle (serve/router cfg)
       request (fn [path host] (maps/put :req_headers (list (tuple "host" host)) (Plug.Test/conn :get path)))]
  (File/mkdir_p! root) (File/write! (str root "/index.html") "ordinary editor")
  (Application/put_env :plug :validate_header_keys_during_test true)
  (try
   (let [redirect (handle (request "/" "PELAGIC.DEV:8812"))]
    (is (= 307 (:status redirect)))
    (is (= (list "/?use=pelagic") (Plug.Conn/get_resp_header redirect "location"))))
   (let [explicit (handle (request "/?use=packages" "pelagic.dev"))
         unknown (handle (request "/" "unknown.localhost"))]
    (is (= 200 (:status explicit))) (is (= "ordinary editor" (:resp_body explicit)))
    (is (= 200 (:status unknown))) (is (= "ordinary editor" (:resp_body unknown))))
   (finally
    (if (= :absent previous) (Application/delete_env :plug :validate_header_keys_during_test)
      (Application/put_env :plug :validate_header_keys_during_test previous))
    (File/rm_rf! root)))))

(deftest generation-routes-serve-only-explicitly-admitted-frontends
 (let [root (str (System/tmp_dir!) "/omega-generation-route-" (System/unique_integer (list :positive)))
       id (String/duplicate "a" 64)
       previous (Application/get_env :plug :validate_header_keys_during_test :absent)
       handle (serve/router {:web root :generations (atom {id {:web root}})})]
  (File/mkdir_p! root) (File/write! (str root "/index.html") "admitted editor")
  (Application/put_env :plug :validate_header_keys_during_test true)
  (try
   (let [bare (handle (Plug.Test/conn :get (str "/generations/" id)))
         page (handle (Plug.Test/conn :get (str "/generations/" id "/")))
         absent (handle (Plug.Test/conn :get (str "/generations/" (String/duplicate "b" 64) "/")))]
    (is (= 307 (:status bare))) (is (= 200 (:status page)))
    (is (= "admitted editor" (:resp_body page))) (is (= 404 (:status absent))))
   (finally
    (if (= :absent previous) (Application/delete_env :plug :validate_header_keys_during_test)
      (Application/put_env :plug :validate_header_keys_during_test previous))
    (File/rm_rf! root)))))
