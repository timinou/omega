(ns omega.org-semantics-test (:require [omega.org-semantics :as org]))
(def source "#+TODO: READY ACTIVE | FINISHED\n* Launch :project:\n:PROPERTIES:\n:ID: launch\n:END:\n** ACTIVE Call client :sales:\nSCHEDULED: <2026-11-16 Mon> DEADLINE: <2026-11-20 Fri>\n:PROPERTIES:\n:ID: call\n:ASSIGNEE: alice\n:END:\n** FINISHED Done\n:PROPERTIES:\n:ID: done\n:END:\n#+begin_src org\n* TODO Not a task\n#+end_src\n")
(deftest source-semantics-use-native-org
 (let [parsed (org/read-source source) rows (:objects parsed)]
  (is (= 3 (count rows)))
  (is (= "project" (:type (first rows))))
  (is (= "Call client" (:title (nth rows 1))))
  (is (= "alice" (get-in rows [1 :properties "ASSIGNEE"])))
  (is (= "2026-11-16" (:scheduled (nth rows 1))))
  (is (= "2026-11-20" (:deadline (nth rows 1))))
  (is (:done? (last rows)))
  (is (empty? (:diagnostics parsed)))))
(deftest profiles-and-diagnostics
 (let [text "* Firm\n:PROPERTIES:\n:ID: firm\n:TYPE: organisation\n:END:\n* TODO Missing identity\n* TODO Duplicate\n:PROPERTIES:\n:ID: firm\n:END:\n"
       parsed (org/read-source text (assoc org/default-profile :types #{"organisation" "task"}))]
  (is (:recognized? (first (:objects parsed))))
  (is (= #{:missing-id :duplicate-id} (set (map :code (:diagnostics parsed)))))))
(deftest semantic-edits-retain-notes-code-and-planning-repeaters
 (let [text "* TODO Meet :work:\nSCHEDULED: <2026-11-16 Mon 10:00 +1w> DEADLINE: <2026-11-20 Fri>\n:PROPERTIES:\n:ID: meet\n:ASSIGNEE: alice\n:CUSTOM: retained\n:END:\n\nNotes.\n\n#+begin_src org\nSCHEDULED: <2000-01-01>\n#+end_src\n"
       next (org/update-object text "meet" {:done? true :assignee "bob" :scheduled "2026-11-17"})]
  (is (starts-with? next "* DONE Meet :work:"))
  (is (includes? next "SCHEDULED: <2026-11-17 10:00 +1w> DEADLINE: <2026-11-20 Fri>"))
  (is (includes? next ":ASSIGNEE: bob\n:CUSTOM: retained"))
  (is (ends-with? next "\n\nNotes.\n\n#+begin_src org\nSCHEDULED: <2000-01-01>\n#+end_src\n"))
  (is (not (includes? (org/update-object text "meet" {:scheduled ""}) "2026-11-16")))
  (is (thrown? (org/update-object text "absent" {:done? true})))
  (is (thrown? (org/update-object text "meet" {:title "Bad\n* injection"})))))
(deftest dates-in-code-are-not-task-planning
 (let [parsed (org/read-source "* TODO Note\n:PROPERTIES:\n:ID: note\n:END:\nText\n#+begin_src org\nSCHEDULED: <2000-01-01>\n#+end_src\n")]
  (is (nil? (:scheduled (first (:objects parsed)))))))
(deftest admitting-natural-org-materializes-identities-without-touching-other-bytes
 (let [text "#+TODO: READY | FINISHED\r\n* READY First\r\nSCHEDULED: <2026-11-16 Mon>\r\nBody 🌿\r\n\r\n* Second :project:\r\n:PROPERTIES:\r\n:CUSTOM: keep\r\n:END:\r\n#+begin_src org\r\n* TODO Literal\r\n#+end_src\r\n"
       prepared (org/assign-identities text #(str "object-" (:row %)))
       parsed (org/read-source (:source prepared))]
  (is (= 2 (count (:assigned prepared))))
  (is (empty? (:diagnostics parsed)))
  (is (includes? (:source prepared) "SCHEDULED: <2026-11-16 Mon>\r\n:PROPERTIES:\r\n:ID: object-1\r\n:END:\r\nBody 🌿"))
  (is (includes? (:source prepared) ":ID: object-5\r\n:CUSTOM: keep\r\n"))
  (is (ends-with? (:source prepared) "#+begin_src org\r\n* TODO Literal\r\n#+end_src\r\n"))
  (is (= (:source prepared) (:source (org/assign-identities (:source prepared) (fn [_] "never-used")))))
  (is (thrown? (org/assign-identities text (fn [_] "same")))))
 (is (thrown? (org/assign-identities "* TODO Broken\n:PROPERTIES:\n:CUSTOM: value\n* TODO Next\n:PROPERTIES:\n:ID: next\n:END:\n" (fn [_] "new")))))

(deftest org-workflow-fast-keys-priorities-and-literal-code-directives
 (let [text "#+TODO: NEXT(n) WAIT(w@/!) | DONE(d!)\n#+SEQ_TODO: IDEA(i) | DROPPED(x)\n* NEXT [#A] Important :work:\n:PROPERTIES:\n:ID: important\n:END:\n#+begin_src org\n#+TODO: WRONG | ALSO_WRONG\n#+end_src\n"
       parsed (org/read-source text) object (first (:objects parsed))]
  (is (= #{"NEXT" "WAIT" "IDEA"} (get-in parsed [:workflow :open])))
  (is (= #{"DONE" "DROPPED"} (get-in parsed [:workflow :done])))
  (is (= "Important" (:title object)))
  (is (= "A" (:priority object)))
  (is (includes? (org/update-object text "important" {:done? true}) "* DONE [#A] Important :work:"))))

(deftest a-property-edit-preserves-the-entire-heading-and-other-source
 (let [text "* TODO [#B] A :z:a:\r\n:PROPERTIES:\r\n:ID: a\r\n:CUSTOM: old\r\n:END:\r\n\r\nNotes.\r\n"]
  (is (= (String/replace text ":CUSTOM: old" ":CUSTOM: new")
         (org/update-object text "a" {:properties {"CUSTOM" "new"}})))))

(deftest clearing-state-keeps-the-native-heading-id-and-project-role
 (let [source "* TODO Direction :project:\n:PROPERTIES:\n:ID: direction\n:END:\n"
       next (org/update-object source "direction" {:state ""})
       object (first (:objects (org/read-source next)))]
  (is (= "* Direction :project:\n:PROPERTIES:\n:ID: direction\n:END:\n" next))
  (is (= :project (:role object)))
  (is (nil? (:state object)))))

(deftest planning-stamps-retain-clock-repeater-and-original-org-row
 (let [text "* TODO Follow up\nSCHEDULED: <2026-11-16 Mon 10:30 ++1d> DEADLINE: [2026-11-20 Fri -2d]\n:PROPERTIES:\n:ID: clock\n:END:\nNotes.\n#+begin_src org\nSCHEDULED: <2000-01-01 ++1w>\n#+end_src\n"
       object (first (:objects (org/read-source text)))]
  (is (= "2026-11-16" (:scheduled object)))
  (is (= "2026-11-20" (:deadline object)))
  (is (= "10:30" (get-in object [:planning :scheduled :time])))
  (is (= "++1d" (get-in object [:planning :scheduled :repeater])))
  (is (= 1 (get-in object [:planning :scheduled :row])))
  (is (true? (get-in object [:planning :deadline :valid-date?])))
  (is (= "[2026-11-20 Fri -2d]" (get-in object [:planning :deadline :stamp]))))
 (let [parsed (org/read-source "* TODO Fix date\nSCHEDULED: <2026-99-99>\n:PROPERTIES:\n:ID: bad\n:END:\n")]
  (is (some #(= :planning-date (:code %)) (:diagnostics parsed)))))

(deftest priority-and-tags-are-native-heading-edits-with-source-preservation
 (let [text "* TODO [#B] Meet 🌱 :work:client:\r\nSCHEDULED: <2026-11-16 Mon ++1w>\r\n:PROPERTIES:\r\n:ID: meet\r\n:CUSTOM: retain\r\n:END:\r\nNotes.\r\n#+begin_src org\r\n* TODO [#A] Literal :code:\r\n#+end_src\r\n"
       next (org/update-object text "meet" {:priority "A" :tags ["client" "follow_up"]})
       object (first (:objects (org/read-source next)))
       cleared (org/update-object next "meet" {:priority "" :tags ""})]
  (is (= "A" (:priority object)))
  (is (= #{"client" "follow_up"} (:tags object)))
  (is (= (String/replace text "* TODO [#B] Meet 🌱 :work:client:" "* TODO [#A] Meet 🌱 :client:follow_up:") next))
  (is (starts-with? cleared "* TODO Meet 🌱\r\n"))
  (is (= ["work" "client"] (org/tag-values ":work:client:")))
  (is (= "B" (:priority (first (:objects (org/read-source (org/update-object text "meet" {:tags ["work"]})))))))
  (doseq [changes [{:priority "AB"} {:priority "\n"} {:priority nil}
                   {:tags ["bad tag"]} {:tags ["same" "same"]} {:tags ["new\n* heading"]}
                   {:tags (vec (repeat 17 "tag"))} {:tags nil}]]
   (is (thrown? (org/update-object text "meet" changes)))))))
