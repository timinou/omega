;; env.bl — omega's project file, read by the `bl` launcher (~/.local/bin/bl).
;;
;; `:bl` pins the beam-lisp build omega runs on. A pinned commit is built ONCE,
;; clean, in a detached tree (~/.cache/bl/build-trees/<sha>) and kept in the
;; store, so omega neither rebuilds nor breaks when the beam-lisp main checkout
;; carries uncommitted work (whose stale boot tier made every run recompile for
;; minutes). Supersedes PLAN-001 D12 ("always the latest checkout").
;;
;; 797dc039: align Omega's BEAM host and PELAGIC's JS graph on the native
;; namespace/actor interop compiler. Compiler resolution is independent of
;; frontend compilation; launches reuse the content-addressed frontend.
;; Previous pin: b4861edf (build-time JS macros).
{:name "omega"
 :paths ["src" "vendor/bl-ed/src" "spikes/pelagic"]
 :bl "commit:797dc039"
 :tasks {"pelagic.build" {:doc "Compile or reuse the shared PELAGIC frontend. No ZIP or installation."
                          :run "spikes/pelagic/frontend.bl"}
         "pelagic.dev" {:doc "Open a PELAGIC session in the shared Omega development host."
                        :run "spikes/pelagic/dev.bl"}
         "pelagic.local" {:doc "Serve the standalone PELAGIC demo (no Omega backend)."
                          :run "spikes/pelagic/local-task.bl"}
         "pelagic.bundle" {:doc "Export the PELAGIC demo ZIP."
                           :run "spikes/pelagic/bundle.bl"}}}
