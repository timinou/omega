;; env.bl — omega's project file, read by the `bl` launcher (~/.local/bin/bl).
;;
;; `:bl` pins the beam-lisp build omega runs on. A pinned commit is built ONCE,
;; clean, in a detached tree (~/.cache/bl/build-trees/<sha>) and kept in the
;; store, so omega neither rebuilds nor breaks when the beam-lisp main checkout
;; carries uncommitted work (whose stale boot tier made every run recompile for
;; minutes). Supersedes PLAN-001 D12 ("always the latest checkout").
;;
;; 65c25b33: Wry detects OS-closed windows and raises native failures.
;; Minimal lifecycle patch over 25f5e799: one JS actor compiler/kernel; children retain
;; their spec owner's environment through restart.
;; Includes d5363326's persistent service tasks, realm-owned hosts and native
;; namespace/actor interop. Compiler resolution is independent of
;; frontend compilation; launches reuse the content-addressed frontend.
;; Previous pin: b4861edf (build-time JS macros).
{:name "omega"
 :paths ["src" "vendor/bl-ed/src" "spikes/pelagic" "spikes/workspace" "spikes/mobile"]
 :bl "commit:65c25b33"
 :vm "shared"
 :ports {"omega" {:port 8812
                  :routes {"pelagic.dev" "/?use=pelagic&layout=pelagic&file=spikes/pelagic/live-set.bl.org"
                           "spikes.pelagic.dev" "/?use=pelagic&layout=pelagic&file=spikes/pelagic/tutorials/00-start.bl.org"
                           "omega.localhost" "/?use=packages&file=package:catalog"}}}
 :tasks {"omega" {:doc "Open Omega Home in a native window. --demo for scripted work; --browser for its URL."
                   :run "scripts/desktop.bl" :service true}
         "home.dev" {:doc "Open the Home prototype on the shared development host."
                     :run "spikes/pelagic/dev.bl" :service true :args ["--preset" "home"]}
         "runtime.review" {:doc "View recorded milestone reports, screenshots and videos. No world or frontend build."
                            :run "scripts/runtime-review.bl"}
         "runtime.dev" {:doc "Open the runtime observatory on the shared Omega world."
                         :run "spikes/pelagic/dev.bl" :service true :args ["--preset" "runtime"]}
         "pelagic.check" {:doc "Verify BL artifact hashes, reproducibility and generated cache syntax."
                          :run "spikes/pelagic/test/artifact.bl"}
         "omega.watch" {:doc "Build validated immutable frontend candidates for explicit session reload."
                        :run "spikes/pelagic/watch.bl" :service true}
         "omega.watch.stop" {:doc "Stop speculative frontend work, keeping the host and tabs."
                             :run "spikes/pelagic/watch.bl" :service true :args ["--stop"]}
         "omega.build" {:doc "Compile or reuse the shared Omega package frontend."
                        :run "spikes/pelagic/frontend.bl"}
         "pocket" {:doc "Open Pocket on the shared Omega world. Add --live for durable work."
                   :run "spikes/pelagic/dev.bl" :service true :args ["--preset" "pocket"]}
         "omega.dev" {:doc "Open the package catalog on the shared Omega application host."
                      :run "spikes/pelagic/dev.bl" :service true :args ["--preset" "packages"]}
         "omega.stop" {:doc "Gracefully stop this world, preserving the shared VM."
                       :run "scripts/stop-dev.bl" :service true}
         "spikes.pelagic.dev" {:doc "Open the PELAGIC showcase on the same Omega host."
                               :run "spikes/pelagic/dev.bl" :service true :args ["--preset" "spikes"]}
         "pelagic.build" {:doc "Compile or reuse the shared PELAGIC frontend. No ZIP or installation."
                          :run "spikes/pelagic/frontend.bl"}
         "pelagic.dev" {:doc "Open a PELAGIC session in the shared Omega development host."
                        :run "spikes/pelagic/dev.bl" :service true :args ["--preset" "pelagic"]}
         "pelagic.local" {:doc "Serve the standalone PELAGIC demo (no Omega backend)."
                          :run "spikes/pelagic/local-task.bl"}
         "pelagic.bundle" {:doc "Export the PELAGIC demo ZIP."
                           :run "spikes/pelagic/bundle.bl"}}}
