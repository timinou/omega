#!/bin/bash
# bin/omega-shot — open the omega window, screenshot it, close it (niri).
#   bin/omega-shot --demo [--light]  → .local/shots/omega-<time>.png (path printed)
# How an agent developing omega SEES the UI. Needs niri + imagemagick.
set -u
ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
OUT="$ROOT/.local/shots"; mkdir -p "$OUT"
win_field() { niri msg --json windows | python3 -c "import json,sys; w=[x for x in json.load(sys.stdin) if x.get('title')=='omega']; print(w[-1]['$1'] if w else '')"; }
close_all() { for p in $(niri msg --json windows | python3 -c "import json,sys; print(' '.join(str(x['pid']) for x in json.load(sys.stdin) if x.get('title')=='omega'))"); do /bin/kill "$p" 2>/dev/null; done; }
close_all; sleep 1
setsid "$ROOT/bin/omega-ui" "$@" > "$OUT/omega-ui.log" 2>&1 < /dev/null 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
ID=""; for i in $(seq 1 60); do sleep 1; ID=$(win_field id); [ -n "$ID" ] && break; done
[ -z "$ID" ] && { echo "no omega window after 60s; see $OUT/omega-ui.log"; exit 1; }
sleep "${OMEGA_SHOT_SETTLE:-4}"
niri msg action focus-window --id "$ID"; sleep 1.5
before=$(ls -t ~/Pictures/Screenshots/*.png 2>/dev/null | head -1)
niri msg action screenshot-window -p false
for i in $(seq 1 20); do sleep 0.3; after=$(ls -t ~/Pictures/Screenshots/*.png | head -1); [ "$after" != "$before" ] && break; done
DEST="$OUT/omega-$(date +%H%M%S).png"
magick "$after" -resize '1400x1400>' "$DEST" && chmod 644 "$DEST"
close_all
echo "$DEST"
