#!/bin/sh
# bin/omega — run one omega task from the shell. See src/omega/cli.bl for flags.
#   bin/omega --offline "look around"        no network: a scripted model
#   bin/omega "add a hello.txt saying hi"    live: Sonnet 5.5 via localhost:8080
ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
ENTRY=$(mktemp --suffix=.bl)
trap 'rm -f "$ENTRY"' EXIT
printf '(ns omega.main (:require [omega.cli :as cli]))\n(cli/main)\n' > "$ENTRY"
"$ROOT/bin/bl" run "$ENTRY" -- --root "$PWD" "$@" 2>&1 | grep -v '^bl-stage-hosts:' | sed -e '/^:ok$/d' -e '/^nil$/d'
