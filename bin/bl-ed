#!/bin/bash
# One shared package frontend; this compatibility command serves it in the foreground.
# bin/bl-ed build compiles/reuses the same generation as bl omega.build.
# Flags: --root DIR --port N (8790) --offline --memory --db DIR.
set -euo pipefail
ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
if [ "${1:-}" = build ]; then
  exec "$ROOT/bin/bl" omega.build
fi
ENTRY=$(mktemp --suffix=.bl)
trap 'rm -f "$ENTRY"' EXIT
printf '(ns omega.ed.entry (:require [omega.ed.main :as m] [pelagic.build :as frontend]))\n(m/main {:web (frontend/frontend!)})\n' > "$ENTRY"
root_args=(--root "$PWD")
for arg in "$@"; do
  if [ "$arg" = --root ]; then root_args=(); break; fi
done
OMEGA_HOME="$ROOT" "$ROOT/bin/bl" --cold run "$ENTRY" -- "${root_args[@]}" "$@"
