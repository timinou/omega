#!/usr/bin/env bash
# Normal use joins the root world. --offline/--memory remains a foreground test.
set -euo pipefail
ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
if [ "${1:-}" = build ]; then exec "$ROOT/bin/bl" omega.build; fi
if [ "${1:-}" = --help ]; then
  printf '%s\n' 'bin/bl-ed [--port N] [--db DIR] [--root DIR]' '  Opens the shared live world; root attaches a working place.' 'bin/bl-ed --offline --memory --port 8792 --root /tmp/x' '  Isolated foreground testing; never uses the live world.'
  exit 0
fi
isolated=false
for arg in "$@"; do
  case "$arg" in --offline|--memory) isolated=true;; esac
done
if $isolated; then
  ENTRY=$(mktemp --suffix=.bl)
  trap 'rm -f "$ENTRY"' EXIT
  printf '(ns omega.ed.entry (:require [omega.ed.main :as m] [pelagic.build :as frontend]))\n(m/main {:web (frontend/frontend!)})\n' > "$ENTRY"
  root_args=(--root "$PWD")
  for arg in "$@"; do if [ "$arg" = --root ]; then root_args=(); break; fi; done
  OMEGA_HOME="$ROOT" "$ROOT/bin/bl" --cold run "$ENTRY" -- "${root_args[@]}" "$@"
else
  caller_root="$PWD"; port=8812; shared_args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --root) caller_root=${2:?--root requires a directory}; shift 2;;
      --port) port=${2:?--port requires a number}; shared_args+=("$1" "$2"); shift 2;;
      *) shared_args+=("$1"); shift;;
    esac
  done
  "$ROOT/bin/bl" omega.dev -- --live "${shared_args[@]}"
  if [ "$(cd "$caller_root" && pwd -P)" != "$ROOT" ]; then
    "$ROOT/bin/omega" --no-start --url "http://127.0.0.1:$port" attach "$caller_root"
  fi
fi
