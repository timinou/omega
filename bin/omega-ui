#!/usr/bin/env bash
# The desktop and phone open the same editor and world. Live by default.
set -euo pipefail
ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
caller_root="$PWD"; port=8812; offline=false; args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --demo|--offline) offline=true; shift;;
    --root) caller_root=${2:?--root requires a directory}; shift 2;;
    --port) port=${2:?--port requires a number}; args+=("$1" "$2"); shift 2;;
    --no-window|--) shift;;
    *) args+=("$1"); shift;;
  esac
done
caller_root=$(cd "$caller_root" && pwd -P)
mode=(--live); client_mode=()
if $offline; then mode=(); client_mode=(--offline); fi
"$ROOT/bin/bl" pocket -- "${mode[@]}" "${args[@]}"
if [ "$caller_root" != "$ROOT" ]; then
  "$ROOT/bin/omega" --no-start "${client_mode[@]}" --url "http://127.0.0.1:$port" attach "$caller_root"
fi
