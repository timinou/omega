; omega/loop.bl — one turn of a task: model → tools → model … → answer.
;
; ══ THE SHAPE ═══════════════════════════════════════════════════════════════
;
; pi's loop, kept minimal. A TURN starts when the task has unread messages and
; ends when the model answers without calling a tool:
;
;   drain inbox → append as :user turns
;   loop:
;     request = {:system :messages :tools}          (context-transform hooks)
;     response = (step request)                     (the model seam)
;     record the :assistant turn
;     if response calls tools → run each (call-predicate hooks), record :tool turn
;        then drain the inbox again: steers land HERE, between steps
;        and repeat
;     else → the answer; the task goes :idle (or :done if the model says so)
;
; ══ THE MODEL SEAM ══════════════════════════════════════════════════════════
;
; `step` is a fn. Request and response are provider-neutral data:
;
;   request  {:system "…" :messages [{:role :user|:assistant :content [block …]}]
;             :tools [{:name :description :input-schema}]}
;   response {:content [block …] :stop :end|:tool-use|:max-tokens :usage {…}}
;            | {:error {…}}
;   block    {:type :text :text s}
;            {:type :tool-use :id s :name s :input map}
;            {:type :tool-result :id s :content s :error? bool}
;
; omega.llm turns an Anthropic endpoint into such a fn; omega.loop/scripted
; turns a list of responses into one, for tests. Both are just `step`.
;
; ══ TOOLS ═══════════════════════════════════════════════════════════════════
;
; A tool is {:name :description :input-schema :run (fn [ctx input] → result)}
; where result is {:ok string} or {:error string}. ctx = {:sys :task}. The
; special result {:ok s :done true} closes the task as :done (the `done` tool).

(ns omega.loop
  (:require [omega.env :as env]
            [omega.actor :as actor]
            [omega.trace :as tr]
            [omega.stream :as stream]
            [clojure.string]
            [datom]))

(def MAX-STEPS 40)

(defn- hook
  "Run hook chain `kind` from the system's hooks (omega.ext), or return x."
  [sys kind x ctx]
  (if-let [run (get-in sys [:hooks :run])] (run kind x ctx) x))

(defn- emit [sys event data]
  ((get-in sys [:hooks :emit] (fn [_ _] nil)) event data))

;; ── turns as facts ──────────────────────────────────────────────────────
;
; The store is the truth for every reader (`turns`). The running turn does not
; re-read it per step (C8): `turn!` reads the list ONCE, then threads it as a
; loop-local value through `append!`, `drain!` and `request`, because it is the
; only writer of its task's turns. Reading every turn back per step made long
; tasks quadratic (spikes/hot-task.bl.md: 1.2 s → 2.7 s per trivial step by
; step 160; spikes/c8-turn-cache.bl.md: 4.4× faster with the list threaded).

(defn turns
  "All turns of task `id`, in order: [{:n :role :content}]. Read by index walk
   (:avet task → :eavt per turn), not a datalog join: 600 turns 1.4 s → ~0.4 s
   (spikes/turn-read-cost.bl.md). A turn missing n, role or content is skipped,
   as the former join skipped it."
  [sys id]
  (let [e (:env sys)
        db (env/db e)
        t (env/eid e :task/id id)]
    (if (nil? t)
      []
      (->> (datom/datoms db :avet :turn/task t)
           (keep (fn [d]
                   (let [m (reduce (fn [m x] (assoc m (nth x 1) (nth x 2))) {} (datom/datoms db :eavt (nth d 0)))]
                     (when (and (contains? m :turn/n) (contains? m :turn/role) (contains? m :turn/content))
                       {:n (:turn/n m) :role (:turn/role m) :content (:turn/content m)}))))
           (sort-by :n)
           vec))))

(defn append!
  "Append a turn after `ts` (task `id`'s turns so far, as the caller holds
   them); returns ts with it. role :user|:assistant|:tool, content = [block …]."
  ([sys id ts role content] (append! sys id ts role content nil))
  ([sys id ts role content usage]
   (let [e (:env sys)
         n (inc (count ts))]
     (env/tx! e [(cond-> {:db/id -1 :turn/id (str id "/" n) :turn/task (env/eid e :task/id id) :turn/n n
                          :turn/role role :turn/content content :turn/at (env/now e)}
                   (some? usage) (assoc :turn/usage usage))])
     (conj ts {:n n :role role :content content}))))

(defn record!
  "Append a turn to task `id`, reading its turns from the store; returns its n.
   For callers outside a running turn (the running turn uses `append!`)."
  ([sys id role content] (record! sys id role content nil))
  ([sys id role content usage]
   (count (append! sys id (turns sys id) role content usage))))

;; ── orphaned tool calls (an interrupted history) ─────────────────────────
;
; Every provider requires each assistant :tool-use to be answered by a
; :tool-result in the user-side message(s) right after it. omega persists the
; assistant turn BEFORE it runs the tools, so a kill (SIGTERM, crash, power)
; in between leaves a durable conversation with an unanswered call; the next
; request is then rejected (Anthropic 400 "tool_use ids without tool_result").
;
; The repair is pure and provider-neutral: it only ADDS an explicit error
; result for a genuinely missing id. It never re-runs a tool (the effect may
; have been applied), never drops or edits a completed result, and leaves a
; healthy history byte-identical.

(def INTERRUPTED-NOTE
  (str "INTERRUPTED: omega stopped before this tool call returned a result. It was NOT re-run. "
       "Its effect is UNKNOWN: it may have fully applied, partly applied, or not run at all. "
       "Inspect the current state (files, processes, remote systems) before retrying; do not assume either outcome."))

(defn- blocks-of [content type] (filter (fn [b] (= type (:type b))) content))

(defn- use-ids
  "The distinct, non-nil ids of the tool calls in `content`, in order."
  [content]
  (vec (distinct (filter some? (map :id (blocks-of content :tool-use))))))

(defn- result-ids [content] (set (filter some? (map :id (blocks-of content :tool-result)))))

(defn interrupted-result
  "The explicit error result standing in for call `id` that never answered."
  [id]
  {:type :tool-result :id id :content INTERRUPTED-NOTE :error? true :interrupted true})

(defn- missing-results
  "Synthetic results for the ids called in `content` and answered by none of
   the user-side messages `following` (the run right after it)."
  [content following]
  (let [have (reduce (fn [s m] (into s (result-ids (:content m)))) #{} following)]
    (vec (map interrupted-result (remove (fn [id] (contains? have id)) (use-ids content))))))

(defn repair-messages
  "Pair every assistant tool call with a result. A call is answered when any
   message of the user-side run right after its assistant message holds a
   result with its id (the provider merges consecutive user messages). Missing
   ones get an explicit error result, put FIRST in that run's first message (or
   in a new user message when no user message follows). Healthy lists are
   returned unchanged."
  [msgs]
  (let [n (count msgs)]
    (loop [i 0 out []]
      (if (>= i n)
        out
        (let [m (nth msgs i)]
          (if (not= :assistant (:role m))
            (recur (inc i) (conj out m))
            (let [run (vec (take-while (fn [x] (= :user (:role x))) (drop (inc i) msgs)))
                  synth (missing-results (:content m) run)]
              (cond
                (empty? synth) (recur (inc i) (conj out m))
                (empty? run) (recur (inc i) (conj (conj out m) {:role :user :content synth}))
                :else (let [f (first run)]
                        (recur (+ i 2) (conj (conj out m) (assoc f :content (into synth (:content f))))))))))))))

(defn orphaned-results
  "The synthetic results the TAIL of turns `ts` needs: the calls of the last
   assistant turn that no later turn answers (turns after it are all user-side).
   [] when the history is healthy. What `recover!` persists."
  [ts]
  (let [i (last (keep-indexed (fn [k t] (when (= :assistant (:role t)) k)) ts))]
    (if (nil? i)
      []
      (missing-results (:content (nth ts i)) (drop (inc i) ts)))))

(defn repair-tail!
  "Persist the explicit error results an interrupted task's tail is missing, as
   one :tool turn. Idempotent. Returns the ids it answered ([] when none)."
  [sys id]
  (let [ts (turns sys id)
        rs (orphaned-results ts)]
    (when (seq rs) (append! sys id ts :tool rs))
    (vec (map :id rs))))

(defn messages
  "Turns → the model's message list. :tool turns travel as :user messages
   (tool results are user-side content, as in the Anthropic and pi models).
   An unanswered tool call is answered by an explicit interruption error here
   too (repair-messages), so no provider ever sees an orphan."
  [ts]
  (repair-messages
   (vec (map (fn [t] {:role (if (= :assistant (:role t)) :assistant :user) :content (:content t)}) ts))))

;; ── the inbox becomes user turns ────────────────────────────────────────

(defn- msg->text [m]
  (case (:kind m)
    :prompt (:text m)
    :steer (str "[steer from " (:from m) "] " (:text m))
    :reply (str "[reply from " (:from m) "] " (:text m))
    :note (str "[note from " (:from m) "] " (:text m))
    (str "[" (name (:kind m)) " from " (:from m) "] " (:text m))))

(defn drain!
  "Consume task `id`'s unread messages as one :user turn appended after `ts`
   (its turns so far; read from the store when omitted). Returns the turns with
   it, or ts unchanged when the inbox is empty."
  ([sys id] (drain! sys id (turns sys id)))
  ([sys id ts]
   (let [e (:env sys)
         box (actor/inbox e id)]
     (if (seq box)
       (let [ts (append! sys id ts :user (vec (map (fn [m] {:type :text :text (msg->text m)}) box)))]
         (doseq [m box] (actor/mark-read! e (:id m)))
         (emit sys :inbox/drained {:task id :count (count box)})
         ts)
       ts))))

;; ── one step ────────────────────────────────────────────────────────────

(defn- tool-table [sys] (or (:tools sys) []))

(defn- find-tool [sys nm] (first (filter (fn [t] (= nm (:name t))) (tool-table sys))))

(defn- run-tool [sys id block step]
  (let [ctx {:sys sys :task id :step step}
        world (env/world (:env sys))
        tool (find-tool sys (:name block))
        decision (hook sys :tool/before {:allow true :block block} ctx)
        _ (stream/activity! world id {:tool (:name block) :since (erlang/system_time :millisecond)
                                :code (first (clojure.string/split-lines (str (or (get-in block [:input :code]) (pr-str (:input block))))))})
        r (cond
            (nil? tool) {:error (str "no such tool: " (:name block))}
            (not (:allow decision)) {:error (str "denied: " (:reason decision))}
            :else (try ((:run tool) (assoc ctx :block block) (:input block))
                       (catch err {:error (ex-message err)})))
        _ (stream/activity! world id nil)
        r (hook sys :tool/after r (assoc ctx :block block))]
    ;; one trace per CALL: the subject carries the turn number, so two calls with a
    ;; reused tool-use id (scripted models, some providers) never merge
    (tr/leave! (:env sys) id {:kind :tool :subject (str (:name block) "#" step "/" (:id block))
                              :text (str (:name block) " " (if (:error r) "error" "ok"))
                              :data {:input (:input block) :error? (some? (:error r))}})
    (emit sys :tool/result {:task id :tool (:name block) :error? (some? (:error r))})
    r))

(def TRUNCATED-NOTE
  (str "NOT RUN: your reply hit the output token limit (stop: max-tokens) while this call was being written, "
       "so its input may be incomplete. Nothing was executed. Retry with a much smaller call: write large files "
       "in several chunks of a few hundred lines per eval (create, then append) and avoid huge literals. "
       "The operator can raise the limit with OMEGA_MAX_TOKENS."))

(defn- tool-uses [content] (filter (fn [b] (= :tool-use (:type b))) content))

(defn- text-of [content]
  (join "\n" (keep (fn [b] (when (= :text (:type b)) (:text b))) content)))

(defn- add-usage [a b]
  (merge-with (fn [x y] (+ (or x 0) (or y 0))) (or a {}) (or b {})))

;; ── the situation: what this step is about (one value, many consumers) ──
;
; Guidelines, the attention line and scope checks all ask "what is the agent
; doing right now?". `situation` answers once per step from what is already
; known — the goal, the last exchange, the tool just used, the task's claims —
; and hooks receive it in ctx as :situation. Pure over (turns, claims).

(defn- block-gist [b]
  (case (:type b)
    :text (:text b)
    :tool-use (str (:name b) " " (pr-str (:input b)))
    :tool-result (let [c (str (:content b))] (subs c 0 (min 300 (count c))))
    ""))

(defn- ext-of [p]
  (let [b (last (clojure.string/split (str p) #"/"))
        i (clojure.string/index-of b ".")]
    (when i (subs b i))))

(defn situation
  "{:goal :recent :step :last-tool :paths :exts :text} for task `id` over turns
   `ts`. :text is the one string a matcher reads (goal + recent exchange +
   paths); :paths are the task's claimed paths (absolute), :exts their file
   extensions (\".bl\" \".css\" \".bl.org\")."
  [sys id ts]
  (let [ms (vec ts)
        goal (clojure.string/join " " (map block-gist (:content (first ms))))
        tail (subvec ms (max 1 (- (count ms) 2)) (count ms))
        recent (clojure.string/join " " (map block-gist (mapcat :content tail)))
        last-tool (last (keep (fn [b] (when (= :tool-use (:type b)) (:name b))) (mapcat :content ms)))
        paths (if (:env sys) (vec (sort (distinct (map :subject (tr/all (:env sys) {:kind :claim :task id}))))) [])]
    {:goal goal :recent recent :step (count ms) :last-tool last-tool
     :paths paths :exts (vec (distinct (keep ext-of paths)))
     :text (str goal "\n" recent (when (seq paths) (str "\nfiles: " (clojure.string/join " " paths))))}))

;; ── the request tail (spikes/prompt-cache.bl.md §4) ─────────────────────
;
; :tail is a vector of content blocks that ride AFTER the last user message's
; content for THIS request only. They are never turns, so the next request's
; prefix is byte-identical and the provider cache holds. Hooks add to it;
; `with-tail` folds it in at the wire boundary (llm/step), so every adapter
; and the cassette digest see the same thing.

;; :record is the sticky sibling of :tail: blocks a hook wants IN the
;; transcript (a guideline the agent should keep seeing, a note the human
;; should be able to audit). They are sent now at the tail, then written into
;; the next user-side turn, so every later request carries them at the same
;; position: one uncached step, then a stable prefix (spikes/guidelines
;; storage.bl: :tail costs the block every step; :record once).

(defn with-tail
  "`req` with its :tail and :record folded into the last user message (or as a
   new user message when the last one is the assistant's); both keys removed."
  [req]
  ;; :record first: the stored turn becomes exactly what was sent minus the
  ;; volatile :tail, so the next request's prefix matches this one's
  (let [t (vec (concat (:record req) (:tail req))) req (dissoc req :tail :record)]
    (if (empty? t)
      req
      (let [ms (vec (:messages req)) i (dec (count ms))]
        (assoc req :messages
               (if (and (>= i 0) (= :user (:role (nth ms i))))
                 (assoc ms i (update (nth ms i) :content (fn [c] (into (vec c) t))))
                 (conj ms {:role :user :content t})))))))

(defn- record-into-last!
  "Append `blocks` to the last user-side turn of `ts` in the store (the turn the
   model just saw them on); returns ts updated. Only a running turn calls this:
   it is the one writer of its task's turns (C8)."
  [sys id ts blocks]
  (let [i (last (keep-indexed (fn [k t] (when (not= :assistant (:role t)) k)) ts))]
    (if (nil? i)
      ts
      (let [t (nth ts i)
            content (into (vec (:content t)) blocks)
            e (:env sys)]
        (env/tx! e [[:db/add (env/eid e :turn/id (str id "/" (:n t))) :turn/content content]])
        (assoc (vec ts) i (assoc t :content content))))))

(defn request
  "The model request for task `id` over its turns `ts` (read from the store
   when omitted), after the :context hooks. Carries :tail (request-time blocks,
   see `with-tail`); hooks get {:sys :task :situation} as ctx."
  ([sys id] (request sys id (turns sys id)))
  ([sys id ts]
  (let [cwd (:task/cwd (env/pull (:env sys) [:task/cwd] (env/eid (:env sys) :task/id id)))
        req {:system (str (or (:system-prompt sys) "You are omega, a coding agent.")
                          (when cwd (str "\nTask working directory: " cwd ". Relative file paths and shell commands resolve here.")))
             :messages (messages ts)
             :tools (vec (map (fn [t] (select-keys t [:name :description :input-schema])) (tool-table sys)))
             :tail [] :record []}]
    (hook sys :context req {:sys sys :task id :situation (situation sys id ts)}))))

(defn- add-cost!
  "Fold one response's usage into the task's running cost. The running turn
   owns the total (C8): it writes the sum it holds, never reads the entity back."
  [sys id cost usage]
  (let [cost (add-usage cost usage)]
    (when (some? usage)
      (env/tx! (:env sys) [[:db/add (env/eid (:env sys) :task/id id) :task/cost cost]]))
    cost))

(defn budget-exhausted?
  "Reported usage is cumulative across continuations. Limits pause before the next request."
  [sys cost]
  (let [b (:token-budget sys) input (+ (or (:input cost) 0) (or (:cache-read cost) 0) (or (:cache-write cost) 0))]
    (or (and (:input b) (>= input (:input b)))
        (and (:output b) (>= (or (:output cost) 0) (:output b))))))

(defn- budget-notice [sys cost]
  (let [b (:token-budget sys) input (+ (or (:input cost) 0) (or (:cache-read cost) 0) (or (:cache-write cost) 0))]
    (when (or (and (:input b) (>= input (* 0.7 (:input b))))
              (and (:output b) (>= (or (:output cost) 0) (* 0.7 (:output b)))))
      "\nUsage budget is nearing its limit. Finish durable partial outputs now, preserve uncertainty, and call done; avoid further discovery.")))

(defn turn!
  "Run one turn of task `id` to completion. Returns the outcome for the
   executor: {:status :idle|:done|:failed :result …}.

   Events: :turn/start once per turn; :step/end after each model step that
   called tools, {:task :step :tools [name …]} (C5) — the honest checkpoint
   point; :turn/end when the turn answers or closes."
  [sys id]
  (let [e (:env sys)
        world (env/world e)
        step (:step sys)
        max-steps (or (:max-steps sys) MAX-STEPS)
        ts0 (drain! sys id (turns sys id))
        cost0 (:task/cost (env/entity e (env/eid e :task/id id)))]
    (emit sys :turn/start {:task id})
    (loop [n 1 ts ts0 cost cost0]
      (cond
        (> n max-steps) {:status :idle :result (str "paused after " max-steps " steps")}
        (budget-exhausted? sys cost) {:status :idle :result "paused: reported token budget reached; durable partial outputs are retained"}
        :else (let [turn-n (inc (count ts))
              ;; deltas are broadcast, never recorded: the final content below is the fact
              ;; volatile notes (budget, hook :tail blocks) ride the tail: the system
              ;; prompt and every stored turn stay byte-stable across steps
              req (request sys id ts)
              req (if-let [note (budget-notice sys cost)]
                    (update req :tail (fn [t] (conj (vec t) {:type :text :text (clojure.string/trim note)})))
                    req)
              rec (vec (:record req))
              resp (step (assoc (with-tail req) :on-delta
                                (fn [d] (stream/delta! world id (assoc d :turn turn-n)))))
              _ (stream/turn-done! world id)
              ;; :record blocks join the transcript where the model saw them: at the
              ;; end of the last user-side turn (rewriting it in place keeps every
              ;; later request's prefix identical to what this one sent)
              ts (if (and (seq rec) (map? resp) (not (contains? resp :error)))
                   (record-into-last! sys id ts rec)
                   ts)]
          (cond
            (not (map? resp))
            {:status :failed :error (str "the model step returned " (pr-str resp) ", not a response map")}

            (contains? resp :error)
            {:status :failed :error (pr-str (:error resp))}

            :else
            (let [content (vec (:content resp))
                  ts (append! sys id ts :assistant content (:usage resp))
                  cost (add-cost! sys id cost (:usage resp))
                  uses (tool-uses content)]
              (if (empty? uses)
                (let [r {:status :idle :result (text-of content)}]
                  (emit sys :turn/end (assoc r :task id))
                  r)
                (let [results (if (= :max-tokens (:stop resp))
                                ;; the output was cut off: the call's input may be incomplete.
                                ;; Answer every call WITHOUT running any, so the history stays paired
                                (vec (map (fn [u] {:id (:id u) :error TRUNCATED-NOTE}) uses))
                                (vec (map (fn [u] (assoc (run-tool sys id u turn-n) :id (:id u))) uses)))
                      done (first (filter :done results))
                      ts (append! sys id ts :tool
                                  (vec (map (fn [r] {:type :tool-result :id (:id r)
                                                     :content (or (:ok r) (:error r))
                                                     :error? (some? (:error r))})
                                            results)))]
                  (emit sys :step/end {:task id :step turn-n :tools (vec (map :name uses))})
                  (if (some? done)
                    (let [r {:status :done :result (:ok done)}]
                      (emit sys :turn/end (assoc r :task id))
                      r)
                    (recur (inc n) (drain! sys id ts) cost)))))))))))

;; ── a scripted model, for tests and offline demos ───────────────────────

(defn- replay-deltas!
  "Stream a canned response the way a provider would: each text block as a few
   word-sized deltas, each tool call's input as its JSON. Lets offline runs
   (tests, demos) exercise the live path exactly."
  [req resp]
  (when-let [f (:on-delta req)]
    (doseq [[i b] (map-indexed (fn [i x] [i x]) (:content resp))]
      (case (:type b)
        :text (doseq [w (map first (Regex/scan (Regex/compile! "\\S+\\s*") (or (:text b) "")))] (f {:block i :kind :text :text w}))
        :tool-use (f {:block i :kind :tool-input :text (pr-str (:input b))})
        nil))))

(defn scripted
  "A `step` fn that replays `responses` in order (then repeats the last). Each
   response may be a map, or a fn of the request (to assert on what was sent).
   Replies stream through the request's :on-delta like a real provider."
  [responses]
  (let [i (atom 0)]
    (fn [req]
      (let [k (swap! i inc)
            r (nth responses (min (dec k) (dec (count responses))))
            resp (if (fn? r) (r req) r)]
        (when (map? resp) (replay-deltas! req resp))
        resp))))

(defn by-goal
  "A `step` fn that routes each request to a scripted model chosen by the task's
   goal (the first user message's text). `routes` maps goal → [responses].
   Concurrent tasks then never consume each other's script."
  [routes]
  (let [models (into {} (map (fn [[g rs]] [g (scripted rs)]) routes))]
    (fn [req]
      (let [goal (get-in (first (:messages req)) [:content 0 :text])]
        (if-let [m (get models goal)]
          (m req)
          {:error {:no-script-for goal}})))))

(defn say [text] {:content [{:type :text :text text}] :stop :end})

(defn call-tool
  ([nm input] (call-tool nm input (str "tu-" nm)))
  ([nm input tid] {:content [{:type :tool-use :id tid :name nm :input input}] :stop :tool-use}))
