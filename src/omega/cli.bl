; omega/cli.bl — the smallest way to use omega from a shell.
;
;   bin/omega "goal"                 one task, live model, prints the conversation
;   bin/omega --offline "goal"       the same against a scripted model (no network)
;   bin/omega --cassette PATH "goal" record/replay the model to PATH (:auto)
;   bin/omega --db DIR "goal"        keep the fact log on disk (fjall) in DIR
;   bin/omega --notify "goal"        desktop notifications (omega.ext.notify)
;   bin/omega --jev "goal"           Jev done-gate + scope check (omega.ext.jev-gate)
;
; The run prints every turn as it lands (sensed from the env, like any other
; observer), then the task's final status, and a summary of what the
; environment now holds. Exit code 0 when the task ended :idle or :done.

(ns omega.cli
  (:require [omega.env :as env]
            [omega.task :as task]
            [omega.loop :as loop]
            [omega.codemode :as codemode]
            [omega.trace :as tr]
            [omega.llm :as llm]
            [omega.ext :as ext]
            [omega.ext.notify :as notify]
            [omega.jev :as jev]
            [omega.ext.jev-gate :as jev-gate]))

(def SYSTEM-PROMPT
  (str "You are omega, a coding agent working in the project at the current root. "
       "You act through ONE tool, `eval`: you write beam-lisp programs that call functions "
       "(read, write, edit, ls, glob, sh, spawn, wait, send, trace, traces, done). "
       "Compose several steps per eval and return only what you need to see. "
       "Read before you edit; edit with exact :old/:new strings. "
       "After changing code, verify it (run it or its tests with sh). "
       "You are one task among possibly many: (trace :finding subject text) when you learn something "
       "others may need; for independent sub-work, (spawn goal) and (wait id). "
       "When the goal is fully achieved, call (done summary) inside an eval. "
       "If you only answered a question, reply with prose and no tool call."))

(defn omega-home
  "Where omega itself lives (its .env holds omega's credentials). bin/omega
   sets OMEGA_HOME; the project being worked on is --root, a different thing."
  []
  (or (System/get_env "OMEGA_HOME") (File/cwd!)))

(defn- parse [args]
  (loop [as args opts {}]
    (if (empty? as)
      opts
      (let [[a & more] as]
        (case a
          "--offline" (recur more (assoc opts :offline true))
          "--notify" (recur more (assoc opts :notify true))
          "--jev" (recur more (assoc opts :jev true))
          "--cassette" (recur (rest more) (assoc opts :cassette (first more)))
          "--db" (recur (rest more) (assoc opts :db (first more)))
          "--root" (recur (rest more) (assoc opts :root (first more)))
          (recur more (update opts :goal (fn [g] (if g (str g " " a) a)))))))))

(defn offline-model
  "A scripted model that exercises the whole loop without a network: it lists
   the root, leaves a finding, and closes the task."
  []
  (loop/scripted
   [(loop/call-tool "eval" {:code "(println (ls))\n(:out (sh \"git log --oneline -3 2>/dev/null || echo no git\"))"} "tu-1")
    (loop/call-tool "eval" {:code "(trace :finding \".\" \"offline demo looked at the root\")\n(done \"Listed the project root and left a finding (offline model).\")"} "tu-2")]))

(defn- block->line [b]
  (case (:type b)
    :text (:text b)
    :tool-use (str "→ " (:name b) " " (pr-str (:input b)))
    :tool-result (let [c (str (:content b))
                       c (if (> (count c) 400) (str (subs c 0 400) " …") c)]
                   (str (if (:error? b) "✗ " "← ") c))
    (pr-str b)))

(defn print-turn [t]
  (println (str "\n── " (name (:role t)) " " (:n t) " ──"))
  (doseq [b (:content t)] (println (block->line b))))

(defn- follow!
  "Print task `id`'s turns as they appear, until it settles."
  [sys id]
  (let [e (:env sys)
        h (env/sense e '[?u :turn/task ?t] :turn)
        printed (atom 0)
        flush! (fn []
                 (let [ts (loop/turns sys id)]
                   (doseq [t (drop @printed ts)] (print-turn t))
                   (reset! printed (count ts))))]
    (loop []
      (flush!)
      (let [s (task/status sys id)]
        (if (or (task/terminal? s) (= :idle s))
          (do (Process/sleep 50) (flush!))
          (do (receive [:omega/sensed :turn _] nil (after 1000 nil))
              (recur)))))
    (env/unsense h)))

(defn run
  "Run one task from argv-style `args`. Returns the final task view."
  [args]
  (let [o (parse args)
        root (or (:root o) (File/cwd!))
        _ (when (nil? (:goal o)) (throw (ex-info "usage: omega [--offline] [--notify] [--jev] [--cassette PATH] [--db DIR] \"goal\"" {})))
        base (if (:offline o) (offline-model) (llm/step (llm/from-env (omega-home))))
        step (if (:cassette o) (llm/cassette base (:cassette o) :auto) base)
        e (env/open (if (:db o) {:path (:db o)} {}))
        sys (task/start-system e {:step step :tools codemode/tools :root root :system-prompt SYSTEM-PROMPT})
        exts (cond-> []
               (:notify o) (conj (notify/extension))
               (:jev o) (conj (jev-gate/extension {:transport (jev/http (or (jev/key-from-env root) (jev/key-from-env (omega-home))))})))
        sys (ext/install sys exts)
        id (task/open! sys {:goal (:goal o)})]
    (println (str "omega · task " id " · " (:goal o)))
    (follow! sys id)
    (let [v (task/view sys id)]
      (println (str "\n══ " id " · " (name (:status v)) " ══"))
      (println (str "result: " (:result v)))
      (println (str "cost:   " (pr-str (select-keys (:cost v) [:input :output :cache-read]))))
      (println (str "traces: " (pr-str (frequencies (map :kind (tr/all e))))))
      (doseq [d (tr/all e {:kind :decision})]
        (println (str "decision: " (:text d) " " (pr-str (or (get-in d [:data :verdicts]) (get-in d [:data :error]))))))
      (when (:notify o) (Process/sleep 500))
      (ext/uninstall sys)
      (task/stop-system! sys)
      v)))

(defn main []
  (let [v (run (vec (BeamLisp/argv)))]
    (when-not (contains? #{:idle :done} (:status v))
      (System/halt 1))))
