; omega/tools.bl — the default tool table.
;
; Full rights by default (decision D10): no plan mode, no permission gate. A
; project that wants one adds a :tool/before hook (omega.ext).
;
;   read   write   edit (edits[] — exact string replacement, all-or-nothing)
;   bash   eval (beam-lisp, through the harness's cell evaluator — D6)
;   spawn  send   wait   trace   done
;
; Paths resolve against the task system's :root (default: the cwd).

(ns omega.tools
  (:require [omega.env :as env]
            [omega.actor :as actor]
            [omega.trace :as tr]
            [harness]))

(defn- root [ctx] (or (get-in ctx [:sys :root]) (File/cwd!)))

(defn- resolve-path [ctx p] (Path/expand p (root ctx)))

(defn- obj [props required]
  {:type "object" :properties props :required required})

(def read-tool
  {:name "read"
   :description "Read a UTF-8 text file. Returns its contents with 1-based line numbers."
   :input-schema (obj {:path {:type "string"}} ["path"])
   :run (fn [ctx {:keys [path]}]
          (let [p (resolve-path ctx path)]
            (if (File/regular? p)
              (let [lines (String/split (File/read! p) "\n")]
                {:ok (join "\n" (map-indexed (fn [i l] (str (inc i) "\t" l)) lines))})
              {:error (str "no such file: " path)})))})

(def write-tool
  {:name "write"
   :description "Create or overwrite a file with the given content. Creates parent directories."
   :input-schema (obj {:path {:type "string"} :content {:type "string"}} ["path" "content"])
   :run (fn [ctx {:keys [path content]}]
          (let [p (resolve-path ctx path)]
            (File/mkdir_p! (Path/dirname p))
            (File/write! p content)
            (tr/claim! (get-in ctx [:sys :env]) (:task ctx) path)
            {:ok (str "wrote " (count content) " bytes to " path)}))})

(defn apply-edits
  "Apply edits [{:old :new}] to `text`, in order. Each :old must occur EXACTLY
   once in the text as it stands when that edit applies. Returns {:ok text} or
   {:error why} — and on error nothing is applied."
  [text edits]
  (reduce (fn [acc ed]
            (if (contains? acc :error)
              acc
              (let [t (:ok acc)
                    old (:old ed)
                    n (count (String/split t old))]
                (cond
                  (= "" old) {:error "an edit's old text is empty"}
                  (= n 1) {:error (str "old text not found: " (pr-str (if (> (count old) 60) (str (subs old 0 60) "…") old)))}
                  (> n 2) {:error (str "old text occurs " (dec n) " times; make it unique: " (pr-str (if (> (count old) 60) (str (subs old 0 60) "…") old)))}
                  :else {:ok (String/replace t old (:new ed) (list (tuple :global false)))}))))
          {:ok text}
          edits))

(def edit-tool
  {:name "edit"
   :description "Edit a file by exact string replacement. `edits` is a list of {old, new}; each `old` must match exactly once. All edits apply, or none."
   :input-schema (obj {:path {:type "string"}
                       :edits {:type "array"
                               :items (obj {:old {:type "string"} :new {:type "string"}} ["old" "new"])}}
                      ["path" "edits"])
   :run (fn [ctx {:keys [path edits]}]
          (let [p (resolve-path ctx path)]
            (if-not (File/regular? p)
              {:error (str "no such file: " path)}
              (let [eds (map (fn [ed] {:old (or (:old ed) (get ed "old")) :new (or (:new ed) (get ed "new"))}) edits)
                    r (apply-edits (File/read! p) eds)]
                (if (contains? r :error)
                  r
                  (do (File/write! p (:ok r))
                      (tr/claim! (get-in ctx [:sys :env]) (:task ctx) path)
                      {:ok (str "applied " (count eds) " edit(s) to " path)}))))))})

(def bash-tool
  {:name "bash"
   :description "Run a shell command in the project root. Returns combined stdout+stderr and the exit status."
   :input-schema (obj {:command {:type "string"}} ["command"])
   :run (fn [ctx {:keys [command]}]
          (let [r (System/cmd "sh" (list "-c" command)
                              (list (tuple :stderr_to_stdout true) (tuple :cd (root ctx))))
                out (elem r 0) code (elem r 1)
                out (if (> (count out) 20000) (str (subs out 0 20000) "\n…[truncated]") out)]
            (if (= 0 code) {:ok out} {:error (str "exit " code "\n" out)})))})

(def eval-tool
  {:name "eval"
   :description "Evaluate beam-lisp code in this task's own namespace (state persists between calls). Returns the value and anything printed."
   :input-schema (obj {:code {:type "string"}} ["code"])
   :run (fn [ctx {:keys [code]}]
          (let [r (harness/eval-cell {:ns (str "omega.task." (:task ctx)) :root (root ctx) :path "eval"}
                                     code 20000)]
            (if (:error r)
              {:error (str (:error r) (when (seq (:stdout r)) (str "\nstdout:\n" (:stdout r))))}
              {:ok (str (when (seq (:stdout r)) (str (:stdout r) "\n")) "=> " (:value r))})))})

(def spawn-tool
  {:name "spawn"
   :description "Open a subtask owned by this task. It runs in parallel; use `wait` to collect its result. Returns the subtask id."
   :input-schema (obj {:goal {:type "string"} :scope {:type "array" :items {:type "string"}}} ["goal"])
   :run (fn [ctx {:keys [goal scope]}]
          (let [open! (get-in ctx [:sys :open!])]
            {:ok (open! (:sys ctx) {:goal goal :owner (:task ctx) :by (:task ctx) :scope scope})}))})

(def send-tool
  {:name "send"
   :description "Send a message to another actor (a task id, or \"human:me\"). kind: note (FYI), ask (expects a reply), steer (change a task's course)."
   :input-schema (obj {:to {:type "string"} :kind {:type "string" :enum ["note" "ask" "steer"]} :text {:type "string"}} ["to" "kind" "text"])
   :run (fn [ctx {:keys [to kind text]}]
          {:ok (actor/send! (get-in ctx [:sys :env]) {:from (:task ctx) :to to :kind (keyword kind) :text text})})})

(def wait-tool
  {:name "wait"
   :description "Block until another task finishes (or goes idle), then return its result. Spends no tokens while waiting."
   :input-schema (obj {:task {:type "string"} :timeout_ms {:type "integer"}} ["task"])
   :run (fn [ctx {:keys [task timeout_ms]}]
          (let [await (get-in ctx [:sys :await])
                v (await (:sys ctx) task (or timeout_ms 600000))]
            (if (= :timeout v)
              {:error (str "timed out waiting on " task)}
              {:ok (str task " is " (name (:status v)) ": " (:result v))})))})

(def trace-tool
  {:name "trace"
   :description "Leave a mark in the shared environment for other tasks: kind finding|intent|blocker|claim (or any word), a subject (path/topic), and text. Or read marks: set read=true with an optional subject prefix."
   :input-schema (obj {:kind {:type "string"} :subject {:type "string"} :text {:type "string"} :read {:type "boolean"}} [])
   :run (fn [ctx {:keys [kind subject text read]}]
          (let [e (get-in ctx [:sys :env])]
            (if read
              {:ok (pr-str (map (fn [v] (select-keys v [:task :kind :subject :text :strength]))
                                (tr/read! e (:task ctx) (cond-> {:min-strength 0.1}
                                                          (some? subject) (assoc :subject-prefix subject)
                                                          (some? kind) (assoc :kind (keyword kind))))))}
              {:ok (tr/leave! e (:task ctx) {:kind (keyword (or kind "finding")) :subject (or subject "") :text text})})))})

(def done-tool
  {:name "done"
   :description "Close this task as complete, with a summary of what was done. Use only when the goal is fully achieved."
   :input-schema (obj {:summary {:type "string"}} ["summary"])
   :run (fn [_ctx {:keys [summary]}] {:ok summary :done true})})

(def default
  [read-tool write-tool edit-tool bash-tool eval-tool spawn-tool send-tool wait-tool trace-tool done-tool])
