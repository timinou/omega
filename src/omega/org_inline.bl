;; Native Org inline marks, projected as data for a host's rich editor.
(ns omega.org-inline (:require [clojure.re] [clojure.edn :as edn] [omega.org-heading-model :as heading]))
(defn- cut [s from size] (erlang/binary_part s from size))
(defn- points [s] (erlang/length (unicode/characters_to_list s)))
(defn- candidate [pattern text kind]
 (when-let [matches (Regex/run pattern text (list (tuple :return :index)))]
  {:from (elem (first matches) 0) :size (elem (first matches) 1)
   :groups (mapv #(if (neg? (elem % 0)) "" (cut text (elem % 0) (elem % 1))) matches) :kind kind}))
(defn- first-match [text]
 (let [link (candidate #"\[\[([^\]\n]+)\]\[([^\]\n]*)\]\]" text :link)
       style (candidate #"(^|[ \t(])([*/_+~=])([^\n]+?)\2(?=$|[ \t.,;:!?)])" text :style)]
  (cond (nil? link) style (nil? style) link (< (:from link) (:from style)) link :else style)))
(defn- style-function [marker]
 (get {"*" "text/bold" "/" "text/emphasis" "_" "text/underline" "+" "text/strike" "~" "text/code" "=" "text/code"} marker))
(declare read-text)
(defn read-text [source seed]
 (loop [remaining source plain "" marks [] serial 0]
  (if-let [match (first-match remaining)]
   (let [groups (:groups match) link? (= :link (:kind match))
         lead (if link? "" (nth groups 1))
         href (when link? (nth groups 1))
         tone (when (and href (starts-with? href "highlight:")) (subs href 10))
         supported? (or (not link?) (contains? #{"amber" "mint" "rose"} tone)
                        (some? (re-find #"^(https?://|mailto:|/|#)" href)))
         inner (nth groups (if link? 2 3))
         code? (and (not link?) (contains? #{"~" "="} (nth groups 2)))
         prefix (str (cut remaining 0 (:from match)) lead)
         parsed (if code? {:text inner :marks []} (read-text inner (str seed "-" serial)))
         start (points (str plain prefix)) length (points (:text parsed))
         function (if link? (if tone "text/highlight" "text/link") (style-function (nth groups 2)))
         call {:id (str seed "-mark-" serial) :function function :version 1 :args (if link? (if tone {:tone tone} {:href href}) {})}
         tail (cut remaining (+ (:from match) (:size match)) (- (erlang/byte_size remaining) (:from match) (:size match)))]
    (if (or (not supported?) (zero? length))
     (recur tail (str plain (cut remaining 0 (+ (:from match) (:size match)))) marks (inc serial))
     (recur tail (str plain prefix (:text parsed))
      (into (conj marks {:call call :from start :to (+ start length)})
            (mapv #(-> % (update :from + start) (update :to + start)) (:marks parsed))) (inc serial))))
   {:text (str plain remaining) :marks marks})))

(defn- fail [reason] (throw (ex-info "Org canvas cannot serialize this edit." {:kind :omega/org-canvas :reason reason})))
;; Native emphasis cannot represent partial-word or crossing ranges. A bounded
;; ordinary Org affiliation retains those exact semantic ranges without execution.
(def inline-functions #{"org/literal" "text/bold" "text/emphasis" "text/italic" "text/underline" "text/strike" "text/code" "text/highlight" "text/link"})
(defn- inline-args? [function args]
 (and (map? args)
  (case function
   "text/link" (and (= #{:href} (set (keys args))) (string? (:href args))
                    (some? (re-find #"^(https?://|mailto:|/|#)" (:href args))))
   "text/highlight" (and (= #{:tone} (set (keys args))) (contains? #{"amber" "mint" "rose"} (:tone args)))
   (empty? args))))
(defn read-data
 "Validate bounded declarative inline ranges and assign projection-local call IDs."
 [text declarations id]
 (let [length (when (string? text) (erlang/length (unicode/characters_to_list text)))]
  (when-not (and length (<= length 65536) (vector? declarations) (<= (count declarations) 512))
   (fail :inline-annotation))
  {:text text :marks
   (mapv (fn [at mark]
    (when-not (and (map? mark) (= #{:from :to :function :version :args} (set (keys mark)))
                  (integer? (:from mark)) (integer? (:to mark)) (<= 0 (:from mark)) (< (:from mark) (:to mark)) (<= (:to mark) length)
                  (contains? inline-functions (:function mark)) (= 1 (:version mark)) (inline-args? (:function mark) (:args mark)))
     (fail :inline-annotation))
    {:from (:from mark) :to (:to mark)
     :call {:id (str id "-annotation-" at) :function (:function mark) :version 1 :args (:args mark)}})
    (range (count declarations)) declarations)}))
(defn read-annotation [prefix text id]
 (when-let [found (Regex/run (Regex/compile! "(?im)^ *#\\+attr_enchant: +:inline +([^\\r\\n]+)\\r?$") prefix)]
  (let [raw (second found)]
   (try
    (when (> (erlang/byte_size raw) 65536) (fail :inline-annotation-size))
    (let [forms (edn/read-string-all raw)]
     (when-not (= 1 (count forms)) (fail :inline-annotation))
     (read-data text (first forms) id))
    (catch _ {:retained true})))))
(defn mark-data [marks]
 (mapv (fn [mark] (merge (select-keys mark [:from :to]) (select-keys (:call mark) [:function :version :args]))) marks))

(defn write-text [block]
 (if (empty? (:marks block)) (:text block)
 (let [text (:text block) points (vec (unicode/characters_to_list text)) marks (:marks block)
       token (fn [m opening?]
               (case (get-in m [:call :function])
                "org/literal" ""
                "text/bold" "*" "text/emphasis" "/" "text/italic" "/" "text/underline" "_" "text/strike" "+" "text/code" "~"
                "text/highlight" (if opening? (str "[[highlight:" (get-in m [:call :args :tone]) "][") "]]")
                "text/link" (if opening? (str "[[" (get-in m [:call :args :href]) "][") "]]")
                (fail :unsupported-inline-function)))]
  (join "" (for [at (range (inc (count points)))]
   (str (join "" (map #(token % false) (reverse (filterv #(= at (:to %)) marks))))
        (join "" (map #(token % true) (filterv #(= at (:from %)) marks)))
        (when (< at (count points)) (unicode/characters_to_binary (list (nth points at))))))))))

(defn literal-ranges [marks]
 (mapv #(select-keys % [:from :to]) (filter #(= "org/literal" (get-in % [:call :function])) marks)))
(defn heading-fields [parsed workflow]
 (heading/fields (:text parsed) workflow (literal-ranges (:marks parsed))))
(defn read-heading
 "Decode rich native text while retaining its native metadata classification.
  Explicit inline affiliations already contain the exact semantic intent."
 [prefix text id workflow]
 (or (read-annotation prefix text id)
  (let [parsed (read-text text id) native (heading/fields text workflow)
        decoded (heading/fields (:text parsed) workflow)
        marks (keep (fn [key]
                (when (and (seq (get decoded key)) (not= (get native key) (get decoded key)))
                 (let [[from to] (case key
                                  :state [(:state/from decoded) (:state/to decoded)]
                                  :priority [(:priority/from decoded) (:priority/to decoded)]
                                  :tags [(:tags/from decoded) (:tags/to decoded)])]
                  {:from from :to to :call {:id (str id "-literal-" (name key)) :function "org/literal" :version 1 :args {}}})))
               [:state :priority :tags])]
   (update parsed :marks into marks))))

(defn write-heading
 "Retain native markup when a heading-aware reread preserves exact rich intent."
 [block workflow]
 (let [native (write-text block) reread (read-heading "" native (:id block) workflow)]
  (if (= [(:text block) (mark-data (:marks block))] [(:text reread) (mark-data (:marks reread))])
   {:text native}
   {:text (:text block) :annotation (edn/write-string (mark-data (:marks block)))})))
