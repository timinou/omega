; omega/env.bl — the environment: one fact store every actor reads and writes.
;
; ══ WHAT THIS IS ════════════════════════════════════════════════════════════
;
; The environment is a datom connection plus a handful of verbs. It is
; deliberately thin: datom already gives transactions, queries, history and
; push subscriptions. What this adds is omega's conventions on top:
;
;   open        → an env (in memory, or durable on disk under :path)
;   tx!         → transact; returns the report
;   q, pull     → read the current value
;   eid         → string id → entity id (nil when absent)
;   id-of       → entity id → string id (for any omega kind)
;   now, new-id → the two impure inputs every fact needs, injectable for tests
;   sense       → subscribe the CALLING process to a pattern: matching commits
;                 arrive as [:omega/sensed tag changes] in its mailbox
;
; An env is a plain map {:conn c :clock f :ids f}. Pass it explicitly; there is
; no global. Two envs never see each other, which is what makes tests hermetic.
;
; NB (observed on beam-lisp main, 2026-10-01): function arguments evaluate
; right-to-left. Never sequence effects through argument position; use let/do.

(ns omega.env
  (:require [datom]
            [datom.store-fjall]
            [omega.schema :as schema]))

(defn- system-ms [] (erlang/system_time :millisecond))

(defn- counter-ids
  "A deterministic id source: \"<prefix>-<n>\", one counter for every prefix,
   continuing after `start` (0 for a fresh env)."
  ([] (counter-ids 0))
  ([start]
   (let [n (atom start)]
     (fn [prefix] (str prefix "-" (swap! n inc))))))

(def ^:private COUNTED-ID-ATTRS [:task/id :msg/id :trace/id])

(defn- highest-id
  "The highest n of every \"<prefix>-<n>\" id stored in `conn`: a reopened
   durable env goes on counting and never reissues an id."
  [conn]
  (let [db (datom/db conn)
        re (Regex/compile! "-([0-9]+)$")]
    (reduce (fn [hi a]
              (reduce (fn [hi [id]]
                        (if-let [m (Regex/run re (str id))]
                          (max hi (erlang/binary_to_integer (second m)))
                          hi))
                      hi
                      (datom/q [:find '?v :where ['?e a '?v]] db)))
            0
            COUNTED-ID-ATTRS)))

(defn- fresh-world
  "A world id unique to this VM. Task ids are unique per world, not per VM, so
   anything VM-global keyed by a task is keyed by [world task] instead (C2)."
  []
  (str "w" (erlang/unique_integer (to-list [:positive]))))

(defn open
  "Open an environment. opts:
     :path    a directory for a durable (fjall) store; omitted → in memory
     :clock   (fn [] ms) — defaults to the system clock
     :ids     (fn [prefix] id) — defaults to a per-env counter
     :schema  extra attribute defs, installed after omega's own (C1): a package
              keeps its facts in the same store, so one query joins them with
              tasks. A durable store may be reopened with or without them.
     :world   this env's world id (default: fresh per open)"
  ([] (open {}))
  ([opts]
   (let [attrs (vec (concat schema/all (:schema opts)))
         conn (if-let [p (:path opts)]
                (datom/connect-with (datom.store-fjall/open p) attrs)
                (datom/connect attrs))]
     {:conn conn
      :world (or (:world opts) (fresh-world))
      :clock (or (:clock opts) system-ms)
      :path (:path opts)
      :ids (or (:ids opts) (counter-ids (if (:path opts) (highest-id conn) 0)))})))

(defn db-path
  "Where project `root` keeps its tasks: `explicit` when given, else
   <root>/.omega/db (one store per project). nil (= in memory) for an omega
   started BY a task (its environment carries the reap tag): that is omega
   testing itself, and the project's store is held by the omega running it."
  [root explicit]
  (cond explicit explicit
        (System/get_env "OMEGA_TASK_TAG") nil
        :else (str root "/.omega/db")))

(defn world
  "The world id of `env` (see `open`)."
  [env]
  (:world env))

(defn open-durable!
  "Open the durable env at `path`, creating it. A store belongs to ONE OS
   process at a time: when another omega has it open, this throws an ex-info
   that says so plainly (instead of datom's typed :store-already-open).
   `opts` as `open` (:schema, :world)."
  ([path] (open-durable! path {}))
  ([path opts]
  (File/mkdir_p! path)
  (try (open (assoc opts :path path))
       (catch err
         (if (= :store-already-open (:reason (ex-data err)))
           (throw (ex-info (str "another omega already has " path " open; close it first, or pass --db DIR or --memory")
                           {:path path :reason :store-already-open}))
           (throw err))))))

(defn close! [env] (datom/close! (:conn env)) :ok)

(defn exit-on-user-error
  "Run `f`; an ex-info carrying `:reason` (an expected condition such as a
   store already open) prints its message as ONE line on stderr and halts
   with 2, instead of a stack trace. Anything else propagates."
  [f]
  (try (f)
       (catch err
         (if (contains? (or (ex-data err) {}) :reason)
           (do (IO/puts :stderr (str "omega: " (ex-message err)))
               (System/halt 2))
           (throw err)))))

(defn now [env] ((:clock env)))
(defn new-id [env prefix] ((:ids env) prefix))

(defn db [env] (datom/db (:conn env)))

(defn tx!
  "Transact `tx-data`; the datom report."
  [env tx-data]
  (datom/transact! (:conn env) tx-data))

(defn q
  "Datalog over the current value. Extra args bind the query's :in."
  [env query & inputs]
  (apply datom/q query (db env) inputs))

(def ^:private ID-ATTRS [:task/id :actor/id :msg/id :trace/id :turn/id])

(defn eid
  "The entity id for an omega string id, looked up under `attr`; nil if absent."
  [env attr id]
  (datom/lookup-ref (db env) [attr id]))

(defn entity
  "The whole entity as a map, or nil."
  [env e]
  (when (some? e) (datom/entity (db env) e)))

(defn id-of
  "The omega string id of entity `e`, whatever its kind."
  [env e]
  (let [m (entity env e)]
    (some (fn [a] (get m a)) ID-ATTRS)))

(defn pull [env pattern e] (datom/pull (db env) pattern e))

(defn history
  "Every value attribute `a` of entity `e` has held: [{:value :added :t}]."
  [env e a]
  (datom/changes (db env) e a))

(defn sense
  "Subscribe the CALLING process to `pattern` (a datom watch pattern such as
   '[?e :task/status :done] or [e :task/status '?s]). Each matching commit
   arrives as [:omega/sensed tag changes]. Returns a handle for `unsense`.

   This is how an actor perceives the environment: not by polling and not by
   a pid link to the writer, but by declaring what it cares about."
  [env pattern tag]
  (let [me (erlang/self)]
    (datom/watch (:conn env) pattern
                 (fn [changes] (erlang/send me [:omega/sensed tag changes])))))

(defn unsense [handle] (datom/unwatch handle) :ok)
