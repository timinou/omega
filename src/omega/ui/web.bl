; omega/ui/web.bl — omega's UI as a beam-lisp live.app, shown in a desktop window.
;
; ══ WHY THIS SHAPE ══════════════════════════════════════════════════════════
;
; beam-lisp already has the whole live UI stack: `live.app` serves a value of
; {routes · worlds · observe · intents · theme}, renders screens server-side,
; holds one socket per viewer, diffs hiccup trees into keyed patch ops, ships
; NEW class rules alongside every patch, and `live/client.js` applies them to
; the real DOM. It is what loom pages run on. This file is just that app; the
; desktop window is a wry webview pointed at it:
;
;   (web/open-window! sys)                    ; served + a native window onto it
;   (web/start! sys {:port 4747})             ; served only: open it in any browser
;
; Nothing here renders, diffs or patches: live.app does. omega supplies:
;   - the worlds: the task env (facts) and a small `ui` conn (ephemeral facts:
;     the turns being streamed right now). Both are OBSERVED, so a commit to
;     either re-renders every viewer — a task finishing, a token arriving.
;   - the intents: the only writes, each a call to the public task verbs.
;   - the screens: omega.ui.screens, unchanged (pure state → hiccup).
;
; Locals (route, open task, theme, drafts) live in each socket — per viewer,
; never shared, never facts.

(ns omega.ui.web
  (:require [proc.reg]          ; registers the defserver `registry` clause live.app needs
            [live.app :as app]
            [loom.desktop]
            [datom]
            [wry]
            [omega.env :as env]
            [omega.actor :as actor]
            [omega.task :as task]
            [omega.stream :as stream]
            [omega.ui.model :as model]
            [omega.ui.theme :as th]
            [omega.ui.screens :as screens]
            [omega.ui.demo]
            [omega.llm]
            [omega.codemode]
            [omega.cli]
            [omega.ext]
            [omega.ext.notify]))

;; ── the ephemeral world: what is being written right now ────────────────

(def ui-schema
  [{:db/ident :live/task :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :live/turn :db/valueType :db.type/long}
   {:db/ident :live/blocks}
   ;; what a task is doing now ({:tool :code :since :sh :sh-since}) and a clock
   ;; that moves once a second while anything is active, so elapsed times tick
   {:db/ident :act/task :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :act/doing}
   {:db/ident :clock/id :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :clock/now :db/valueType :db.type/long}])

(defn merge-activity
  "Fold an activity patch into a task's current activity; nil (or nothing
   left) means idle."
  [cur patch]
  (when (some? patch)
    (let [m (reduce-kv (fn [m k v] (if (nil? v) (dissoc m k) (assoc m k v))) (or cur {}) patch)]
      (when (contains? m :tool) m))))

(defn activity-map
  "task id → what it is doing now, plus :now (ms) from the ticking clock."
  [ui-conn]
  (let [db (datom/db ui-conn)
        now (first (first (datom/q '[:find ?n :where [?c :clock/id "clock"] [?c :clock/now ?n]] db)))]
    (into {} (map (fn [[t d]] [t (assoc d :now (or now (erlang/system_time :millisecond)))])
                  (datom/q '[:find ?t ?d :where [?e :act/task ?t] [?e :act/doing ?d]] db)))))

(defn apply-delta
  "Fold one streamed delta into a task's partial turn {:turn n :blocks {i {:kind :text}}}.
   A delta for a NEW turn starts over."
  [cur d]
  (let [cur (if (= (:turn cur) (:turn d)) cur {:turn (:turn d) :blocks {}})]
    (update-in cur [:blocks (:block d)]
               (fn [b] {:kind (:kind d) :text (str (:text b) (:text d))}))))

(defn- live-map [ui-conn]
  (into {} (map (fn [[t n bs]] [t {:turn n :blocks bs}])
                (datom/q '[:find ?t ?n ?b :where [?e :live/task ?t] [?e :live/turn ?n] [?e :live/blocks ?b]]
                         (datom/db ui-conn)))))

(defn- stream-pump
  "Join omega's delta broadcast and mirror each task's partial turn into the
   ui conn, at most every 80 ms (≈12 renders/s however fast the model is).
   A finished turn is retracted: the recorded turn in the env replaces it."
  [ui-conn]
  (spawn (fn []
           (stream/watch!)
           (loop [pending {} done #{} acts {} dirty #{} tick 0]
             (receive
               :stop :stopped
               [:omega/delta t d] (recur (update pending t (fn [cur] (apply-delta (or cur (get (live-map ui-conn) t)) d))) (disj done t) acts dirty tick)
               [:omega/turn-done t] (recur (dissoc pending t) (conj done t) acts dirty tick)
               [:omega/activity t p] (recur pending done (assoc acts t (merge-activity (get acts t) p)) (conj dirty t) tick)
               (after 80
                 (let [now (erlang/system_time :millisecond)
                       tick? (and (some some? (vals acts)) (>= (- now tick) 1000))]
                   (when (seq pending)
                     (datom/transact! ui-conn (vec (map (fn [[t lt]] {:db/id -1 :live/task t :live/turn (:turn lt) :live/blocks (:blocks lt)})
                                                        pending))))
                   (doseq [t done]
                     (when-let [e (datom/lookup-ref (datom/db ui-conn) [:live/task t])]
                       (datom/transact! ui-conn [[:db/retractEntity e]])))
                   (doseq [t dirty]
                     (if-let [a (get acts t)]
                       (datom/transact! ui-conn [{:db/id -1 :act/task t :act/doing a}])
                       (when-let [e (datom/lookup-ref (datom/db ui-conn) [:act/task t])]
                         (datom/transact! ui-conn [[:db/retractEntity e]]))))
                   (when tick? (datom/transact! ui-conn [{:db/id -1 :clock/id "clock" :clock/now now}]))
                   (recur {} #{} (into {} (filter (fn [[_ a]] (some? a)) acts)) #{} (if tick? now tick)))))))))

;; ── the screen ──────────────────────────────────────────────────────────

(defn- ui-from-locals
  "The screens' ui map, from this socket's locals."
  [locals]
  {:task (get locals :task)
   :theme (if (= "light" (str (get locals :theme))) :light :dark)
   :drafts (get locals :drafts {})})

(defn home-screen
  "omega's one route: overview or task detail, by the socket's :task local."
  [sys ui-conn]
  (fn [{:keys [locals]}]
    (let [ui (ui-from-locals locals)]
      (screens/view {:snap (model/snapshot (:env sys))
                     :ui ui
                     :live (live-map ui-conn)
                     :activity (activity-map ui-conn)
                     :detail (when (:task ui) (model/task-detail sys (:task ui)))}))))

;; ── intents: the only writes, each one public task verb ─────────────────

(defn- trimmed [x] (let [s (clojure.string/trim (str x))] (when (seq s) s)))

(defn intents [sys]
  {:new-task (fn [_conn p _who] (when-let [g (trimmed (:value p))] (task/open! sys {:goal g})) nil)
   :say (fn [_conn p _who] (when-let [m (trimmed (:value p))] (task/say! sys (:task p) m)) nil)
   :answer (fn [_conn p _who] (actor/reply! (:env sys) (:msg p) (:choice p)) nil)})

;; ── the app value ───────────────────────────────────────────────────────

(defn app-value [sys ui-conn]
  (let [screen (home-screen sys ui-conn)]
    {:home "/"
     :title "omega"
     :routes [["/" screen]]
     :principal (fn [_conn] "human:me")
     :worlds (fn [_me _params] {})
     :observe (fn [_me] [(:conn (:env sys)) ui-conn])
     :shared-conn (:conn (:env sys))
     :intents (intents sys)
     :theme (fn [locals] (th/install! (if (= "light" (str (get-in locals [:theme]))) :light :dark)))
     :warm ["/"]}))

(defn- upstream-desktop?
  "Whether this beam-lisp has loom.desktop/serve-window (branch
   loom-desktop-live). Until it is merged, omega serves and opens the window
   itself; once it is, the same call goes through upstream — no edit here."
  []
  (try (number? (loom.desktop/free-port)) (catch _ false)))

(defn- free-port []
  (if (upstream-desktop?)
    (loom.desktop/free-port)
    (let [r (gen_tcp/listen 0 (list (tuple :ip (tuple 127 0 0 1))))
          sock (elem r 1)
          port (elem (inet/port sock) 1)]
      (gen_tcp/close sock)
      port)))

(defn- prepare
  "The ephemeral ui conn and its stream pump, for task system `sys`."
  []
  (let [ui-conn (datom/connect ui-schema)]
    {:ui-conn ui-conn :pump (stream-pump ui-conn)}))

(defn start!
  "Serve omega's UI for task system `sys` on loopback, without a window (for a
   browser, or tests). opts :port (default 4747; :free picks an unused one).
   Returns {:url :port :ui-conn :pump}."
  ([sys] (start! sys {}))
  ([sys opts]
   (let [port (let [p (:port opts)] (cond (= :free p) (free-port) (nil? p) 4747 :else p))
         {:keys [ui-conn pump]} (prepare)]
     (app/serve (app-value sys ui-conn) {:port port :ip (tuple 127 0 0 1) :log nil})
     {:url (str "http://127.0.0.1:" port "/") :ui-conn ui-conn :pump pump :port port})))

(defn open-window!
  "Serve omega's UI AND open a native window onto it. Uses
   loom.desktop/serve-window when beam-lisp has it. opts :port :width :height.
   Returns {:url :port :ui-conn :pump :window}."
  ([sys] (open-window! sys {}))
  ([sys opts]
   (let [size {:width (or (:width opts) 1100) :height (or (:height opts) 760) :title "omega"}]
     (if (upstream-desktop?)
       (let [{:keys [ui-conn pump]} (prepare)
             w (loom.desktop/serve-window (app-value sys ui-conn)
                                          (merge size (when (number? (:port opts)) {:port (:port opts)})))]
         (assoc (select-keys w [:url :port :window]) :ui-conn ui-conn :pump pump))
       (let [ui (start! sys {:port (or (:port opts) :free)})]
         (assoc ui :window (wry/open (assoc size :url (:url ui)))))))))

;; ── bin/omega-ui ────────────────────────────────────────────────────────

(defn- main*
  [args]
  (let [flag? (fn [f] (some (fn [a] (= a f)) args))
        opt (fn [f] (second (drop-while (fn [a] (not= a f)) args)))
        root (or (opt "--root") (File/cwd!))
        home (or (System/get_env "OMEGA_HOME") (File/cwd!))
        db (when-not (or (flag? "--demo") (flag? "--memory")) (env/db-path root (opt "--db")))
        sys (if (flag? "--demo")
              (omega.ui.demo/start! "/tmp/omega-ui-demo")
              (task/start-system (if db (env/open-durable! db) (env/open))
                                 {:step (omega.llm/step (omega.llm/from-env home))
                                  :tools omega.codemode/tools :root root
                                  :system-prompt omega.cli/SYSTEM-PROMPT}))
        sys (omega.ext/install sys (if (flag? "--notify") [(omega.ext.notify/extension)] []))
        interrupted (task/recover! sys)
        _ (when db (println (str "omega: tasks are kept in " db
                                 (when (seq interrupted) (str " · interrupted: " (clojure.string/join " " interrupted))))))
        port (if-let [p (opt "--port")] (erlang/binary_to_integer p) 4747)]
    (if (flag? "--no-window")
      (let [ui (start! sys {:port port})]
        (println (str "omega UI at " (:url ui)))
        (receive :never nil))
      (let [ui (open-window! sys {:port port})]
        (println (str "omega UI at " (:url ui) (if (upstream-desktop?) " (loom.desktop/serve-window)" "")))
        ;; the window's IPC receiver exits when the window closes
        (erlang/monitor :process (:receiver (:window ui)))
        (receive [:DOWN _ :process _ _] :closed)))
    (task/stop-system! sys)
    (when db (env/close! (:env sys)))))

(defn main
  "bin/omega-ui: serve omega's UI over a live task system rooted at --root
   (default cwd), or over the offline demo world with --demo, and open a
   native window onto it. --no-window serves only (open the URL in a
   browser). Blocks until the window closes (or forever with --no-window)."
  []
  (env/exit-on-user-error (fn [] (main* (vec (BeamLisp/argv))))))
