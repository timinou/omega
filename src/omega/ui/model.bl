; omega/ui/model.bl — what a screen shows, as plain data projected from the env.
;
; The UI never reads processes, never holds authoritative state (D1). A
; snapshot is a pure projection of the fact log at one moment; screens are pure
; functions of (snapshot, ui-state). That makes every screen testable without a
; window: build an env, project, render, assert on the hiccup.
;
;   (snapshot env now) → {:tasks [...] :human {...} :traces [...] :now ms}
;
; Tasks are grouped by URGENCY (impeccable §7.1): what needs the human first,
; then what is running, then what waits, then what is finished.

(ns omega.ui.model
  (:require [omega.env :as env]
            [omega.actor :as actor]
            [omega.trace :as tr]
            [omega.loop :as loop]))

(def STALE-MS
  "A running task whose newest trace is older than this is shown as stale."
  300000)

(def ^:private TASK-PULL
  [:task/id :task/goal :task/title :task/status :task/scope :task/result :task/cost :task/at
   :task/cwd :task/home-path :task/home-block
   {:task/place [:place/id]} {:task/owner [:task/id]} {:task/waits-on [:task/id]}])

(defn- last-trace-at [traces id]
  (reduce (fn [m t] (if (= id (:task t)) (max m (or (:at t) 0)) m)) 0 traces))

(defn task-row
  "One task as the overview shows it."
  [e m traces asks now]
  (let [id (:task/id m)
        last-at (max (last-trace-at traces id) (or (:task/at m) 0))
        st (:task/status m)
        ;; Keep message history, but a closed task cannot act on an answer.
        my-asks (when-not (contains? #{:done :failed :cancelled} st)
                  (filter (fn [a] (= id (:from a))) asks))]
    {:id id
     :title (or (:task/title m) id)
     :goal (:task/goal m)
     :place (get-in m [:task/place :place/id])
     :cwd (:task/cwd m)
     :home (when (:task/home-path m) {:path (:task/home-path m) :block (:task/home-block m)})
     :status st
     :owner (get-in m [:task/owner :task/id])
     :scope (vec (or (:task/scope m) []))
     :result (:task/result m)
     :cost (:task/cost m)
     :age-ms (- now last-at)
     :stale? (and (contains? #{:running :waiting} st) (> (- now last-at) STALE-MS))
     :asks (vec my-asks)
     :claims (vec (keep (fn [t] (when (and (= id (:task t)) (= :claim (:kind t))) (:subject t))) traces))}))

(defn- narrow-traces
  "The {:task :kind :subject :at} fields task-row reads, for task entity `t` only."
  [e t id]
  (mapv (fn [tr]
          (let [m (env/pull e [:trace/kind :trace/subject :trace/at] tr)]
            {:task id :kind (:trace/kind m) :subject (:trace/subject m) :at (:trace/at m)}))
        (map first (env/q e '[:find ?tr :in $ ?t :where [?tr :trace/task ?t]] t))))

(defn task-rows
  "Overview rows for exactly the tasks `ids` (unknown ids skipped), in `ids`
   order, same shape as snapshot's :tasks rows. Touches only the selected
   tasks' attributes and traces; never turns or other tasks. Optional `now`."
  ([e ids] (task-rows e ids (env/now e)))
  ([e ids now]
   (let [human "human:me"
         asks (if (env/eid e :actor/id human)
                (filter (fn [m] (= :ask (:kind m))) (actor/inbox e human))
                [])]
     (vec (keep (fn [id]
                  (when-let [t (env/eid e :task/id id)]
                    (task-row e (env/pull e TASK-PULL t) (narrow-traces e t id) asks now)))
                ids)))))

(defn group-of
  "Which overview group a task row belongs in."
  [row]
  (cond
    (seq (:asks row)) :needs-you
    (= :failed (:status row)) :needs-you
    (= :idle (:status row)) :needs-you
    (:stale? row) :stale
    (= :running (:status row)) :running
    (contains? #{:open :waiting} (:status row)) :waiting
    :else :finished))

(def GROUPS
  [[:needs-you "Needs you"]
   [:running "Running"]
   [:waiting "Waiting"]
   [:stale "Stale"]
   [:finished "Finished"]])

(defn snapshot
  "Project the env into everything the screens need."
  ([e] (snapshot e (env/now e)))
  ([e now]
   (let [traces (tr/all e)
         human "human:me"
         asks (if (env/eid e :actor/id human) (filter (fn [m] (= :ask (:kind m))) (actor/inbox e human)) [])
         ids (map first (env/q e '[:find ?t :where [?t :task/id _]]))
         rows (map (fn [t] (task-row e (env/pull e TASK-PULL t) traces asks now)) ids)
         rows (sort-by (fn [r] [(- (or (:age-ms r) 0)) (:id r)]) rows)]
     {:now now
      :tasks (vec (reverse rows))
      :by-group (group-by group-of rows)
      :asks (vec asks)
      :traces traces})))

(defn task-detail
  "Everything the task screen shows for task `id`."
  [sys id]
  (let [e (:env sys)]
    {:turns (loop/turns sys id)
     :traces (tr/all e {:task id})
     :messages (actor/messages e id)}))
