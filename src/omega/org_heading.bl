;; Pure source-backed heading plans. Presentation is installed only once the
;; complete heading package and source workflow snapshot have qualified.
(ns ^:js omega.org-heading
 (:require [omega.org-heading-model :as heading] [live.edit.document :as document]))
(defn workflow [doc] (get-in doc [:meta :org/workflow] heading/default-workflow))
(defn fields [block doc] (heading/fields (:text block) (workflow doc)
  (mapv #(select-keys % [:from :to]) (filter #(= "org/literal" (get-in % [:call :function])) (:marks block)))))
(defn title-range [block context]
 (let [f (fields block (:document context))]
  {:from (:title/from f) :to (:title/to f) :isolated true :label "Heading title"}))
(defn- plain-insert [id at text]
 {:op "text/replace" :block id :from at :to at :text text :expected "" :styles []})
(defn- separators
 "Keep source separators outside an initially empty title. The inserted content
  retains its own marks; native IME and inline replacement use this same plan."
 [context input]
 (let [op (:op input) doc (:document context) block (document/find-block doc (:block op))]
  (when (and (= "heading" (:type block)) (= "text/replace" (:op op))
             (string? (:text op)) (not (empty? (:text op))))
   (let [f (fields block doc) at (:title/from f) to (:title/to f)
         text (:text block) before (heading/slice text 0 at) after (heading/slice text to (heading/length text))
         prefix (when (and (not (empty? before)) (not (re-find #"[ \t]$" before))) " ")
         suffix (when (and (not (empty? after)) (not (re-find #"^[ \t]" after))) " ")]
    (when (and (= at to (:from op) (:to op)) (or prefix suffix))
     (let [start (+ at (heading/length (or prefix ""))) end (+ start (heading/length (:text op)))
           point {:block (:id block) :offset end :affinity "right"}
           selection (:selection input)
           move (fn [point]
                  (if (= (:id block) (:block point)) (update point :offset + (- start at)) point))]
      {:op {:op "batch" :ops (vec (concat
              (when prefix [(plain-insert (:id block) at prefix)])
              [(assoc op :from start :to start :expected "")]
              (when suffix [(plain-insert (:id block) end suffix)])))}
       :selection (if (and selection (= (:id block) (get-in selection [:anchor :block]) (get-in selection [:head :block])))
                    {:anchor (move (:anchor selection)) :head (move (:head selection))}
                    {:anchor point :head point})}))))))

(def literal-function
 {:label "Literal Org text" :kind "wrap" :scope "inline" :version 1 :params {}
  :render (fn [_ content] [:span content])})
(defn- replacement [block f key value]
 (let [text (:text block)]
  (case key
   :state (if (:state f)
            {:from (:state/from f) :to (if value (:state/to f) (:state/next f)) :text (or value "")}
            {:from (:state/from f) :to (:state/from f) :text (str value " ")})
   :priority (if (:priority f)
               {:from (:priority/from f) :to (if (empty? value) (:title/from f) (:priority/to f))
                :text (if (empty? value) "" (str "[#" value "]"))}
               {:from (:priority/from f) :to (:priority/from f) :text (str "[#" value "] ")})
   :tags (let [token (when (seq value) (str ":" (join ":" value) ":"))]
           (if (:tags/from f)
            {:from (if token (:tags/from f) (:title/to f)) :to (:tags/to f) :text (or token "")}
            {:from (:title/to f) :to (:title/to f) :text (if token (str " " token) "")}))
   :title (let [from (:title/from f) to (:title/to f) empty-title? (empty? (:title f))
                before (heading/slice text 0 from) after (heading/slice text to (heading/length text))]
            {:from from :to to :text (str (when (and empty-title? (seq before) (not (re-find #"[ \t]$" before))) " ")
                                     value (when (and empty-title? (seq after) (not (re-find #"^[ \t]" after))) " "))}))))
(defn protect-metadata
 "A title edit cannot implicitly create new metadata. Literal calls carry that
  intent through native source, rich annotations, copy and subsequent typing."
 [doc id expected seed]
 (let [block (document/find-block doc id) actual (fields block doc)]
  (vec (keep (fn [key]
               (when (and (seq (get actual key)) (not= (get expected key) (get actual key)))
                (let [[from to] (case key :state [(:state/from actual) (:state/to actual)]
                                      :priority [(:priority/from actual) (:priority/to actual)]
                                      :tags [(:tags/from actual) (:tags/to actual)])]
                 {:op "style/set" :block id :from from :to to :function "org/literal"
                  :id (str seed "/literal-" (name key)) :args {} :enabled true}))) [:state :priority :tags]))))
(defn plan-fields
 "Plan only the requested native fields with standard mapped operations.
  Untouched lexical seams and rich ranges remain source owned."
 [doc id changes seed]
 (let [changes (heading/validate-changes (workflow doc) changes)
       initial (fields (document/find-block doc id) doc)
       expected (merge (select-keys initial [:state :priority :tags]) (select-keys changes [:state :priority :tags]))
       expected (if (= "" (:priority expected)) (assoc expected :priority nil) expected)
       registry {"org/literal" literal-function}]
  (loop [keys [:state :priority :tags :title] current doc ops [] intent (select-keys initial [:state :priority :tags])]
   (if (empty? keys)
    (let [extra (protect-metadata current id expected seed)
          after (reduce #(-> (document/apply-trusted registry %1 %2) :document) current extra)
          actual (fields (document/find-block after id) after)]
     (when-not (= expected (select-keys actual [:state :priority :tags]))
      (throw (ex-info "This change would reclassify native Org metadata." {})))
     {:ops (into ops extra) :document after})
    (let [key (first keys) block (document/find-block current id) f (fields block current)
          value (get changes key) equal-value (if (and (= key :priority) (= "" value)) nil value)]
     (if (or (not (contains? changes key)) (= (get f key) equal-value)) (recur (rest keys) current ops intent)
      (let [edit (replacement block f key value)
            op (merge edit {:op "text/replace" :block id :expected (heading/slice (:text block) (:from edit) (:to edit)) :styles []})
            next (:document (document/apply-trusted registry current op))
            intent (if (= key :title) intent (assoc intent key equal-value))
            extra (protect-metadata next id intent (str seed "/" (name key)))
            next (reduce #(-> (document/apply-trusted registry %1 %2) :document) next extra)]
       (recur (rest keys) next (into (conj ops op) extra) intent))))))))

(defn- simulate-input [doc op]
 (let [op (if (contains? op :styles)
             (-> op (assoc :styles [] :restore (mapv (fn [call] {:from 0 :to (heading/length (:text op)) :call call}) (:styles op)))) op)]
  (:document (document/apply-trusted {} doc op))))
(defn typing
 "Plan title input, including required native separators and literal-looking
  words. The declared field never edits metadata through a text-input event."
 [context input]
 (let [op (:op input) doc (:document context) block (document/find-block doc (:block op))]
  (when (and (= "heading" (:type block)) (= "text/replace" (:op op)))
   (let [f (fields block doc)]
    (when-not (and (<= (:title/from f) (:from op) (:to op) (:title/to f))
                  (not (re-find #"[\r\n]" (:text op))))
     (throw (ex-info "Edit the heading title here; use its fields for metadata and Enter for a new paragraph." {})))
    (let [envelope (separators context input)
          planned-op (or (:op envelope) op)
          ops (if (= "batch" (:op planned-op)) (:ops planned-op) [planned-op])
          after (reduce simulate-input doc ops)
          literal (protect-metadata after (:id block) (select-keys f [:state :priority :tags]) (:seed input))]
     (when (or envelope (seq literal))
      (cond-> {:op (if (= 1 (count (into ops literal))) (first ops) {:op "batch" :ops (into ops literal)})}
        (contains? envelope :selection) (assoc :selection (:selection envelope)))))))))
(defn- selected-heading [context]
 (let [selection (:selection context) a (:anchor selection) z (:head selection)
       block (document/find-block (:document context) (:block a))]
  (when (and block (= "heading" (:type block)) (= (:block a) (:block z)))
   [block (min (:offset a) (:offset z)) (max (:offset a) (:offset z))])))
(defn heading-selection? [context] (boolean (selected-heading context)))
(defn paragraph
 "Keep heading metadata and identity together. Enter moves only the right title
  into a fresh ordinary paragraph; at the beginning it inserts before the heading."
 [context _]
 (let [[block from to] (selected-heading context) doc (:document context)
       f (fields block doc) start (:title/from f) end (:title/to f)
       _ (when-not (and block (<= start from to end)) (throw (ex-info "Select a heading title." {})))
       id (str (:seed context) "/paragraph") beginning? (= start from to)
       text (if beginning? "" (heading/slice (:text block) to end))
       marks (if beginning? []
               (vec (keep (fn [mark]
                           (let [a (max to (:from mark)) z (min end (:to mark))]
                            (when (< a z) (assoc mark :from (- a to) :to (- z to))))) (:marks block))))
       fresh (assoc (document/block id text) :marks marks :parent (:parent block) :slot (:slot block "body"))
       remove (when-not beginning? {:op "text/replace" :block (:id block) :from from :to end
                                     :expected (heading/slice (:text block) from end) :text "" :styles []})
       after (if remove (:document (document/apply-trusted {} doc remove)) doc)
       literal (when remove (protect-metadata after (:id block) (select-keys f [:state :priority :tags]) (str (:seed context) "/enter")))
       insert {:op "node/insert" :blocks [fresh] :parent (:parent block) :slot (:slot block "body")
               :after (if beginning? (document/previous-sibling doc block) (:id block))}
       point {:block id :offset 0 :affinity "right"}]
  {:ops (vec (concat (when remove [remove]) literal [insert])) :selection {:anchor point :head point}}))
(defn- boundary [context backward?]
 (let [doc (:document context) selection (:selection context) a (:anchor selection) z (:head selection)
       block (document/find-block doc (:block a)) index (when block (document/block-index doc (:id block)))
       same? (and block (= (select-keys a [:block :offset]) (select-keys z [:block :offset])))
       f (when (= "heading" (:type block)) (fields block doc))
       neighbour (when (and same? (if backward? (= (:offset a) 0) (= (:offset a) (heading/length (:text block)))))
                   (nth (:blocks doc) (+ index (if backward? -1 1)) nil))]
  (cond
   (and same? f (= (:offset a) (if backward? (:title/from f) (:title/to f)))) a
   (and same? (= "heading" (:type neighbour)))
   {:block (:id neighbour) :offset (get (fields neighbour doc) (if backward? :title/to :title/from)) :affinity "right"})))
(defn backward-boundary? [context] (boolean (boundary context true)))
(defn forward-boundary? [context] (boolean (boundary context false)))
(defn backward-boundary [context _]
 (let [point (boundary context true)] {:ops [] :selection {:anchor point :head point}}))
(defn forward-boundary [context _]
 (let [point (boundary context false)] {:ops [] :selection {:anchor point :head point}}))
