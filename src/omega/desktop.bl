; The window is a client. Host acquisition remains pelagic.launch/omega.dev.
(ns omega.desktop (:require [pelagic.launch :as launch] [wry] [loom.desktop :as desktop]))
(defn options [args]
  (let [demo? (some #{"--demo"} args)
        browser? (some #{"--browser"} args)
        host-args (vec (remove #{"--demo" "--browser"} args))
        host-args (if (or demo? (some #{"--live"} host-args)) host-args (conj host-args "--live"))]
    (when (and demo? (some #{"--live"} host-args))
      (throw (ex-info "Choose --demo or --live" {})))
    {:browser? browser? :host-args (conj host-args "--preset" "home")}))
(defn open!
  "Attach a native client to an existing host. The caller owns its Window.
   Does not serve another application, start a task system or stop the host."
  ([url] (open! url {}))
  ([url opts]
   (when-not (desktop/available?)
     (throw (ex-info "Native WebView is unavailable. Use bl omega -- --browser." {})))
   (wry/open (merge {:title "Omega" :width 1280 :height 850 :url url} opts))))
(defn wait!
  "Wait for window close without owning the world's lifetime. Wry eval refuses
   a closed native handle; finally also retracts its IPC receiver."
  [window]
  (try
    (loop []
      (when (try (wry/eval window "void 0") true (catch _ false))
        (receive :stop nil (after 1000 (recur)))))
    (finally (wry/close window))))
(defn run! [args]
  (let [{:keys [browser? host-args]} (options args)
        config (launch/route-config)
        opts (launch/options host-args (or (:port config) 8812))]
    (launch/dev! host-args)
    (let [url (launch/preset-url (:port opts) "home")]
      (if (or browser? (not (desktop/available?)))
        (println (str "Omega Home: " url (when-not browser? " · native WebView unavailable; open this URL")))
        (do (println (str "Omega window: " url " · closing it keeps the shared world running"))
            (wait! (open! url)))))))
