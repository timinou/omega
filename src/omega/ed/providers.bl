; omega/ed/providers.bl — omega's documents and intents for bl-ed.
;
; Turns a running task system into the provider map and intent map the bl-ed
; server takes (bl-ed.serve/start! {:providers … :intents …}). Every view is a
; pure renderer (omega.ed.render) over a projection omega.ui already uses; this
; namespace reads the world, maintains scratch/query side files, and maps
; intents onto the public task verbs. It holds NO authority of its own: writes
; are task/open! task/say! task/steer! task/cancel! actor/reply! (D1).
;
;   (providers sys opts) → {"omega" p "task" p "q" p "effects" p}
;   (intents sys opts)   → {"task/open" f "task/say" f "task/steer" f "task/cancel" f
;                           "msg/answer" f "cell/to-scratch" f "q/new" f}
;
; opts {:state dir} — where the side files live (default <root>/.omega/ed):
;   scratch.bl.org  the one writable virtual document (omega:scratch)
;   homes.edn       legacy {task-id {:path p :block id}}; new homes are task facts
;   queries.edn     {qid text} — the q: documents' query texts
;
; Revs & cache. A rev is the hash of the rendered TEXT, so a re-render that
; changes nothing never reloads the page. A rendered doc is reused while ALL of
; its dependencies hold (see `cached`): the store's basis-t, the side files it
; read (content hash), and the clock — each doc records the instant its coarsest
; displayed age next ticks (`:until`), so ages are never stale and an idle poll
; never re-renders. Concurrent callers of one cold key share one render
; (single-flight, per key); the cache is bounded (MAX-ENTRIES, oldest out).
; Counters: (cache-stats cache) — pass {:cache (atom {})} in opts to read them.

(ns omega.ed.providers
  (:require [omega.env :as env]
            [omega.task :as task]
            [omega.actor :as actor]
            [omega.loop :as loop]
            [omega.trace :as tr]
            [omega.codemode :as cm]
            [omega.ui.model :as model]
            [omega.ed.render :as r]
            [clojure.edn]
            [clojure.string :as str]))

; ─── side files ─────────────────────────────────────────────────────────────

(defn state-dir [sys opts]
  (or (:state opts) (str (or (:root sys) (File/cwd!)) "/.omega/ed")))

(defn- read-edn [path]
  (if (File/regular? path) (try (clojure.edn/read-string (File/read! path)) (catch _ {})) {}))

(defn- write-edn! [path v]
  (File/mkdir_p! (Path/dirname path))
  (File/write! path (pr-str v)))

(def SCRATCH-SEED "#+TITLE: omega scratch — tasks with no home, and your notes\n")

(defn- rev [s] (str (erlang/phash2 (str s) 4294967296)))

; ─── the cache ──────────────────────────────────────────────────────────────
; cache = (atom {:entries {key entry} :stats {counter n}})
; entry = {:basis :sig :doc :until :stable :at :flight :owner}

(def MAX-ENTRIES 64)

(defn- basis [sys] (datom.db/basis-t (env/db (:env sys))))

(defn- ms [] (erlang/monotonic_time :millisecond))

(defn- bump! [cache k n]
  (swap! cache update-in [:stats k] (fn [x] (+ (or x 0) n))))

(defn- timed
  "Run f, adding its wall time to the :ms/<phase> counter — the phases of a
   render (snapshot, detail, query…) stay separable."
  [cache phase f]
  (let [t0 (ms) v (f)]
    (bump! cache (keyword (str "ms/" (name phase))) (- (ms) t0))
    v))

(defn cache-stats
  "Counters so far: :hit :miss :render :wait :evict :ms/render + :ms/<phase>,
   and :entries (current size)."
  [cache]
  (assoc (:stats @cache) :entries (count (:entries @cache))))

(defn- dep-sig
  "Content hash of each side file (nil when absent): a hand edit, an intent
   write or a sidefile appearing all change it; mtime's 1 s resolution would not."
  [sys opts files]
  (mapv (fn [f] (let [p (str (state-dir sys opts) "/" f)]
                  (when (File/regular? p) (erlang/phash2 (File/read! p)))))
        files))

(defn- fresh? [e b sig now]
  (and e (:doc e)
       (= b (:basis e)) (= sig (:sig e))
       (<= (:at e) now)
       (or (nil? (:until e)) (< now (:until e)))))

(defn- flying? [e] (and (:flight e) (erlang/is_process_alive (:owner e))))

(defn- evict [entries keep-k]
  (if (<= (count entries) MAX-ENTRIES)
    entries
    (let [victim (first (sort-by (fn [[_ e]] (or (:stored e) 0))
                                 (filter (fn [[k e]] (and (not= k keep-k) (not (:flight e)))) entries)))]
      (if victim (dissoc entries (first victim)) entries))))

(defn- cached
  "The doc for key `k`, rendered at most once per (basis, side-file sig, clock
   tick). `deps` names the side files `render` reads. `render` → doc, optionally
   with :until (ms: when a displayed age next changes) and :stable (a value; an
   unchanged one keeps the previous doc, e.g. a query's timing field)."
  [cache sys opts k deps render]
  (let [b (basis sys)
        sig (dep-sig sys opts deps)
        now (env/now (:env sys))
        e (get-in @cache [:entries k])]
    (cond
      (fresh? e b sig now) (do (bump! cache :hit 1) (:doc e))
      (flying? e) (do (bump! cache :wait 1) (Process/sleep 5) (cached cache sys opts k deps render))
      :else
      (let [token (erlang/unique_integer (list :positive))]
        (swap! cache update-in [:entries k] (fn [x] (if (flying? x) x (assoc x :flight token :owner (erlang/self)))))
        (if (not= token (get-in @cache [:entries k :flight]))
          (cached cache sys opts k deps render)
          (try
            (let [t0 (ms)
                  d (render now)
                  _ (bump! cache :miss 1)
                  _ (bump! cache :render 1)
                  _ (bump! cache :ms/render (- (ms) t0))
                  keep? (and e (:doc e) (some? (:stable d)) (= (:stable d) (:stable e)))
                  doc (if keep? (:doc e) (let [d (dissoc d :until :stable)] (assoc d :rev (rev (:text d)))))]
              (swap! cache (fn [st]
                             (let [all (assoc (:entries st) k {:basis b :sig sig :doc doc :at now :until (:until d)
                                                              :stable (:stable d)
                                                              :stored (erlang/monotonic_time :microsecond)})
                                   kept (evict all k)]
                               (-> st (assoc :entries kept)
                                   (update-in [:stats :evict] (fn [x] (+ (or x 0) (- (count all) (count kept)))))))))
              doc)
            (catch err
              (swap! cache update-in [:entries k] (fn [x] (if (= token (:flight x)) (dissoc x :flight :owner) x)))
              (throw err))))))))

(defn- ages-until
  "The instant (ms) the first displayed age of `rows` next changes: the next
   unit boundary of r/age, or the stale threshold. nil with no rows."
  [now rows]
  (when (seq rows)
    (+ now (apply min
                  (map (fn [row]
                         (let [a (max 0 (or (:age-ms row) 0))
                               unit (cond (< a 60000) 1000 (< a 3600000) 60000 :else 3600000)
                               d (- unit (mod a unit))
                               st (when (and (contains? #{:running :waiting} (:status row)) (<= a model/STALE-MS))
                                    (- (inc model/STALE-MS) a))]
                           (if st (min d st) d)))
                       rows)))))

; ─── projections ────────────────────────────────────────────────────────────

(defn- snapshot [sys now] (model/snapshot (:env sys) now))

(defn- homes [sys opts]
  ;; New task homes are facts. Keep legacy side-file entries readable.
  (reduce (fn [hs [id path block]] (assoc hs id {:path path :block block}))
          (read-edn (str (state-dir sys opts) "/homes.edn"))
          (env/q (:env sys) '[:find ?id ?path ?block :where
                              [?t :task/id ?id] [?t :task/home-path ?path]
                              [?t :task/home-block ?block]])))

(defn- effect-rows
  "v0 effects of task `id` from its turns: each eval cell's edit/write calls
   are file effects (:source :edit); an `sh` is one :opaque row (its inner
   writes are not captured until the jail lands, FEAT-021 v1)."
  [sys id]
  (let [turns (loop/turns sys id)]
    (vec (for [t turns
               b (:content t)
               :when (= :tool-use (:type b))
               :let [code (str (get-in b [:input :code]))
                     cell (str id "/" (:n t))]
               [op path] (concat
                           (map (fn [m] [:write (second m)]) (re-seq #"\((?:edit|write)\s+\"([^\"]+)\"" code))
                           (map (fn [m] [:exec (str "sh " (r/one-line (second m) 60))]) (re-seq #"\(sh\s+\"((?:[^\"\\]|\\.)*)\"" code)))]
           {:cell cell :op op :path path
            :source (if (= op :exec) :opaque :edit)
            :verdict (if (= op :exec) :opaque :allow)}))))

; ─── providers ──────────────────────────────────────────────────────────────

(defn- scratch-provider [sys opts]
  (let [path (fn [] (str (state-dir sys opts) "/scratch.bl.org"))
        text (fn [] (if (File/regular? (path)) (File/read! (path)) SCRATCH-SEED))]
    {:read (fn [_ _] {:text (text) :read-only? false :title "omega:scratch"
                      :objects (vec (keep-indexed
                                      (fn [i l] (when-let [m (re-find #"^: #omega/task \{:id \"([^\"]+)\"" l)]
                                                  {:row i :type "omega/task" :key (second m)}))
                                      (str/split-lines (text))))})
     :rev (fn [_ _] (rev (text)))
     :write (fn [_ _ t base]
              (let [cur (rev (text))]
                (if (and (some? base) (not= base cur))
                  {:conflict cur}
                  (do (File/mkdir_p! (state-dir sys opts)) (File/write! (path) t) {:rev (rev t)}))))
     :eval (fn [_ _ id t]
             ;; a cell with `:ns omega.task.<id>` runs in that task as a steer
             (let [m (re-find (re-pattern (str "#\\+begin_src beam-lisp[^\\n]*:id " id "[^\\n]*:ns omega\\.task\\.(t-[0-9]+)[^\\n]*\\n([\\s\\S]*?)\\n#\\+end_src")) t)]
               (if (nil? m)
                 {:result "this scratch cell names no task (add :ns omega.task.<id>), or it is not a beam-lisp cell"}
                 (let [tid (nth m 1) code (nth m 2)
                       out (cm/run-eval sys tid code)
                       res (or (:ok out) (str "error: " (:error out)))]
                   (task/steer! sys tid (str "The human ran this in your namespace:\n" code "\n=> " res) "human:me")
                   {:result res}))))}))

(defn- overview-provider [sys opts cache]
  (let [get-doc (fn []
                  (cached cache sys opts "overview" ["homes.edn"]
                          (fn [now]
                            (let [snap (timed cache :snapshot (fn [] (snapshot sys now)))]
                              (assoc (r/overview snap (homes sys opts) now) :until (ages-until now (:tasks snap)))))))]
    {:read (fn [_ _] (get-doc))
     :rev (fn [_ _] (:rev (get-doc)))}))

(defn- tasks-provider
  "omega:tasks?ids=a,b — the cards (internal; the editor watches it). :data is
   a vector of cards, each with its :home (where its task cell lives)."
  [sys opts cache]
  (let [render (fn [ids now]
                 (let [hs (homes sys opts)
                       rows (timed cache :rows (fn [] (model/task-rows (:env sys) ids now)))
                       d (r/task-rows {:tasks rows} ids now)
                       cards (vec (map (fn [cd] (assoc cd :home (get hs (:id cd)))) (vals (:cards d))))]
                   (assoc d :data cards :text (pr-str (sort-by :id cards))
                          :until (ages-until now rows))))
        ids-of (fn [params] (vec (remove str/blank? (str/split (str (:ids params)) ","))))
        get-doc (fn [params] (let [ids (ids-of params)]
                               (cached cache sys opts (str "tasks:" ids) ["homes.edn"] (fn [now] (render ids now)))))]
    {:read (fn [_ params] (get-doc params))
     :rev (fn [_ params] (:rev (get-doc params)))}))

(defn- task-provider [sys opts cache]
  (let [render (fn [id params now]
                 (let [row (first (timed cache :rows (fn [] (model/task-rows (:env sys) [id] now))))]
                   (if (nil? row)
                     {:title (str "task:" id) :text (str "#+TITLE: task:" id "\n\nNo task " id " in this world.") :objects []}
                     (assoc (r/task-doc row
                                        (assoc (timed cache :detail (fn [] (model/task-detail sys id))) :asks (:asks row))
                                        (homes sys opts) now (= "1" (:all params)))
                            :until (ages-until now [row])))))
        get-doc (fn [id params]
                  (cached cache sys opts (str "task:" id (:all params)) ["homes.edn"] (fn [now] (render id params now))))]
    {:read (fn [id params] (get-doc id params))
     :rev (fn [id params] (:rev (get-doc id params)))
     :eval (fn [id _ cell-id t]
             ;; re-run one of the task's cells AS the human: same namespace and
             ;; limits as the agent; the cell and its result reach the task as a steer
             (let [m (re-find (re-pattern (str "#\\+begin_src beam-lisp :id " (str/replace cell-id "/" "\\/") "[^\\n]*\\n([\\s\\S]*?)\\n#\\+end_src")) t)
                   code (when m (second m))]
               (if (nil? code)
                 {:result (str "no cell " cell-id)}
                 (let [out (cm/run-eval sys id code)
                       res (or (:ok out) (str "error: " (:error out)))]
                   (task/steer! sys id (str "The human re-ran your cell " cell-id ":\n" code "\n=> " res) "human:me")
                   {:result res}))))}))

(defn- run-query [sys text]
  (let [t0 (erlang/monotonic_time :millisecond)
        res (try
              (let [form (clojure.edn/read-string text)
                    form (if (vector? form) form (throw (ex-info "a query is a vector: [:find ?x :where …]" {})))
                    finds (vec (take-while (fn [x] (not (keyword? x))) (rest form)))
                    rows (env/q (:env sys) form)]
                {:vars (mapv str finds) :rows (vec (sort-by pr-str (map vec rows)))})
              (catch e {:error (ex-message e)}))]
    [res (- (erlang/monotonic_time :millisecond) t0)]))

(defn- q-provider [sys opts cache]
  (let [qfile (fn [] (str (state-dir sys opts) "/queries.edn"))
        render (fn [qid]
                 (let [text (get (read-edn (qfile)) qid)]
                   (if (nil? text)
                     {:title (str "q:" qid) :text (str "#+TITLE: q:" qid "\n\nNo such query. (omega/q '[:find …]) makes one.") :objects []}
                     (let [[res qms] (run-query sys text)
                           _ (bump! cache :ms/query qms)]
                       ;; :stable = what the doc says apart from run time: an
                       ;; unchanged answer keeps its rev though `ms` jitters
                       (assoc (r/query-doc qid text res qms) :stable [text res])))))
        get-doc (fn [qid] (cached cache sys opts (str "q:" qid) ["queries.edn"] (fn [_] (render qid))))]
    {:read (fn [qid _] (get-doc qid))
     :rev (fn [qid _] (:rev (get-doc qid)))
     :eval (fn [qid _ _ _]
             (swap! cache update :entries dissoc (str "q:" qid))
             {:result "re-ran"})}))

(defn- effects-provider [sys opts cache]
  (let [render (fn [nm]
                 (let [[id cell] (if (str/includes? nm "/") [(first (str/split nm "/")) nm] [nm nil])]
                   (r/effects-doc id cell (effect-rows sys id))))
        get-doc (fn [nm] (cached cache sys opts (str "effects:" nm) [] (fn [_] (render nm))))]
    {:read (fn [nm _] (get-doc nm))
     :rev (fn [nm _] (:rev (get-doc nm)))}))

(defn providers
  "The provider map for bl-ed.serve/start!."
  ([sys] (providers sys {}))
  ([sys opts]
   (let [cache (or (:cache opts) (atom {:entries {} :stats {}}))]
     {"omega" {:read (fn [nm p] (case nm
                                  "scratch" ((:read (scratch-provider sys opts)) nm p)
                                  "overview" ((:read (overview-provider sys opts cache)) nm p)
                                  "tasks" ((:read (tasks-provider sys opts cache)) nm p)
                                  {:error (str "no document omega:" nm) :status 404}))
               :rev (fn [nm p] (case nm
                                 "scratch" ((:rev (scratch-provider sys opts)) nm p)
                                 "overview" ((:rev (overview-provider sys opts cache)) nm p)
                                 "tasks" ((:rev (tasks-provider sys opts cache)) nm p)
                                 nil))
               :write (fn [nm p t base] (if (= nm "scratch") ((:write (scratch-provider sys opts)) nm p t base) {:read-only true}))
               :eval (fn [nm p id t] (if (= nm "scratch") ((:eval (scratch-provider sys opts)) nm p id t) {:result "cells here do not run"}))}
      "task" (task-provider sys opts cache)
      "q" (q-provider sys opts cache)
      "effects" (effects-provider sys opts cache)})))

; ─── intents ────────────────────────────────────────────────────────────────

(defn- scratch-append!
  "Append `text` to the scratch document (the bridge's only write there)."
  [sys opts text]
  (let [p (str (state-dir sys opts) "/scratch.bl.org")
        cur (if (File/regular? p) (File/read! p) SCRATCH-SEED)]
    (File/mkdir_p! (state-dir sys opts))
    (File/write! p (str cur (if (str/ends-with? cur "\n") "" "\n") text))))

(defn reference
  "The #+RESULTS value of a task block the WORLD writes (a homeless task in
   scratch), in the shape the editor writes: `#omega/task {:id \"t-1\"}`. No
   :goal — the goal digest is the editor's (ed/omega.bl `digest`); a reference
   without one counts as unedited, and the editor adds it on the next C-Enter."
  [m]
  (str "#omega/task {:id " (pr-str (:id m)) "}"))

(defn intents
  "The intent map for bl-ed.serve/start!. Each fn takes keywordized args and
   returns a JSON-able map (merged into {:ok true})."
  ([sys] (intents sys {}))
  ([sys opts]
   {"task/open"
    (fn [{:keys [goal path block scope cwd]}]
      (let [goal (str/trim (str goal))]
        (if (str/blank? goal)
          {:ok false :message "a task needs a goal (the block's text)"}
          (let [base (or (:root sys) (File/cwd!))
                wd (if-let [resolve (:working-directory opts)] (resolve path cwd)
                     (Path/expand (or cwd (when (and path (not (str/includes? path ":"))) (Path/dirname (Path/expand path base))) base) base))
                origin (when (and path block) {:path path :block block})
                id (task/open! sys (cond-> {:goal goal :cwd wd :home origin}
                                    (seq scope) (assoc :scope (if (string? scope) (vec (str/split scope " ")) (vec scope)))))
                home (if (and path block) {:path path :block block} {:path "omega:scratch" :block id})]
            (when-not origin
              (env/tx! (:env sys) [[:db/add (env/eid (:env sys) :task/id id) :task/home-path (:path home)]
                                  [:db/add (env/eid (:env sys) :task/id id) :task/home-block (:block home)]]))
            (when-not (and path block)
              (scratch-append! sys opts (str "\n* " (r/one-line goal 70) "\n#+begin_task :id " id "\n" goal "\n#+end_task\n#+RESULTS: " id "\n: " (reference {:id id}) "\n")))
            {:id id}))))
    "task/say" (fn [{:keys [id text]}] (task/say! sys id (str text) "human:me") {})
    "task/steer" (fn [{:keys [id text]}] (task/steer! sys id (str text) "human:me") {})
    "task/cancel" (fn [{:keys [id]}] (task/cancel! sys id) {})
    "msg/answer" (fn [{:keys [msg text]}] {:reply (actor/reply! (:env sys) msg (str text))})
    "cell/to-scratch"
    (fn [{:keys [task cell code]}]
      (scratch-append! sys opts (str "\n* from task:" task " · cell " cell "\n#+begin_src beam-lisp :id s-" (erlang/unique_integer (list :positive)) " :ns omega.task." task "\n" code "\n#+end_src\n"))
      {:path "omega:scratch"})
    "q/new"
    (fn [{:keys [text name]}]
      (let [qid (or name (subs (rev text) 0 (min 8 (count (rev text)))))
            p (str (state-dir sys opts) "/queries.edn")]
        (write-edn! p (assoc (read-edn p) qid (str text)))
        {:path (str "q:" qid)}))}))
