; omega/ed/main.bl — omega inside bl-ed, in ONE VM: the task world and the
; editor's server share the pinned beam-lisp, so omega's documents and intents
; are plain function calls (no bridge process, no .omega/url).
;
; The root env.bl tasks acquire this host through omega.dev. Pocket and other
; editor presets are views over its world, task system and buffer service.
; bin/bl-ed normally joins that host; --offline/--memory retains a separate
; foreground entry for disposable tests. Frontends are immutable build outputs.

(ns omega.ed.main
  (:require [omega.env :as env]
            [omega.task :as task]
            [omega.loop :as loop]
            [omega.llm :as llm]
            [omega.codemode :as cm]
            [omega.cli :as cli]
            [omega.ed.providers :as pv]
            [omega.packages :as packages]
            [omega.ext :as ext]
            [omega.artifacts :as artifacts]
            [omega.workspace :as workspace]
            [buffer.model :as buffer]
            [bl-ed.serve :as serve]
            [bl-ed.image :as image]))

(defn offline-model
  "A scripted model that does a little real work, asks one question, and
   closes: enough to see every part of the slice without a network."
  []
  (fn [req]
    (let [stage (count (filter (fn [m] (= :assistant (:role m))) (:messages req)))]
      (case stage
        0 (loop/call-tool "eval" {:code "(trace :finding \".\" \"looked at the goal\")\n(println (ls))"} "tu-1")
        1 (loop/call-tool "eval" {:code "(send \"human:me\" :ask \"Shall I go ahead?\")"} "tu-2")
        2 (loop/say "Waiting for your answer.")
        (loop/call-tool "eval" {:code (str "(done \"Offline run finished; you said: "
             (clojure.string/replace (str (get-in (last (:messages req)) [:content 0 :text])) "\"" "'")
             "\")")} "tu-3")))))

(defn start!
  "Start the world and the editor. opts {:root :port :web :offline? :db :memory? :step :tools :system-prompt :max-steps
   :intent-factory :providers :extensions [ext …] :dev?}.
   Returns {:url :sys :env}."
  [opts]
  (let [root (Path/expand (or (:root opts) (File/cwd!)))
        home (or (System/get_env "OMEGA_HOME") (File/cwd!))
        db (when-not (or (:memory? opts) (and (:offline? opts) (nil? (:db opts)))) (env/db-path root (:db opts)))
        e (if db (env/open-durable! db {:schema workspace/schema}) (env/open {:schema workspace/schema}))
        state (or (:state opts) (if db (str (Path/dirname db) "/ed")
                                    (str (System/tmp_dir!) "/omega-ed-" (System/pid) "-" (env/world e))))
        ephemeral-state? (and (nil? db) (nil? (:state opts)))
        opts (assoc opts :state state :package-state
               (or (:package-state opts) (if db (str (Path/dirname db) "/packages.edn")
                                             (str state "/packages.edn"))))
        acquired (atom nil) workspace-owner (atom nil) pinned (atom nil) generations (atom {})]
    (try
      (let [server (workspace/start! e root)
        _ (reset! workspace-owner server)
        step (or (:step opts) (if (:offline? opts) (offline-model) (llm/step (llm/from-env home))))
        sys (task/start-system e (merge (select-keys opts [:max-steps :token-budget :dev?])
                                  {:step step :tools (or (:tools opts) cm/tools) :root root :files (buffer/port server)
                                   :system-prompt (or (:system-prompt opts) cli/SYSTEM-PROMPT)}))
        _ (reset! acquired sys)
        ;; extensions go in BEFORE recovery and serving: executors copy the
        ;; system they start with (omega.task/start-system)
        sys (if (seq (:extensions opts)) (ext/install sys (:extensions opts)) sys)
        context-opts (workspace/options sys server opts)
        registry (packages/registry home root (merge opts context-opts))
        interrupted (task/recover! sys (fn [id] (packages/recover-system registry sys id)))
        web (or (:web opts) (str home "/vendor/bl-ed/web"))
        ;; bl: shows THIS VM's image — omega itself, live (a project's target
        ;; VM forwards the same provider later)
        _ (reset! pinned (artifacts/pin! web))
        img (image/provider)
        r (serve/start! {:port (or (:port opts) 8790) :root root :web web
                         :landing-pages (:landing-pages opts) :generations generations
                         :providers (merge (:providers opts)
                                           (assoc (workspace/providers sys server context-opts) "bl" (:provider img) "package" (packages/provider registry)))
                         :intents (merge (pv/intents sys context-opts) (workspace/intents sys server) (:intents img)
                                   (when-let [factory (:intent-factory opts)] (factory sys))
                                   (packages/intents registry sys context-opts))})]
    (when db (println (str "omega: tasks are kept in " db (when (seq interrupted) (str " · interrupted: " (clojure.string/join " " interrupted))))))
    (assoc r :sys sys :env e :db db :buffers server :state state :ephemeral-state? ephemeral-state? :packages registry :frontend-pin @pinned :generations generations))
      (catch error
        ;; Readiness is transactional: a failed listener must not leave a task
        ;; supervisor or storage owner behind when the service is retried.
        (try
          (when @acquired (task/stop-system! @acquired))
          (finally (try (workspace/stop! @workspace-owner)
                     (finally (try (env/close! e) (finally (when ephemeral-state? (File/rm_rf! state)) (artifacts/unpin! @pinned)))))))
        (throw error)))))

(defn stop!
  "Close a started host in dependency order: HTTP, task executors, storage.
   A listener failure still allows task/storage cleanup; errors remain visible."
  [host]
  (try (serve/stop! host)
    (finally
      (try (task/stop-system! (:sys host))
        (finally (try (workspace/stop! (:buffers host))
          (finally (try (env/close! (:env host))
                   (finally
                     (when (:ephemeral-state? host) (File/rm_rf! (:state host)))
                     (doseq [[_ generation] @(:generations host)] (artifacts/unpin! (:pin generation)))
                     (artifacts/unpin! (:frontend-pin host))))))))))
  :ok)

(defn admit-frontend!
 "Called by the host owner after artifact validation. Keep admitted generations
  pinned for existing tabs; bounded retention requires an explicit host restart."
 [host id web]
 (when-not (re-matches #"[a-f0-9]{64}" id) (throw (ex-info "Invalid generation identity" {})))
 (when-not (= id (File/read! (str web "/.inputs")))
  (throw (ex-info "Frontend identity does not match its admitted path" {})))
 (when-not (get @(:generations host) id)
  (when (>= (count @(:generations host)) 8)
   (throw (ex-info "Eight frontend generations are retained; restart the host to continue" {})))
  (let [pin (artifacts/pin! web)]
   (when-not pin (throw (ex-info "Only managed immutable frontends can be admitted" {:path web})))
   (swap! (:generations host) assoc id {:web web :pin pin})))
 {:generation id :path (str "/generations/" id "/") :url (str (:url host) "generations/" id "/")})

(defn main
  "bin/bl-ed: serve until killed; callers may supply already-built host options."
  ([] (main {}))
  ([overrides]
  (env/exit-on-user-error
    (fn []
      (let [args (vec (BeamLisp/argv))
            flag? (fn [f] (some (fn [a] (= a f)) args))
            opt (fn [f] (second (drop-while (fn [a] (not= a f)) args)))
            r (start! (merge {:root (opt "--root") :offline? (flag? "--offline") :memory? (flag? "--memory") :db (opt "--db")
                       :port (when-let [p (opt "--port")] (erlang/binary_to_integer p))} overrides))]
        (println (str "bl-ed + omega: " (:url r) "?file=omega:overview   (documents under " (:root r) ")"))
        (println (str "  packages: " (:url r) "?file=package:catalog&use=packages"))
        (println "  space a o  overview · space a s  scratch · space a n  new task · C-Enter on a #+begin_task block")
        (receive :never nil))))))
