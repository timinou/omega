;; GENERATED by scripts/live-doc-assets.py from client.js and client.css. Do not edit.
(ns omega.live-doc.assets)
(def client-js "// omega.live-doc client — edit a rendered document in place.
//
// The page stays the document's own rendering. Every rendered block that came
// from source lines carries data-src=\"from:to\" (end exclusive). In edit mode a
// block opens where it stands as its exact Org source, in the block's own
// typography; it saves as you pause, and closes back into its rendering.
// Changes from anyone (another tab, Emacs, an agent) arrive through one
// long-poll; the host page refreshes itself on `live-doc:changed`.
//
// Host contract (all optional except data-src):
//   <body data-live-doc='{\"rev\":\"3\",\"prefix\":\"_live\"}'>  the revision the page
//       was rendered from; the same for every reader, so pages cache. Whether
//       this reader edits comes from GET {prefix}/config (or an inline
//       \"editable\", for hosts that render per reader).
//   window.dossierRefresh(force) -> Promise   re-render the page body
//   window.liveDoc.holding()                  true while an editor is open
(() => {
  if (window.liveDoc) return;
  const host = document.querySelector('[data-live-doc]');
  if (!host) return;
  let config = {};
  try { config = JSON.parse(host.dataset.liveDoc || '{}'); } catch {}
  const base = config.prefix || '_live';
  const html = document.documentElement;
  let rev = config.rev == null ? null : String(config.rev);
  let editing = null;          // the open editor session
  const holds = [];            // other editors' \"my session is open\" predicates
  let mode = false;            // edit mode: blocks open on a click or tap
  let stale = false;           // a save landed; the rendering is behind its source
  const seq = () => Date.now() * 1000 + Math.floor(Math.random() * 1000);
  const clientId = (() => { try { const k = 'live-doc:client'; let v = sessionStorage.getItem(k); if (!v) { v = (crypto.randomUUID?.() || String(seq())); sessionStorage.setItem(k, v); } return v; } catch { return String(seq()); } })();
  const emit = (name, detail) => window.dispatchEvent(new CustomEvent(name, { detail }));

  // ── changes arrive by long-poll ──────────────────────────────────────────
  let waitDelay = 0;
  async function waitLoop() {
    for (;;) {
      if (document.hidden) { await new Promise(r => document.addEventListener('visibilitychange', r, { once: true })); }
      try {
        const r = await fetch(`${base}/wait?since=${encodeURIComponent(rev ?? '')}`, { cache: 'no-store' });
        if (!r.ok) throw new Error(String(r.status));
        const d = await r.json();
        waitDelay = 0;
        if (d.rev !== rev) { const first = rev === null; rev = d.rev; if (!first) emit('live-doc:changed', { rev }); }
      } catch {
        waitDelay = Math.min(30000, waitDelay ? waitDelay * 2 : 1000);
        emit('live-doc:offline', { retry: waitDelay });
        await new Promise(r => setTimeout(r, waitDelay));
      }
    }
  }

  // ── blocks ────────────────────────────────────────────────────────────────
  const range = el => { const m = /^(\\d+):(\\d+)$/.exec(el?.dataset?.src || ''); return m ? [Number(m[1]), Number(m[2])] : null; };
  const blocks = () => Array.from(document.querySelectorAll('[data-src]')).filter(el => range(el) && !el.closest('.ld-editor') && el.getClientRects().length);
  const PROSE = new Set(['P', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'UL', 'OL', 'BLOCKQUOTE', 'LI', 'DL']);
  const prose = el => PROSE.has(el.tagName);
  // Interactive controls inside blocks keep working; only the block's text opens.
  const interactive = t => t.closest('a[href],button,input,select,textarea,label,summary,details>*:not(summary) a,form,[contenteditable=\"true\"],video,audio,iframe,.sg-stage,[data-live-doc-ignore]');
  const normalize = s => s.replace(/\\r\\n/g, '\\n').replace(/\\n+$/, '');
  const shift = (after, delta) => {
    if (!delta) return;
    for (const el of document.querySelectorAll('[data-src]')) {
      const r = range(el); if (!r || r[0] < after) continue;
      el.dataset.src = `${r[0] + delta}:${r[1] + delta}`;
    }
  };
  const draftKey = (from, before) => `live-doc:draft:${location.origin}${location.pathname}:${from}:${hash(before)}`;
  function hash(s) { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0).toString(36); }
  const store = { get(k) { try { return localStorage.getItem(k); } catch { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch {} }, del(k) { try { localStorage.removeItem(k); } catch {} } };

  // Place the caret where the reader pointed: the rendered text just before the
  // pointer is found in the source, nearest the same relative position.
  function caretFor(el, source, point) {
    if (!point) return source.length;
    let node = null, offset = 0;
    if (document.caretPositionFromPoint) { const p = document.caretPositionFromPoint(point.x, point.y); if (p) { node = p.offsetNode; offset = p.offset; } }
    else if (document.caretRangeFromPoint) { const r = document.caretRangeFromPoint(point.x, point.y); if (r) { node = r.startContainer; offset = r.startOffset; } }
    if (!node || !el.contains(node)) return source.length;
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    let before = '', total = 0, n;
    while ((n = walker.nextNode())) { if (n === node) { before += n.textContent.slice(0, offset); total = before.length; } else if (!total) before += n.textContent; }
    const rendered = el.textContent || '';
    const ratio = rendered.length ? before.length / rendered.length : 1;
    for (let len = Math.min(24, before.length); len >= 2; len = Math.floor(len / 2)) {
      const needle = before.slice(-len);
      let best = -1, at = source.indexOf(needle);
      while (at !== -1) { if (best < 0 || Math.abs(at / source.length - ratio) < Math.abs(best / source.length - ratio)) best = at; at = source.indexOf(needle, at + 1); }
      if (best >= 0) {
        // Skip closing markup that renders as nothing (*bold*, =code=, ]] …).
        let end = best + len; while (end < source.length && /[*/_=~+\\]]/.test(source[end]) && !/\\s/.test(source[end - 1] || '')) end++;
        return end;
      }
    }
    return Math.round(ratio * source.length);
  }

  function typography(el, area) {
    const cs = getComputedStyle(el);
    for (const p of ['fontFamily', 'fontSize', 'fontWeight', 'fontStyle', 'lineHeight', 'letterSpacing', 'color', 'textAlign', 'textTransform', 'wordSpacing']) area.style[p] = cs[p];
    return cs;
  }
  const autosize = area => { area.style.height = 'auto'; area.style.height = area.scrollHeight + 'px'; };

  // ── one open editor at a time ─────────────────────────────────────────────
  async function open(el, point) {
    if (editing?.el === el) return;
    if (editing) await close({ refresh: false });
    const r = range(el); if (!r) return;
    const kind = prose(el) ? 'prose' : 'source';
    const box = document.createElement('div');
    box.className = 'ld-editor';
    box.dataset.kind = kind;
    box.setAttribute('role', 'group');
    box.setAttribute('aria-label', 'Editing this passage');
    const area = document.createElement('textarea');
    area.className = 'ld-area';
    area.spellcheck = kind === 'prose';
    area.setAttribute('aria-label', kind === 'prose' ? 'Passage source' : 'Block source');
    area.rows = 1;
    const status = document.createElement('div');
    status.className = 'ld-status'; status.setAttribute('role', 'status'); status.setAttribute('aria-live', 'polite');
    const done = document.createElement('button');
    done.type = 'button'; done.className = 'ld-done'; done.textContent = 'Done';
    status.append(document.createElement('span'), done);
    box.append(area, status);
    const cs = getComputedStyle(el);
    if (kind === 'prose') {
      typography(el, area);
      box.style.marginTop = cs.marginTop; box.style.marginBottom = cs.marginBottom;
      area.style.paddingLeft = cs.paddingLeft; area.style.paddingRight = cs.paddingRight;
    }
    box.style.minHeight = el.getBoundingClientRect().height + 'px';
    const session = { el, box, area, status, from: r[0], to: r[1], before: null, sent: null, inflight: null, timer: 0, closed: false, kind };
    editing = session;
    html.dataset.liveDocOpen = '';
    el.before(box);
    el.classList.add('ld-hidden');
    area.value = el.textContent.trim();
    area.readOnly = true; box.dataset.state = 'loading';
    autosize(area); area.focus({ preventScroll: true });
    try {
      const q = await fetch(`${base}/block?from=${r[0]}&to=${r[1]}`, { cache: 'no-store' });
      const d = await q.json();
      if (!q.ok) throw new Error(d.error || 'This passage cannot open now.');
      if (session.closed) return;
      session.before = normalize(d.text); session.sent = session.before;
      const draft = store.get(draftKey(session.from, session.before));
      area.value = draft ?? session.before;
      area.readOnly = false; delete box.dataset.state;
      autosize(area);
      const at = draft ? area.value.length : caretFor(el, area.value, point);
      area.setSelectionRange(at, at);
      area.focus({ preventScroll: true });
      say(session, draft ? 'Recovered your unsaved text' : '');
      if (draft) schedule(session, 50);
    } catch (e) {
      say(session, e.message || 'Offline — try again', 'error');
      setTimeout(() => { if (editing === session && session.before === null) close({ refresh: false }); }, 1800);
      return;
    }
    area.addEventListener('input', () => { autosize(area); store.set(draftKey(session.from, session.before), area.value); say(session, ''); schedule(session, 650); });
    area.addEventListener('keydown', e => keys(session, e));
    area.addEventListener('blur', () => setTimeout(() => { if (editing === session && !box.contains(document.activeElement)) close(); }, 160));
    done.addEventListener('click', () => close());
  }

  function say(session, text, tone) {
    const label = session.status.firstChild;
    label.textContent = text;
    session.status.dataset.tone = tone || '';
  }
  function schedule(session, ms) { clearTimeout(session.timer); session.timer = setTimeout(() => save(session), ms); }

  async function save(session) {
    clearTimeout(session.timer);
    if (session.before === null) return true;
    if (session.inflight) { await session.inflight; return save(session); }
    const text = session.area.value;
    if (normalize(text) === session.before) { say(session, session.saved ? 'Saved' : ''); return true; }
    const before = session.before;
    say(session, 'Saving…');
    session.inflight = (async () => {
      for (let attempt = 0; ; attempt++) {
        try {
          const r = await fetch(`${base}/block`, { method: 'POST', cache: 'no-store', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ from: session.from, before, text, client: clientId, sequence: seq() }) });
          const d = await r.json().catch(() => ({}));
          if (r.ok) {
            store.del(draftKey(session.from, before));
            const oldTo = session.from + before.split('\\n').length;
            shift(oldTo, (d.to - d.from) - (oldTo - session.from));
            session.from = d.from; session.to = d.to; session.before = normalize(text); session.saved = true; stale = true;
            session.removed = !!d.removed; if (d.rev != null) rev = String(d.rev);
            say(session, normalize(session.area.value) === session.before ? 'Saved' : 'Saving…');
            return true;
          }
          if (r.status === 409 && d.reason === 'target-changed') { conflict(session, d.current ?? ''); return false; }
          if (r.status === 409 && attempt < 3) continue;
          say(session, d.error || 'Not saved — your text is kept here', 'error');
          return false;
        } catch {
          say(session, 'Offline — your text is kept; retrying', 'error');
          await new Promise(res => setTimeout(res, Math.min(8000, 800 * 2 ** attempt)));
          if (session.closed && attempt > 3) return false;
        }
      }
    })();
    const ok = await session.inflight; session.inflight = null;
    if (ok && normalize(session.area.value) !== session.before) return save(session);
    return ok;
  }

  function conflict(session, current) {
    say(session, 'Changed elsewhere while you typed', 'error');
    session.box.dataset.state = 'conflict';
    let bar = session.box.querySelector('.ld-conflict');
    if (!bar) {
      bar = document.createElement('div'); bar.className = 'ld-conflict';
      const theirs = document.createElement('pre'); theirs.className = 'ld-theirs';
      const keep = document.createElement('button'); keep.type = 'button'; keep.textContent = 'Keep mine';
      const take = document.createElement('button'); take.type = 'button'; take.textContent = 'Use theirs';
      bar.append(theirs, keep, take);
      session.box.insertBefore(bar, session.status);
      keep.addEventListener('click', () => { session.before = normalize(bar.dataset.current); bar.remove(); delete session.box.dataset.state; save(session); session.area.focus(); });
      take.addEventListener('click', () => { session.before = normalize(bar.dataset.current); session.area.value = session.before; autosize(session.area); bar.remove(); delete session.box.dataset.state; say(session, 'Showing the current version'); session.area.focus(); });
    }
    bar.dataset.current = current;
    bar.querySelector('.ld-theirs').textContent = current || '(this passage was removed elsewhere)';
  }

  async function close(options = {}) {
    const session = editing; if (!session || session.closing) return;
    session.closing = true;
    const ok = await save(session);
    if (!ok && session.box.dataset.state === 'conflict') { session.closing = false; return; }
    session.closed = true;
    editing = null; delete html.dataset.liveDocOpen;
    // The host refreshes only when nobody is typing; this passage is settled.
    if (document.activeElement === session.area) session.area.blur();
    if (stale && !options.next && options.refresh !== false && window.dossierRefresh) {
      // Keep the typed source in place until its rendering replaces it.
      session.box.dataset.state = 'settling'; stale = false;
      try { await window.dossierRefresh(true); } catch { stale = true; }
    }
    // A refresh replaced the body; otherwise reveal the untouched rendering.
    if (session.box.isConnected) { session.box.remove(); session.el.classList.remove('ld-hidden'); if (session.removed) session.el.remove(); }
    if (options.next) { const target = find(options.next); if (target) open(target, null).then(() => { if (editing && options.atEnd) { const a = editing.area; a.setSelectionRange(a.value.length, a.value.length); } }); }
  }
  // After a refresh, elements are new; the neighbour is found again by source line.
  const find = ({ line, dir }) => {
    const list = blocks();
    return dir < 0 ? list.filter(el => range(el)[1] <= line).at(-1) : list.find(el => range(el)[0] >= line);
  };

  function keys(session, e) {
    const a = session.area, mod = e.metaKey || e.ctrlKey;
    if (e.key === 'Escape') { e.preventDefault(); close(); return; }
    if (mod && e.key === 'Enter') { e.preventDefault(); close(); return; }
    if (mod && (e.key === 's' || e.key === 'S')) { e.preventDefault(); save(session); return; }
    const collapsed = a.selectionStart === a.selectionEnd;
    if (e.key === 'ArrowUp' && collapsed && !a.value.slice(0, a.selectionStart).includes('\\n')) {
      e.preventDefault(); close({ refresh: false, next: { line: session.from, dir: -1 }, atEnd: true });
    } else if (e.key === 'ArrowDown' && collapsed && !a.value.slice(a.selectionEnd).includes('\\n')) {
      e.preventDefault(); close({ refresh: false, next: { line: session.to, dir: 1 } });
    }
  }

  // ── edit mode ─────────────────────────────────────────────────────────────
  function setMode(on) {
    mode = !!on;
    if (mode) html.dataset.liveEdit = ''; else delete html.dataset.liveEdit;
    const b = document.getElementById('live-doc-edit');
    if (b) { b.setAttribute('aria-pressed', String(mode)); b.textContent = mode ? 'Done' : 'Edit'; }
    try { sessionStorage.setItem('live-doc:mode', mode ? '1' : '0'); } catch {}
    if (!mode && editing) close();
  }
  function toggleButton() {
    if (!config.editable || document.getElementById('live-doc-edit')) return;
    const bar = document.querySelector(config.bar || '.live');
    const b = document.createElement('button');
    b.type = 'button'; b.id = 'live-doc-edit'; b.className = 'ld-toggle';
    b.title = 'Edit this document in place (E)';
    b.addEventListener('click', () => setMode(!mode));
    if (bar) bar.append(b); else { b.classList.add('ld-floating'); document.body.append(b); }
    // With an in-place editor the page is edited where it stands, so editing
    // is on until the editor says Done in this tab; the source-only editor
    // waits to be asked.
    setMode((() => { try { const v = sessionStorage.getItem('live-doc:mode'); return v === '1' || (v !== '0' && !!config.inplace); } catch { return !!config.inplace; } })());
  }

  document.addEventListener('click', e => {
    if (!config.editable) return;
    // The path is recorded at dispatch: a control the editor just removed (the
    // conflict bar's buttons) still counts as inside it.
    if (editing && !e.composedPath().includes(editing.box) && !e.target.closest?.('#live-doc-edit')) { close(); }
    if (!mode || document.body.hasAttribute('data-review-mode')) return;   // commenting takes the click
    if (e.target.isContentEditable || holds.some(h => h())) return;    // another editor owns this click
    if (html.dataset.inplace === 'ready') return;   // the in-place editor owns edit-mode clicks; source is in its block menu
    const el = e.target.closest('[data-src]');
    if (!el || !el.isConnected || el.closest('.ld-editor') || interactive(e.target)) return;
    if (getSelection()?.toString()) return;   // selecting text to copy or comment
    e.preventDefault();
    open(el, { x: e.clientX, y: e.clientY });
  });
  // Outside edit mode, a double-click opens the passage directly (desktop).
  document.addEventListener('dblclick', e => {
    if (!config.editable || mode) return;
    const el = e.target.closest('[data-src]');
    if (!el || interactive(e.target)) return;
    getSelection()?.removeAllRanges();
    open(el, { x: e.clientX, y: e.clientY });
  });
  document.addEventListener('keydown', e => {
    if (!config.editable || editing) return;
    const t = e.target;
    // Any editable target types its own keys (contenteditable=\"plaintext-only\"
    // included, which a [contenteditable=\"true\"] selector misses).
    if (t.isContentEditable || t.closest?.('input,textarea,select') || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'e' || e.key === 'E') { e.preventDefault(); setMode(!mode); }
  });
  window.addEventListener('beforeunload', e => { if (editing && normalize(editing.area.value) !== editing.before) { e.preventDefault(); e.returnValue = ''; } });

  window.liveDoc = {
    // A page refresh waits while any editor holds the page: this one's open
    // block, or one registered with hold() (an in-place editor's session).
    holding: () => !!editing || holds.some(h => h()),
    hold: (predicate) => { holds.push(predicate); },
    get rev() { return rev; },
    edit: setMode,
    open: (el, point) => open(el, point),
    close: () => close(),
    install() { toggleButton(); }
  };
  // An in-place editor module (config.inplace, relative to the routes) loads
  // only for a reader who edits: it is large, and nobody else needs it.
  let inplaceLoaded = false;
  function loadInplace() {
    if (!config.editable || !config.inplace || inplaceLoaded) return;
    inplaceLoaded = true;
    import(new URL(config.inplace, new URL(base + '/', location.href)).href)
      .catch(e => console.warn('live-doc: in-place editor unavailable', e));
  }
  if ('editable' in config) { toggleButton(); loadInplace(); }
  else fetch(`${base}/config`, { cache: 'no-store' }).then(r => r.ok ? r.json() : {})
    .then(c => { config.editable = !!c.editable; toggleButton(); loadInplace(); }, () => {});
  waitLoop();
})();
")
(def client-css "/* omega.live-doc client — an open block keeps the place, size and type of its
   rendering. Only a quiet rule in the margin says it is open. Colours come from
   the host page (--live-doc-*), else the dossier palette, else neutral values. */
:root{
  --ld-accent:var(--live-doc-accent,var(--clay,#b0654a));
  --ld-line:var(--live-doc-line,var(--line,#e2ddd6));
  --ld-ink:var(--live-doc-ink,var(--ink,#2b2622));
  --ld-muted:var(--live-doc-muted,var(--muted,#6d625a));
  --ld-card:var(--live-doc-card,var(--card,#fbf8f4));
  --ld-mono:var(--live-doc-mono,var(--mono,ui-monospace,\"SF Mono\",Menlo,monospace));
  --ld-ui:var(--live-doc-ui,var(--font-ui,system-ui,-apple-system,\"Segoe UI\",sans-serif));
}
.ld-hidden{display:none!important}

/* Edit mode: every source block shows it can open, without moving anything. */
html[data-live-edit] [data-src]:not(.ld-editor){cursor:text;border-radius:4px;transition:box-shadow .16s ease,background-color .16s ease}
html[data-live-edit] [data-src]:not(.ld-editor):hover{box-shadow:-10px 0 0 -8px color-mix(in srgb,var(--ld-accent) 55%,transparent);background:color-mix(in srgb,var(--ld-accent) 4%,transparent)}
html[data-live-edit] [data-src] a[href],html[data-live-edit] [data-src] button{cursor:pointer}

.ld-editor{position:relative;display:block;box-sizing:border-box;margin:0;animation:ld-in .14s ease-out}
.ld-editor::before{content:\"\";position:absolute;left:-12px;top:2px;bottom:2px;width:2px;border-radius:2px;background:var(--ld-accent);opacity:.75}
@keyframes ld-in{from{opacity:.55}to{opacity:1}}
.ld-area{display:block;box-sizing:border-box;width:100%;max-width:inherit;margin:0;padding:0;border:0;outline:0;resize:none;overflow:hidden;
  background:transparent;color:inherit;caret-color:var(--ld-accent);field-sizing:content;min-height:1lh;-webkit-appearance:none;appearance:none;border-radius:0}
.ld-editor[data-kind=\"prose\"]{max-width:var(--measure,70ch)}
/* Wide screens: status and Done sit in the margin, so nothing below the passage moves. */
@media (min-width:900px){
  .ld-editor[data-kind=\"prose\"] .ld-status{position:absolute;top:2px;left:calc(100% + 22px);margin:0;min-height:0;
    flex-direction:column;align-items:flex-start;gap:6px;width:max-content;max-width:min(18ch,calc(100vw - 100% - 60px))}
  .ld-editor[data-kind=\"prose\"] .ld-status span:empty::before{content:\"Esc to close\"}
}
.ld-area::selection{background:color-mix(in srgb,var(--ld-accent) 22%,transparent)}
/* Blocks that render as figures, cards or tables open as their exact source. */
.ld-editor[data-kind=\"source\"]{margin:14px 0;padding:12px 14px 10px;border:1px solid var(--ld-line);border-radius:10px;background:var(--ld-card)}
.ld-editor[data-kind=\"source\"]::before{left:-1px;top:10px;bottom:10px}
.ld-editor[data-kind=\"source\"] .ld-area{font:13px/1.55 var(--ld-mono);color:var(--ld-ink);tab-size:2;white-space:pre;overflow-x:auto}
.ld-editor[data-state=\"loading\"] .ld-area{opacity:.6}
.ld-editor[data-state=\"settling\"]{opacity:.8;transition:opacity .2s}

.ld-status{display:flex;align-items:center;justify-content:flex-end;gap:10px;min-height:22px;margin-top:2px;font:12px var(--ld-ui);color:var(--ld-muted)}
.ld-status[data-tone=\"error\"]{color:var(--ld-accent)}
.ld-status span:empty::before{content:\"Esc or Done to close · ↑↓ to move\";opacity:.0;transition:opacity .2s}
.ld-editor:focus-within .ld-status span:empty::before{opacity:.7}
.ld-done{font:12px var(--ld-ui);border:1px solid var(--ld-line);background:transparent;color:var(--ld-muted);border-radius:6px;padding:2px 10px;cursor:pointer}
.ld-done:hover,.ld-done:focus-visible{color:var(--ld-ink);border-color:var(--ld-muted)}

.ld-conflict{margin:8px 0 0;padding:10px;border:1px solid color-mix(in srgb,var(--ld-accent) 40%,var(--ld-line));border-radius:8px;font:12px var(--ld-ui);color:var(--ld-ink)}
.ld-conflict::before{content:\"Current version\";display:block;margin-bottom:4px;color:var(--ld-muted)}
.ld-theirs{margin:0 0 8px;max-height:12em;overflow:auto;white-space:pre-wrap;font:12px/1.5 var(--ld-mono)}
.ld-conflict button{font:12px var(--ld-ui);margin-right:6px;border:1px solid var(--ld-line);background:var(--ld-card);color:var(--ld-ink);border-radius:6px;padding:3px 10px;cursor:pointer}

.ld-toggle[aria-pressed=\"true\"]{background:var(--ld-ink);border-color:var(--ld-ink);color:var(--ld-card)}
.ld-floating{position:fixed;right:16px;bottom:16px;z-index:20;font:13px var(--ld-ui);padding:8px 14px;border-radius:999px;border:1px solid var(--ld-line);background:var(--ld-card);color:var(--ld-ink);box-shadow:0 6px 20px rgb(0 0 0 / .12)}

@media (max-width:720px){
  .ld-editor::before{left:-8px}
  .ld-editor[data-kind=\"source\"] .ld-area{font-size:12.5px}
  /* The keyboard covers the bottom of the screen: keep the close control reachable. */
  .ld-status{position:sticky;bottom:0;background:linear-gradient(transparent,var(--bg,#fff) 40%);padding-top:6px}
}
/* Touch screens have no Esc or arrow keys: Done is the whole affordance. */
@media (pointer:coarse){.ld-status span:empty::before{content:none}}
@media (prefers-reduced-motion:reduce){.ld-editor{animation:none}html[data-live-edit] [data-src]{transition:none}}

/* ── in place (omega.live-doc.inplace) ─────────────────────────────────── */
[data-inplace=\"editing\"],[data-inplace=\"saving\"],[data-inplace=\"saved\"],[data-inplace=\"refused\"]{outline:none;border-radius:4px;box-shadow:0 0 0 2px color-mix(in srgb,var(--ld-accent) 30%,transparent);caret-color:var(--ld-accent)}
[data-inplace=\"saving\"]{box-shadow:0 0 0 2px color-mix(in srgb,var(--ld-accent) 45%,transparent)}
[data-inplace=\"refused\"]{box-shadow:0 0 0 2px color-mix(in srgb,#c0392b 55%,transparent)}
#ip-gutter{position:absolute;z-index:40;display:flex;gap:1px;padding:2px;border-radius:7px;background:color-mix(in srgb,var(--ld-card) 88%,transparent);opacity:.8;transition:opacity .12s ease}
#ip-gutter:hover{opacity:1}
#ip-gutter[hidden]{display:none}
html:not([data-live-edit]) #ip-gutter{display:none}
#ip-gutter button{width:26px;height:26px;border:0;border-radius:5px;background:transparent;color:var(--ld-muted);font:600 16px/1 var(--ld-ui);cursor:pointer;padding:0}
#ip-gutter button:hover{background:color-mix(in srgb,var(--ld-ink) 8%,transparent);color:var(--ld-ink)}
.ip-pop{position:absolute;z-index:41;min-width:220px;max-width:min(360px,calc(100vw - 32px));max-height:min(420px,60vh);overflow:auto;background:var(--ld-card);color:var(--ld-ink);border:1px solid var(--ld-line);border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.14);padding:6px;font:14px/1.4 var(--ld-ui)}
.ip-pop button{display:flex;flex-direction:column;align-items:flex-start;width:100%;border:0;background:none;color:inherit;font:inherit;text-align:left;padding:6px 8px;border-radius:6px;cursor:pointer}
.ip-pop button:hover,.ip-pop button:focus-visible{background:color-mix(in srgb,var(--ld-accent) 10%,transparent);outline:none}
.ip-pop button small{color:var(--ld-muted);font-size:12px}
.ip-pop .ip-danger{color:#b03a2e}
.ip-insert input{width:100%;box-sizing:border-box;border:1px solid var(--ld-line);border-radius:6px;padding:6px 8px;font:inherit;background:transparent;color:inherit;margin-bottom:4px}
.ip-settings{display:grid;gap:10px;padding:10px}
.ip-field{display:grid;gap:4px;font-size:13px}
.ip-field>span{color:var(--ld-muted)}
.ip-field input[type=text],.ip-field input[type=number]{border:1px solid var(--ld-line);border-radius:6px;padding:5px 8px;font:inherit;background:transparent;color:inherit}
.ip-chips{display:flex;flex-wrap:wrap;gap:4px}
.ip-chips button{display:inline-block;width:auto;border:1px solid var(--ld-line);border-radius:999px;padding:3px 10px}
.ip-chips button[aria-pressed=\"true\"]{background:var(--ld-ink);border-color:var(--ld-ink);color:var(--ld-card)}
#ip-toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:42;display:flex;gap:12px;align-items:center;background:var(--ld-ink);color:var(--ld-card);border-radius:8px;padding:8px 14px;font:14px/1.3 var(--ld-ui)}
#ip-toast button{border:0;background:none;color:inherit;font:inherit;font-weight:600;text-decoration:underline;cursor:pointer}
@media (hover:none){#ip-gutter{opacity:1}}
#ip-gutter [data-g=menu]{cursor:grab;letter-spacing:-3px}
html.ip-dragging,html.ip-dragging *{cursor:grabbing!important;user-select:none}
#ip-drop{position:absolute;z-index:43;height:3px;border-radius:2px;background:var(--ld-accent);pointer-events:none}
#ip-drop[hidden]{display:none}
.ip-new{animation:ip-new .9s ease}
@keyframes ip-new{from{background:color-mix(in srgb,var(--ld-accent) 14%,transparent)}to{background:transparent}}
[contenteditable][data-inplace]{white-space:pre-wrap}
.ip-draft{min-height:1.6em;margin:.6em 0;outline:none;border-radius:4px;caret-color:var(--ld-accent);white-space:pre-wrap}
.ip-draft:empty::before{content:attr(data-placeholder);color:var(--ld-muted);opacity:.75;pointer-events:none}
.ip-draft[data-kind=heading]{font-size:1.6em;font-weight:700;line-height:1.25}
.ip-draft[data-kind=subheading]{font-size:1.25em;font-weight:650;line-height:1.3}
.ip-draft[data-kind=bullet],.ip-draft[data-kind=number],.ip-draft[data-kind=todo]{position:relative;padding-left:1.6em}
.ip-draft[data-kind=bullet]::after{content:\"•\";position:absolute;left:.45em;top:0}
.ip-draft[data-kind=number]::after{content:\"1.\";position:absolute;left:.2em;top:0}
.ip-draft[data-kind=todo]::after{content:\"☐\";position:absolute;left:.2em;top:0}
.ip-draft[data-kind=quote]{border-left:3px solid var(--ld-line);padding-left:.9em;font-style:italic}
#ip-format{position:absolute;z-index:44;display:flex;gap:2px;align-items:center;padding:3px;border-radius:8px;background:var(--ld-ink);color:var(--ld-card);box-shadow:0 8px 24px rgba(0,0,0,.2);font:13px/1 var(--ld-ui)}
#ip-format[hidden]{display:none}
#ip-format button{min-width:30px;height:28px;border:0;border-radius:6px;background:none;color:inherit;font:inherit;cursor:pointer;padding:0 8px}
#ip-format button:hover{background:color-mix(in srgb,var(--ld-card) 16%,transparent)}
#ip-format button[aria-pressed=true]{background:color-mix(in srgb,var(--ld-card) 26%,transparent)}
#ip-format code{font:12px/1 ui-monospace,monospace;background:none;color:inherit}
#ip-format .ip-link input{width:min(300px,60vw);border:0;border-radius:6px;padding:6px 8px;font:inherit}
#ip-format .ip-link[hidden]{display:none}
.ip-pop.ip-insert{width:min(680px,calc(100vw - 16px));max-width:none;max-height:min(460px,70vh);display:flex;flex-direction:column;overflow:hidden;padding:8px}
.ip-ins-body{display:grid;grid-template-columns:minmax(200px,250px) 1fr;gap:10px;min-height:0;flex:1}
.ip-list{overflow:auto;min-height:0;max-height:calc(min(460px,70vh) - 60px)}
.ip-slash .ip-list{max-height:calc(min(460px,70vh) - 20px)}
.ip-group-name{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ld-muted);padding:8px 8px 2px}
.ip-group[hidden]{display:none}
.ip-pop .ip-list button[hidden]{display:none}
.ip-pop .ip-list button.on{background:color-mix(in srgb,var(--ld-accent) 13%,transparent)}
.ip-pop .ip-list button small{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ip-preview{overflow:hidden;border-left:1px solid var(--ld-line);padding:4px 4px 4px 12px;min-height:0}
.ip-pv-head{display:flex;gap:8px;align-items:baseline;justify-content:space-between}
.ip-pv-head span{font-size:11px;color:var(--ld-muted);text-transform:uppercase;letter-spacing:.06em}
.ip-pv-hint{margin:4px 0 10px;color:var(--ld-muted);font-size:13px}
.ip-pv-none{color:var(--ld-muted);font-size:13px;font-style:italic}
.ip-thumb{position:relative;height:300px;overflow:hidden;border:1px solid var(--ld-line);border-radius:8px;background:var(--ld-page,var(--ld-card))}
.ip-thumb::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:40px;background:linear-gradient(transparent,var(--ld-page,var(--ld-card)))}
.ip-thumb-in{width:640px;zoom:.62;padding:16px;pointer-events:none;font-size:16px}
@media (max-width:720px){.ip-ins-body{grid-template-columns:1fr}.ip-preview{display:none}}
")
