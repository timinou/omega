; One account host, the existing place table and one shared buffer per real file.
; Dossier parsing/presentation is reused; no per-document listener or code execution.
(ns omega.documents
  (:require [place.model :as place] [buffer.model :as buffer] [omega.env :as env]
            [omega.document-source :as source]
            [dossier.org :as org] [dossier.page :as page] [dossier.answer :as answer]
            [dossier.film :as film] [live.hiccup :as h] [web :as web]
            [bl.doc :as doc] [bl.json :as json] [clojure.string :as str]))

(defn real-path [path]
  (let [[result status] (System/cmd "realpath" (list "-e" "--" path))]
    (when-not (= 0 status) (throw (ex-info "Document is unavailable." {})))
    (str/trim result)))
(defn- inside? [root path] (or (= root path) (str/starts-with? path (str root "/"))))
(def schema
  [{:db/ident :document/id :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :document/entry}])
(defn- remembered [sys]
  (into {} (map (fn [[id entry]] [id entry])
    (env/q (:env sys) '[:find ?id ?entry :where [?d :document/id ?id] [?d :document/entry ?entry]]))))
(defn registry [sys server opts]
  {:sys sys :server server :admitted (atom (remembered sys)) :cache (atom {}) :assets (atom {})
   :owner (:document-owner opts) :handle (or (:document-handle opts) (System/get_env "USER") "owner")
   :home (Path/expand "../.." (Path/dirname (BeamLisp.Loader/source_path "omega.documents")))})
(defn- digest [value] (str/lower-case (Base/encode16 (crypto/hash :sha256 (str value)))))
(defn- remember! [r entry]
  (when-not (= entry (get @(:admitted r) (:id entry)))
    (env/tx! (get-in r [:sys :env]) [{:db/id -1 :document/id (:id entry) :document/entry entry}])
    (swap! (:admitted r) assoc (:id entry) entry)) entry)
(defn- org-files [roots]
  ;; Discovery is bounded and skips symlinked directories; never recurse into
  ;; generated/dependency trees. An ambiguous ID is not a rename recovery.
  (loop [todo (vec (distinct roots)) out [] visited #{} n 0]
    (if (or (empty? todo) (>= n 2000)) out
      (let [path (first todo) todo (vec (rest todo))]
        (cond
          (contains? visited path) (recur todo out visited (inc n))
          (and (File/dir? path) (= path (real-path path)))
          (recur (into todo (map #(str path "/" %) (remove #(or (str/starts-with? % ".") (contains? #{"node_modules" "target" "_build" "build" "out"} %)) (sort (File/ls! path))))) out (conj visited path) (inc n))
          (and (File/regular? path) (str/ends-with? path ".bl.org")) (recur todo (conj out path) visited (inc n))
          :else (recur todo out visited (inc n)))))))
(defn- recover-entry [r entry]
  (if (File/regular? (:path entry)) entry
    (let [ps (place/all (get-in r [:sys :env]))
          roots (if (:project entry) [(place/root ps (:project entry))] [(Path/dirname (:path entry))])
          matches (filter (fn [path]
                            (let [text (File/read! path)]
                              (if (:org-id entry) (= (:org-id entry) (:org-id (source/index text)))
                                (= (:fingerprint entry) (digest text))))) (org-files (keep identity roots)))]
      (when-not (= 1 (count matches)) (throw (ex-info "Document moved; no unique Org ID or unchanged source was found. Reopen the file to recover." {})))
      (remember! r (assoc entry :path (real-path (first matches)))))))
(defn- project-path [r address]
  (let [parts (str/split address "/") id (first parts)
        root (place/root (place/all (get-in r [:sys :env])) id)]
    (when-not root (throw (ex-info "Unknown project." {})))
    (let [root (real-path root) path (real-path (str root "/" (str/join "/" (rest parts))))]
      (when-not (inside? root path) (throw (ex-info "Path leaves its attached directory." {})))
      {:path path :project id})))
(defn resolve-document
  "Admit exactly one file. Project/work/full-file spellings converge by real path."
  [r address]
  (let [address (str address)]
    (if (str/starts-with? address "document:")
      (let [id (subs address 9) entry (get @(:admitted r) id)]
        (when-not entry (throw (ex-info "Document is not admitted to this account." {})))
        (let [entry (recover-entry r entry)]
        (when-not (= (:path entry) (real-path (:path entry)))
          (throw (ex-info "Document target changed; open it again." {})))
        (when (:project entry)
          (let [root (place/root (place/all (get-in r [:sys :env])) (:project entry))]
            (when-not (and root (inside? (real-path root) (:path entry)))
              (throw (ex-info "Project access was removed." {})))))
        (when-not (File/regular? (:path entry)) (throw (ex-info "Not a file." {})))
        entry))
      (let [entry (cond
                    (str/starts-with? address "project:") (project-path r (subs address 8))
                    (str/starts-with? address "work:") (project-path r (subs address 5))
                    (str/starts-with? address "file:")
                    (let [uri (URI/parse address) path (:path uri)]
                      (when-not (and (contains? #{nil "" "localhost"} (:host uri)) (str/starts-with? path "/")) (throw (ex-info "Use an absolute file address." {})))
                      {:path (real-path (URI/decode path))})
                    (str/starts-with? address "/") {:path (real-path address)}
                    :else {:path (real-path (Path/expand address (get-in r [:sys :root])))})
            path (:path entry)
            _ (when-not (File/regular? path)
                (throw (ex-info "Open a regular file." {})))
            text (File/read! path) idx (source/index text)
            previous (first (filter #(or (= path (:path %)) (and (:org-id idx) (= (:org-id idx) (:org-id %)))) (vals @(:admitted r))))
            _ (when (and previous (:org-id idx) (not= path (:path previous)) (File/regular? (:path previous)))
                (throw (ex-info "Duplicate Org file ID. Resolve the duplicate before opening this copy." {})))
            id (or (:id previous) (digest (str (get-in r [:sys :root]) "\n" (or (:org-id idx) path))))
            existing (get @(:admitted r) id)
            entry (merge existing entry {:id id :address (str "document:" id) :org-id (:org-id idx)
                                        :title (:title idx) :fingerprint (digest text)})]
        (when (and (nil? existing) (>= (count @(:admitted r)) 256))
          (throw (ex-info "Prototype document limit reached." {})))
        (remember! r entry)))))
(defn normalize [r address]
  (let [s (str address)]
    (if (or (str/starts-with? s "document:") (str/starts-with? s "project:")
            (str/starts-with? s "work:") (str/starts-with? s "file:")
            (str/starts-with? s "/")
            (and (not (str/includes? s ":"))
                 (or (str/ends-with? s ".bl.org") (str/ends-with? s ".bl.md"))))
      (:address (resolve-document r s)) address)))
(defn file-path [r address] (:path (resolve-document r address)))
(defn snapshot [r entry]
  (let [result (buffer/request! (:server r) [:read (:path entry) {}])]
    (when (:error result) (throw (ex-info (:error result) {})))
    (let [idx (source/index (:text result))]
      (remember! r (assoc entry :title (:title idx) :org-id (:org-id idx) :fingerprint (digest (:text result))))) result))
(defn context! [r args]
  (let [entry (resolve-document r (:path args)) d (snapshot r entry)
        _ (when (and (:rev args) (not= (:rev args) (:rev d))) (throw (ex-info "The document changed; choose the starting context again. Your goal is retained." {})))
        context (source/capture (:text d) args)]
    (merge context {:path (:address entry) :document (:id entry) :file (:path entry) :rev (:rev d)
                    :project (:project entry)})))
(defn reveal! [r origin]
  (let [entry (resolve-document r (:path origin)) d (snapshot r entry)]
    (merge {:path (:address entry) :file (:path entry) :origin origin} (source/reveal (:text d) origin))))
(defn index! [r project]
  (let [root (place/root (place/all (get-in r [:sys :env])) project)]
    (when-not root (throw (ex-info "Unknown project." {})))
    (let [root (real-path root)]
      (mapv (fn [path] (let [idx (source/index (File/read! path))]
                        {:title (:title idx) :path path :org-id (:org-id idx)
                         :address (str "project:" project "/" (subs path (inc (count root))))}))
            (org-files [root])))))
(defn provider [r]
  {:read (fn [id _]
           (let [entry (resolve-document r (str "document:" id)) d (snapshot r entry)]
             {:text (:text d) :rev (:rev d) :title (Path/basename (:path entry)) :objects [] :read-only? false
              :data (cond-> {:buffer true :document (:address entry) :document-title (:title (get @(:admitted r) id))}
                      (str/ends-with? (:path entry) ".bl.org")
                      (assoc :packages ["dossier" "document-tasks"] :dossier {:id id :url (str "/documents/" id "/view")}))}))
   :rev (fn [id _] (:rev (snapshot r (resolve-document r (str "document:" id)))))
   :eval (fn [id _ cell text]
           (let [entry (resolve-document r (str "document:" id)) sliced (doc/slice-text text (doc/format-of (:path entry)))]
             (if (:error sliced) {:result (pr-str (:error sliced))}
               (let [document (assoc (:ok sliced) :path (:path entry)) result (doc/run-doc document)]
                 {:result (get (:results result) cell "")
                  :text (doc/write-results document (select-keys (:results result) [cell]))}))))
   :write (fn [id params text base]
            (buffer/request! (:server r) [:save (file-path r (str "document:" id))
              {:text text :base base :client (or (:client params) "manual") :sequence (or (:client-seq params) 0)}]))})
(defn submit-answer! [r entry request]
  (let [{:keys [id answer note base]} request]
    (when-not (and (string? id) (< (count id) 100) (string? answer) (< (count answer) 200)
                  (string? note) (< (count note) 12000) (string? base))
      (throw (ex-info "Invalid answer fields; your draft is retained." {})))
    (let [d (snapshot r entry)]
      (when-not (= base (:rev d))
        (throw (ex-info "The document changed. Review the current question before retrying; your draft is retained." {})))
      (let [patch (answer/answer-lines (vec (String/split (:text d) "\n")) id answer note (answer/now-stamp) (:handle r))]
        (when (:error patch) (throw (ex-info (:error patch) {})))
        (let [result (buffer/request! (:server r) [:save (:path entry)
                       {:text (str/join "\n" (:lines patch)) :base base :resolution? true
                        :client (str "dossier:" id) :sequence (System/os_time :microsecond)}])]
          (when (or (:error result) (:conflict result))
            (throw (ex-info (or (:error result) (:message result) "Answer conflicts with current source.") {})))
          {:ok true :rev (:rev result)})))))
(defn- kit-asset [r name] (File/read! (str (:home r) "/spikes/workspace/dossier/host/" name)))
(def asset-types {"png" "image/png" "jpg" "image/jpeg" "jpeg" "image/jpeg" "webp" "image/webp" "gif" "image/gif" "svg" "image/svg+xml" "mp4" "video/mp4" "webm" "video/webm" "pdf" "application/pdf"})
(defn- reference [r entry key value]
  (if (or (not (string? value)) (str/blank? value) (str/starts-with? value "#")
          (some #(str/starts-with? value %) ["http:" "https:" "mailto:" "data:"])) value
    (let [value (if (str/starts-with? value "file:") (subs value 5) value)
          path (Path/expand value (Path/dirname (:path entry)))
          extension (str/lower-case (subs (Path/extname path) (min 1 (count (Path/extname path)))))]
      (if (and (= key :href) (or (str/ends-with? path ".bl.org") (str/ends-with? path ".bl.md")))
        (str "file:" path)
        (if-let [mime (get asset-types extension)]
          (let [token (digest path)]
            (swap! (:assets r) assoc [(:id entry) token] {:path path :mime mime})
            (str "/documents/" (:id entry) "/asset/" token))
          value)))))
(defn- rewrite-h [r entry tree]
  (cond (map? tree) (reduce (fn [out [key value]] (assoc out key (if (contains? #{:src :href} key) (reference r entry key value) value))) {} tree)
        (vector? tree) (mapv #(rewrite-h r entry %) tree)
        (seq? tree) (map #(rewrite-h r entry %) tree)
        :else tree))
(defn projection [r entry]
  (let [d (snapshot r entry) doc (film/enrich (org/read-doc (:text d)) (Path/dirname (:path entry)))
        key [(:id entry) (:rev d) (digest (pr-str doc))]
        cached (get @(:cache r) key)]
    (or cached
      (let [result {:rev (:rev d) :generation (digest (pr-str key))
                    :html (str/join "" (map h/hiccup->html (rewrite-h r entry (page/doc-h doc)))) :doc doc}]
        (when (>= (count @(:cache r)) 16) (reset! (:cache r) {}))
        (swap! (:cache r) assoc key result) result))))
(defn- full-page [r entry]
  (let [p (projection r entry)]
    (str "<!doctype html>"
      (h/hiccup->html (rewrite-h r entry (page/page-h (:doc p) (kit-asset r "style.css")
        (str "window.omegaDocument=" (json/encode {:path (:address entry) :rev (:rev p) :generation (:generation p)}) ";\n"
             (kit-asset r "live.js"))))))))
(defn- route [r conn]
  (let [parts (str/split (web/path conn) "/") id (nth parts 2 "") op (nth parts 3 "view")
        entry (resolve-document r (str "document:" id)) method (str/upper-case (str (web/method conn)))]
    (cond
      (and (= method "GET") (= op "asset"))
      (let [asset (get @(:assets r) [id (nth parts 4 "")])]
        (when-not asset (throw (ex-info "Asset is not referenced by this document." {})))
        (when-not (= (Path/expand (:path asset)) (real-path (:path asset)))
          (throw (ex-info "Asset target changed." {})))
        (-> conn (web/resp-header "content-type" (:mime asset))
                 (web/resp-header "x-content-type-options" "nosniff")
                 (web/bytes (:mime asset) (File/read! (:path asset)))))
      (and (= method "GET") (= op "view")) (web/html conn (full-page r entry))
      (and (= method "GET") (= op "src")) (web/text conn (:text (snapshot r entry)))
      (and (= method "GET") (= op "rev")) (web/json conn (select-keys (projection r entry) [:rev :generation]))
      (and (= method "GET") (= op "doc")) (web/json conn (select-keys (projection r entry) [:rev :generation :html]))
      (and (= method "GET") (= op "answers"))
      (web/json conn (vec (page/feedback-items (org/read-doc (:text (snapshot r entry))))))
      (and (= method "POST") (= op "answer"))
      (let [[body conn] (web/read-body* conn)]
        (when (> (count body) 16384) (throw (ex-info "Answer is too large." {})))
        (let [m (json/decode body {:keys :keyword})]
          (web/json conn (submit-answer! r entry m))))
      :else (web/text conn 404 "not found"))))
(defn middleware [r handler]
  (fn [conn]
    (try
      (let [conn (web/resp-header conn "cache-control" "private, no-store")
            owner (:owner r) origin (web/req-header conn "origin") host (web/req-header conn "host")]
        (cond
          (and owner (not= owner (web/req-header conn "tailscale-user-login")))
          (web/json conn 403 {:ok false :message "This document host belongs to another account."})
          (and origin (not (contains? #{(str "http://" host) (str "https://" host)} origin)))
          (web/json conn 403 {:ok false :message "Cross-origin request refused."})
          (str/starts-with? (web/path conn) "/documents/") (route r conn)
          :else (handler conn)))
      (catch error (web/json conn 409 {:ok false :error (ex-message error) :message (ex-message error)})))))
