;; Data-only semantic Org reader. Profiles extend interpretation, not syntax.
(ns omega.org-semantics (:require [omega.document-source :as source] [clojure.re] [omega.org-profile :as profile]))
(def default-profile
 {:types #{"task" "project"} :open #{"TODO" "NEXT" "DOING" "WAIT" "BLOCKED" "REVIEW"} :done #{"DONE" "DROP" "CANCELLED" "CANCELED"}})
(defn- planning-rows [lines]
 (loop [at 0 drawer? false rows []]
  (if (>= at (count lines)) rows
   (let [line (nth lines at)]
    (cond
     drawer? (recur (inc at) (not (some? (re-find #"(?i)^ *:END: *\r?$" line))) rows)
     (re-find #"(?i)^ *:PROPERTIES: *\r?$" line) (recur (inc at) true rows)
     (re-find #"^ *(SCHEDULED:|DEADLINE:|CLOSED:)" line) (recur (inc at) false (conj rows at))
     :else rows)))))
(defn- date-at [lines key]
 (some (fn [line] (second (re-find (Regex/compile! (str key ": *[<\\[]([0-9]{4}-[0-9]{2}-[0-9]{2})")) line))) lines))
(defn read-source
 ([text] (read-source text (merge default-profile (profile/read-source text))))
 ([text profile]
 (let [index (source/index text) lines (:lines index)
       header-lines (mapcat (fn [span] (when (= :prose (:kind span)) (subvec lines (:from span) (:to span)))) (:blocks index))
       declarations (keep #(second (re-find #"(?i)^#\+(?:TODO|SEQ_TODO|TYP_TODO): +(.*)$" %)) header-lines)
       sequences (mapv (fn [declaration]
                     (let [words (mapv #(String/replace % #"\(.*\)$" "") (String/split declaration #" +"))
                           divider (first (keep-indexed #(when (= "|" %2) %1) words))
                           at (or divider (max 0 (dec (count words))))]
                       {:open (vec (take at words)) :done (vec (drop (if divider (inc at) at) words))})) declarations)
       open (if (seq sequences) (set (mapcat :open sequences)) (:open profile))
       done (if (seq sequences) (set (mapcat :done sequences)) (:done profile))
       headings (:outline index)
       rows (mapv (fn [h]
        (let [properties (source/properties lines (inc (:row h)))
              title (trim (String/replace (nth lines (:row h)) #"^\*+ +" "")) keyword (first (String/split title #" +"))
              state (when (contains? (into open done) keyword) keyword)
              title (if state (trim (subs title (count state))) title)
              priority (second (re-find #"^\[#([A-Za-z0-9])\] +" title))
              title (if priority (String/replace title #"^\[#[A-Za-z0-9]\] +" "") title)
              tag-match (re-find #" +(:[A-Za-z0-9_@#%:-]+:) *$" title)
              tags (if tag-match (set (remove empty? (String/split (second tag-match) ":"))) #{})
              title (if tag-match (trim (String/replace title (first tag-match) "")) title)
              kind (or (get properties "TYPE") (get properties "KIND") (profile/rule-type profile properties tags state) (when (contains? tags "project") "project") (when state "task"))
              next-heading (first (filter #(> (:row %) (:row h)) headings))
              body-end (or (:row next-heading) (:end h))
              body (subvec lines (inc (:row h)) body-end)
              fields (profile/fields profile kind properties (:row h))]
         {:id (get properties "ID") :type kind :recognized? (contains? (:types profile) kind) :complete? (not (blank? title))
          :role (get-in profile [:declarations kind :role] (case kind "task" :task "project" :project :data))
          :fields (:values fields) :field-diagnostics (:diagnostics fields)
          :title title :priority priority :state state :done? (contains? done state) :tags tags :properties properties
          :scheduled (date-at (mapv #(nth body %) (planning-rows body)) "SCHEDULED") :deadline (date-at (mapv #(nth body %) (planning-rows body)) "DEADLINE")
          :row (:row h) :end (:end h) :level (:level h)})) headings)
       duplicates (set (for [[id n] (frequencies (keep :id rows)) :when (> n 1)] id))]
  {:objects rows :profile (select-keys profile [:id :declarations :types :rules]) :workflow {:open open :done done :sequences sequences}
   :diagnostics (vec (concat (mapcat :field-diagnostics rows)
    (for [row rows :when (and (:recognized? row) (not (:complete? row)))]
     {:code :empty-title :row (:row row) :message "Add a title to show this object in views."})
    (for [row rows :when (and (:recognized? row) (:complete? row) (blank? (:id row)))]
     {:code :missing-id :row (:row row) :message "Add an ID property to edit this object across views."})
    (for [row rows :when (contains? duplicates (:id row))]
     {:code :duplicate-id :row (:row row) :id (:id row) :message "Org IDs must be unique within a document."})))})))

(defn update-object
 "Change native task fields by stable ID while retaining the rest of its section.
  Returned source still needs the host's revision and permission guarded writer."
 [text id changes]
 (when-not (and (map? changes) (every? #{:title :state :done? :assignee :scheduled :deadline :properties} (keys changes)))
  (throw (ex-info "Choose supported Org object fields." {})))
 (doseq [key [:title :state :assignee] :when (contains? changes key)]
  (when-not (and (string? (get changes key)) (not (re-find #"[\r\n]" (get changes key))))
   (throw (ex-info "Use single-line text for Org object fields." {}))))
 (when (and (contains? changes :done?) (not (boolean? (:done? changes))))
  (throw (ex-info "done? must be a boolean." {})))
 (doseq [key [:scheduled :deadline] :when (contains? changes key)]
  (let [value (get changes key)]
   (when-not (and (string? value) (or (empty? value) (and (re-matches #"[0-9]{4}-[0-9]{2}-[0-9]{2}" value)
                                                                       (= :ok (first (Date/from_iso8601 value))))))
    (throw (ex-info "Use an ISO date or an empty string to clear planning." {})))))
 (let [parsed (read-source text) matches (filterv #(= id (:id %)) (:objects parsed))]
  (when-not (= 1 (count matches)) (throw (ex-info "Choose one unambiguous Org ID." {:kind :omega/org-object})))
  (let [object (first matches) lines (vec (String/split text "\n")) row (:row object)
        raw (nth lines row) cr (if (ends-with? raw "\r") "\r" "")
        title (get changes :title (:title object))
        _ (when (or (blank? title) (re-find #"[\r\n]" title)) (throw (ex-info "Use a single-line Org title." {})))
        workflow (:workflow parsed) done? (:done? changes)
        state (cond (contains? changes :state) (:state changes)
                    (contains? changes :done?)
                    (if done? (if (contains? (:done workflow) "DONE") "DONE" (first (sort (:done workflow))))
                               (if (contains? (:open workflow) "TODO") "TODO" (first (sort (:open workflow)))))
                    :else (:state object))
        _ (when (and state (not (contains? (into (:open workflow) (:done workflow)) state)))
            (throw (ex-info "Choose a state declared by the document TODO workflow." {})))
        heading (if (some #(contains? changes %) [:title :state :done?])
                  (str (join "" (repeat (:level object) "*")) " " (when state (str state " "))
                       (when (:priority object) (str "[#" (:priority object) "] ")) title
                       (when-let [tags (second (re-find #" +(:[A-Za-z0-9_@#%:-]+:) *\r?$" raw))] (str " " tags)) cr)
                  raw)
        own-end (or (:row (first (filter #(> (:row %) row) (:objects parsed)))) (:end object))
        body (subvec lines (inc row) own-end)
        property-update (fn [body key value]
          (let [start (first (keep-indexed #(when (re-find #"(?i)^ *:PROPERTIES: *\r?$" %2) %1) body))
                end (when start (first (filter #(re-find #"(?i)^ *:END: *\r?$" (nth body %)) (range (inc start) (count body)))))
                property-row (when end (first (filter #(re-find (Regex/compile! (str "(?i)^ *:" key ":")) (nth body %)) (range (inc start) end))))
                line (str ":" key ": " value cr)]
            (cond (and property-row (nil? value)) (into (subvec body 0 property-row) (subvec body (inc property-row)))
                  (nil? value) body
                  property-row (assoc body property-row line)
                  end (into (conj (subvec body 0 end) line) (subvec body end))
                  start (throw (ex-info "Close the Org property drawer before editing its fields." {}))
                  :else (into [(str ":PROPERTIES:" cr) line (str ":END:" cr)] body))))
        property-changes (:properties changes {})
        _ (when-not (and (map? property-changes) (<= (count property-changes) 32))
            (throw (ex-info "Change at most 32 Org properties at once." {})))
        body (reduce (fn [body [key value]]
               (let [key (if (keyword? key) (name key) key)
                     _ (when-not (and (string? key) (re-matches #"[A-Z][A-Z0-9_+-]{0,63}" key)
                                       (not (contains? #{"ID" "END" "PROPERTIES"} key)))
                         (throw (ex-info "Use uppercase property names; stable IDs are edited explicitly in source." {})))
                     value (cond (nil? value) nil (string? value) value
                                  (or (boolean? value) (number? value)) (pr-str value)
                                  (and (vector? value) (every? string? value)) (join ":" value)
                                  :else (throw (ex-info "Use scalar property values or a vector of tags." {})))
                     _ (when (and value (or (> (count value) 2000) (re-find #"[\r\n]" value)))
                         (throw (ex-info "Keep property values to one short line." {})))]
                 (property-update body key value))) body property-changes)
        body (if (contains? changes :assignee) (property-update body "ASSIGNEE" (:assignee changes)) body)
        planning (fn [body key value]
          (let [pattern (Regex/compile! (str key ": *([<\\[])[0-9]{4}-[0-9]{2}-[0-9]{2}([^>\\]]*)([>\\]]) *"))
                eligible (set (planning-rows body))
                present? (some #(re-find pattern (nth body %)) eligible)
                cleaned (vec (remove nil? (map-indexed (fn [i line]
                  (if-let [matched (when (contains? eligible i) (re-find pattern line))]
                   (let [tail (String/replace (nth matched 2) #"^ +[A-Za-z]{3}(?= |$)" "")
                         replacement (if (blank? value) "" (str key ": " (second matched) value tail (nth matched 3) (when (ends-with? (first matched) " ") " ")))
                         changed (String/replace line (first matched) replacement)]
                     (when-not (blank? changed) changed)) line)) body)))]
           (if (or present? (blank? value)) cleaned
            (into [(str key ": <" value ">" cr)] cleaned))))
        body (if (contains? changes :scheduled) (planning body "SCHEDULED" (:scheduled changes)) body)
        body (if (contains? changes :deadline) (planning body "DEADLINE" (:deadline changes)) body)
        next (into (into (conj (subvec lines 0 row) heading) body) (subvec lines own-end))]
   (join "\n" next))))

(defn assign-identities
 "Materialize missing IDs once when a host admits native work into its corpus.
  make-id is pure and host-owned; unrelated source bytes remain untouched."
 ([text make-id] (assign-identities text make-id (merge default-profile (profile/read-source text))))
 ([text make-id profile]
 (let [parsed (read-source text profile) missing (filterv #(and (:recognized? %) (:complete? %) (blank? (:id %))) (:objects parsed))
       used (set (keep :id (:objects parsed)))
       assignments (mapv #(assoc (select-keys % [:row :type]) :id (make-id %)) missing)]
  (when-not (and (every? #(and (string? (:id %)) (re-matches #"[A-Za-z0-9_.-]{1,160}" (:id %))) assignments)
                 (= (count assignments) (count (set (map :id assignments))))
                 (not-any? #(contains? used (:id %)) assignments))
   (throw (ex-info "Generated Org identities must be unique and valid." {})))
  {:assigned assignments
   :source (reduce (fn [source assignment]
     (let [lines (vec (String/split source "\n")) row (:row assignment)
           cr (if (ends-with? (nth lines row) "\r") "\r" "")
           at (loop [at (inc row)]
                (if (and (< at (count lines)) (or (blank? (nth lines at)) (re-find #"^ *(SCHEDULED:|DEADLINE:|CLOSED:)" (nth lines at))))
                 (recur (inc at)) at))
           drawer? (and (< at (count lines)) (re-find #"(?i)^ *:PROPERTIES: *\r?$" (nth lines at)))
           section-end (or (first (filter #(re-find #"^\*+ " (nth lines %)) (range (inc at) (count lines)))) (count lines))
           end (when drawer? (first (filter #(re-find #"(?i)^ *:END: *\r?$" (nth lines %)) (range (inc at) section-end))))
           _ (when (and drawer? (nil? end)) (throw (ex-info "Close the property drawer before assigning an Org ID." {})))
           insert-at (if drawer? (inc at)
                       (loop [at (inc row)] (if (and (< at (count lines)) (re-find #"^ *(SCHEDULED:|DEADLINE:|CLOSED:)" (nth lines at)))
                                              (recur (inc at)) at)))
           added (if drawer? [(str ":ID: " (:id assignment) cr)]
                   [(str ":PROPERTIES:" cr) (str ":ID: " (:id assignment) cr) (str ":END:" cr)])]
       (join "\n" (into (into (subvec lines 0 insert-at) added) (subvec lines insert-at)))))
     text (reverse assignments))})))
