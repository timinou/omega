; omega/stream.bl — live model output, as an EPHEMERAL broadcast.
;
; A turn's final content is a fact (omega.loop records it). The tokens that
; build it are not: they are worth seeing while they arrive and worthless
; after, so they never touch the fact log. They travel over OTP `pg` process
; groups instead — one group for everything, joined by any viewer:
;
;   (stream/watch!)                     the calling process joins
;   receive [:omega/delta task-id d]    d = {:turn n :block i :kind :text|:tool-input :text s}
;   receive [:omega/turn-done task-id]  the turn's content is now a fact
;   receive [:omega/activity task-id p] what it is doing now (a tool call, an sh); nil = nothing
;
; Publishing is fire-and-forget to every member; a slow or dead viewer can
; never stall a model call. Coalescing is the viewer's business.

(ns omega.stream)

(defn group [world] [:omega/stream world])

(defn- ensure-pg
  "Start the default pg scope once, UNLINKED (start_link would tie it to
   whichever process happened to call first, and it would die with it).
   NB: erlang/whereis answers :undefined, not nil, for an unregistered name."
  []
  (when (= :undefined (erlang/whereis :pg))
    (try (pg/start :pg) (catch _ nil)))
  :ok)

(defn watch!
  "Join `world`'s stream group: this process now receives its tasks' deltas."
  [world]
  (ensure-pg)
  (pg/join (group world) (erlang/self))
  :ok)

(defn unwatch! [world]
  (ensure-pg)
  (pg/leave (group world) (erlang/self))
  :ok)

(defn publish!
  "Send `msg` to every watcher of `world`."
  [world msg]
  (ensure-pg)
  (doseq [p (pg/get_members (group world))] (erlang/send p msg))
  :ok)

(defn delta! [world task d] (publish! world [:omega/delta task d]))

(defn activity!
  "What task `task` is doing right now, as a patch merged into its activity
   (keys with nil values are cleared); `nil` clears it all. Shapes:
   {:tool \"eval\" :code first-line :since ms} while a call runs, plus
   {:sh cmd :sh-since ms} while an (sh …) inside it runs."
  [world task patch]
  (publish! world [:omega/activity task patch]))
(defn turn-done! [world task] (publish! world [:omega/turn-done task]))
