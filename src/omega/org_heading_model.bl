;; One lexical headline grammar, portable between native readers and the editor.
(ns ^:js omega.org-heading-model (:require [clojure.re]))
(def default-workflow
 {:open #{"TODO" "NEXT" "DOING" "WAIT" "BLOCKED" "REVIEW"}
  :done #{"DONE" "DROP" "CANCELLED" "CANCELED"}})
(defn workflow
 "Read ordered TODO declarations from reader-approved header lines. Explicit
  empty declarations disable the default workflow; CRLF and fast keys are native."
 [lines fallback]
 (let [declarations (keep (fn [line]
                       (when-let [match (re-find #"^#\+([^:]+):[ \t]*([^\r\n]*)\r?$" line)]
                        (when (contains? #{"TODO" "SEQ_TODO" "TYP_TODO"} (upper-case (second match))) (nth match 2)))) lines)
       sequences (mapv (fn [declaration]
                    (let [tokens (vec (remove blank? (split (trim declaration) #"[ \t]+")))
                          words (mapv #(Regex/replace #"\(.*\)$" % "") tokens)
                          divider (first (keep-indexed #(when (= "|" %2) %1) words))
                          at (or divider (max 0 (dec (count words))))]
                     {:open (vec (take at words)) :done (vec (drop (if divider (inc at) at) words))
                      :tokens tokens})) declarations)]
  (if (seq declarations)
   {:open (set (mapcat :open sequences)) :done (set (mapcat :done sequences)) :sequences sequences}
   (assoc (select-keys fallback [:open :done]) :sequences []))))
(defn workflow-data
 "JSON-safe ordered snapshot for a protected document projection."
 [workflow]
 (let [sequences (:sequences workflow)
       ordered (fn [key] (if (seq sequences) (vec (distinct (mapcat key sequences))) (vec (sort (get workflow key)))))]
  (let [data {:open (ordered :open) :done (ordered :done) :sequences (vec sequences)}
        words (concat (:open data) (:done data))]
   (when-not (and (<= (count words) 128) (<= (count sequences) 64)
                  (every? #(and (string? %) (<= 1 (erlang/byte_size %) 320)) words)
                  (<= (erlang/byte_size (pr-str data)) 16384))
    (throw (ex-info "Keep the visual workflow below 128 states and 16 KB; use Source for larger declarations." {:kind :omega/org-workflow})))
   data)))
(defn length [text] (erlang/length (unicode/characters_to_list text)))
(defn slice [text from to]
 (unicode/characters_to_binary (to-list (subvec (vec (unicode/characters_to_list text)) from to))))
(def priority-pattern "(?:[A-Za-z]|[0-5]?[0-9]|6[0-4])")
(def priority-value-pattern (Regex/compile! (str "^" priority-pattern "$")))
(def priority-cookie-pattern (Regex/compile! (str "^\\[#(" priority-pattern ")\\](?:[ \\t]+|$)")))
(defn priority? [value] (boolean (and (string? value) (re-matches priority-value-pattern value))))
(defn- literal? [ranges from to]
 (boolean (some #(and (< (:from %) to) (> (:to %) from)) ranges)))
(defn- gap-end [text at]
 (+ at (length (or (re-find #"^[ \t]*" (slice text at (length text))) ""))))
(defn fields
 "Interpret a headline body, without its leading stars. Title bounds are
  Unicode codepoints in the original body, not bytes or markup offsets."
 ([text workflow] (fields text workflow []))
 ([text workflow literals]
 (let [body (trim text) leading (length (or (re-find #"^\s*" text) ""))
       word (first (split body #"[ \t]+"))
       state (when (and (contains? (set (concat (:open workflow) (:done workflow))) word)
                        (not (literal? literals leading (+ leading (length word))))) word)
       state-to (+ leading (if state (length state) 0))
       priority-from (if state (gap-end text state-to) leading)
       after-state (trim (slice text priority-from (length text)))
       priority-match (re-find priority-cookie-pattern after-state)
       priority (when (and priority-match (not (literal? literals priority-from (+ priority-from 3 (length (second priority-match))))))
                  (second priority-match))
       priority-to (+ priority-from (if priority (+ 3 (length priority)) 0))
       from (if priority (gap-end text priority-to) priority-from)
       after-priority (trim (slice text from (length text)))
       tag-match (re-find #"(?:^|[ \t]+)(:[A-Za-z0-9_@#%:-]+:)[ \t]*$" after-priority)
       tag-from (when tag-match (- (+ leading (length body)) (length (second tag-match))))
       tag-match (when (and tag-match (not (literal? literals tag-from (+ leading (length body))))) tag-match)
       tags (if tag-match (vec (remove empty? (split (second tag-match) ":"))) [])
       before-tags (if tag-match (slice after-priority 0 (- (length after-priority) (length (first tag-match)))) after-priority)
       title (trim before-tags)
       metadata-to (if priority priority-to state-to)
       ;; Empty titles reuse an existing separator on each side. Choosing the
       ;; tag's start would add a third separator after deleting a normal title.
       from (if (and tag-match (empty? title) (or state priority))
              (+ metadata-to (if (< metadata-to tag-from) 1 0)) from)
       to (+ from (length title))]
  {:title title :state state :priority priority :tags tags :title/from from :title/to to
   :state/from leading :state/to state-to :state/next priority-from
   :priority/from priority-from :priority/to priority-to
   :tags/from (when tag-match (- (+ leading (length body)) (length (second tag-match))))
   :tags/to (when tag-match (+ leading (length body)))})))
(defn tag-values [value]
 (let [tags (cond (string? value) (vec (remove empty? (map trim (split value ":"))))
                  (vector? value) value :else nil)]
  (when-not (and tags (<= (count tags) 16)
                 (every? #(and (string? %) (<= 1 (length %) 80) (re-matches #"[A-Za-z0-9_@#%-]+" %)) tags)
                 (= (count tags) (count (set tags))))
   (throw (ex-info "Use at most 16 distinct Org tags, separated by colons." {})))
  tags))

(defn- replace-range [text from to value]
 (str (slice text 0 from) value (slice text to (length text))))
(defn validate-changes [workflow changes]
 (when-not (and (map? changes) (every? #{:state :priority :tags :title} (keys changes)))
  (throw (ex-info "Choose native headline fields." {})))
 (when (contains? changes :state)
  (when-not (or (nil? (:state changes))
                (contains? (set (concat (:open workflow) (:done workflow))) (:state changes)))
   (throw (ex-info "Choose a state declared by the document workflow." {}))))
 (when (contains? changes :priority)
  (when-not (and (string? (:priority changes))
                (or (empty? (:priority changes)) (priority? (:priority changes))))
   (throw (ex-info "Use an Org priority letter or number0–64, or empty text." {}))))
 (when (contains? changes :title)
  (when-not (and (string? (:title changes)) (not (blank? (:title changes)))
                (not (re-find #"[\r\n]" (:title changes))))
   (throw (ex-info "Use a single-line Org title." {}))))
 (cond-> changes (contains? changes :tags) (assoc :tags (tag-values (:tags changes)))))
(defn rewrite
 "Patch native headline fields without rewriting untouched lexical seams.
  Full single-line body only; stars and line ending remain the caller's."
 [text workflow changes]
 (let [changes (validate-changes workflow changes)
       result (reduce (fn [text key]
                (if-not (contains? changes key) text
                 (let [f (fields text workflow) value (get changes key)]
                  (if (= (get f key) (if (and (= key :priority) (empty? value)) nil value)) text
                   (case key
                    :state (if (:state f)
                             (replace-range text (:state/from f) (if value (:state/to f) (:state/next f)) (or value ""))
                             (replace-range text (:state/from f) (:state/from f) (str value " ")))
                    :priority (if (:priority f)
                                (replace-range text (:priority/from f) (if (empty? value) (:title/from f) (:priority/to f))
                                  (if (empty? value) "" (str "[#" value "]")))
                                (replace-range text (:priority/from f) (:priority/from f) (str (when (and (:state f) (= (:state/to f) (:priority/from f))) " ") "[#" value "] ")))
                    :tags (let [token (when (seq value) (str ":" (join ":" value) ":"))]
                            (if (:tags/from f)
                             (replace-range text (if token (:tags/from f) (:title/to f)) (:tags/to f) (or token ""))
                             (if token (replace-range text (:title/to f) (:title/to f) (str " " token)) text)))
                    :title (let [from (:title/from f) to (:title/to f) empty-title? (empty? (:title f))
                                 before (slice text 0 from) after (slice text to (length text))
                                 prefix (when (and empty-title? (not (empty? before)) (not (re-find #"[ \t]$" before))) " ")
                                 suffix (when (and empty-title? (not (empty? after)) (not (re-find #"^[ \t]" after))) " ")]
                             (replace-range text from to (str prefix value suffix)))))))) text [:state :priority :tags :title])
       actual (fields result workflow)]
  (doseq [[key value] changes]
   (when-not (= (if (= key :title) (trim value) (if (and (= key :priority) (empty? value)) nil value)) (get actual key))
    (throw (ex-info "This field would change the meaning of native Org metadata. Use Source to express it explicitly." {}))))
  result))
