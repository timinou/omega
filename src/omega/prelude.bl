; omega/prelude.bl — the functions a task's eval code calls.
;
; Referred into every task namespace by omega.codemode. Each function finds its
; task through the cell process's dictionary (`-bind!`), and the task's system
; through a registry keyed by task id (`-register!`). So the model writes
; `(read "a.txt")`, never `(read sys task "a.txt")`.
;
; Every function returns plain data and throws ex-info with a clear message on
; failure: inside a program, an exception aborts the program and the model
; reads the message, which is the behaviour a script author expects.

(ns omega.prelude
  (:require [omega.env :as env]
            [omega.actor :as actor]
            [omega.trace :as tr]
            [omega.reap :as reap]
            [omega.stream :as stream]
            [omega.edit :as ed]))

;; ── context ─────────────────────────────────────────────────────────────
;
; Keyed by [world task] (C2): task ids are unique per world (per env), not per
; VM, so two omega worlds in one VM never see each other's systems.

(def ^:private SYSTEMS (atom {}))
(def ^:private DONE (atom {}))

(defn -register!
  "Make `sys` the system for its world's task `task`; returns the world id."
  [task sys]
  (let [w (env/world (:env sys))
        id (env/eid (:env sys) :task/id task)
        cwd (:task/cwd (when id (env/pull (:env sys) [:task/cwd] id)))
        context (if cwd (assoc sys :root cwd) sys)]
    (swap! SYSTEMS assoc [w task] context) w))
(defn -bind!
  "Bind the cell process to `task` of `world`; `cell` tags the OS processes it
   starts, `deadline` (monotonic ms) is when the cell will be killed."
  ([world task] (-bind! world task nil nil))
  ([world task cell deadline]
   (erlang/put :omega/world world)
   (erlang/put :omega/task task)
   (erlang/put :omega/cell cell)
   (erlang/put :omega/deadline deadline)
   task))

(defn- now-ms [] (erlang/monotonic_time :millisecond))

(defn- ms-left
  "Milliseconds until this cell is killed, keeping `margin` to report back; nil outside a cell."
  [margin]
  (when-let [d (erlang/get :omega/deadline)] (max 0 (- d (now-ms) margin))))

(defn- task [] (or (erlang/get :omega/task) (throw (ex-info "not inside a task eval" {}))))
(defn- world [] (erlang/get :omega/world))
(defn- sys [] (get @SYSTEMS [(world) (task)]))
(defn- e [] (:env (sys)))
(defn- root [] (or (:root (sys)) (File/cwd!)))
(defn- path [p] (Path/expand p (root)))

(defn -done? [world t] (contains? @DONE [world t]))
(defn -take-done! [world t] (let [s (get @DONE [world t])] (swap! DONE dissoc [world t]) s))

;; ── files, through a port (C6) ──────────────────────────────────────────
;
; read/write/edit go through the system's file port, `(:files sys)`, a map of
; three fns over ctx = {:task :cell :root}. The default is the disk. A buffer
; server (bl-ed) installs its own port, so an agent's edit lands in the buffer
; the human is looking at instead of under it. A port's :edit returns
; {:ok text} | {:error why}; the rules it applies are omega.edit's.

(def DISK
  "The default file port: the project directory."
  {:read (fn [c p] (let [f (Path/expand p (:root c))] (when (File/regular? f) (File/read! f))))
   :write (fn [c p s] (let [f (Path/expand p (:root c))] (File/mkdir_p! (Path/dirname f)) (File/write! f s) :ok))
   :edit (fn [c p edits]
           (let [f (Path/expand p (:root c))]
             (if (File/regular? f)
               (let [r (ed/apply-edits (:rules c) (File/read! f) edits)]
                 (when (contains? r :ok) (File/write! f (:ok r)))
                 r)
               {:error (str "no such file: " p)})))})

(defn- port [] (or (:files (sys)) DISK))
(defn- ctx [] {:task (task) :cell (erlang/get :omega/cell) :root (root) :rules (ed/rules (sys))})

(defn- claim-path!
  "Claim `p` for this task under the :claims rule. Returns the note the model
   reads (C9), or nil. :refuse is checked before writing (see `guard!`)."
  [p]
  (let [mode (:claims (ed/rules (sys)))]
    (when-not (= :ignore mode)
      (let [r (tr/claim! (e) (task) (path p))]
        (when-let [cs (seq (:conflict r))]
          (ed/claim-note p (vec (distinct (map :task cs)))))))))

(defn- guard!
  "Under the :refuse claims rule, throw before touching `p` held by another task."
  [p]
  (when (= :refuse (:claims (ed/rules (sys))))
    (when-let [cs (seq (tr/conflicts (e) (task) (path p)))]
      (throw (ex-info (str "not written: " (ed/claim-note p (vec (distinct (map :task cs)))))
                      {:path p :claims (vec (map :task cs))})))))

(defn- with-note [s note] (if note (str s " (" note ")") s))

(defn read
  "The text of file `p` (relative to the project root)."
  [p]
  (let [s ((:read (port)) (ctx) p)]
    (if (nil? s) (throw (ex-info (str "no such file: " p) {:path p})) s)))

(defn write
  "Create or overwrite `p` with string `s`; claims the path for this task."
  [p s]
  (guard! p)
  ((:write (port)) (ctx) p s)
  (with-note (str "wrote " (count s) " bytes to " p) (claim-path! p)))

(defn apply-edits
  "Apply [{:old :new}] to `text` under omega.edit's default rules."
  [text edits]
  (ed/apply-edits text edits))

(defn edit
  "Edit `p` by exact replacement: edits = [{:old \"…\" :new \"…\"} …]. All or nothing."
  [p edits]
  (guard! p)
  (let [r ((:edit (port)) (ctx) p edits)]
    (if (and (contains? r :error) (not (contains? r :ok)))
      (throw (ex-info (str "edit " p ": " (:error r)) {:path p}))
      (with-note (str "applied " (if (:error r) (str "some edits (stopped at: " (:error r) ")") (str (count edits) " edit(s)")) " to " p)
                 (claim-path! p)))))

(defn ls
  "Entries of directory `p` (default the root), sorted."
  ([] (ls "."))
  ([p] (vec (sort (File/ls! (path p))))))

(defn glob
  "Paths matching `pattern` under the root, relative, sorted."
  [pattern]
  (let [r (root)]
    (vec (sort (map (fn [f] (Path/relative_to f r)) (Path/wildcard (Path/join r pattern)))))))

;; ── shell, as a function ────────────────────────────────────────────────

(defn sh
  "Run `cmd` with sh in the project root: {:out combined-output :exit code}.
   Never throws on a non-zero exit — check :exit."
  [cmd]
  ;; TERM=dumb + NO_COLOR: tools think they're in a pipe, so output carries no
  ;; escape codes or terminfo warnings into the model's context
  (stream/activity! (world) (task) {:sh cmd :sh-since (erlang/system_time :millisecond)})
  (let [r (System/cmd "sh" (list "-c" cmd) (list (tuple :stderr_to_stdout true) (tuple :cd (root))
                                                 ;; the reap tags: whatever this starts, even in the
                                                 ;; background, dies with its cell or task (omega.reap)
                                                 (tuple :env (to-list (concat [(tuple "TERM" "dumb") (tuple "NO_COLOR" "1")
                                                                               (tuple "PAGER" "cat") (tuple "GIT_PAGER" "cat")]
                                                                              (reap/env-tags (:nonce (sys)) (task) (erlang/get :omega/cell)))))))]
    (stream/activity! (world) (task) {:sh nil :sh-since nil})
    {:out (elem r 0) :exit (elem r 1)}))

;; ── tasks ───────────────────────────────────────────────────────────────

(defn spawn
  "Open a subtask owned by this task; returns its id at once (it runs in parallel)."
  ([goal] (spawn goal nil))
  ([goal scope]
   (let [s (sys)]
     ((:open! s) s {:goal goal :owner (task) :by (task) :scope scope}))))

(defn wait
  "Block until task `id` is done/idle/failed: {:status :result}. Spends no tokens.
   Never outlives this eval: it waits at most `ms` AND until shortly before the
   cell's deadline, then returns {:status :running :pending true …} — the task
   goes on; (wait id) again in a later eval."
  ([id] (wait id 600000))
  ([id ms]
   (let [s (sys)
         left (ms-left 3000)
         ms (if left (min ms left) ms)
         v ((:await s) s id ms)]
     (if (= :timeout v)
       {:status ((:status s) s id) :result nil :pending true
        :note (str id " is still working after " (quot ms 1000) "s; call (wait " (pr-str id) ") again in your next eval")}
       (select-keys v [:status :result])))))

(defn send
  "Message another actor (a task id or \"human:me\"). kind :note | :ask | :steer."
  [to kind text]
  (actor/send! (e) {:from (task) :to to :kind (keyword kind) :text text}))

(defn done
  "Close this task as complete with `summary`. Takes effect when the eval returns."
  [summary]
  (swap! DONE assoc [(world) (task)] summary)
  :done)

;; ── the shared environment ──────────────────────────────────────────────

(defn trace
  "Leave (or reinforce) a mark for other tasks. kind: :finding :intent :blocker … (open)."
  [kind subject text]
  (tr/leave! (e) (task) {:kind (keyword kind) :subject subject :text text}))

(defn traces
  "Read marks (strongest first); reading reinforces others' marks.
   opts: :kind :task :subject-prefix :min-strength (default 0.1)."
  ([] (traces {}))
  ([opts]
   (vec (map (fn [v] (select-keys v [:task :kind :subject :text :strength]))
             (tr/read! (e) (task) (merge {:min-strength 0.1} opts))))))

(defn q
  "Datalog over the environment (tasks, messages, traces, turns)."
  [query & inputs]
  (apply env/q (e) query inputs))
